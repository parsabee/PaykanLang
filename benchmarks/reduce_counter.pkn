// The same count as atomic_counter, as a reduction: each chunk counts in
// its own slot, and the partials are folded afterwards.  No shared line.
//   reduce_counter <n> <reps> <stride>
import ::io;
import bench;

fn main(args: view Str[]) -> int {
  let n = bench::arg(args, 1, 4194304);
  let reps = bench::arg(args, 2, 5);
  let stride = bench::arg(args, 3, 1);
  best = 0;
  total = 0;
  c = 0;
  let c0 = bench::cpu();
  let w0 = bench::now();
  for r in 0..reps {
    c = 0;
    let t0 = bench::now();
    parallel for i in 0..n {
      if i % stride == 0 { c += 1; }
    }
    let dt = bench::now() - t0;
    total += dt;
    if best == 0 || dt < best { best = dt; }
  }
  let cpu = bench::cpu() - c0;
  let wall = bench::now() - w0;
  io::println("reduce_counter n=" + Str(n) + " reps=" + Str(reps) + " stride="
      + Str(stride) + " ns_min=" + Str(best) + " ns_mean=" + Str(total / reps)
      + " wall_ns=" + Str(wall) + " cpu_ns=" + Str(cpu) + " check=" + Str(c));
  return 0;
}
