// ys = a * xs + ys over two heap buffers: xs frozen in a box, read in
// place (a bounds check and a load per element); ys, the function's own,
// read in place too and written at the loop's variable (Sema allows no
// other index) with the memory module's `set`: a call per element, which
// checks the index and returns an error value.
//   saxpy_buf <n> <reps>      n elements in each (32M: 512 MB in all)
import ::io;
import ::memory as mem;
import bench;

fn main(args: view Str[]) -> int {
  let n = bench::arg(args, 1, 33554432);
  let reps = bench::arg(args, 2, 3);
  a = mem::Buffer<float>();
  ys = mem::Buffer<float>();
  let ga = a.grow(unsigned<int>(n));
  let gy = ys.grow(unsigned<int>(n));
  for i in 0..n {
    let ea = a.set(unsigned<int>(i), float<int>(i % 7));
    let ey = ys.set(unsigned<int>(i), 1.0);
  }
  let xs: atomic shared const mem::Box<mem::Buffer<float>> = mem::Box(move a);
  let k = 0.5;
  best = 0;
  total = 0;
  let c0 = bench::cpu();
  let w0 = bench::now();
  for r in 0..reps {
    let t0 = bench::now();
    parallel for i in 0..n {
      let u = unsigned<int>(i);
      let e = ys.set(unsigned<int>(i), k * xs.value().at(u) + ys.at(u));
    }
    let dt = bench::now() - t0;
    total += dt;
    if best == 0 || dt < best { best = dt; }
  }
  let cpu = bench::cpu() - c0;
  let wall = bench::now() - w0;
  check = 0.0;
  for i in 0..n { check += ys.at(unsigned<int>(i)); }
  io::println("saxpy_buf n=" + Str(n) + " reps=" + Str(reps) + " ns_min="
      + Str(best) + " ns_mean=" + Str(total / reps) + " wall_ns=" + Str(wall)
      + " cpu_ns=" + Str(cpu) + " check=" + Str(check));
  return 0;
}
