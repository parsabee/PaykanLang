// A reduction over a heap buffer: the design's route to data larger than
// a fixed-size array.  A buffer is a struct, a value, so it goes in a
// `mem::Box`, an object, which is frozen (`atomic shared`) with the buffer
// and its elements: every thread then reads it with no reference counting.
// An element read (`xs.value().at(i)`) is emitted in place by the lowering:
// a bounds check and a load, no call and no count.
//   sum_buf <n> <reps>      n elements, 8 bytes each (64M: 512 MB)
import ::io;
import ::memory as mem;
import bench;

fn main(args: view Str[]) -> int {
  let n = bench::arg(args, 1, 67108864);
  let reps = bench::arg(args, 2, 3);
  b = mem::Buffer<float>();
  let grown = b.grow(unsigned(n));
  for i in 0..n { let e = b.set(unsigned(i), float(i % 7)); }
  let xs: atomic shared = mem::Box(move b);   // boxed, then frozen
  best = 0;
  total = 0;
  s = 0.0;
  let c0 = bench::cpu();
  let w0 = bench::now();
  for r in 0..reps {
    let t0 = bench::now();
    s = 0.0;
    parallel for i in 0..n { s += xs.value().at(unsigned(i)); }
    let dt = bench::now() - t0;
    total += dt;
    if best == 0 || dt < best { best = dt; }
  }
  let cpu = bench::cpu() - c0;
  let wall = bench::now() - w0;
  io::println("sum_buf n=" + Str(n) + " reps=" + Str(reps) + " ns_min="
      + Str(best) + " ns_mean=" + Str(total / reps) + " wall_ns=" + Str(wall)
      + " cpu_ns=" + Str(cpu) + " check=" + Str(s));
  return 0;
}
