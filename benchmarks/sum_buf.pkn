// A reduction over a heap buffer: the design's route to data larger than
// a fixed-size array.  A buffer is a struct, a value, so it goes in a
// `mem::Box`, an object, which is frozen (`atomic const`) with the buffer
// and its elements: every thread then reads it with no reference counting.
// Each element read is a call of the box's `value`, of the buffer's `at`
// and of the runtime's bounds-checked `PaykanBuffer_get`.
//   sum_buf <n> <reps>      n elements, 8 bytes each (64M: 512 MB)
import ::io;
import ::memory as mem;
import bench;

fn main(args: view Str[]) -> int {
  let n = bench::arg(args, 1, 67108864);
  let reps = bench::arg(args, 2, 3);
  b = mem::Buffer<float>();
  let grown = b.grow(unsigned<int>(n));
  for i in 0..n { let e = b.set(unsigned<int>(i), float<int>(i % 7)); }
  let xs: atomic const mem::Box<mem::Buffer<float>> = mem::Box(move b);   // boxed, then frozen
  best = 0; total = 0; s = 0.0;
  let c0 = bench::cpu();
  let w0 = bench::now();
  for r in 0..reps {
    let t0 = bench::now();
    s = 0.0;
    parallel for i in 0..n { s += xs.value().at(unsigned<int>(i)); }
    let dt = bench::now() - t0;
    total += dt;
    if best == 0 || dt < best { best = dt; }
  }
  let cpu = bench::cpu() - c0;
  let wall = bench::now() - w0;
  io::println("sum_buf n=" + Str(n) + " reps=" + Str(reps) + " ns_min=" + Str(best) +
              " ns_mean=" + Str(total / reps) + " wall_ns=" + Str(wall) + " cpu_ns=" + Str(cpu) + " check=" + Str(s));
  return 0;
}
