// scalar.pkn — scalar Op enum and integer arithmetic
//
// Exported:
//   enum Op { Add, Sub, Mul, Div, Mod }
//   fn isValidOp(s: Str) -> bool
//   fn parseOp(s: Str) -> Op
//   fn applyOp(op: Op, a: int, b: int) -> int
//   fn opSymbol(op: Op) -> Str

enum Op {
  Add,
  Sub,
  Mul,
  Div,
  Mod,
}

fn isValidOp(s: Str) -> bool {
  match s {
    "+" { return True; }
    "-" { return True; }
    "*" { return True; }
    "/" { return True; }
    "%" { return True; }
    _   { return False; }
  }
}

fn parseOp(s: Str) -> Op {
  match s {
    "+" { return Op::Add; }
    "-" { return Op::Sub; }
    "*" { return Op::Mul; }
    "/" { return Op::Div; }
    "%" { return Op::Mod; }
    _   { return Op::Add; }   // unreachable if isValidOp was checked first
  }
}

fn applyOp(op: Op, a: int, b: int) -> int {
  match op {
    Add { return a + b; }
    Sub { return a - b; }
    Mul { return a * b; }
    Div { return a / b; }
    Mod { return a % b; }
  }
}

fn opSymbol(op: Op) -> Str {
  match op {
    Add { return "+"; }
    Sub { return "-"; }
    Mul { return "*"; }
    Div { return "/"; }
    Mod { return "%"; }
  }
}
