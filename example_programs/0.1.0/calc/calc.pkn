// calc.pkn — Paykan calculator REPL with variable environment
//
// Usage:  paykan calc.pkn
//
// Commands:
//   <name> = <int>                   assign integer literal
//   <name> = <varname>               copy a variable
//   <name> = [[r0c0 r0c1] [r1c0 ...]]  assign matrix literal
//   <name> = <a> <op> <b>            compute and store result
//   <a> <op> <b>                     compute and print (variable names or int literals)
//   scale <name> <float>             print matrix scaled by float
//   <name> = scale <src> <float>     compute scaled matrix and store
//   show <name>                      print variable value
//   vars                             list all variables
//   quit                             exit
//
// Matrix literal format: "[[r0c0 r0c1 ...] [r1c0 r1c1 ...] ...]"
//   Rows are space-separated numbers inside [...]; rows are separated by spaces.
//   Example:  a = [[1 2 3] [4 5 6]]  ->  2×3 matrix
//
// Parsing uses std::read(std::in()), std::split(s," "), and (int)/(float) casts.

import std;
import ops::scalar;
import ops::matrix;
import env::env;

// ── output helpers ────────────────────────────────────────────────────────────

fn println(msg: Str) {
  std::write(std::println(), msg);
}

fn error(msg: Str) {
  std::write(std::err(), "error: " + msg + "\n");
}

// ── string helpers ────────────────────────────────────────────────────────────

// True if s begins with "["  (i.e. it is the start of a matrix literal token)
fn isMatLit(s: Str) -> bool {
  return std::split(s, "[")[0] == "";
}

// Concatenate parts[start..] back into a space-separated string.
fn joinFrom(parts: Str[], start: int) -> Str {
  result: Str = parts[start];
  i: int = start + 1;
  while (i < parts.len()) {
    result = result + " " + parts[i];
    i = i + 1;
  }
  return result;
}

// Count non-empty tokens in an array.
fn countValid(toks: Str[]) -> int {
  n: int = 0;
  i: int = 0;
  while (i < toks.len()) {
    if (toks[i] != "") { n = n + 1; }
    i = i + 1;
  }
  return n;
}

// ── matrix literal parser ─────────────────────────────────────────────────────
// Parses "[[r0c0 r0c1 ...] [r1c0 ...] ...]" into a Mat.
//
// Algorithm (only std::split is needed):
//   1. Split the whole string by "]"  -> one segment per row + trailing empty.
//   2. Per segment: split by "["  -> last element is the space-separated numbers.
//   3. Split that by " " and skip empty tokens to get individual values.
//   4. Two passes: first count rows/cols, then create Mat and fill.

fn parseMatLit(s: Str) -> matrix::Mat {
  rowSegs: Str[] = std::split(s, "]");

  // Pass 1 — count rows and cols
  rows: int = 0;
  cols: int = 0;
  i: int = 0;
  while (i < rowSegs.len()) {
    bParts: Str[] = std::split(rowSegs[i], "[");
    numStr: Str = bParts[bParts.len() - 1];
    validCols: int = countValid(std::split(numStr, " "));
    if (validCols > 0) {
      if (rows == 0) { cols = validCols; }
      rows = rows + 1;
    }
    i = i + 1;
  }

  result: matrix::Mat = matrix::Mat(rows, cols);

  // Pass 2 — fill values
  r: int = 0;
  i = 0;
  while (i < rowSegs.len()) {
    bParts: Str[] = std::split(rowSegs[i], "[");
    numStr: Str = bParts[bParts.len() - 1];
    toks: Str[] = std::split(numStr, " ");
    c: int = 0;
    j: int = 0;
    while (j < toks.len()) {
      if (toks[j] != "") {
        matrix::matSet(result, r, c, (float)toks[j]);
        c = c + 1;
      }
      j = j + 1;
    }
    if (c > 0) { r = r + 1; }
    i = i + 1;
  }

  return result;
}

// ── matrix operation helpers ──────────────────────────────────────────────────

fn dimOk(a: matrix::Mat, op: Str, b: matrix::Mat) -> bool {
  match op {
    "+" { return a.rows == b.rows && a.cols == b.cols; }
    "-" { return a.rows == b.rows && a.cols == b.cols; }
    "*" { return a.cols == b.rows; }
    _   { return False; }
  }
}

fn dimErrMsg(a: matrix::Mat, op: Str, b: matrix::Mat) -> Str {
  return "dimension mismatch: " + matrix::matDimsStr(a) + " " + op + " " + matrix::matDimsStr(b);
}

fn applyMatOp(a: matrix::Mat, op: Str, b: matrix::Mat) -> matrix::Mat {
  match op {
    "+" { return matrix::matAdd(a, b); }
    "-" { return matrix::matSub(a, b); }
    "*" { return matrix::matMul(a, b); }
    _   { return matrix::matAdd(a, b); }  // unreachable: caller validates op
  }
}

// ── show ──────────────────────────────────────────────────────────────────────

fn runShow(environ: env::Env, name: Str) {
  if (env::envHasInt(environ, name)) {
    println(name + " = " + (Str)env::envGetInt(environ, name) + "\n");
  } else if (env::envHasMat(environ, name)) {
    m: matrix::Mat = env::envGetMat(environ, name);
    println(name + " [" + matrix::matDimsStr(m) + "] =\n" + matrix::matToStr(m) + "\n");
  } else {
    error("undefined variable '" + name + "'");
  }
}

// ── scale command ─────────────────────────────────────────────────────────────

fn runScale(environ: env::Env, name: Str, sStr: Str) {
  if (!env::envHasMat(environ, name)) {
    error("'" + name + "' is not a matrix");
    return;
  }
  result: matrix::Mat = matrix::matScale(env::envGetMat(environ, name), (float)sStr);
  println(sStr + " * " + name + " =\n" + matrix::matToStr(result) + "\n");
}

fn runScaleStore(environ: env::Env, target: Str, name: Str, sStr: Str) {
  if (!env::envHasMat(environ, name)) {
    error("'" + name + "' is not a matrix");
    return;
  }
  result: matrix::Mat = matrix::matScale(env::envGetMat(environ, name), (float)sStr);
  env::envSetMat(environ, target, result);
  println(target + " = [" + matrix::matDimsStr(result) + " matrix]\n");
}

// ── binary op (print result) ──────────────────────────────────────────────────

fn runBinOp(environ: env::Env, lhs: Str, op: Str, rhs: Str) {
  lhsIsMat: bool = env::envHasMat(environ, lhs);
  rhsIsMat: bool = env::envHasMat(environ, rhs);

  if (lhsIsMat || rhsIsMat) {
    if (!lhsIsMat) { error("'" + lhs + "' is not a matrix"); return; }
    if (!rhsIsMat) { error("'" + rhs + "' is not a matrix"); return; }
    a: matrix::Mat = env::envGetMat(environ, lhs);
    b: matrix::Mat = env::envGetMat(environ, rhs);
    if (!dimOk(a, op, b)) { error(dimErrMsg(a, op, b)); return; }
    result: matrix::Mat = applyMatOp(a, op, b);
    println(lhs + " " + op + " " + rhs + " =\n" + matrix::matToStr(result) + "\n");
  } else {
    // int: look up in env or treat as literal
    a: int = if env::envHasInt(environ, lhs) then env::envGetInt(environ, lhs) else (int)lhs;
    b: int = if env::envHasInt(environ, rhs) then env::envGetInt(environ, rhs) else (int)rhs;
    if (!scalar::isValidOp(op)) { error("unknown op '" + op + "'"); return; }
    sop: scalar::Op = scalar::parseOp(op);
    if (sop == scalar::Op::Div && b == 0) { error("division by zero"); return; }
    result: int = scalar::applyOp(sop, a, b);
    println(lhs + " " + op + " " + rhs + " = " + (Str)result + "\n");
  }
}

// ── binary op with store ──────────────────────────────────────────────────────

fn runBinOpStore(environ: env::Env, target: Str, lhs: Str, op: Str, rhs: Str) {
  lhsIsMat: bool = env::envHasMat(environ, lhs);
  rhsIsMat: bool = env::envHasMat(environ, rhs);

  if (lhsIsMat || rhsIsMat) {
    if (!lhsIsMat) { error("'" + lhs + "' is not a matrix"); return; }
    if (!rhsIsMat) { error("'" + rhs + "' is not a matrix"); return; }
    a: matrix::Mat = env::envGetMat(environ, lhs);
    b: matrix::Mat = env::envGetMat(environ, rhs);
    if (!dimOk(a, op, b)) { error(dimErrMsg(a, op, b)); return; }
    result: matrix::Mat = applyMatOp(a, op, b);
    env::envSetMat(environ, target, result);
    println(target + " = [" + matrix::matDimsStr(result) + " matrix]\n");
  } else {
    a: int = if env::envHasInt(environ, lhs) then env::envGetInt(environ, lhs) else (int)lhs;
    b: int = if env::envHasInt(environ, rhs) then env::envGetInt(environ, rhs) else (int)rhs;
    if (!scalar::isValidOp(op)) { error("unknown op '" + op + "'"); return; }
    sop: scalar::Op = scalar::parseOp(op);
    if (sop == scalar::Op::Div && b == 0) { error("division by zero"); return; }
    result: int = scalar::applyOp(sop, a, b);
    env::envSetInt(environ, target, result);
    println(target + " = " + (Str)result + "\n");
  }
}

// ── assignment dispatch ───────────────────────────────────────────────────────
// Called when parts[1] == "=".  Handles all forms:
//   name = <int>                      (3 tokens)
//   name = <varname>                  (3 tokens)
//   name = [[...] [...] ...]          (3+ tokens, parts[2] starts with "[")
//   name = <a> <op> <b>               (5 tokens)
//   name = scale <src> <float>        (5 tokens, parts[2] == "scale")

fn runAssign(environ: env::Env, parts: Str[]) {
  target: Str = parts[0];

  if (isMatLit(parts[2])) {
    m: matrix::Mat = parseMatLit(joinFrom(parts, 2));
    env::envSetMat(environ, target, m);
    println(target + " = [" + matrix::matDimsStr(m) + " matrix assigned]\n");
  } else if (parts.len() == 5 && parts[2] == "scale") {
    runScaleStore(environ, target, parts[3], parts[4]);
  } else if (parts.len() == 5) {
    // name = src1 op src2
    runBinOpStore(environ, target, parts[2], parts[3], parts[4]);
  } else if (parts.len() == 3) {
    // name = int_literal  or  name = varname
    if (env::envHasMat(environ, parts[2])) {
      env::envSetMat(environ, target, env::envGetMat(environ, parts[2]));
      m: matrix::Mat = env::envGetMat(environ, target);
      println(target + " = [" + matrix::matDimsStr(m) + " matrix copied]\n");
    } else if (env::envHasInt(environ, parts[2])) {
      env::envSetInt(environ, target, env::envGetInt(environ, parts[2]));
      println(target + " = " + (Str)env::envGetInt(environ, target) + "\n");
    } else {
      v: int = (int)parts[2];
      env::envSetInt(environ, target, v);
      println(target + " = " + (Str)v + "\n");
    }
  } else {
    error("unrecognized assignment form");
  }
}

// ── main ──────────────────────────────────────────────────────────────────────

fn main() -> int {
  println("Paykan Calc REPL\n");
  println("  <name> = <int>                    assign integer\n");
  println("  <name> = [[r0c0 r0c1] [r1c0 ...]] assign matrix\n");
  println("  <name> = <a> <op> <b>             compute and store  (ops: + - * /)\n");
  println("  <a> <op> <b>                      compute and print  (vars or literals)\n");
  println("  scale <name> <float>              scale matrix by float\n");
  println("  <name> = scale <src> <float>      scale and store\n");
  println("  show <name>                       print variable\n");
  println("  vars                              list all variables\n");
  println("  quit\n\n");

  environ = env::Env();

  running: bool = True;
  while (running) {
    println("> ");
    line: Str = std::read(std::in());
    parts: Str[] = std::split(line, " ");
    n = parts.len();

    if (n == 0) {
      // empty line — skip
    } else if (n == 1) {
      match parts[0] {
        "quit" { running = False; }
        "vars" { println(env::envListVars(environ)); }
        _      { error("unknown command '" + parts[0] + "'"); }
      }
    } else if (n == 2 && parts[0] == "show") {
      runShow(environ, parts[1]);
    } else if (n == 3 && parts[0] == "scale") {
      runScale(environ, parts[1], parts[2]);
    } else if (n >= 3 && parts[1] == "=") {
      runAssign(environ, parts);
    } else if (n == 3) {
      runBinOp(environ, parts[0], parts[1], parts[2]);
    } else {
      error("unrecognized command");
    }
  }

  println("bye.\n");
  return 0;
}