// env.pkn — named variable environment for the calc REPL
//
// Stores named int variables and named matrix variables in parallel arrays.
// Uses push(array, value) for dynamic array growth (runtime array operation).
//
// Exported:
//   class Env
//   fn envHasInt(self: Env, name: Str) -> bool
//   fn envGetInt(self: Env, name: Str) -> int
//   fn envSetInt(self: Env, name: Str, v: int)
//   fn envHasMat(self: Env, name: Str) -> bool
//   fn envGetMat(self: Env, name: Str) -> matrix::Mat
//   fn envSetMat(self: Env, name: Str, m: matrix::Mat)
//   fn envListVars(self: Env) -> Str

import ops::matrix;

class Env {
  intNames: Str[];
  intVals:  int[];
  matNames: Str[];
  matVals:  matrix::Mat[];

  fn __init__() {
    self.intNames = [];
    self.intVals  = [];
    self.matNames = [];
    self.matVals  = [];
  }
}

// ── int variables ─────────────────────────────────────────────────────────────

fn envIndexOfInt(self: Env, name: Str) -> int {
  i: int = 0;
  while (i < len(self.intNames)) {
    if (self.intNames[i] == name) { return i; }
    i = i + 1;
  }
  return -1;
}

fn envHasInt(self: Env, name: Str) -> bool {
  return envIndexOfInt(self, name) != -1;
}

fn envGetInt(self: Env, name: Str) -> int {
  return self.intVals[envIndexOfInt(self, name)];
}

fn envSetInt(self: Env, name: Str, v: int) {
  idx: int = envIndexOfInt(self, name);
  if (idx == -1) {
    push(self.intNames, name);
    push(self.intVals, v);
  } else {
    self.intVals[idx] = v;
  }
}

// ── matrix variables ──────────────────────────────────────────────────────────

fn envIndexOfMat(self: Env, name: Str) -> int {
  i: int = 0;
  while (i < len(self.matNames)) {
    if (self.matNames[i] == name) { return i; }
    i = i + 1;
  }
  return -1;
}

fn envHasMat(self: Env, name: Str) -> bool {
  return envIndexOfMat(self, name) != -1;
}

fn envGetMat(self: Env, name: Str) -> matrix::Mat {
  return self.matVals[envIndexOfMat(self, name)];
}

fn envSetMat(self: Env, name: Str, m: matrix::Mat) {
  idx: int = envIndexOfMat(self, name);
  if (idx == -1) {
    push(self.matNames, name);
    push(self.matVals, m);
  } else {
    self.matVals[idx] = m;
  }
}

// ── listing ───────────────────────────────────────────────────────────────────

fn envListVars(self: Env) -> Str {
  result: Str = "";
  i: int = 0;
  while (i < len(self.intNames)) {
    result = result + "  " + self.intNames[i] + " : int = " + (Str)self.intVals[i] + "\n";
    i = i + 1;
  }
  i = 0;
  while (i < len(self.matNames)) {
    m: matrix::Mat = self.matVals[i];
    result = result + "  " + self.matNames[i] + " : Mat[" + matrix::matDimsStr(m) + "]\n";
    i = i + 1;
  }
  return result;
}
