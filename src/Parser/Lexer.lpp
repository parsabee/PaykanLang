%{
#include <cerrno>
#include <cstdlib>
#include <string>
#include "AST.h"
#include "Parser.ypp.h"
#include "ParserDriverImpl.h"
%}

%option noyywrap nounput noinput batch debug

%{
  // A number symbol corresponding to the value in S.
  yy::parser::symbol_type
  make_INT (const std::string &s, const yy::parser::location_type& loc);

  yy::parser::symbol_type
  make_FLOAT (const std::string &s, const yy::parser::location_type& loc);

  yy::parser::symbol_type
  make_CHAR (const char *text, int len, const yy::parser::location_type& loc);
%}

id          [_a-zA-Z][_a-zA-Z_0-9]*
int         [0-9]+
float       [0-9]+\.[0-9]*([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+
blank       [ \t\r]
comment     \/\/[^\n]*

%{
  // Code run each time a pattern is matched.
  # define YY_USER_ACTION  loc.columns (yyleng);
%}

%%

%{
  // A handy shortcut to the location held by the driver.
  yy::location& loc = paykan::parser::impl(drv).Location;
  // Code run each time yylex is called.
  loc.step ();
%}

{blank}+   loc.step ();
{comment}  loc.step();
\n+        loc.lines (yyleng); loc.step ();

"::"       return yy::parser::make_COLONCOLON(loc);
"->"       return yy::parser::make_ARROW     (loc);
"&&"       return yy::parser::make_AND       (loc);
"||"       return yy::parser::make_OR        (loc);
">="       return yy::parser::make_MOREEQ    (loc);
"<="       return yy::parser::make_LESSEQ    (loc);
"=="       return yy::parser::make_EQUAL     (loc);
"!="       return yy::parser::make_NOT_EQUAL (loc);
"-"        return yy::parser::make_MINUS     (loc);
"+"        return yy::parser::make_PLUS      (loc);
"*"        return yy::parser::make_STAR      (loc);
"/"        return yy::parser::make_SLASH     (loc);
"%"        return yy::parser::make_MOD       (loc);
">"        return yy::parser::make_MORE      (loc);
"<"        return yy::parser::make_LESS      (loc);
"("        return yy::parser::make_LPAREN    (loc);
")"        return yy::parser::make_RPAREN    (loc);
"["        return yy::parser::make_LSQUARE   (loc);
"]"        return yy::parser::make_RSQUARE   (loc);
"{"        return yy::parser::make_LBRACK    (loc);
"}"        return yy::parser::make_RBRACK    (loc);
"="        return yy::parser::make_ASSIGN    (loc);
":"        return yy::parser::make_COLON     (loc);
"."        return yy::parser::make_DOT       (loc);
";"        return yy::parser::make_SEMICOLON (loc);
","        return yy::parser::make_COMMA     (loc);
"!"        return yy::parser::make_NOT       (loc);
"?"        return yy::parser::make_QUESTION  (loc);

\'([^\\'\n]|\\.)\'  { return make_CHAR(yytext, yyleng, loc); }

  /* A character literal whose closing quote is missing before the end of the
     line (or file).  Raw newlines are excluded from the pattern above for the
     same reason as in string literals -- see the comment there. */
\'([^\\'\n]|\\.)?  { throw yy::parser::syntax_error(loc,
                       "unterminated character literal"); }

  /* String literals are single-line by design: an embedded newline must be
     written as the escape \n.  The unescaped-character class excludes '\n'
     so a literal that reaches end-of-line without its closing quote falls
     through to the error rule below.  (Letting the pattern swallow raw
     newlines would also silently skip loc.lines(), shifting the line number
     of every diagnostic issued after the literal.) */
\"([^\\\"\n]|\\.)*\"  { std::string raw(yytext + 1, yyleng - 2);
                      std::string s;
                      s.reserve(raw.size());
                      for (size_t i = 0; i < raw.size(); ++i) {
                        if (raw[i] == '\\' && i + 1 < raw.size()) {
                          switch (raw[++i]) {
                            case 'n':  s += '\n'; break;
                            case 't':  s += '\t'; break;
                            case 'r':  s += '\r'; break;
                            case '\\': s += '\\'; break;
                            case '"':  s += '"';  break;
                            case '0':  s += '\0'; break;
                            default:   s += '\\'; s += raw[i]; break;
                          }
                        } else {
                          s += raw[i];
                        }
                      }
                      return yy::parser::make_STRING (s, loc); }

  /* A string literal that hits a newline or EOF before its closing quote.
     The optional trailing backslash also catches a line ending in an escape
     (e.g. "abc\<newline>) so the whole broken literal is one error token.
     The newline itself is NOT consumed here; the \n+ rule above still counts
     it, keeping line numbers correct for every later diagnostic. */
\"([^\\\"\n]|\\.)*\\?  { throw yy::parser::syntax_error(loc,
                           "unterminated string literal (string literals "
                           "cannot span multiple lines; use \\n)"); }

{int}      return make_INT   (yytext, loc);
{float}    return make_FLOAT (yytext, loc);
"True"     return yy::parser::make_BOOL  (true,  loc);
"False"    return yy::parser::make_BOOL  (false, loc);
"None"     return yy::parser::make_NONE  (loc);
"fn"       return yy::parser::make_FN(loc);
"return"   return yy::parser::make_RETURN(loc);
"if"       return yy::parser::make_IF(loc);
"then"     return yy::parser::make_THEN(loc);
"else"     return yy::parser::make_ELSE(loc);
"while"    return yy::parser::make_WHILE(loc);
"break"    return yy::parser::make_BREAK(loc);
"continue" return yy::parser::make_CONTINUE(loc);
"import"   return yy::parser::make_IMPORT(loc);
"as"       return yy::parser::make_AS(loc);
"class"    return yy::parser::make_CLASS(loc);
"enum"     return yy::parser::make_ENUM(loc);
"match"    return yy::parser::make_MATCH(loc);
"mov"      return yy::parser::make_MOV(loc);
"_"        return yy::parser::make_UNDERSCORE(loc);
{id}       return yy::parser::make_IDENT (yytext, loc);

  /* Catch-all: any byte no earlier rule claims is a lexical error (without
     this, flex's default action would silently ECHO the byte to stdout and
     drop it from the token stream). */
.          { throw yy::parser::syntax_error(loc,
                 std::string("invalid character '") + yytext + "'"); }

<<EOF>>    return yy::parser::make_YYEOF (loc);

%%

yy::parser::symbol_type
make_INT (const std::string &s, const yy::parser::location_type& loc)
{
  // strtoll saturates on overflow and reports it solely through ERANGE, and
  // `long long` is exactly 64 bits wide on every supported target, so errno
  // is the one and only out-of-range signal (an additional value comparison
  // against INT64_MIN/INT64_MAX would be a compile-time tautology).
  //
  // Deliberate edge case: the scanner never sees a negative literal -- `-` is
  // a separate MINUS token -- so `-9223372036854775808` reaches us as the bare
  // magnitude 9223372036854775808, which overflows and is rejected here with
  // "integer is out of range".  INT64_MIN must be written as an expression,
  // e.g. `-9223372036854775807 - 1`, matching C/C++ practice.
  errno = 0;
  long long n = strtoll (s.c_str(), nullptr, 10);
  if (errno == ERANGE)
    throw yy::parser::syntax_error (loc, "integer is out of range: " + s);
  return yy::parser::make_INT (static_cast<long>(n), loc);
}

yy::parser::symbol_type
make_FLOAT (const std::string &s, const yy::parser::location_type& loc)
{
  double n = strtod (s.c_str(), NULL);
  return yy::parser::make_FLOAT ((double) n, loc);
}

yy::parser::symbol_type
make_CHAR (const char *text, int len, const yy::parser::location_type& loc)
{
  if (len == 3) // 'x'
    return yy::parser::make_CHAR(text[1], loc);
  if (len == 4) { // '\X'
    char c;
    switch (text[2]) {
    case 'n':  c = '\n'; break;
    case 't':  c = '\t'; break;
    case 'r':  c = '\r'; break;
    case '\\': c = '\\'; break;
    case '\'': c = '\''; break;
    case '0':  c = '\0'; break;
    default:   c = text[2]; break;
    }
    return yy::parser::make_CHAR(c, loc);
  }
  throw yy::parser::syntax_error(loc, "invalid character literal: " + std::string(text));
}

bool
paykan::parser::ParserDriver::Impl::scanBegin()
{
  errno = 0;
  yy_flex_debug = TraceScanning;
  if (CurFile.empty () || CurFile == "-")
    yyin = stdin;

  else if (!(yyin = fopen (CurFile.c_str (), "r")))
    // Library code must not terminate the process: report failure to the
    // caller (parseFile), which emits the diagnostic and fails the parse.
    // errno is left set for the caller's message.
    return false;

  // Reset scanner state to discard any leftover buffer from a previous parse.
  yyrestart(yyin);
  return true;
}

void
paykan::parser::ParserDriver::Impl::scanEnd()
{
  if (yyin && yyin != stdin)
    fclose(yyin);
}
