%skeleton "lalr1.cc" // -*- C++ -*-
%require "3.7.1"
%defines

%define api.token.constructor
%define api.value.type variant
%define parse.assert

%code requires {
  #include <string>
  #include <iostream>
  #include "AST.h"

  namespace paykan::parser
  {
    class ParserDriver;
  }

  using namespace paykan::ast;

  // Accumulator used while parsing top-level declarations in any order.
  struct TLDeclBag {
    std::vector<ImportDecl *> Imports;
    std::vector<ClassDecl  *> Classes;
    std::vector<FuncDecl   *> Funcs;
    std::vector<EnumDecl   *> Enums;
  };
}

// The parsing context.
%param { paykan::parser::ParserDriver& drv }
%locations

%define parse.trace
%define parse.error detailed
%define parse.lac full

%code {
  #include "ParserDriverImpl.h"
  using paykan::parser::impl;

  // Creates a source location from Bison location tokens
  #define loc(BEGIN_TOK, END_TOK) \
    SourceLocation(BEGIN_TOK.begin.line, BEGIN_TOK.begin.column, END_TOK.end.line, END_TOK.end.column)
}

%define api.token.prefix {TOK_}
%token
  ASSIGN  "="
  MINUS   "-"
  PLUS    "+"
  STAR    "*"
  SLASH   "/"
  MOD     "%"
  LESS   "<"
  MORE   ">"
  LESSEQ   "<="
  MOREEQ   ">="
  EQUAL    "=="
  NOT_EQUAL "!="
  NOT     "!"
  COLON   ":"
  DOT     "."
  SEMICOLON ";"
  COMMA     ","
  LPAREN  "("
  RPAREN  ")"
  LBRACK  "{"
  RBRACK  "}"
  LSQUARE "["
  RSQUARE "]"
  ARROW "->"
  AND   "&&"
  OR    "||"
  COLONCOLON "::"
  IMPORT "import"
  AS     "as"
  CLASS  "class"
  ENUM   "enum"
  MATCH  "match"
  MOV    "mov"
  UNDERSCORE "_"
  FN     "fn"
  RETURN "return"
  IF     "if"
  ELSE   "else"
  WHILE  "while"
  BREAK  "break"
  CONTINUE "continue"
  THEN   "then"
;

// associating terminals with types
%token <long> INT
%token <double> FLOAT
%token <bool> BOOL
%token <char> CHAR
%token       NONE
%token <std::string> STRING
%token <std::string> IDENT
// `.N` — a tuple element index (see the tupleindex rule in Lexer.lpp).
%token <long> TUPLE_INDEX

%type <TranslationUnit *> translationUnit
%type <Stmt *> statement
%type <CompoundStmt *> compoundStmt
%type <CompoundStmt *> block
%type <Type *> typeAnnotation
%type <VarDecl *> varDecl
%type <DeclStmt *> staticAssignment
%type <BinaryOpcode> relationalOperator
%type <Expr *> primaryExpression
%type <Expr *> postfixExpression
%type <Expr *> unaryExpression
%type <Expr *> additiveExpression
%type <Expr *> multiplicativeExpression
%type <Expr *> expression
%type <Expr *> relationalExpression
%type <Expr *> logicalAndExpression
%type <Expr *> logicalOrExpression
%type <Expr *> ternaryExpression
%type <Stmt *> ifStmt
%type <Stmt *> whileStmt
%type <std::vector<Expr *>> argumentList
%type <UnaryOpcode> unaryOperator
%type <std::vector<Param>> paramList
%type <Param> param
%type <FuncDecl *> funcDecl
%type <ImportDecl *> importDecl
%type <std::string> modulePath
%type <std::pair<std::string,std::string>> importedModule
%type <std::vector<std::pair<std::string,std::string>>> importedModuleList
%type <ClassDecl *> classDecl
%type <EnumDecl *> enumDecl
%type <std::vector<const std::string *>> enumVariantList
%type <TLDeclBag> topLevelDeclList
%type <ClassBody> classMemberList
%type <MatchStmt *> matchStmt
%type <std::vector<MatchArm *>> matchArmList
%type <MatchArm *> matchArm
%type <Expr *> literalPattern
%type <std::vector<Type *>> tupleTypeElems
%type <std::vector<Expr *>> tupleExprElems
%type <DestructureStmt::Target> destructureTarget
%type <std::vector<DestructureStmt::Target>> destructureTargets
%%

%start translationUnit;

translationUnit : topLevelDeclList
                                    { $$ = impl(drv).Ctx.make<TranslationUnit>(loc(@1, @1),
                                           std::move($1.Imports), std::move($1.Classes), std::move($1.Funcs),
                                           std::move($1.Enums));
                                      impl(drv).Root = $$;
                                    }
;

topLevelDeclList: %empty            { $$ = TLDeclBag{}; }
    | topLevelDeclList importDecl   { $$ = std::move($1); $$.Imports.push_back($2); }
    | topLevelDeclList classDecl    { $$ = std::move($1); $$.Classes.push_back($2); }
    | topLevelDeclList funcDecl     { $$ = std::move($1); $$.Funcs.push_back($2); }
    | topLevelDeclList enumDecl     { $$ = std::move($1); $$.Enums.push_back($2); }
    ;

importDecl:
      "import" modulePath ";"
                                    { $$ = paykan::parser::makeSingleImport(impl(drv).Ctx, loc(@1, @3), $2, "", /*isSystem=*/false); }
    | "import" modulePath "as" IDENT ";"
                                    { $$ = paykan::parser::makeSingleImport(impl(drv).Ctx, loc(@1, @5), $2, $4, /*isSystem=*/false); }
    | "import" modulePath "::" "{" importedModuleList "}" ";"
                                    { $$ = paykan::parser::makeImportList(impl(drv).Ctx, loc(@1, @7), $2, $5, /*isSystem=*/false); }
    | "import" "::" modulePath ";"
                                    { $$ = paykan::parser::makeSingleImport(impl(drv).Ctx, loc(@1, @4), $3, "", /*isSystem=*/true); }
    | "import" "::" modulePath "as" IDENT ";"
                                    { $$ = paykan::parser::makeSingleImport(impl(drv).Ctx, loc(@1, @6), $3, $5, /*isSystem=*/true); }
    | "import" "::" modulePath "::" "{" importedModuleList "}" ";"
                                    { $$ = paykan::parser::makeImportList(impl(drv).Ctx, loc(@1, @8), $3, $6, /*isSystem=*/true); }
    | "import" "::" "{" importedModuleList "}" ";"
                                    { $$ = paykan::parser::makeImportList(impl(drv).Ctx, loc(@1, @6), "", $4, /*isSystem=*/true); }
    ;

importedModule:
      IDENT                         { $$ = {$1, ""}; }
    | IDENT "as" IDENT              { $$ = {$1, $3}; }
    ;

importedModuleList:
      importedModule                { $$ = std::vector<std::pair<std::string,std::string>>{std::move($1)}; }
    | importedModuleList "," importedModule
                                    { $$ = std::move($1); $$.push_back(std::move($3)); }
    ;

modulePath:
      IDENT                         { $$ = $1; }
    | modulePath "::" IDENT         { $$ = $1 + "::" + $3; }
    ;

classDecl:
      "class" IDENT "{" classMemberList "}"
                                    { $$ = impl(drv).Ctx.make<ClassDecl>(loc(@1, @5), impl(drv).Ctx.intern($2),
 impl(drv).Ctx.intern(""), std::move($4.Fields), std::move($4.Methods)); }
    | "class" IDENT ":" modulePath "{" classMemberList "}"
                                    { $$ = impl(drv).Ctx.make<ClassDecl>(loc(@1, @7), impl(drv).Ctx.intern($2),
 impl(drv).Ctx.intern($4), std::move($6.Fields), std::move($6.Methods)); }
    ;

classMemberList: %empty             { $$ = ClassBody{}; }
    | classMemberList varDecl ";"   { $$ = std::move($1); $$.Fields.push_back($2); }
    | classMemberList funcDecl      { $$ = std::move($1); $$.Methods.push_back($2); }
    ;

enumDecl:
      "enum" IDENT "{" enumVariantList "}"
                                    { $$ = impl(drv).Ctx.make<EnumDecl>(loc(@1, @5),
                                           impl(drv).Ctx.intern($2), std::move($4)); }
    ;

// Variants are interned-string pointers in declaration order.  A trailing
// comma after the last variant is permitted.
enumVariantList:
      IDENT                         { $$ = std::vector<const std::string *>{&impl(drv).Ctx.intern($1)}; }
    | enumVariantList "," IDENT     { $$ = std::move($1); $$.push_back(&impl(drv).Ctx.intern($3)); }
    | enumVariantList ","           { $$ = std::move($1); }
    ;

compoundStmt: %empty                { $$ = impl(drv).Ctx.make<CompoundStmt>(loc(@$, @$)); }
    | compoundStmt statement        { $$ = $1;
                                      if ($2) // can be null (empty stmt ";")
                                        $$->addStatement($2);
                                    }
    ;

block: "{" compoundStmt "}"        { $$ = $2; }
    ;

typeAnnotation: IDENT               { auto *ty = impl(drv).Ctx.lookupType($1);
                                      if (!ty)
                                        // Unknown at parse time — could be a forward-referenced
                                        // class type. Sema's resolveType() will validate it.
                                        ty = impl(drv).Ctx.make<ClassType>(loc(@1, @1), impl(drv).Ctx.intern($1), nullptr);
                                      $$ = ty;
                                    }
    | modulePath "::" IDENT         { // Qualified type:  module::Type (and the full
                                      // path form a::b::Type).  The imported class is
                                      // registered under that exact qualified name as a
                                      // ClassType alias (see SemaImport), so Sema's
                                      // resolveType() resolves it via lookupType().
                                      $$ = impl(drv).Ctx.make<ClassType>(loc(@1, @3),
                                           impl(drv).Ctx.intern($1 + "::" + $3), nullptr);
                                    }
    | typeAnnotation "[" "]"        { $$ = impl(drv).Ctx.make<ArrayType>(loc(@1, @3), $1); }
    | "(" tupleTypeElems ")"        { // Tuple type (T1, T2, ...).  The element list
                                      // nonterminal starts at two elements, so a
                                      // 1-tuple type `(int)` is a syntax error rather
                                      // than a parenthesised type.
                                      $$ = impl(drv).Ctx.make<TupleType>(loc(@1, @3), std::move($2)); }
    ;

// Two or more comma-separated types — the body of a tuple type annotation.
tupleTypeElems:
      typeAnnotation "," typeAnnotation
                                    { $$ = std::vector<Type *>{$1, $3}; }
    | tupleTypeElems "," typeAnnotation
                                    { $$ = std::move($1); $$.push_back($3); }
    ;

varDecl: IDENT ":" typeAnnotation
                                    { $$ = impl(drv).Ctx.make<VarDecl>(loc(@1, @3), impl(drv).Ctx.intern($1), $3, nullptr); }
    ;

staticAssignment: varDecl "=" expression
                                    { auto *vd = impl(drv).Ctx.make<VarDecl>(
                                          loc(@1, @3), $1->getName(), $1->getType(), $3);
                                      $$ = impl(drv).Ctx.make<DeclStmt>(loc(@1, @3), vd);
                                    }
    ;

statement: ";"                      { $$ = nullptr; }
    | expression ";"                { $$ = impl(drv).Ctx.make<ExprStmt>(loc(@1, @2), $1); }
    | expression "=" expression ";" { if (auto *lhs = dyn_cast<Identifier>($1)) {
                                        $$ = impl(drv).Ctx.make<AssignStmt>(loc(@1, @4), lhs, $3);
                                      } else if (auto *ma = dyn_cast<MemberAccessExpr>($1)) {
                                        $$ = impl(drv).Ctx.make<MemberAssignStmt>(loc(@1, @4), ma->getReceiver(), ma->getFieldName(), $3);
                                      } else if (auto *se = dyn_cast<SubscriptExpr>($1)) {
                                        $$ = impl(drv).Ctx.make<SubscriptAssignStmt>(loc(@1, @4), se->getArray(), se->getIndex(), $3);
                                      } else if (auto *ti = dyn_cast<TupleIndexExpr>($1)) {
                                        // `t.0 = v` is well-formed syntax but tuples are
                                        // immutable: hand it to Sema as a member assignment
                                        // whose "field" is the index so the rejection is a
                                        // typed diagnostic rather than a parse error.
                                        $$ = impl(drv).Ctx.make<MemberAssignStmt>(loc(@1, @4), ti->getTuple(),
                                             impl(drv).Ctx.intern(std::to_string(ti->getIndex())), $3);
                                      } else {
                                        throw yy::parser::syntax_error(@1, "left-hand side of '=' must be an identifier, field access, or subscript");
                                      }
                                    }
    | staticAssignment ";"          { $$ = $1; }
    | destructureTargets "=" expression ";"
                                    { $$ = impl(drv).Ctx.make<DestructureStmt>(loc(@1, @4), std::move($1), $3); }
    | "return" expression ";"       { $$ = impl(drv).Ctx.make<ReturnStmt>(loc(@1, @3), $2); }
    | "return" ";"                  { $$ = impl(drv).Ctx.make<ReturnStmt>(loc(@1, @2), nullptr); }
    | block                         { $$ = $1; }
    | ifStmt                        { $$ = $1; }
    | whileStmt                     { $$ = $1; }
    | "break" ";"                   { $$ = impl(drv).Ctx.make<BreakStmt>(loc(@1, @2)); }
    | "continue" ";"                { $$ = impl(drv).Ctx.make<ContinueStmt>(loc(@1, @2)); }
    | matchStmt                     { $$ = $1; }
    | error ";"                     { $$ = nullptr; yyerrok; }
    ;

// Destructuring targets: `a, b`, `a: int, _`, ... (two or more).  Unlike the
// `expression "=" expression` statement, the first target is parsed as a bare
// IDENT (not an expression), so after IDENT the lookahead alone decides:
// `,` → destructuring target, `=` / operators → expression / assignment,
// `:` followed by a type and then `,` → typed target, `=` → staticAssignment.
destructureTarget:
      IDENT                         { $$ = DestructureStmt::Target{&impl(drv).Ctx.intern($1), nullptr, loc(@1, @1)}; }
    | IDENT ":" typeAnnotation      { $$ = DestructureStmt::Target{&impl(drv).Ctx.intern($1), $3, loc(@1, @3)}; }
    | "_"                           { $$ = DestructureStmt::Target{&impl(drv).Ctx.intern(""), nullptr, loc(@1, @1)}; }
    ;

destructureTargets:
      destructureTarget "," destructureTarget
                                    { $$ = std::vector<DestructureStmt::Target>{std::move($1), std::move($3)}; }
    | destructureTargets "," destructureTarget
                                    { $$ = std::move($1); $$.push_back(std::move($3)); }
    ;

matchStmt: "match" expression "{" matchArmList "}"
                                    { $$ = impl(drv).Ctx.make<MatchStmt>(loc(@1, @5), $2, std::move($4)); }
    ;

matchArmList: matchArm              { $$ = std::vector<MatchArm *>(); $$.push_back($1); }
    | matchArmList matchArm         { $$ = std::move($1); $$.push_back($2); }
    ;

matchArm:
      typeAnnotation "{" compoundStmt "}"
                                    { $$ = impl(drv).Ctx.make<MatchArm>(loc(@1, @4), impl(drv).Ctx.intern(""), $1, $3); }
    | IDENT ":" typeAnnotation "{" compoundStmt "}"
                                    { $$ = impl(drv).Ctx.make<MatchArm>(loc(@1, @6), impl(drv).Ctx.intern($1), $3, $5); }
    | literalPattern "{" compoundStmt "}"
                                    { $$ = impl(drv).Ctx.make<MatchArm>(loc(@1, @4), impl(drv).Ctx.intern(""), $1, $3); }
    | "_" "{" compoundStmt "}"      { $$ = impl(drv).Ctx.make<MatchArm>(loc(@1, @4), impl(drv).Ctx.intern(""), (Type *)nullptr, $3); }
    ;

// A literal usable as a value-match pattern.  Restricted to bare literal tokens
// so the grammar stays unambiguous against type arms (which start with IDENT).
literalPattern:
      INT                           { $$ = impl(drv).Ctx.make<IntegerLiteral>(loc(@1, @1), $1); }
    | FLOAT                         { $$ = impl(drv).Ctx.make<FloatLiteral>(loc(@1, @1), $1); }
    | BOOL                          { $$ = impl(drv).Ctx.make<BoolLiteral>(loc(@1, @1), $1); }
    | CHAR                          { $$ = impl(drv).Ctx.make<CharLiteral>(loc(@1, @1), $1); }
    | STRING                        { $$ = impl(drv).Ctx.make<StringLiteral>(loc(@1, @1), $1); }
    ;

param: IDENT ":" typeAnnotation     { $$ = Param{&impl(drv).Ctx.intern($1), $3}; }
    ;

paramList: %empty                   { $$ = std::vector<Param>(); }
    | param                         { $$ = std::vector<Param>{std::move($1)}; }
    | paramList "," param           { $$ = std::move($1); $$.push_back(std::move($3)); }
    ;

ifStmt: "if" "(" expression ")" block
                                    { $$ = impl(drv).Ctx.make<IfStmt>(loc(@1, @5), $3, $5); }
    | "if" "(" expression ")" block "else" block
                                    { $$ = impl(drv).Ctx.make<IfStmt>(loc(@1, @7), $3, $5, $7); }
    | "if" "(" expression ")" block "else" ifStmt
                                    { $$ = impl(drv).Ctx.make<IfStmt>(loc(@1, @7), $3, $5, $7); }
    ;

whileStmt: "while" "(" expression ")" block
                                    { $$ = impl(drv).Ctx.make<WhileStmt>(loc(@1, @5), $3, $5); }
    ;

funcDecl: "fn" IDENT "(" paramList ")" "->" typeAnnotation block
                                    { $$ = impl(drv).Ctx.make<FuncDecl>(loc(@1, @8), impl(drv).Ctx.intern($2), std::move($4), $7, $8); }
    | "fn" IDENT "(" paramList ")" block
                                    { $$ = impl(drv).Ctx.make<FuncDecl>(loc(@1, @6), impl(drv).Ctx.intern($2), std::move($4), nullptr, $6); }
    ;

relationalOperator:
      "<"                           { $$ = BinaryOpcode::Lt; }
    | ">"                           { $$ = BinaryOpcode::Gt; }
    | "<="                          { $$ = BinaryOpcode::Le; }
    | ">="                          { $$ = BinaryOpcode::Ge; }
    | "=="                          { $$ = BinaryOpcode::Eq; }
    | "!="                          { $$ = BinaryOpcode::Ne; }
    ;

primaryExpression:
      INT                           { $$ = impl(drv).Ctx.make<IntegerLiteral>(loc(@1, @1), $1); }
    | FLOAT                         { $$ = impl(drv).Ctx.make<FloatLiteral>(loc(@1, @1), $1); }
    | BOOL                          { $$ = impl(drv).Ctx.make<BoolLiteral>(loc(@1, @1), $1); }
    | CHAR                          { $$ = impl(drv).Ctx.make<CharLiteral>(loc(@1, @1), $1); }
    | NONE                          { $$ = impl(drv).Ctx.make<NoneLiteral>(loc(@1, @1)); }
    | STRING                        { $$ = impl(drv).Ctx.make<StringLiteral>(loc(@1, @1), $1); }
    | IDENT "(" argumentList ")"    { $$ = impl(drv).Ctx.make<CallExpr>(loc(@1, @4), impl(drv).Ctx.intern($1), std::move($3)); }
    | modulePath "::" IDENT "(" argumentList ")"
                                    { $$ = impl(drv).Ctx.make<CallExpr>(loc(@1, @6), impl(drv).Ctx.intern($1 + "::" + $3), std::move($5)); }
    | modulePath "::" IDENT         { // Enum variant access:  MyEnum::Variant.
                                      // Shares the `modulePath "::" IDENT` prefix
                                      // with the qualified-call rule above; the
                                      // only decision is shift '(' (call) vs
                                      // reduce here, resolved by 1-token lookahead.
                                      $$ = impl(drv).Ctx.make<EnumValueExpr>(loc(@1, @3),
                                           impl(drv).Ctx.intern($1), impl(drv).Ctx.intern($3)); }
    | IDENT                         { $$ = impl(drv).Ctx.make<Identifier>(loc(@1, @1), impl(drv).Ctx.intern($1)); }
    | "(" expression ")"            { $$ = $2; }
    | "(" tupleExprElems ")"        { // Tuple literal (e1, e2, ...).  Shares the "(" expression
                                      // prefix with the parenthesised expression above; the
                                      // next token decides: ")" → plain expression (no
                                      // 1-tuples), "," → tuple literal.
                                      $$ = impl(drv).Ctx.make<TupleLiteralExpr>(loc(@1, @3), std::move($2)); }
    | "[" argumentList "]"          { $$ = impl(drv).Ctx.make<ArrayLiteralExpr>(loc(@1, @3), std::move($2)); }
    ;

// Two or more comma-separated expressions — the body of a tuple literal.
tupleExprElems:
      expression "," expression     { $$ = std::vector<Expr *>{$1, $3}; }
    | tupleExprElems "," expression { $$ = std::move($1); $$.push_back($3); }
    ;

argumentList: %empty                { $$ = std::vector<Expr *>(); }
    | expression                    { $$ = std::vector<Expr *>{$1}; }
    | argumentList "," expression   { $$ = std::move($1); $$.push_back($3); }
    ;

postfixExpression:
      primaryExpression             { $$ = $1; }
    | postfixExpression "." IDENT "(" argumentList ")"
                                    { $$ = impl(drv).Ctx.make<MethodCallExpr>(loc(@1, @6), $1, impl(drv).Ctx.intern($3), std::move($5)); }
    | postfixExpression "." IDENT
                                    { $$ = impl(drv).Ctx.make<MemberAccessExpr>(loc(@1, @3), $1, impl(drv).Ctx.intern($3)); }
    | postfixExpression "[" expression "]"
                                    { $$ = impl(drv).Ctx.make<SubscriptExpr>(loc(@1, @4), $1, $3); }
    | postfixExpression TUPLE_INDEX { $$ = impl(drv).Ctx.make<TupleIndexExpr>(loc(@1, @2), $1, static_cast<size_t>($2)); }
    ;

unaryOperator: "!"                  { $$ = UnaryOpcode::Not; }
    | "-"                           { $$ = UnaryOpcode::Neg; }
    ;

unaryExpression:
      postfixExpression             { $$ = $1; }
    | unaryOperator unaryExpression
                                    { $$ = impl(drv).Ctx.make<UnaryExpr>(loc(@1, @2), $1, $2); }
    | "mov" unaryExpression
                                    { $$ = impl(drv).Ctx.make<MovExpr>(loc(@1, @2), $2); }
    ;

multiplicativeExpression:
      unaryExpression               { $$ = $1; }
    | multiplicativeExpression "*" unaryExpression
                                    { $$ = impl(drv).Ctx.make<BinaryExpr>(loc(@1, @3), BinaryOpcode::Mul, $1, $3); }
    | multiplicativeExpression "/" unaryExpression
                                    { $$ = impl(drv).Ctx.make<BinaryExpr>(loc(@1, @3), BinaryOpcode::Div, $1, $3); }
    | multiplicativeExpression "%" unaryExpression
                                    { $$ = impl(drv).Ctx.make<BinaryExpr>(loc(@1, @3), BinaryOpcode::Mod, $1, $3); }
    ;

additiveExpression:
      multiplicativeExpression      { $$ = $1; }
    | additiveExpression "+" multiplicativeExpression
                                    { $$ = impl(drv).Ctx.make<BinaryExpr>(loc(@1, @3), BinaryOpcode::Add, $1, $3); }
    | additiveExpression "-" multiplicativeExpression
                                    { $$ = impl(drv).Ctx.make<BinaryExpr>(loc(@1, @3), BinaryOpcode::Sub, $1, $3); }
    ;

relationalExpression:
      additiveExpression            { $$ = $1; }
    | additiveExpression relationalOperator additiveExpression
                                    { $$ = impl(drv).Ctx.make<BinaryExpr>(loc(@1, @3), $2, $1, $3); }
    ;

logicalAndExpression:
      relationalExpression          { $$ = $1; }
    | logicalAndExpression "&&" relationalExpression
                                    { $$ = impl(drv).Ctx.make<BinaryExpr>(loc(@1, @3), BinaryOpcode::And, $1, $3); }
    ;

logicalOrExpression:
      logicalAndExpression          { $$ = $1; }
    | logicalOrExpression "||" logicalAndExpression
                                    { $$ = impl(drv).Ctx.make<BinaryExpr>(loc(@1, @3), BinaryOpcode::Or, $1, $3); }
    ;

ternaryExpression:
      logicalOrExpression          { $$ = $1; }
    | "if" logicalOrExpression "then" expression "else" ternaryExpression
                                    { $$ = impl(drv).Ctx.make<TernaryExpr>(loc(@1, @6), $2, $4, $6); }
    ;

expression: ternaryExpression       { $$ = $1; }
    ;

%%

void yy::parser::error (const location_type& l, const std::string& m) {
  ++impl(drv).ErrorCount;
  if (auto *diags = impl(drv).Diags) {
    paykan::ast::SourceLocation sloc(l.begin.line, l.begin.column,
                                     l.end.line,   l.end.column);
    diags->error(sloc, m);
  } else {
    std::cerr << "error @" << l << ": " << m << "\n\n";
  }
}