//
// Single source of truth for the PaykanLang version string.
//
// This file is a template. CMake expands the @PAYKAN_VERSION@ tokens from the
// top-level project(... VERSION ...) declaration and writes the result to
// <build>/generated/include/Version.h. Do not edit the generated header.

#pragma once

namespace paykan {

// Dotted version string, including any pre-release label: e.g. "1.2.3" for a
// final release, "1.2.3-rc1" for a pre-release.
inline constexpr const char *kVersion = "@PAYKAN_VERSION@";

inline constexpr int kVersionMajor = @PAYKAN_VERSION_MAJOR@;
inline constexpr int kVersionMinor = @PAYKAN_VERSION_MINOR@;
inline constexpr int kVersionPatch = @PAYKAN_VERSION_PATCH@;

// Pre-release label ("rc1", "beta", ...); empty for a final release.
inline constexpr const char *kVersionPrerelease = "@PAYKAN_VERSION_PRERELEASE@";

} // namespace paykan
