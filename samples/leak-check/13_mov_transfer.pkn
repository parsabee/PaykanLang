// Isolates: handing a reference on and re-assigning the source must neither
// leak nor double-free.  `t = s` shares the string (the `mov` site before
// #145 retired it); re-assigning `s` releases its share, and `t` releases the
// other at scope exit, so the counts stay balanced.
//
// Runtime allocation sites: two PaykanString_new + their PaykanShared boxes
// (the shared string, and the one re-assigned to the source).
//
// Expected under --track-heap: live blocks : 0.

fn main() -> int {
  s: Str = "moved";
  t = s;            // t shares the string
  println(t);

  s = "revived";    // s gets a fresh string
  println(s);

  return 0;
}
