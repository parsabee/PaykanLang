// Isolates: Str + Str concatenation.
// Runtime allocation site: PaykanString_concat (String.c) — allocates a new
// PaykanString holding the joined bytes (in addition to the two operands).
//
// Expected under --track-heap: live blocks : 0.

fn main() -> int {
  let a: Str = "foo";
  let b: Str = "bar";
  let c: Str = a + b;
  return 0;
}
