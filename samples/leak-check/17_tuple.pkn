// Isolates: tuple values — a literal with a Str element, a tuple
// returned from a function and destructured, a nested tuple, a tuple stored
// in an array and in a class field, a call-rooted element read (`mk().0`),
// element-wise `==`, and a tuple copied between locals.  A tuple is a value
// held in place (in its variable, field or array slot), not a block of its
// own: `(1, "a")` allocates only its Str, and a tuple of ints allocates
// nothing.  Each copy of a tuple retains the references in it; a variable's
// are released at scope exit, a field's or array slot's when its holder dies.
//
// Runtime allocation sites: PaykanString_new (String.c), the objects.
//
// Expected under --track-heap: live blocks : 0.

import ::io;

class Holder {
  pair: (int, Str);
  view fn get() -> view (int, Str) { return self.pair; }
}

impl Holder {
  fn __init__(p: (int, Str)) { self.pair = p; }
}

fn mk() -> (Str, int) {
  return ("tmp", 1);
}

fn main() -> int {
  let t = (1, "a");                  // literal with a Str element
  let s: Str = t.1;                  // new owner of the element
  str, n = mk();                     // destructure a returned temporary
  let nested = ((1, "x"), (2.5, t)); // nested tuple holding a copy of t
  io::println(nested);
  io::println(mk().0);               // call-rooted element read
  let arr: (int, Str)[3] = [t, (2, "b"), mk_pair()];
  let h: Holder = Holder(t);
  pair: view = h.get();         // a 'view' of h.pair
  io::println(Str<bool>(t == (1, "a")));
  let m = t;                     // a copy: retains t's Str again
  let ints = (1, (2, 3));        // only ints: nothing allocated
  io::println(m.1 + s + str + pair.1 + arr[2].1);
  io::println(Str(n + pair.0 + ints.1.1));
  return 0;
}

fn mk_pair() -> (int, Str) {
  return (3, "c");
}
