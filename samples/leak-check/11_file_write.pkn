// Isolates: a File object from a successful open() for writing.
// Runtime allocation site: PaykanFile_new (File.c) — allocates the file handle
// wrapper. The handle must be closed and freed by ARC destroy at end of scope.
//
// Expected under --track-heap: live blocks : 0.
//
// args: {tmpdir}

// The directory the scratch files go in: the first argument (the samples
// harnesses pass a fresh one per run, `// args: {tmpdir}`, so parallel runs
// never share a file), else /tmp.
fn scratchDir(args: Str[]) -> Str {
  if (args.len() > 1) { return args[1]; }
  return "/tmp";
}

fn main(args: Str[]) -> int {
  match open(scratchDir(args) + "/pkn_leakcheck_write.txt", "w") {
    e: Error { }
    f: File  { f.write("hello"); }
  }
  return 0;
}
