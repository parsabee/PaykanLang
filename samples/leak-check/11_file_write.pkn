// Isolates: a File object from a successful open() for writing.
// Runtime allocation site: PaykanFile_new (File.c) — allocates the file handle
// wrapper. The handle must be closed and freed by ARC destroy at end of scope.
//
// Expected under --track-heap: live blocks : 0.
//
// args: {tmpdir}

// The path of the scratch file `name`: in the first argument's directory
// (the samples harnesses pass a fresh one per run, `// args: {tmpdir}`, so
// parallel runs never share a file), else in /tmp.
fn scratchPath(args: view Str[], name: Str) -> Str {
  if args.len() > 1 { return args[1] + "/" + name; }
  return "/tmp/" + name;
}

fn main(args: view Str[]) -> int {
  match open(scratchPath(args, "pkn_leakcheck_write.txt"), "w") {
    e: Error { }
    f: File  { f.write("hello"); }
  }
  return 0;
}
