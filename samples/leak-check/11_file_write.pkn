// Isolates: a File from a successful open() for writing.
// Runtime allocation site: file_new (File.c) — allocates the runtime's file.
// The File's `__deinit__` must close and free it at the end of its scope.
//
// Expected under --track-heap: live blocks : 0.
//
// args: {tmpdir}

import ::io;

// The path of the scratch file `name`: in the first argument's directory
// (the samples harnesses pass a fresh one per run, `// args: {tmpdir}`, so
// parallel runs never share a file), else in /tmp.
fn scratchPath(args: view Str[], name: Str) -> Str {
  if args.len() > 1 {
    return args[1] + "/" + name;
  }
  return "/tmp/" + name;
}

fn main(args: view Str[]) -> int {
  match io::open(scratchPath(args, "pkn_leakcheck_write.txt"), "w") {
    f: Ok { f.value.write("hello"); }
    _ { }
  }
  return 0;
}
