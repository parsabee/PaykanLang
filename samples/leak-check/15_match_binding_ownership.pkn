// Isolates: ownership-taking uses of a match-arm binding.
// The binding names the subject without owning it; consuming it (as a
// function argument, a new owned variable, or a class field) retains the
// subject's object (Paykan_retain), so the binding's consumers and the
// subject's owner share it and it is destroyed once.
//
// Runtime allocation sites: two objects (the matched A and the Holder).
//
// Expected under --track-heap: live blocks : 0.

import ::io;

class A {
  x: int;
}

impl A {
  fn __init__() { self.x = 5; }
}

class Holder {
  a: A;
}

impl Holder {
  fn __init__(a0: A) { self.a = a0; }
}

fn probe(a: A) {
  io::println(Str<int>(a.x));
}

fn main() -> int {
  let o: Obj = A();
  let h: Holder = Holder(A());
  match o {
    b: A {
      probe(b);      // consumed argument: retains the subject's box
      let c: A = b;  // new owner: shares the same box
      h.a = b;       // field slot: releases old box, retains subject's
      io::println(Str(c.x + h.a.x));  // 10
    }
    _ { io::println("no"); }
  }
  return 0;
}
