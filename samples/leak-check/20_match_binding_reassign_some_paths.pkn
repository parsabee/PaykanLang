// Isolates: a match-arm binding reassigned on only some paths.
// `match move o` makes the binding own the subject's A; the assignment in the
// `if` releases it and makes the binding own a fresh A on that path only.
// Where the paths join, the binding must release exactly what it owns: the
// subject's A when it was not reassigned, the new A when it was.
//
// Runtime allocation site: the matched A object.
//
// Expected under --track-heap: live blocks : 0.
// expect-stdout: 7

import ::io;

class A {
  v: int;
}
impl A {
  fn __init__(v: int) { self.v = v; }
}

fn main() -> int {
  let o: A? = A(7);
  let k = 0;
  match move o {
    a: A {
      if k == 1 { a = A(1); }
      io::println(Str(a.v));
    }
    None { }
  }
  return 0;
}
