// Isolates: a match-arm binding reassigned in a loop.
// The first assignment replaces the alias of the subject (nothing to
// release); every later one releases the A the previous iteration created.
// At the end of the arm the binding owns the last A.
//
// Runtime allocation sites: four A structs + their PaykanShared boxes (the
// subject and one per iteration).
//
// Expected under --track-heap: live blocks : 0.
// expect-stdout: 2

class A { v: int; fn __init__(v: int) { self.v = v; } }

fn main() -> int {
  o: A? = A(0);
  match o {
    a: A {
      i: int = 0;
      while (i < 3) { a = A(i); i = i + 1; }
      println(StrInt(a.v));
    }
    None { }
  }
  return 0;
}
