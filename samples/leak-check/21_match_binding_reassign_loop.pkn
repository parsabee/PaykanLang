// Isolates: a match-arm binding reassigned in a loop.
// `match move o` makes the binding own the subject's A, which the first
// assignment releases; every later one releases the A the previous iteration
// created.  At the end of the arm the binding owns the last A.
//
// Runtime allocation sites: four A objects (the subject and one per
// iteration).
//
// Expected under --track-heap: live blocks : 0.
// expect-stdout: 2

import ::io;

class A {
  v: int;
}
impl A {
  fn __init__(v: int) { self.v = v; }
}

fn main() -> int {
  let o: A? = A(0);
  match move o {
    a: A {
      i = 0;
      while i < 3 {
        a = A(i);
        i = i + 1;
      }
      io::println(Str(a.v));
    }
    None { }
  }
  return 0;
}
