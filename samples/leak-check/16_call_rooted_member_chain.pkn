// Isolates: member chains rooted in a call result: the fresh receiver
// (`makeH()` below) is owned by the member access and must be released after
// the field is read, with a reference-typed field value retained first so it
// survives the receiver's release.  Also exercises a new owner of a field's
// value (x = h.a), which must retain it rather than take the field's
// reference.
//
// Runtime allocation sites: the objects, PaykanString_new (String.c).
//
// Expected under --track-heap: live blocks : 0.

import ::io;

class H {
  a: Str;
}

impl H {
  fn __init__() { self.a = "hello"; }
}

class O {
  h: H;
}

impl O {
  fn __init__() { self.h = H(); }
}

fn makeH() -> H {
  return H();
}

fn makeO() -> O {
  return O();
}

fn main() -> int {
  let x = makeH().a;     // chain used as a value
  io::println(x);
  let n: int = makeH().a.len(); // chain used as a receiver
  io::println(Str<int>(n));
  let y = makeO().h.a;   // nested chain
  io::println(y);
  let h: H = H();
  let z = h.a;           // borrowed field read acquired by a new owner
  io::println(z);
  return 0;
}
