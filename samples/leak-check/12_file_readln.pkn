// Isolates: the readln line buffer.
// Runtime allocation site: PaykanFile_readln (File.c) — allocates (and grows)
// the line buffer, then hands back a Str. Both the temporary buffer and the
// returned Str must be released.
//
// The program first writes a one-line file, then reads that line back so the
// readln path is exercised on real data.
//
// Expected under --track-heap: live blocks : 0.
//
// args: {tmpdir}

// The directory the scratch files go in: the first argument (the samples
// harnesses pass a fresh one per run, `// args: {tmpdir}`, so parallel runs
// never share a file), else /tmp.
fn scratchDir(args: Str[]) -> Str {
  if (args.len() > 1) { return args[1]; }
  return "/tmp";
}

fn writeIt(path: Str) {
  match open(path, "w") {
    e: Error { }
    f: File  { f.write("line one\n"); }
  }
}

fn main(args: Str[]) -> int {
  path: Str = scratchDir(args) + "/pkn_leakcheck_readln.txt";
  writeIt(path);
  match open(path, "r") {
    e: Error { }
    f: File {
      match f.readln() {
        line: Str { }
        _         { }
      }
    }
  }
  return 0;
}
