// Isolates: the readln line buffer.
// Runtime allocation site: PaykanFile_readln (File.c) — allocates (and grows)
// the line buffer, then hands back a Str. Both the temporary buffer and the
// returned Str must be released.
//
// The program first writes a one-line file, then reads that line back so the
// readln path is exercised on real data.
//
// Expected under --track-heap: live blocks : 0.
//
// args: {tmpdir}

// The path of the scratch file `name`: in the first argument's directory
// (the samples harnesses pass a fresh one per run, `// args: {tmpdir}`, so
// parallel runs never share a file), else in /tmp.
fn scratchPath(args: view Str[], name: Str) -> Str {
  if (args.len() > 1) { return args[1] + "/" + name; }
  return "/tmp/" + name;
}

fn writeIt(path: Str) {
  match open(path, "w") {
    e: Error { }
    f: File  { f.write("line one\n"); }
  }
}

fn main(args: view Str[]) -> int {
  path: Str = scratchPath(args, "pkn_leakcheck_readln.txt");
  writeIt(path);
  match open(path, "r") {
    e: Error { }
    f: File {
      match f.readln() {
        line: Str { }
        _         { }
      }
    }
  }
  return 0;
}
