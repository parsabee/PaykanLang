// Isolates: the Result of a failing io::open(): its Error's message, a Str
// the runtime makes (Paykan_error_text, Error.c), is released with the
// Result, whether the Result is a variable, a temporary, or matched.
//
// Expected under --track-heap: live blocks : 0.

import ::io;

fn func1() {
  r = io::open("/nonexistent/paykan/leak-check/path.txt", "r");
  match r {
    f: Ok { }
    e: Err { }
  }
}

fn func2() {
  match io::open("/nonexistent/paykan/leak-check/path.txt", "r") {
    e: Err {
      msg: Obj = e.error.message();
      match msg {
        s: Str { }
        _ { }
      }
    }
    _ { }
  }
}

fn main() -> int {
  func1();
  func2();
  return 0;
}
