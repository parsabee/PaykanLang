// Isolates: the allocations of the conversion constructors (#64).  Every
// `Str<...>` result is a fresh Str temporary (destroyed after use, or owned
// by its variable); an `int<Str>` / `float<Str>` result is an optional value
// and allocates nothing (#96), and neither do the numeric conversions.
// Exercised in a loop, as a call argument, a returned value, a field and a
// match subject.
//
// Runtime allocation sites: PaykanString_from_int / _float / _bool / _char
// (String.c), the class instance and the array.
//
// Expected under --track-heap: live blocks : 0.
// expect-stdout: 0 1 2 3 4
// expect-stdout: 15
// expect-stdout: 2.5
// expect-stdout: True a 7

class Cell {
  label: Str;
  value: int?;
}

impl Cell {
  fn __init__() { self.label = Str<int>(0); }
}

fn parseOr(s: Str, d: int) -> int {
  match int<Str>(s) {
    n: int { return n; }
    None   { return d; }
  }
}

fn main() -> int {
  line = "";
  i = 0;
  while (i < 5) {
    line = line + Str(i);
    if (i < 4) { line = line + " "; }
    i = i + 1;
  }
  println(line);

  words: Str[] = ["1", "2", "x", "3", "", "4", "5"];
  total = 0;
  i = 0;
  while (i < words.len()) { total = total + parseOr(words[i], 0); i = i + 1; }
  println(Str<int>(total));

  c = Cell();
  c.label = Str(2.5);
  c.value = int("7");
  c.value = int<Str>("nope");
  c.value = int("7");
  println(c.label);

  f = float<Str>("1.25");
  f = float("bad");
  n = int<float>(7.9) + int(False) + int<char>(char(0));
  println(Str<bool>(bool<int>(n)) + " " + Str(char(97)) + " " +
          Str<int>(n));
  return 0;
}
