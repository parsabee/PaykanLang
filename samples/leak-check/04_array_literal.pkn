// Isolates: an int[3] array literal.
// Runtime allocation site: none — a `T[n]` holds its elements inline (a local
// one on the stack), so the literal allocates nothing.
//
// Expected under --track-heap: live blocks : 0 (and no allocations at all).

fn main() -> int {
  a: int[3] = [1, 2, 3];
  return 0;
}
