// Isolates: an Obj[1] holding a single boxed (reference-counted) element.
// Runtime allocation site: PaykanShared (Shared.c) — the ARC box wrapping the
// stored string; the array holds that box inline, in its one slot.
//
// Expected under --track-heap: live blocks : 0 (the array's element is
// released at end of scope).

fn main() -> int {
  a: Obj[1] = ["x"];
  return 0;
}
