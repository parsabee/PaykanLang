// Isolates: a single fieldless class instance.
// Runtime allocation site: the object (Paykan_malloc in the constructor),
// one block holding its header (vtable, strong and weak counts) and fields.
//
// Expected under --track-heap: live blocks : 0 (destroy runs at end of scope).

class Box {}

impl Box {
  fn __init__() { }
}

fn main() -> int {
  let b: Box = Box();
  return 0;
}
