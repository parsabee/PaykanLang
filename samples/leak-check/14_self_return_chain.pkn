// Isolates: `self` used as a value: returned (and chained) out of a method.
// Each ownership-taking use of `self` retains the object (Paykan_retain), so
// every chained `return self` hop and the extra owner `c` share the one
// object, which is destroyed once, when the last of them lets go.
//
// Runtime allocation site: one object.
//
// Expected under --track-heap: live blocks : 0.

import ::io;

class Counter {
  n: int;
  fn bump() -> Counter { self.n = self.n + 1; return self; }
}

impl Counter {
  fn __init__() { self.n = 0; }
}

fn main() -> int {
  let a: Counter = Counter();
  let c: Counter = a.bump().bump().bump();  // each hop retains the same box
  io::println(Str<int>(c.n));                 // 3
  return 0;
}
