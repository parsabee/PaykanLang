// Isolates: `self` used as a value: returned (and chained) out of a
// `shared fn`, where `self` is a `shared mut Counter`, so the receiver `a` is
// declared `shared mut` too.  Each ownership-taking use of `self` retains the
// object (Paykan_retain), so every chained `return self` hop and the extra
// owner `c` share the one object, which is destroyed once, when the last of
// them lets go.
//
// Runtime allocation site: one object.
//
// Expected under --track-heap: live blocks : 0.

import ::io;

class Counter {
  n: int;
  shared fn bump() -> shared mut Counter { self.n = self.n + 1; return self; }
}

impl Counter {
  fn __init__() { self.n = 0; }
}

fn main() -> int {
  let a: shared mut = Counter();
  let c = a.bump().bump().bump();  // each hop retains the same object
  io::println(Str(c.n));                 // 3
  return 0;
}
