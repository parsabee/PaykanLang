// Isolates: optional primitives (`int?`, `float?`, `bool?`, `char?`, #66),
// which are values (#96): a present value is held inline in a local, a
// parameter, a return value, a field, an array slot and a tuple element, and
// allocates nothing; rebinding between a value and None; a copy into a new
// local; a `match` on a call result whose arm binding owns nothing; a `T?`
// with T = int inside a generic class; and printing one.
//
// Runtime allocation sites: the class instances and the strings (the array
// holds its 16-byte elements inline, the tuple its elements in place).
//
// Expected under --track-heap: live blocks : 0.
// expect-stdout: 6
// expect-stdout: None
// expect-stdout: 3
// expect-stdout: x
// expect-stdout: 2

class Holder {
  n: int?;
  f: float?;
}

impl Holder {
  fn __init__() { }
}

class Slot<T> {
  v: T?;
  fn set(x: T) { self.v = x; }
}

impl Slot<T> {
  fn __init__() { }
}

fn twice(o: int?) -> int? {
  match o {
    n: int { return n * 2; }
    None   { return None; }
  }
}

fn main() -> int {
  a: int? = 3;
  println(twice(a));
  a = None;
  println(twice(a));
  a = 3;
  b = a;                       // shared box
  a = None;
  println(b);

  h = Holder();
  h.n = 1;
  h.n = 2;
  h.f = 0.5;
  h.f = None;

  xs: int?[3] = [1, 2, None];
  xs[0] = 5;
  xs[1] = None;

  t: (int?, bool?) = (4, True);
  c: char? = 'x';
  println(c);

  s = Slot<int>();
  s.set(1);
  s.set(2);
  println(s.v);

  m = b;
  i = 0;
  while (i < 3) { m = i; i = i + 1; }
  return 0;
}
