// Isolates: match-arm bindings (of `match move`, which own what they bind)
// reassigned in a loop and then returned, a None arm returning a fresh
// object, and a binding reassigned and then moved into itself.  The returned
// binding hands its (owned) reference to the caller; `a = move a` must not
// release it.
//
// Runtime allocation sites: the A objects and their Str fields (literals and "n" + Str(i) concatenations).
//
// Expected under --track-heap: live blocks : 0.
// expect-stdout: n2
// expect-stdout: none
// expect-stdout: q

import ::io;

class A {
  s: Str;
}
impl A {
  fn __init__(s: Str) { self.s = move s; }
}

fn pick(o: A?) -> A {
  match move o {
    a: A {
      i = 0;
      while i < 3 {
        a = A("n" + Str(i));
        i = i + 1;
      }
      return a;
    }
    None { return A("none"); }
  }
  return A("x");
}

fn main() -> int {
  let o: A? = A("z");
  io::println(pick(A("z")).s);
  io::println(pick(None).s);
  match move o {
    a: A {
      a = A("q");
      a = move a;
      io::println(a.s);
    }
    None { }
  }
  return 0;
}
