// Isolates: a class instance that owns a Str field.
// Runtime allocation sites: the object, plus the Str stored in the field
// (PaykanString_new). The field must be released by the generated
// destructor.
//
// Expected under --track-heap: live blocks : 0.

class Named {
  name: Str;
}

impl Named {
  fn __init__(n: Str) { self.name = n; }
}

fn main() -> int {
  let x: Named = Named("hi");
  return 0;
}
