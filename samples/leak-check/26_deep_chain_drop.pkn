// Isolates: dropping very deep object graphs (#118).  Destroying an object
// releases what it holds, so a recursive destroy costs a C stack frame per
// link and overflowed the stack on long chains.  The runtime destroys
// iteratively (objects released to zero inside a destroy are deferred and
// destroyed one by one by the outermost release), so each structure below
// is freed without stack growth:
//   * a 1,000,000-node `Node?` linked list (class instances, Str fields);
//   * a deep, wide tree: a 200,000-node spine whose every node also holds a
//     three-node subtree and a Node (with its Str);
//   * a chain of 200,000 links through arrays: each link's `Obj[3]` field
//     holds the next link, a string and a Node;
//   * a chain of 200,000 objects linked through tuples: each link's tuple
//     field holds, in place, a nested tuple with the next link and an `Obj`
//     slot, which carries the message of a failed io::open() in every
//     10,000th link.  Releasing a link releases the references its tuple holds.
//
// Runtime allocation sites: the objects,
// PaykanString_new (String.c), Paykan_error_text (Error.c).
//
// Expected under --track-heap: live blocks : 0.

import ::io;

// expect-stdout: list 1000000
// expect-stdout: tree 200000
// expect-stdout: arrays 200000
// expect-stdout: tuples 200000
// expect-stdout: done

class Node {
  v: int;
  name: Str;
  next: Node?;
}

impl Node {
  fn __init__(v: int) { self.v = v; self.name = "n"; }
}

class Tree {
  left: Tree?;
  right: Tree?;
  leaves: Node?;
}

impl Tree {
  fn __init__() { }
}

class Link {
  slots: Obj[3];
}

class Chain {
  link: (int, (Chain?, Obj));             // the next link sits in a tuple
}

impl Chain {
  fn __init__(link: (int, (Chain?, Obj))) { self.link = link; }
}

fn leaf() -> Tree {
  let t = Tree();
  t.leaves = Node(0);
  return t;
}

fn list(n: int) -> int {
  head: Node? = None;
  i = 0;
  while i < n {
    let node = Node(i);
    node.next = head;
    head = node;
    i = i + 1;
  }
  return i;                    // head goes out of scope: the whole list drops
}

fn tree(depth: int) -> int {
  root: Tree? = None;
  i = 0;
  while i < depth {
    let t = Tree();
    let side = Tree();
    side.left = leaf();
    side.right = leaf();
    t.left = side;
    t.right = root;
    t.leaves = Node(i);
    root = t;
    i = i + 1;
  }
  return i;
}

fn arrays(n: int) -> int {
  prev: Obj = None;
  i = 0;
  while i < n {
    prev = Link([prev, Str<int>(i), Node(i)]);
    i = i + 1;
  }
  return i;
}

/// The message of an open that fails.
fn openError() -> Obj {
  match io::open("/nonexistent/paykan/leak-check/deep.txt", "r") {
    e: Err { return e.error.message(); }
    _ { return None; }
  }
}

fn tuples(n: int) -> int {
  prev: Chain? = None;
  i = 0;
  while i < n {
    e: Obj = None;
    if i % 10000 == 0 {
      e = openError();
    }
    prev = Chain((i, (prev, e)));
    i = i + 1;
  }
  return i;
}

fn main() -> int {
  io::println("list " + Str(list(1000000)));
  io::println("tree " + Str(tree(200000)));
  io::println("arrays " + Str(arrays(200000)));
  io::println("tuples " + Str(tuples(200000)));
  io::println("done");
  return 0;
}
