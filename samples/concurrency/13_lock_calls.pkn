// What a `lock` block calls (docs/language/19-concurrency.md, "What a `lock`
// block calls").  A block calls what waits for nothing: plain functions, the
// methods of a `final` class, printing.  What may wait, a function that
// takes a lock or awaits a task, is called before or after the block.  A
// `__deinit__` is held to the same rule, since it runs where its object is
// let go of: the Session below is moved into the `tally` block and
// destroyed at its end, where it counts itself closed in an `atomic` cell.
// expect-stdout: total 43, closed 1, log 2

import ::io;

class Tally {
  total: int;
  log: int;
}

final class Scale {
  by: int;
  view fn apply(n: int) -> int { return n * self.by; }
}

class Session {
  closed: atomic int;
  id: int;
}

impl Session {
  fn __deinit__() { self.closed += 1; }   // no lock: it may run in a block
}

async fn fetch(n: int) -> int { return n + 1; }

// It takes a lock: a `lock` block does not call it.
fn note(tally: locked mutable Tally) {
  lock tally as t: inout { t.log += 1; }
}

fn weight(s: view Session) -> int {
  return s.id * 10;
}

async fn main() -> int {
  closed: atomic int = 0;
  let tally: locked mutable Tally = Tally(0, 0);
  let scale = Scale(1);
  let s = Session(closed, 4);

  let fetched = await fetch(2);       // the wait, before the block
  note(tally);
  lock tally as t: inout {
    let mine = move s;                // let go of at the block's end
    t.total += scale.apply(fetched);  // a `final` class's method
    t.total += weight(mine);
  }
  note(tally);                        // and after it

  lock tally as t: view {
    io::println("total " + Str(t.total) + ", closed " + Str(closed) + ", log "
        + Str(t.log));
  }
  return 0;
}
