import ::io;

class Cache { hits: atomic int; }
class Job { name: Str; cache: atomic const Cache; }   // a handle inside: crossable
class Named { tag: Str; n: int; }                      // unique: moves into a task
struct Point { x: int; y: int; }                       // Copyable: copied by a generic

async fn run(j: Job, x: int, nm: Named) -> int {
  j.cache.hits += 1;
  return j.name.len() + x + nm.tag.len() + nm.n;
}

fn twice<T: Copyable>(x: T) -> (T, T) { return (x, x); }

fn show(n: view Job) -> int { return n.name.len(); }   // a view takes every form
fn mark(n: inout Job) { n.name = n.name + "!"; }        // an inout takes a unique or shared object

fn main() -> int {
  let shared_cache: atomic const Cache = Cache(0);
  let t = run(Job("job", shared_cache), 3, move Named("tag", 4));   // a temporary may be `move`d
  let nm = Named("tt", 1);
  let u = run(Job("j", shared_cache), 3, move nm);                   // nm moved
  io::println(Str(await t) + " " + Str(await u) + " hits " + Str(shared_cache.hits));
  let p = Point(1, 2);
  let pair = twice(p);
  io::println(Str(pair.0.x + pair.1.y));
  let c: const Job = Job("cc", shared_cache);
  io::println(Str(show(c)));
  s: shared Job = Job("s", shared_cache);
  mark(s);                                   // no retain or release for the borrow
  io::println(s.name + " " + Str(show(s)));
  return 0;
}
