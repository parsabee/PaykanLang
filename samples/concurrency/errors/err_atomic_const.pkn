import ::io;

class Limits { lo: int; hi: int; }
class Config { name: Str; limits: Limits; }

fn main() -> int {
  let cfg: atomic const Config = Config("demo", Limits(0, 100));
  cfg.limits.hi = 5;                 // error: const through atomic const
  cfg.name = "x";                    // error: const
  let u: Config = cfg;               // error: none back
  let k: atomic const int = 1;       // error: qualifies a reference
  return 0;
}
