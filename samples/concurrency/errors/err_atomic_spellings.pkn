// The spellings the parser refuses.  The bare type is immutable, and `mut`
// adds the writes (`mut T`, `shared mut T`, `locked mut T`), the form
// first, then the writes.  A frozen object (`atomic
// shared T`) and a cell (`atomic T`) take no `mut`.  Every line marked
// `error` is a parse error, reported in one run, so this file gets no
// Sema errors.
import ::io;

class Node {
  id: int;
}

fn main() -> int {
  let d: atomic shared mut Node = Node(4);    // error: written from several threads with no lock
  let e: atomic mut Node = Node(5);           // error: a cell takes no 'mut'
  let f: mut shared Node = Node(6);           // error: spelled 'shared mut'
  let g: mut locked Node = Node(7);           // error: spelled 'locked mut'
  let h: shared mut shared Node = Node(8);    // error: a type takes one qualifier
  return 0;
}
