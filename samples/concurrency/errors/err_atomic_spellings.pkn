// The spellings the parser refuses.  The bare type is immutable, and `mutable`
// adds the writes (`mutable T`, `shared mutable T`, `locked mutable T`), the form
// first, then the writes.  A frozen object (`atomic
// shared T`) and a cell (`atomic T`) take no `mutable`.  Every line marked
// `error` is a parse error, reported in one run, so this file gets no
// Sema errors.
import ::io;

class Node {
  id: int;
}

fn main() -> int {
  let d: atomic shared mutable Node = Node(4);    // error: written from several threads with no lock
  let e: atomic mutable Node = Node(5);           // error: a cell takes no 'mutable'
  let f: mutable shared Node = Node(6);           // error: spelled 'shared mutable'
  let g: mutable locked Node = Node(7);           // error: spelled 'locked mutable'
  let h: shared mutable shared Node = Node(8);    // error: a type takes one qualifier
  return 0;
}
