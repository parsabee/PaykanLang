import ::io;

class Counts { hits: int[16]; total: int; }

async fn ping(n: int) -> int { return n; }

fn main() -> int {
  let counts: locked Counts = Counts([0; 16], 0);
  let t = counts.total;                 // error: locked: reach its contents in a lock block
  lock counts as c: view {
    c.total = 5;                        // error: view binding is read-only
    let p = ping(1);
    let r = await p;                    // error: await in a lock block
    lock counts as d: inout { }         // error: nested lock
  }
  let n = 3;
  lock n as m: inout { }                // error: not locked
  let k: locked int = 1;                // error: the prototype locks objects
  return 0;
}
