import ::io;

class Node {
  id: int;
  name: Str;
}
struct Pair {
  left: Node;
  n: int;
}

fn change(n: Node) {
  n.id = 0;
}

fn main() -> int {
  let s: shared Node = Node(1, "s");
  let u: Node = s;                      // error: shared into unique
  let c: const Node = Node(2, "c");
  c.id = 5;                             // error: const field assignment
  change(c);                            // error: const into a unique parameter
  let sc: shared const Node = Node(3, "sc");
  sc.name = "x";                        // error: const
  let k: const int = 1;                 // error: const applies to objects
  let w: shared int = 2;                // error: shared qualifies a reference
  let p: atomic shared const Pair = Pair(Node(4, "p"), 1);   // error: a struct is a value: box it
  return 0;
}
