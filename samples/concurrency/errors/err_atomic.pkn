import ::io;

class Box {
  n: atomic int;
}
struct P {
  c: atomic int;                          // error: a struct cannot hold a cell
}

fn main() -> int {
  hits: atomic int = 0;
  hits = hits * 2 + 1;                    // error: reads and writes separately
  hits *= 2;                              // error: not an atomic operation
  let x = hits.load();                    // error: no method
  let s: atomic Str = "a";                // error: not a number: a Str is an object
  let o: atomic Box = Box(1);             // error: an object crosses threads as 'atomic shared Box' or 'locked mut Box'
  let b = Box(0);
  b.n = b.n + 1;                          // fine: the parser rewrites it to "b.n += 1"
  b.n.compareExchange(1);                 // error: argument count
  hits += 1.5;                            // error: type
  let fixed: atomic int = 1;              // warning: a 'let' atomic: nothing changes it
  fixed += 1;                             // error: a 'let' cell is not changed through its name
  let was = fixed.exchange(2);            // error: nor by 'exchange'
  return 0;
}
