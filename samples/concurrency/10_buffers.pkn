// The concurrency prototype: heap buffers in a `parallel for`.  A
// `mem::Buffer<T>` of numbers that the enclosing function owns is read at
// any index and written at the loop's variable only; a frozen one, boxed
// (`atomic const mem::Box<mem::Buffer<T>>`), is read by every thread with
// no reference counting.  Element reads are a bounds check and a load.
// expect-stdout: sum 1.49998e+10 of 100000 elements
// expect-leaks: the frozen box and its buffer are immortal in the prototype

import ::io;
import ::memory as mem;

fn main() -> int {
  let n = 100000;
  xs = mem::Buffer<float>();
  let grown = xs.grow(unsigned<int>(n));
  for i in 0..n { let e = xs.set(unsigned<int>(i), float<int>(i)); }
  ys = mem::Buffer<float>();
  let grown2 = ys.grow(unsigned<int>(n));
  // Written at the loop's variable: no two iterations touch one element.
  parallel for i in 0..n {
    let e = ys.set(unsigned<int>(i), xs.at(unsigned<int>(i)) * 2.0);
  }
  // Frozen in a box: a handle every thread reads.
  let frozen: atomic const mem::Box<mem::Buffer<float>> = mem::Box(move xs);
  s = 0.0;
  parallel for i in 0..n {
    let u = unsigned<int>(i);
    s += frozen.value().at(u) + ys.at(u);
  }
  io::println("sum " + Str(s) + " of " + Str(ys.len()) + " elements");
  return 0;
}
