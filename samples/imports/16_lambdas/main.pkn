// OK: expression-bodied lambdas made in another module, in a function and
// in its templates instantiated here (docs/language/14-function-types.md):
// the module's file keeps a template's lambda as it was written, and its
// result type is inferred in each instantiation.
// expect-stdout: 15 21 7.5 id: 42
import ::io;
import fns;

fn main() -> int {
  io::println(Str(fns::adder(10)(5)) + " " + Str(fns::scale(3)(7)) + " "
      + Str(fns::scale(2.5)(3.0)) + " " + fns::labeler<int>("id: ")(42));
  return 0;
}
