// Function values made by expression-bodied lambdas (`fn(x: int) = x + n`),
// in a function and in templates, for main.pkn.

fn adder(n: int) -> (int) -> int {
  return fn(x: int) = x + n;
}

fn scale<T>(by: T) -> (T) -> T {
  return fn(x: T) = x * by;
}

fn labeler<T: Show>(prefix: Str) -> (view T) -> Str {
  return fn(x: view T) -> Str = prefix + x.toString();
}
