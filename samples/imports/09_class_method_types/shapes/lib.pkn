// A module whose exported signatures name other types of the SAME module:
// methods returning a class, taking a class, returning an enum, and returning
// an array of a class.  `Pair` deliberately comes first and refers to `Cell`
// (fields and a return type) before `Cell` is declared, and `Kind` is declared
// last: the importer must resolve every signature against the module's own
// types whatever order they were declared or serialised in.

class Pair {
  a: Cell;
  b: Cell;
  view fn first() -> view Cell { return self.a; }
  view fn sum() -> int         { return self.a.v + self.b.v; }
}

impl Pair {
  fn __init__(a: Cell, b: Cell) { self.a = move a; self.b = move b; }
}

class Cell {
  v: int;
  kind: Kind;
  view fn kindOf() -> Kind          { return self.kind; }
  view fn pairWith(o: Cell) -> Pair { return Pair(self.clone(), move o); }
}

// pairWith puts a clone of its receiver in the pair.
impl Cloneable for Cell {}

impl Cell {
  fn __init__(v: int) {
    self.v = v;
    self.kind = Kind::Even;
    if v % 2 != 0 {
      self.kind = Kind::Odd;
    }
  }
}

class Splitter {
  view fn split(c: view Cell) -> Cell[2] {
    return [Cell(c.v / 2), Cell(c.v - c.v / 2)];
  }
}

impl Splitter {
  fn __init__() { }
}

enum Kind { Even, Odd }

fn total(cs: view Cell[]) -> int {
  s = 0;
  i = 0;
  while i < cs.len() {
    s = s + cs[i].v;
    i = i + 1;
  }
  return s;
}
