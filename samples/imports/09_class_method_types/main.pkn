// OK: methods of an imported class whose parameter / return types are other
// classes, enums, or arrays of classes declared in the same module.
//
// The importer rebuilds the module's types from its export record; every
// type a signature names must resolve to the rebuilt type — regardless of
// the order the module declared them — so that e.g. `c.pairWith(d)` is typed
// `lib::Pair` at the call site and not silently `void`.

import ::io;
import shapes::lib;

fn main() -> int {
  let c: lib::Cell = lib::Cell(7);
  let d: lib::Cell = lib::Cell(4);

  let p: lib::Pair = c.pairWith(d);     // method taking and returning module classes
  f: view lib::Cell = p.first();        // ... from the class that was declared first, as a 'view'
  let k: lib::Kind = f.kindOf();        // method returning a module enum
  let s: lib::Splitter = lib::Splitter();
  let halves: lib::Cell[2] = s.split(c);    // method returning an array of a class

  odd: int = 0;
  if k == lib::Kind::Odd { odd = 1; }

  io::println(Str<int>(p.sum()));             // 11
  io::println(Str(lib::total(halves)));  // 7
  io::println(Str<int>(odd));                 // 1
  return 0;
}
