// OK: nested path import — import path::to::mod;
//   short qualifier = "arith"  (last path segment)
//   full  qualifier = "math::arith"  (full path)
//   Both are valid at call sites.
import math::arith;

fn main() -> int {
  a: int = arith::mul(6, 7);                 // short qualifier
  b: int = math::arith::div(42, 2);          // full qualifier
  return a - b;                              // 42 - 21 = 21
}
