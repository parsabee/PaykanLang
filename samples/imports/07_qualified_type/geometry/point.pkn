// Module: geometry/point
// Exported class used as a qualified type (point::Point) in another module.
class Point {
  x: int;
  y: int;
  fn __init__(x: int, y: int) {
    self.x = x;
    self.y = y;
  }
  fn sum() -> int { return self.x + self.y; }
  fn toString() -> Str {
    return "(" + Str<int>(self.x) + "," + Str(self.y) + ")";
  }
}
