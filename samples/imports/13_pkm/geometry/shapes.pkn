// A small geometry library: a class hierarchy, an enum and free functions.
// The point of this sample is not the geometry but how the module reaches
// its importer: through a .pkm module file (see ../README.md).

enum Kind { Flat, Solid }

class Shape {
  name: Str;
  view fn area() -> int  { return 0; }
  view fn kind() -> Kind { return Kind::Flat; }
  view fn describe() -> Str {
    return self.name + " of area " + Str<int>(self.area());
  }
}

impl Shape {
  fn __init__(name: Str) { self.name = name; }
}

class Rect : Shape {
  w: int;
  h: int;
  view fn area() -> int { return self.w * self.h; }
}

impl Rect {
  fn __init__(w: int, h: int) { __super__("rect"); self.w = w; self.h = h; }
}

class Square : Rect {
  view fn kind() -> Kind { return Kind::Solid; }
}

impl Square {
  fn __init__(side: int) { __super__(side, side); }
}

// The total area of some shapes.
fn total(shapes: view Shape[]) -> int {
  sum: int = 0;
  i: int = 0;
  while i < shapes.len() {
    sum = sum + shapes[i].area();
    i = i + 1;
  }
  return sum;
}

fn kindName(k: Kind) -> Str {
  match k {
    Flat { return "flat"; }
    Solid { return "solid"; }
  }
  return "";
}
