// calc — an arithmetic calculator with variables and memory.
//
// Expressions support + - * / %, parentheses, unary minus, and decimals.
// Results are remembered: assign with `x = expr`, then use `x` (and the
// built-in `ans`, `pi`, `e`) in later expressions. Variables live in a
// string-keyed hash map (calc/hashmap.pkn).
//
// As a sample, it first replays a short scripted session (`demo` below)
// through the same code path as the REPL, which ends by defining `a` and `b`;
// then it handles its command line. The sample harnesses run it as
// `paykan main.pkn a b`, which evaluates `a` and `b` after the demo.
//
// Command line:
//   paykan main.pkn "3 + 4 * (2 - 1)" "10 / 4"     # evaluate each argument
//   paykan main.pkn -e "x = 6" -e "x * 7"          # -e flags, shared state
//   paykan main.pkn -q "1 + 2"                     # quiet: results only
//   paykan main.pkn --no-demo                      # skip the scripted session
//   paykan main.pkn                                # REPL on stdin
//   printf "x = 5\nx * x\n" | paykan main.pkn
//
// REPL commands: :vars  :history  :del <name>  :clear  :help  :quit
//
// Errors go to stderr; every line below is what the scripted session and
// `a b` print on stdout.
//
// expect-stdout: > 1 + 2 * 3
// expect-stdout: 1 + 2 * 3 = 7
// expect-stdout: > (1 + 2) * 3
// expect-stdout: (1 + 2) * 3 = 9
// expect-stdout: > x = 6
// expect-stdout: x = 6
// expect-stdout: > y = x * 7
// expect-stdout: y = 42
// expect-stdout: > (x + y) / 4
// expect-stdout: (x + y) / 4 = 12
// expect-stdout: > ans * 2
// expect-stdout: ans * 2 = 24
// expect-stdout: > -x + 10 % 4
// expect-stdout: -x + 10 % 4 = -4
// expect-stdout: > 2.5 * 2
// expect-stdout: 2.5 * 2 = 5
// expect-stdout: > :vars
// expect-stdout:   e = 2.71828
// expect-stdout:   x = 6
// expect-stdout:   pi = 3.14159
// expect-stdout:   y = 42
// expect-stdout:   ans = 5
// expect-stdout: > :history
// expect-stdout:   1: 1 + 2 * 3  => 7
// expect-stdout:   2: (1 + 2) * 3  => 9
// expect-stdout:   3: x = 6  => 6
// expect-stdout:   4: y = x * 7  => 42
// expect-stdout:   5: (x + y) / 4  => 12
// expect-stdout:   6: ans * 2  => 24
// expect-stdout:   7: -x + 10 % 4  => -4
// expect-stdout:   8: 2.5 * 2  => 5
// expect-stdout: > :del y
// expect-stdout: deleted 'y'
// expect-stdout: > y + 1
// expect-stdout: > :del y
// expect-stdout: > 1 / 0
// expect-stdout: 1 / 0 = inf
// expect-stdout: > 3 +
// expect-stdout: > 4 4
// expect-stdout: > :frobnicate
// expect-stdout: > :clear
// expect-stdout: cleared all variables
// expect-stdout: > :vars
// expect-stdout:   e = 2.71828
// expect-stdout:   pi = 3.14159
// expect-stdout:   ans = 0
// expect-stdout: > a = 6
// expect-stdout: a = 6
// expect-stdout: > b = a * 7
// expect-stdout: b = 42
// expect-stdout: a = 6
// expect-stdout: b = 42

import ::io;
import calc::parser;
import calc::hashmap;
import calc::utils;

// A fixed-capacity ring buffer that keeps the most recent 16 items, oldest
// first. It is generic: `Ring<(Str, float)>` below holds the statement history,
// and any other element type works the same way.
class Ring<T> {
  items: T[16];
  count: int; // how many slots are in use: all of them once the buffer is full
  start: int; // index of the oldest item once the buffer is full

  // Append `x`, overwriting the oldest item when the buffer is full.
  fn add(x: T) {
    if self.count < self.items.len() {
      self.items[self.count] = x;
      self.count = self.count + 1;
    } else {
      self.items[self.start] = x;
      self.start = (self.start + 1) % self.items.len();
    }
  }

  view fn len() -> int { return self.count; }

  // The i-th oldest item (0 <= i < len()).
  view fn at(i: int) -> view T {
    return self.items[(self.start + i) % self.items.len()];
  }
}

impl Ring<T> {
  // Every slot starts as `blank`, until an item is added there.
  fn __init__(blank: T) {
    self.items = [blank; 16];
    self.count = 0;
    self.start = 0;
  }
}

// Format a result with trailing zeros trimmed.
fn show(v: float) -> Str {
  return utils::trimFloat(Str<float>(v));
}

// Seed the environment with the constants and the `ans` register.
fn defineConstants(env: hashmap::HashMap) {
  env.put("pi", 3.141592653589793);
  env.put("e", 2.718281828459045);
  env.put("ans", 0.0);
}

// Evaluate one statement line (an assignment or a bare expression) and print.
fn evalStatement(src: Str, env: hashmap::HashMap, history: Ring<(Str, float)>,
                 quiet: bool) {
  p: parser::Parser = parser::Parser(src, env);
  target, value = p.parseStatement();

  match p.error {
    msg: Str {
      io::printerrln("error: " + msg);
      return;
    }
    None { }
  }
  if !p.done() {
    io::printerrln("error: unexpected '" + p.rest() + "'");
    return;
  }

  env.put("ans", value);
  history.add((src, value));
  match target {
    name: Str {
      env.put(name, value);
      if quiet {
        io::println(show(value));
      } else {
        io::println(name + " = " + show(value));
      }
    }
    None {
      if quiet {
        io::println(show(value));
      } else {
        io::println(src + " = " + show(value));
      }
    }
  }
}

// List every stored variable, walking each bucket's chain of entries.
fn listVars(env: hashmap::HashMap) {
  if env.count() == 0 {
    io::println("(no variables)");
    return;
  }
  b: int = 0;
  while b < env.bucketCount() {
    cur: hashmap::Entry? = env.bucket(b);
    while cur != None {
      match cur {
        e: hashmap::Entry {
          io::println("  " + e.key + " = " + show(e.value));
          cur = e.next;
        }
        None { }
      }
    }
    b = b + 1;
  }
}

// Print the remembered statements, oldest first, numbered from 1.
fn listHistory(history: Ring<(Str, float)>) {
  if history.len() == 0 {
    io::println("(no history)");
    return;
  }
  i: int = 0;
  while i < history.len() {
    entry: view = history.at(i);   // (source, value)
    value = entry.1;
    io::println("  " + Str(i + 1) + ": " + entry.0 + "  => " + show(value));
    i = i + 1;
  }
}

// Split a `:command arg` line into its command word (between ':' and the
// first space) and its argument (everything after the spaces that follow).
fn splitCommand(s: Str) -> (Str, Str) {
  word: Str = "";
  i: int = 1;
  while i < s.len() && s[i] != ' ' {
    word = word + Str<char>(s[i]);
    i = i + 1;
  }
  while i < s.len() && s[i] == ' ' {
    i = i + 1;
  }
  arg: Str = "";
  while i < s.len() {
    arg = arg + Str(s[i]);
    i = i + 1;
  }
  return (word, arg);
}

// Run a `:command`. Returns False only for :quit (stop the REPL).
fn runCommand(s: Str, env: hashmap::HashMap, history: Ring<(Str, float)>,
              quiet: bool) -> bool {
  word, arg = splitCommand(s);

  if word.equals("quit") || word.equals("q") || word.equals("exit") {
    return False;
  }
  if word.equals("help") || word.equals("h") {
    printHelp();
    return True;
  }
  if word.equals("vars") {
    listVars(env);
    return True;
  }
  if word.equals("history") {
    listHistory(history);
    return True;
  }
  if word.equals("clear") {
    env.clear();
    defineConstants(env);
    if !quiet {
      io::println("cleared all variables");
    }
    return True;
  }
  if word.equals("del") {
    if arg.len() == 0 {
      io::printerrln("usage: :del <name>");
      return True;
    }
    if env.remove(arg) {
      if !quiet {
        io::println("deleted '" + arg + "'");
      }
    } else {
      io::printerrln("no such variable: '" + arg + "'");
    }
    return True;
  }
  io::printerrln("unknown command ':" + word + "' (try :help)");
  return True;
}

// Handle one input line. Returns False only when the user asked to quit.
fn handle(line: Str, env: hashmap::HashMap, history: Ring<(Str, float)>,
          quiet: bool) -> bool {
  s: Str = utils::stripLine(line);
  if s.len() == 0 { return True; }
  if s[0] == ':' {
    return runCommand(s, env, history, quiet);
  }
  evalStatement(s, env, history, quiet);
  return True;
}

// Read-evaluate-print loop over standard input.
fn repl(env: hashmap::HashMap, history: Ring<(Str, float)>, quiet: bool) -> int {
  if !quiet {
    io::println("calc — arithmetic with variables.  :help for commands, :quit to exit.");
  }
  while True {
    match io::stdin().readln().value {
      line: Str {
        if !handle(line, env, history, quiet) {
          return 0;
        }
      }
      _ { break; } // None — end of input
    }
  }
  return 0;
}

fn printHelp() {
  io::println("expressions:  + - * / %, parentheses, unary minus, decimals");
  io::println("variables:    x = 3 + 4     assign, then use x later");
  io::println("              ans           the last computed result");
  io::println("              pi, e         predefined constants");
  io::println("commands:     :vars         list all variables");
  io::println("              :history      list recent statements and results");
  io::println("              :del <name>   delete a variable");
  io::println("              :clear        remove all variables");
  io::println("              :help         show this help");
  io::println("              :quit         exit");
}

// The scripted session: each line goes through handle(), as if typed at the
// REPL. It covers expressions, assignment, `ans`, the constants, every
// command and a few errors, and ends with `a` and `b` defined.
fn demo(env: hashmap::HashMap, history: Ring<(Str, float)>) {
  script: Str[_] = [ "1 + 2 * 3", "(1 + 2) * 3", "x = 6", "y = x * 7",
      "(x + y) / 4", "ans * 2", "-x + 10 % 4", "2.5 * 2", ":vars", ":history",
      ":del y", "y + 1", ":del y", "1 / 0", "3 +", "4 4", ":frobnicate",
      ":clear", ":vars", "a = 6", "b = a * 7" ];
  i: int = 0;
  while i < script.len() {
    io::println("> " + script[i]);
    handle(script[i], env, history, False);
    i = i + 1;
  }
}

fn printUsage() {
  io::println("calc - arithmetic calculator with variables");
  io::println("");
  io::println("usage: paykan main.pkn [options] [expr ...]");
  io::println("");
  io::println("options:");
  io::println("  -e, --eval <expr>   evaluate <expr> (may be repeated)");
  io::println("  -q, --quiet         print only results (no echo, no banner)");
  io::println("      --no-demo       skip the scripted demo session");
  io::println("  -h, --help          show this help");
  io::println("");
  io::println("With no expressions, reads one statement per line from stdin.");
}

// True for an option such as `-q` (a lone `-` is not one).
fn isOption(a: view Str) -> bool {
  return utils::startsWith(a, "-") && a.len() > 1;
}

fn main(args: view Str[]) -> int {
  quiet: bool = False;
  runDemo: bool = True;
  nexprs: int = 0;

  // -- command-line parsing: flags, repeatable -e, positional expressions --
  i: int = 1;
  while i < args.len() {
    a: view = args[i];
    if a.equals("-h") || a.equals("--help") {
      printUsage();
      return 0;
    } elif a.equals("-q") || a.equals("--quiet") {
      quiet = True;
    } elif a.equals("--no-demo") {
      runDemo = False;
    } elif a.equals("-e") || a.equals("--eval") {
      if i + 1 < args.len() {
        i = i + 1;
        nexprs = nexprs + 1;
      } else {
        io::printerrln("error: " + a + " requires an argument");
        return 2;
      }
    } elif isOption(a) {
      io::printerrln("error: unknown option '" + a + "' (try -h)");
      return 2;
    } else {
      nexprs = nexprs + 1; // a positional argument is an expression
    }
    i = i + 1;
  }

  env: hashmap::HashMap = hashmap::HashMap();
  defineConstants(env);
  history: Ring<(Str, float)> = Ring<(Str, float)>(("", 0.0));
  if runDemo { demo(env, history); }

  // Batch mode: walk the arguments again and evaluate every expression, in
  // order, sharing one environment. The first pass checked the options, so
  // each one here is known. `toString()` gives an argument's string as one
  // of our own, for the parser and the history to keep.
  if nexprs > 0 {
    j: int = 1;
    while j < args.len() {
      if args[j].equals("-e") || args[j].equals("--eval") {
        j = j + 1;
        evalStatement(args[j].toString(), env, history, quiet);
      } elif !isOption(args[j]) {
        evalStatement(args[j].toString(), env, history, quiet);
      }
      j = j + 1;
    }
    return 0;
  }

  // Interactive mode.
  return repl(env, history, quiet);
}
