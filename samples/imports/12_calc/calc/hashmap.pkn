// calc/hashmap — a string-keyed hash map (Str -> float).
//
// A separate-chaining hash table that backs the calculator's variable store.
// Keys are compared with `Str.equals()`, character by character, and
// `charOrd` derives a character's ordinal from its index in a reference
// alphabet.
//
// The table has a fixed number of buckets (`Entry?[8]`), each the first entry
// of a linked chain (`Entry.next`), or None when the bucket is empty. A new
// key goes at the end of its bucket's chain, so a bucket keeps its keys in the
// order they were added. `lookup` returns an optional (`Entry?`): a missing
// key is `None`, so callers unwrap with `match` instead of pairing has() with
// get().

// One key/value pair, linked to the next one in its bucket.
class Entry {
  key: Str;
  value: float;
  next: Entry?;   // the next entry in the same bucket, or None

  // Link `e` at the end of the chain that starts here.
  fn append(e: Entry) {
    match self.next {
      n: Entry { n.append(e); }
      None { self.next = e; }
    }
  }

  // Unlink the entry after this one whose key is `key`. Returns True if there
  // was one.
  fn unlink(key: Str) -> bool {
    match self.next {
      n: Entry {
        if n.key.equals(key) {
          self.next = n.next;
          return True;
        }
        return n.unlink(key);
      }
      None { return False; }
    }
  }
}

impl Entry {
  fn __init__(k: Str, v: float) { self.key = k; self.value = v; }
}

// Ordinal of a character: its 1-based index in a reference alphabet, or 0 for
// any character outside it. Distinct identifier characters get distinct codes,
// which is all the hash needs.
fn charOrd(c: char) -> int {
  let alpha: Str =
      "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
  i: int = 0;
  while i < alpha.len() {
    if alpha[i] == c { return i + 1; }
    i = i + 1;
  }
  return 0;
}

class HashMap {
  buckets: Entry?[8];
  size: int;

  // djb2 over the key's character ordinals, folded into the bucket range.
  view fn indexFor(key: Str) -> int {
    h: int = 5381;
    i: int = 0;
    while i < key.len() {
      h = h * 33 + charOrd(key[i]);
      i = i + 1;
    }
    if h < 0 { h = 0 - h; }
    return h % self.buckets.len();
  }

  // The entry stored under `key`, or None when the key is absent.  Not a
  // `view fn`: the entry it returns can be changed (insert does).
  fn lookup(key: Str) -> Entry? {
    cur: Entry? = self.buckets[self.indexFor(key)];
    while cur != None {
      match cur {
        e: Entry {
          if e.key.equals(key) {
            return e;
          }
          cur = e.next;
        }
        None { }
      }
    }
    return None;
  }

  // Update the entry in place or append a new one. Returns True if a NEW key
  // was added.
  fn insert(key: Str, value: float) -> bool {
    match self.lookup(key) {
      e: Entry {
        e.value = value; // update in place (Entry is a reference type)
        return False;
      }
      None {
        let b: int = self.indexFor(key);
        match self.buckets[b] {
          first: Entry {
            first.append(Entry(key, value));
          }
          None {
            self.buckets[b] = Entry(key, value);
          }
        }
        return True;
      }
    }
  }

  fn put(key: Str, value: float) {
    if self.insert(key, value) {
      self.size = self.size + 1;
    }
  }

  // Delete a key. Returns True if it was present.
  fn remove(key: Str) -> bool {
    let b: int = self.indexFor(key);
    match self.buckets[b] {
      first: Entry {
        if first.key.equals(key) {
          self.buckets[b] = first.next; // the chain now starts at the second
        } elif !first.unlink(key) {
          return False;
        }
        self.size = self.size - 1;
        return True;
      }
      None { return False; }
    }
  }

  // The number of buckets, and the first entry of bucket `b`'s chain (None
  // when it is empty): with `Entry.next`, a way to visit every entry, in
  // bucket order.  `bucket` is not a `view fn`: the entries it reaches can be
  // changed.
  view fn bucketCount() -> int { return self.buckets.len(); }
  fn bucket(b: int) -> Entry?  { return self.buckets[b]; }

  view fn count() -> int       { return self.size; }

  // Drop all entries.
  fn clear()                   { self.buckets = [None; 8]; self.size = 0; }
}

impl HashMap {
  fn __init__() { self.buckets = [None; 8]; self.size = 0; }
}
