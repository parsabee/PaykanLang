// calc/utils — string helpers for the calculator.

// Strip trailing zeros from a Str<float> result.
// Examples: "7.000000" -> "7",  "3.140000" -> "3.14",  "2.5" -> "2.5"
fn trimFloat(s: Str) -> Str {
  dot = -1;
  i = 0;
  while i < s.len() {
    if s[i] == '.' { dot = i; }
    i = i + 1;
  }
  if dot == -1 { return s; }

  end = s.len() - 1;
  while end > dot && s[end] == '0' {
    end = end - 1;
  }
  if end == dot {
    end = end - 1;
  }

  result = "";
  i = 0;
  while i <= end {
    result = result + Str(s[i]);
    i = i + 1;
  }
  return result;
}

// Strip trailing newline, carriage-return, and spaces from a line.
// Used to clean up input from io::stdin().readln().
fn stripLine(s: view Str) -> Str {
  end = s.len() - 1;
  while end >= 0 && (s[end] == '\n' || s[end] == '\r' || s[end] == ' ') {
    end = end - 1;
  }
  result = "";
  i = 0;
  while i <= end {
    result = result + Str(s[i]);
    i = i + 1;
  }
  return result;
}

// True if `s` begins with `prefix` (character-by-character; `Str ==` is
// reference identity, so the comparison is done over chars).
fn startsWith(s: view Str, prefix: view Str) -> bool {
  if prefix.len() > s.len() {
    return False;
  }
  i = 0;
  while i < prefix.len() {
    if s[i] != prefix[i] {
      return False;
    }
    i = i + 1;
  }
  return True;
}
