// Module: cells — a function, a method and a field whose types carry a
// qualifier, which an importer reads back from the module's interface.
class Cell {
  n: int;
  next: shared mut Cell?;
  fn bump()            { self.n += 1; }
  fn me() -> mut Cell? { return self; }
}

fn make(n: int) -> mut Cell {
  return Cell(n, None);
}

fn link(a: mut Cell, b: shared mut Cell) {
  a.next = b;
}
