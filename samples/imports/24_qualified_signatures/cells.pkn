// Module: cells — functions, a method and a field whose types carry a
// qualifier, which an importer reads back from the module's interface.
class Cell {
  n: int;
  next: shared mutable Cell?;
  fn bump()                              { self.n += 1; }
  shared fn me() -> shared mutable Cell? { return self; }
}

fn make(n: int) -> mutable Cell {
  return Cell(n, None);
}

// Links `a` to `b` and hands `a` back.
fn link(a: mutable Cell, b: shared mutable Cell) -> mutable Cell {
  a.next = b;
  return a;
}
