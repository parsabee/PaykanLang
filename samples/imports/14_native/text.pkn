// text — string helpers whose bodies are C (text.c).
// A `native fn` names the C function.  paykan does not build C: compile
// text.c into an object and pass it with --object (#198).

// C borrows each Str (`view`); only scalars cross by value.
native fn upper(s: view Str) -> Str = "sample_text_upper";
native fn count(s: view Str, c: char) -> int = "sample_text_count";
native fn find(s: view Str, needle: view Str) -> Str? = "sample_text_find";
// C replaces the caller's Str in place (`inout`).
native fn trim(s: inout Str) = "sample_text_trim";

// Ordinary Paykan code can wrap native functions like any others.
fn shout(s: Str) -> Str {
  return upper(s) + "!";
}
