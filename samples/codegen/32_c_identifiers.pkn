// 32 — identifiers that are special in C: every backend must accept any
// valid Paykan name.  The C backend (replaced by the mlir backend's --emit-c)
// once emitted user names unchanged, so these collided with its own generated
// names (`x_1`, `a_<n>`), with C type names (`int64_t`) and with C library
// macros and functions (`errno`, `stdout`, `EOF`, `fmod`, `malloc`).
// Exercises: locals, parameters, fields, methods, functions and classes named
//            like C / libc identifiers or like generated, mangled C names.

import ::io;

// Library function names as Paykan functions.
fn fmod(a: float, b: float) -> float {
  return 42.0;
}
fn malloc(n: int) -> int {
  return n + 1;
}

// Names that look like mangled / generated ones.
fn f_5F(x: int) -> int {
  return x + 100;
}
fn f_(x: int) -> int {
  return x + 1;
}

class Box<T: Copyable> {
  v: T;
  view fn get() -> T { return self.v; }
}
impl Box<T> {
  fn __init__(v: T) { self.v = v; }
}
class Box_3Cint_3E {
  w: Str;
  view fn get() -> view Str { return self.w; }
}
impl Box_3Cint_3E {
  fn __init__() { self.w = "plain"; }
}

// Fields named like C macros and like the object header's members.
class P {
  errno: int;
  stdout: Str;
  vtable: int;
  strong: int;
  view fn EOF() -> int { return self.errno + self.vtable + self.strong; }
}

impl P {
  fn __init__(e: int) {
    self.errno = e;
    self.stdout = "s";
    self.vtable = 1;
    self.strong = 2;
  }
}
fn P_vtable() -> int {
  return 9;
}

// User locals named like the backend's suffixed names.
fn suffixes() -> int {
  let x = 1;
  let x_0 = 2;
  let x_1 = 3;
  let x_2 = 4;
  return x + x_0 + x_1 + x_2;
}

// Many locals `a_<n>` and many values derived from `a`.
fn manyValues() -> int {
  a = 1;
  let a_0 = 0;
  let a_1 = 1;
  let a_2 = 2;
  let a_3 = 3;
  let a_4 = 4;
  let a_5 = 5;
