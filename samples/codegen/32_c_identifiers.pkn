  a = a + 1;
  a = a + 1;
  a = a + 1;
  a = a + 1;
  a = a + 1;
  a = a + 1;
  a = a + 1;
  a = a + 1;
  a = a + 1;
  a = a + 1;
  a = a + 1;
  a = a + 1;
  return a + a_3 + a_79;
}

fn params(int64_t: int, errno: int, l_x: int, v1: int) -> int {
  return int64_t * 1000 + errno * 100 + l_x * 10 + v1;
}

fn main() -> int {
  // C library macros as locals.
  let errno: int = 3;
  let stdout: int = 4;
  let EOF: int = 5;
  io::println(Str<int>(errno + stdout + EOF));

  // A local hiding a libc function used by float `%`.
  let x: float = 7.5;
  let fmod_: float = 2.0;
  let y: float = x % fmod_;
  io::println(Str(y));
  io::println(Str<float>(fmod(x, fmod_)));
  io::println(Str(malloc(1)));

  // A C type name as a variable.
  let int64_t: int = 3;
  let b: int = int64_t + 1;
  io::println(Str<int>(b));

  io::println(Str(suffixes()));
  io::println(Str<int>(manyValues()));
  io::println(Str(params(1, 2, 3, 4)));

  // Shadowing in a nested scope.
  let n: int = 1;
  if n == 1 {
    let n: int = 5;
    io::println(Str<int>(n));
  }
  io::println(Str(n));

  let bx: Box<int> = Box<int>(5);
  let plain: Box_3Cint_3E = Box_3Cint_3E();
  io::println(Str<int>(bx.get()) + plain.get() + Str(f_5F(1))
      + Str<int>(f_(1)));

  let p: P = P(3);
  io::println(Str(p.EOF()) + p.stdout + Str<int>(P_vtable()));
  return 0;
}
