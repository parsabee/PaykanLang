// 19_file_copy.pkn — Copy every line from a source file to a destination file.
// Demonstrates: io::open() and File.readln() returning a res::Result, matched
//               on its variants (`Ok` with the value on success, `Err` with
//               the error on failure), and File.write().
//
// open()   -> Result<File, Error> : the File, or the Error saying why not
// readln() -> Result<Str, Error>  : a line, or EndOfFile at the end
//
// args: {tmpdir}

import ::io;

// The path of the scratch file `name`: in the first argument's directory
// (the samples harnesses pass a fresh one per run, `// args: {tmpdir}`, so
// parallel runs never share a file), else in /tmp.
fn scratchPath(args: view Str[], name: Str) -> Str {
  if args.len() > 1 {
    return args[1] + "/" + name;
  }
  return "/tmp/" + name;
}

fn writeSource(path: Str) -> int {
  match io::open(path, "w") {
    e: Err {
      io::printerrln("writeSource: " + e.error.message());
      return 1;
    }
    w: Ok {
      f = w.value;
      f.write("first line\n");
      f.write("second line\n");
      f.write("third line\n");
    }
  }
  return 0;
  // the File destroyed when the match ends -> fclose -> data flushed
}

fn copy(inFile: io::File, outFile: io::File) {
  while True {
    match inFile.readln() {
      line: Ok {
        outFile.write(line.value);
      }
      _ { break; }
    }
  }
}

fn copyFile(src: Str, dst: Str) -> int {
  match io::open(src, "r") {
    e: Err {
      io::printerrln("copyFile: cannot open src: " + e.error.message());
      return 1;
    }
    input: Ok {
      match io::open(dst, "w") {
        e: Err {
          io::printerrln("copyFile: cannot open dst: " + e.error.message());
          return 1;
        }
        output: Ok {
          copy(input.value, output.value);
        }
      }
    }
  }
  return 0;
  // both File handles destroyed when the matches end -> fclose
}

fn printFile(path: Str) -> int {
  match io::open(path, "r") {
    e: Err {
      io::printerrln("printFile: " + e.error.message());
      return 1;
    }
    r: Ok {
      while True {
        match r.value.readln() {
          line: Ok { io::print(line.value); }
          _ { break; }
        }
      }
    }
  }
  return 0;
}

fn main(args: view Str[]) -> int {
  src: Str = scratchPath(args, "paykan_copy_src.txt");
  dst: Str = scratchPath(args, "paykan_copy_dst.txt");

  writeSource(src);    // write & close src
  printFile(src);
  copyFile(src, dst);  // copy src -> dst, close both
  printFile(dst);      // read & print dst

  return 0;
}
