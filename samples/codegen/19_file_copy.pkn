// 19_file_copy.pkn — Copy every line from a source file to a destination file.
// Demonstrates: io::open() and File.readln() returning a res::Result, matched
//               on its value (present on success, None on failure), and
//               File.write().
//
// open()   -> Result<File> : the File, or the Error saying why not
// readln() -> Result<Str>  : a line, or EndOfFile at the end
//
// args: {tmpdir}

import ::io;

// The path of the scratch file `name`: in the first argument's directory
// (the samples harnesses pass a fresh one per run, `// args: {tmpdir}`, so
// parallel runs never share a file), else in /tmp.
fn scratchPath(args: view Str[], name: Str) -> Str {
  if args.len() > 1 {
    return args[1] + "/" + name;
  }
  return "/tmp/" + name;
}

fn writeSource(path: Str) -> int {
  r = io::open(path, "w");
  match r.value {
    None {
      io::printerrln("writeSource: " + r.error.message());
      return 1;
    }
    f: io::File {
      f.write("first line\n");
      f.write("second line\n");
      f.write("third line\n");
    }
  }
  return 0;
  // f destroyed here -> fclose -> data flushed to disk
}

fn copy(inFile: io::File, outFile: io::File) {
  while True {
    match inFile.readln().value {
      line: Str {
        outFile.write(line);
      }
      _ { break; }
    }
  }
}

fn copyFile(src: Str, dst: Str) -> int {
  input = io::open(src, "r");
  match input.value {
    None {
      io::printerrln("copyFile: cannot open src: " + input.error.message());
      return 1;
    }
    inFile: io::File {
      output = io::open(dst, "w");
      match output.value {
        None {
          io::printerrln("copyFile: cannot open dst: "
              + output.error.message());
          return 1;
        }
        outFile: io::File {
          copy(inFile, outFile);
        }
      }
    }
  }
  return 0;
  // both File handles destroyed here -> fclose
}

fn printFile(path: Str) -> int {
  r = io::open(path, "r");
  match r.value {
    None {
      io::printerrln("printFile: " + r.error.message());
      return 1;
    }
    f: io::File {
      while True {
        match f.readln().value {
          line: Str { io::print(line); }
          _ { break; }
        }
      }
    }
  }
  return 0;
}

fn main(args: view Str[]) -> int {
  src: Str = scratchPath(args, "paykan_copy_src.txt");
  dst: Str = scratchPath(args, "paykan_copy_dst.txt");

  writeSource(src);    // write & close src
  printFile(src);
  copyFile(src, dst);  // copy src -> dst, close both
  printFile(dst);      // read & print dst

  return 0;
}
