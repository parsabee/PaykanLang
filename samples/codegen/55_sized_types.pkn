// 55 — sized numeric types
// Exercises: i8/i16/i32, u8/u16/u32, unsigned (u64), f16/f32: literals taking
//            the type their context expects, arithmetic wrapping to the
//            width, unsigned division, remainder and ordering, f32/f16
//            rounding after each operation, the conversions of each family
//            (wrapping, truncating with a range panic, rounding),
//            Str(...) and toString(), parsing into T?, hash(), sized fields
//            of a struct, elements of a tuple and a fixed-size array, a
//            generic class over a sized type, an optional and a match.
// expect-stdout: 4 127 -5536 705032704
// expect-stdout: 18446744073709551615 9223372036854775807 5 True -1
// expect-stdout: 0.1 1.67772e+07 0.0999756 inf 65504
// expect-stdout: 44 -56 -1 1.84467e+19 1 -128 -128
// expect-stdout: max None -128 18446744073709551615 None 0.1
// expect-stdout: Pixel(r: 255, g: 128, b: 0, a: 0.5) True
// expect-stdout: (18446744073709551615, -5, 0.0999756) True
// expect-stdout: 2 44 18446744073709551615 255 seven True 0.428571

import ::io;

struct Pixel {
  r: u8;
  g: u8;
  b: u8;
  a: f32;
}

class Box<T> {
  v: T;
}
impl Box<T> {
  fn __init__(v: T)  { self.v = v; }
  view fn get() -> T { return self.v; }
}

fn sum(xs: view u16[3]) -> u16 {
  t: u16 = 0;
  i = 0;
  while i < 3 {
    t = t + xs[i];
    i = i + 1;
  }
  return t;
}

fn main() -> int {
  // Wrapping arithmetic at the type's width.
  a: u8 = 250;
  b: u8 = a + 10;              // 4
  c: i8 = -128;
  d: i8 = c - 1;               // 127
  e: i16 = 30000;
  f: i16 = e * 2;              // -5536
  g: u32 = 4000000000;
  h: u32 = g + 1000000000;     // 705032704
  io::println(Str(b) + " " + Str(d) + " " + Str(f) + " " + Str(h));

  // unsigned: the same bits as int, read unsigned.
  u: unsigned = unsigned(-1);
  io::println(Str(u) + " " + Str(u / 2) + " " + Str(u % 10) + " " + Str(u > 1)
      + " " + Str(i32(u32(u))));

  // f32 and f16 round after each operation.
  x: f32 = 0.1;
  y: f32 = 16777216.0;
  z: f16 = 0.1;
  io::println(Str(x) + " " + Str(y + 1) + " " + Str(z) + " " + Str(f16(70000.0))
      + " " + Str(f16(65519.0)));

  // Conversions: wrapping, truncating, rounding.
  n: i8 = -128;
  io::println(Str(u8(300)) + " " + Str(i8(200)) + " " + Str(i32(-1.5)) + " "
      + Str(float(u)) + " " + Str(u64(int(1.5))) + " " + Str(-n) + " "
      + Str(n / -1));

  // Parsing into T?, printed through println's optional rendering.
  p: u16? = "65535".toU16();
  match p {
    v: u16 {
      match v {
        65535 { io::print("max "); }
        _ { io::print("other "); }
      }
    }
    None { io::print("none "); }
  }
  q: u8? = "256".toU8();
  r: i8? = "-128".toI8();
  s: unsigned? = "18446744073709551615".toUnsigned();
  t: unsigned? = "-1".toUnsigned();
  w: f32? = "0.1".toF32();
  io::print(q);
  io::print(" ");
  io::print(r);
  io::print(" ");
  io::print(s);
  io::print(" ");
  io::print(t);
  io::print(" ");
  io::println(w);

  // Sized fields and elements print and compare like int and float ones.
  px = Pixel(255, 128, 0, 0.5);
  io::println(px.toString() + " " + Str(px == Pixel(255, 128, 0, 0.5)));
  tu = (unsigned(-1), i8(-5), f16(0.1));
  io::println(tu.toString() + " "
      + Str(tu == (unsigned(-1), i8(-5), f16(0.1))));
  xs: u16[3] = [65535, 1, 2];
  bx = Box<u8>(200);
  k: u8 = bx.get() + 100;      // 44
  big = Box<unsigned>(unsigned(-1));
  arr: u8[3] = [1, 2, 255];
  m: u32 = 7;
  seven: Str = "other";
  match m {
    7 { seven = "seven"; }
    _ { }
  }
  h250: u8 = 250;
  fr: f32 = 3.0;
  io::println(Str(sum(xs)) + " " + Str(k) + " " + Str(big.get()) + " "
      + Str(arr[2]) + " " + seven + " " + Str(a.hash() == h250.hash()) + " "
      + Str(fr / 7));
  return 0;
}
