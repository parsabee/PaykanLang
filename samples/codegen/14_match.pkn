// 14_match.pkn — comprehensive codegen sample for the `match` statement.
//
// Covers BOTH modes of match:
//
//   TYPE MODE  (subject is a class type) — runtime downcasting dispatch via
//              vtable identity. Arms name a class type, optionally with a
//              binding (`name: Type`). Comparison is *exact* type (a subclass
//              does not match a parent arm).
//
//   VALUE MODE (subject is a builtin type: int/float/bool/char/Str) — value
//              comparison against a literal pattern. Arms are literals written
//              `literal { ... }`. First match wins. Str arms compare string
//              *content*.
//
// In both modes `_` is the catch-all and must be the last arm.

// ===========================================================================
// Type-mode fixtures
// ===========================================================================

class Animal {
  fn __init__() {}
  fn speak() -> Str { return "..."; }
}

class Dog : Animal {
  fn __init__() { __super__(); }
  fn speak() -> Str { return "Woof"; }
}

class Cat : Animal {
  fn __init__() { __super__(); }
  fn speak() -> Str { return "Meow"; }
}

class Bird : Animal {
  fn __init__() { __super__(); }
  fn speak() -> Str { return "Tweet"; }
}

class Labrador : Dog {
  name: Str;
  fn __init__() { __super__(); self.name = "Rex"; }
}

// match inside a helper function (type mode), used as the function's value.
fn describeAnimal(x: Animal) -> Str {
  match x {
    Dog  { return "it is a dog"; }
    Cat  { return "it is a cat"; }
    Bird { return "it is a bird"; }
    _    { return "unknown"; }
  }
  return "unreachable";
}

// match inside a helper function (value mode).
fn classify(n: int) -> Str {
  match n {
    0 { return "zero"; }
    1 { return "one"; }
    2 { return "two"; }
    _ { return "many"; }
  }
  return "unreachable";
}

fn main() -> int {

  // =========================================================================
  // PART A — TYPE MODE
  // =========================================================================

  // --- A1: basic no-binding dispatch ---
  a: Animal = Dog();
  match a {
    Dog  { println("A1: Dog"); }
    Cat  { println("A1: Cat"); }
    Bird { println("A1: Bird"); }
    _    { println("A1: other"); }
  }

  // --- A2: wildcard-only arm ---
  b: Animal = Cat();
  match b {
    _ { println("A2: wildcard"); }
  }

  // --- A3: binding + field access ---
  d: Animal = Labrador();
  match d {
    lab: Labrador { println("A3: " + lab.name); }
    Dog           { println("A3: plain dog"); }
    _             { println("A3: other"); }
  }

  // --- A4: binding + method call (dispatch through the binding) ---
  plainDog: Animal = Dog();
  match plainDog {
    dog: Dog { println("A4: " + dog.speak()); }
    _        { println("A4: other"); }
  }

  // --- A5: exact-type comparison — a Labrador does NOT match the Dog arm ---
  e: Animal = Labrador();
  match e {
    Cat      { println("A5: cat"); }
    Dog      { println("A5: Dog"); }
    Labrador { println("A5: Labrador"); }
    _        { println("A5: other"); }
  }

  // --- A6: no arm matches -> wildcard ---
  f: Animal = Bird();
  match f {
    Dog { println("A6: dog"); }
    Cat { println("A6: cat"); }
    _   { println("A6: wildcard Bird"); }
  }

  // --- A7: match inside a helper function ---
  println(describeAnimal(Dog()));
  println(describeAnimal(Bird()));
  println(describeAnimal(Cat()));

  // =========================================================================
  // PART B — VALUE MODE
  // =========================================================================

  // --- B1: Str literal match (content comparison) ---
  greeting: Str = "World";
  match greeting {
    "Hello" { println("B1: got Hello"); }
    "World" { println("B1: got World"); }
    _       { println("B1: other"); }
  }

  // --- B2: Str match falls through to wildcard ---
  nope: Str = "Nope";
  match nope {
    "Hello" { println("B2: got Hello"); }
    "World" { println("B2: got World"); }
    _       { println("B2: wildcard"); }
  }

  // --- B3: int literal match ---
  n: int = 2;
  match n {
    1 { println("B3: one"); }
    2 { println("B3: two"); }
    3 { println("B3: three"); }
    _ { println("B3: many"); }
  }

  // --- B4: float literal match ---
  pi: float = 2.5;
  match pi {
    1.0 { println("B4: one"); }
    2.5 { println("B4: two-point-five"); }
    _   { println("B4: other"); }
  }

  // --- B5: char literal match ---
  ch: char = 'b';
  match ch {
    'a' { println("B5: a"); }
    'b' { println("B5: b"); }
    _   { println("B5: other"); }
  }

  // --- B6: bool literal match — exhaustive, no wildcard needed ---
  flag: bool = False;
  match flag {
    True  { println("B6: yes"); }
    False { println("B6: no"); }
  }

  // --- B7: value match inside a helper function ---
  println(classify(0));
  println(classify(1));
  println(classify(2));
  println(classify(9));

  return 0;
}
