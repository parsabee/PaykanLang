// 14_match.pkn — comprehensive codegen sample for the `match` statement.
//
// Covers BOTH modes of match:
//
//   TYPE MODE  (subject is a class type) — runtime downcasting dispatch via
//              vtable identity. Arms name a class type, optionally with a
//              binding (`name: Type`). Comparison is *exact* type (a subclass
//              does not match a parent arm).
//
//   VALUE MODE (subject is a builtin type: int/float/bool/char/Str) — value
//              comparison against a literal pattern. Arms are literals written
//              `literal { ... }`. First match wins. Str arms compare string
//              *content*.
//
// In both modes `_` is the catch-all and must be the last arm.

import ::io;

// ===========================================================================
// Type-mode fixtures
// ===========================================================================

class Animal {
  view fn speak() -> Str { return "..."; }
}

impl Animal {
  fn __init__() { }
}

class Dog : Animal {
  view fn speak() -> Str { return "Woof"; }
}

impl Dog {
  fn __init__() { __super__(); }
}

class Cat : Animal {
  view fn speak() -> Str { return "Meow"; }
}

impl Cat {
  fn __init__() { __super__(); }
}

class Bird : Animal {
  view fn speak() -> Str { return "Tweet"; }
}

impl Bird {
  fn __init__() { __super__(); }
}

class Labrador : Dog {
  name: Str;
}

impl Labrador {
  fn __init__() { __super__(); self.name = "Rex"; }
}

// match inside a helper function (type mode), used as the function's value.
fn describeAnimal(x: Animal) -> Str {
  match x {
    Dog { return "it is a dog"; }
    Cat { return "it is a cat"; }
    Bird { return "it is a bird"; }
    _ { return "unknown"; }
  }
  return "unreachable";
}

// match inside a helper function (value mode).
fn classify(n: int) -> Str {
  match n {
    0 { return "zero"; }
    1 { return "one"; }
    2 { return "two"; }
    _ { return "many"; }
  }
  return "unreachable";
}

fn main() -> int {
  // =========================================================================
  // PART A — TYPE MODE
  // =========================================================================

  // --- A1: basic no-binding dispatch ---
  a: Animal = Dog();
  match a {
    Dog { io::println("A1: Dog"); }
    Cat { io::println("A1: Cat"); }
    Bird { io::println("A1: Bird"); }
    _ { io::println("A1: other"); }
  }

  // --- A2: wildcard-only arm ---
  b: Animal = Cat();
  match b {
    _ { io::println("A2: wildcard"); }
  }

  // --- A3: binding + field access ---
  d: Animal = Labrador();
  match d {
    lab: Labrador {
      io::println("A3: " + lab.name);
    }
    Dog {
      io::println("A3: plain dog");
    }
    _ {
      io::println("A3: other");
    }
  }

  // --- A4: binding + method call (dispatch through the binding) ---
  plainDog: Animal = Dog();
  match plainDog {
    dog: Dog {
      io::println("A4: " + dog.speak());
    }
    _ {
      io::println("A4: other");
    }
  }

  // --- A5: exact-type comparison — a Labrador does NOT match the Dog arm ---
  e: Animal = Labrador();
  match e {
    Cat { io::println("A5: cat"); }
    Dog { io::println("A5: Dog"); }
    Labrador {
      io::println("A5: Labrador");
    }
    _ {
      io::println("A5: other");
    }
  }

  // --- A6: no arm matches -> wildcard ---
  f: Animal = Bird();
  match f {
    Dog { io::println("A6: dog"); }
    Cat { io::println("A6: cat"); }
    _ {
      io::println("A6: wildcard Bird");
    }
  }

  // --- A7: match inside a helper function ---
  io::println(describeAnimal(Dog()));
  io::println(describeAnimal(Bird()));
  io::println(describeAnimal(Cat()));

  // =========================================================================
  // PART B — VALUE MODE
  // =========================================================================

  // --- B1: Str literal match (content comparison) ---
  greeting: Str = "World";
  match greeting {
    "Hello" {
      io::println("B1: got Hello");
    }
    "World" {
      io::println("B1: got World");
    }
    _ {
      io::println("B1: other");
    }
  }

  // --- B2: Str match falls through to wildcard ---
  nope: Str = "Nope";
  match nope {
    "Hello" {
      io::println("B2: got Hello");
    }
    "World" {
      io::println("B2: got World");
    }
    _ {
      io::println("B2: wildcard");
    }
  }

  // --- B3: int literal match ---
  n: int = 2;
  match n {
    1 { io::println("B3: one"); }
    2 { io::println("B3: two"); }
    3 { io::println("B3: three"); }
    _ { io::println("B3: many"); }
  }

  // --- B4: float literal match ---
  pi: float = 2.5;
  match pi {
    1.0 { io::println("B4: one"); }
    2.5 {
      io::println("B4: two-point-five");
    }
    _ { io::println("B4: other"); }
  }

  // --- B5: char literal match ---
  ch: char = 'b';
  match ch {
    'a' { io::println("B5: a"); }
    'b' { io::println("B5: b"); }
    _ { io::println("B5: other"); }
  }

  // --- B6: bool literal match — exhaustive, no wildcard needed ---
  flag: bool = False;
  match flag {
    True { io::println("B6: yes"); }
    False { io::println("B6: no"); }
  }

  // --- B6b: a literal subject (a constant, but still a value match) ---
  match "World" {
    "Hello" {
      io::println("B6b: got Hello");
    }
    "World" {
      io::println("B6b: got World");
    }
    _ {
      io::println("B6b: other");
    }
  }
  match 3 {
    3 { io::println("B6b: three"); }
    _ { io::println("B6b: other"); }
  }

  // --- B7: value match inside a helper function ---
  io::println(classify(0));
  io::println(classify(1));
  io::println(classify(2));
  io::println(classify(9));

  return 0;
}
