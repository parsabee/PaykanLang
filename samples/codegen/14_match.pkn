// 14_match.pkn — codegen sample for match statements
// Covers: no-binding dispatch, wildcard, binding+field, binding+method,
//         match in helper function, exact-type dispatch, match-as-sole-return.

class Animal {
  fn __init__() {}
  fn speak() -> Str { return "..."; }
}

class Dog : Animal {
  fn __init__() { __super__(); }
  fn speak() -> Str { return "Woof"; }
}

class Cat : Animal {
  fn __init__() { __super__(); }
  fn speak() -> Str { return "Meow"; }
}

class Bird : Animal {
  fn __init__() { __super__(); }
  fn speak() -> Str { return "Tweet"; }
}

class Labrador : Dog {
  name: Str;
  fn __init__() { __super__(); self.name = "Rex"; }
}

// --- Test 6 helper ---
fn describeAnimal(x: Animal) -> Str {
  match x {
    Dog  { return "it is a dog"; }
    Cat  { return "it is a cat"; }
    Bird { return "it is a bird"; }
    _    { return "unknown"; }
  }
  return "unreachable";
}

fn main() -> int {

  // --- Test 1: basic no-binding dispatch ---
  a: Animal = Dog();
  match a {
    Dog  { println("test1: Dog"); }
    Cat  { println("test1: Cat"); }
    Bird { println("test1: Bird"); }
    _    { println("test1: other"); }
  }

  // --- Test 2: wildcard only ---
  b: Animal = Cat();
  match b {
    _ { println("test2: wildcard"); }
  }

  // --- Test 3: binding + field access ---
  d: Animal = Labrador();
  match d {
    lab: Labrador { println(lab.name); }
    Dog           { println("test3: plain dog"); }
    _             { println("test3: other"); }
  }

  // --- Test 4: binding + method call ---
  match d {
    dog: Dog { println(dog.speak()); }
    _        { println("test4: other"); }
  }

  // --- Test 5: Cat subject ---
  c: Animal = Cat();
  match c {
    Dog { println("test5: dog"); }
    Cat { println("test5: Cat"); }
    _   { println("test5: other"); }
  }

  // --- Test 6: match inside a helper function ---
  println(describeAnimal(Dog()));
  println(describeAnimal(Bird()));
  println(describeAnimal(Cat()));

  // --- Test 7: Labrador does NOT match Dog arm (exact-type comparison) ---
  e: Animal = Labrador();
  match e {
    Cat      { println("test7: cat"); }
    Dog      { println("test7: Dog"); }
    Labrador { println("test7: Labrador"); }
    _        { println("test7: other"); }
  }

  // --- Test 8: no match -> wildcard ---
  f: Animal = Bird();
  match f {
    Dog { println("test8: dog"); }
    Cat { println("test8: cat"); }
    _   { println("test8: wildcard Bird"); }
  }

  // --- Test 9: Labrador-specific arm with binding ---
  g: Animal = Labrador();
  match g {
    lab: Labrador { println("test9: Labrador, name=" + lab.name); }
    Dog           { println("test9: plain Dog"); }
    _             { println("test9: other"); }
  }

  // --- Test 10: exhaustive arms ---
  h: Animal = Cat();
  match h {
    Dog      { println("test10: dog"); }
    Cat      { println("test10: Cat"); }
    Bird     { println("test10: bird"); }
    Labrador { println("test10: labrador"); }
    _        { println("test10: other"); }
  }

  return 0;
}
