// 12 — Comprehensive: combines every codegen feature in one program.
// Acts as a smoke-test that all paths compose correctly together.
// Exercises: all operators, all control flow, all types, Str methods,
//            recursion, multiple function return paths, nested scopes,
//            bool/int/float/Str passing in every direction

// ---- Utility functions (int) ----------------------------------------------

fn abs(x: int) -> int       { return if x < 0 then 0 - x else x; }
fn max(a: int, b: int) -> int { return if a > b then a else b; }
fn min(a: int, b: int) -> int { return if a < b then a else b; }
fn clamp(v: int, lo: int, hi: int) -> int {
  return max(lo, min(hi, v));
}

fn gcd(a: int, b: int) -> int {
  while (b != 0) {
    t: int = b;
    b = a % b;
    a = t;
  }
  return a;
}
fn lcm(a: int, b: int) -> int { return (a / gcd(a, b)) * b; }

fn isPrime(n: int) -> bool {
  if (n < 2)  { return False; }
  if (n == 2) { return True; }
  if (n % 2 == 0) { return False; }
  d: int = 3;
  while (d * d <= n) {
    if (n % d == 0) { return False; }
    d = d + 2;
  }
  return True;
}

fn sumRange(lo: int, hi: int) -> int {
  s: int = 0;
  i: int = lo;
  while (i <= hi) { s = s + i; i = i + 1; }
  return s;
}

fn power(base: int, exp: int) -> int {
  r: int = 1;
  i: int = 0;
  while (i < exp) { r = r * base; i = i + 1; }
  return r;
}

// ---- Float helpers --------------------------------------------------------

fn fsquare(x: float) -> float { return x * x; }
fn favg(a: float, b: float) -> float { return (a + b) / 2.0; }

// ---- Str helpers ----------------------------------------------------------

fn padLeft(s: Str, width: int) -> Str {
  result: Str = s;
  while (result.len() < width) {
    result = " " + result;
  }
  return result;
}

fn fizzbuzz(n: int) -> Str {
  if (n % 15 == 0) { return "FizzBuzz"; }
  if (n % 3  == 0) { return "Fizz"; }
  if (n % 5  == 0) { return "Buzz"; }
  return Str<int>(n);
}

fn tableRow(label: Str, val: int) -> Str {
  return label + ": " + padLeft(Str<int>(val), 6);
}

// ---- main -----------------------------------------------------------------

fn main() -> int {
  println("============================");
  println("  PaykanLang CodeGen Suite  ");
  println("============================");

  // ---------- Int arithmetic & operators -----------------------------------
  println("\n--- Int arithmetic ---");
  println(tableRow("2+3*4",    2 + 3 * 4));    // 14
  println(tableRow("(2+3)*4",  (2 + 3) * 4));  // 20
  println(tableRow("17%5",     17 % 5));        // 2
  println(tableRow("abs(-99)", abs(0 - 99)));   // 99
  println(tableRow("clamp", clamp(150, 0, 100))); // 100

  // ---------- Relational & logical -----------------------------------------
  println("\n--- Relational/Logical ---");
  x: int = 7;
  println("7 in [1,10]: " + Str<bool>(x >= 1 && x <= 10));  // True
  println("7 prime:     " + Str<bool>(isPrime(x)));           // True
  println("7 even:      " + Str<bool>(x % 2 == 0));          // False
  println("!prime(4):   " + Str<bool>(!isPrime(4)));          // True

  // ---------- Float ---------------------------------------------------------
  println("\n--- Float ---");
  pi: float = 3.14159;
  println("pi^2=" + Str<float>(fsquare(pi)));          // ~9.8696
  println("avg=" + Str<float>(favg(1.0, 3.0)));       // 2
  println("0.1+0.2=" + Str<float>(0.1 + 0.2));

  // ---------- Ternary -------------------------------------------------------
  println("\n--- Ternary ---");
  grade: int = 83;
  band: Str = if grade >= 90 then "A"
              else if grade >= 80 then "B"
              else if grade >= 70 then "C"
              else "F";
  println("grade 83 -> " + band);   // B

  // ---------- Control flow --------------------------------------------------
  println("\n--- FizzBuzz 1-20 ---");
  k: int = 1;
  while (k <= 20) {
    println(fizzbuzz(k));
    k = k + 1;
  }

  println("\n--- Primes up to 30 ---");
  p: int = 2;
  while (p <= 30) {
    if (isPrime(p)) { println(Str<int>(p)); }
    p = p + 1;
  }

  // ---------- Math results --------------------------------------------------
  println("\n--- Math ---");
  println(tableRow("sum 1..100",   sumRange(1, 100)));   // 5050
  println(tableRow("gcd(48,18)",   gcd(48, 18)));         // 6
  println(tableRow("lcm(12,18)",   lcm(12, 18)));         // 36
  println(tableRow("2^16",         power(2, 16)));         // 65536

  // ---------- Str methods & ops --------------------------------------------
  println("\n--- Str methods ---");
  hello: Str = "Hello";
  world: Str = " World";
  hw: Str = hello + world;
  println(hw);                          // Hello World
  println(Str<int>(hw.len()));      // 11
  println(hw.toString());               // Hello World

  // Padded table rows via Str helper
  println("\n--- Padded table ---");
  i: int = 1;
  while (i <= 5) {
    println(tableRow("item-" + Str<int>(i), i * i));
    i = i + 1;
  }

  // ---------- Nested scopes + cleanup --------------------------------------
  println("\n--- Scope stress ---");
  j: int = 0;
  while (j < 4) {
    row: Str = "row-" + Str<int>(j);
    col: int = 0;
    while (col < 3) {
      cell: Str = row + "-" + Str<int>(col);
      println(cell);
      col = col + 1;
    }
    j = j + 1;
  }

  println("\n============================");
  println("         All done           ");
  println("============================");
  return 0;
}
