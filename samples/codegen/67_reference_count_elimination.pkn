// 67 — reference-count elimination: a retain and its releases removed
// where something else keeps the object alive
// Exercises: the compiler's reference-count elimination (docs/pir.md §12,
//            "The reference-count elimination pass";
//            docs/language/16-memory.md, "Reference counts the compiler
//            removes") on each shape it judges: a match on a field whose
//            arm calls nothing (its subject's and its binding's retains
//            go); a match whose arm calls code that clears the field it
//            read, so that only the match holds the node (its subject's
//            retain stays: the field-load hazard); `x.next = x.next.next`
//            under a match on `x.next`; an array element replaced by a call
//            while a match holds it; a match on a weak field; a walk with
//            `break` and `continue`; and a return from inside a match.  The
//            `weak` references show when each object dies: where it would
//            without the pass, at the end of what last held it.
// expect-stdout: no call: 3 | a's next alive
// expect-stdout: cleared: a alive b | after: gone
// expect-stdout: unlinked: y alive | list: xz | y gone
// expect-stdout: element: old! new | old gone
// expect-stdout: weak: w1 of w | gone: none, other
// expect-stdout: walk: 1+4=5 | stopped at 3
// expect-stdout: early: 2 | 0 | e alive

import ::io;

class Node {
  name: Str;
  v: int;
  next: Node?;
}

class List {
  head: Node?;
}

class Watch {
  weak target: Node?;
}

/// What @p w refers to: "alive" or "gone".
fn state(w: view Watch) -> Str {
  match w.target {
    Node { return "alive"; }
    None { return "gone"; }
  }
}

/// The values of the first two nodes: nothing in the arms can let go of a
/// reference, so the field keeps what the matches read.
fn firstTwo(n: Node) -> int {
  match n.next {
    m: Node { return n.v + m.v; }
    None { return n.v; }
  }
}

/// Lets the whole list go: what the caller's match read loses its holder.
fn clear(l: List) -> int {
  l.head = None;
  return 0;
}

/// A match on l.head whose arm clears l: the node lives on in the match.
fn cleared(l: List, w: view Watch) -> Str {
  out = "";
  match l.head {
    n: Node {
      k = clear(l);
      out = n.name + " " + state(w);
      match n.next {
        m: Node { out = out + " " + m.name; }
        None { }
      }
    }
    None { }
  }
  return out;
}

/// x.next = x.next.next while a match holds x.next.
fn unlink(x: Node, w: view Watch) -> Str {
  match x.next {
    n: Node {
      x.next = n.next;
      return n.name + " " + state(w);
    }
    None { return "none"; }
  }
}

/// The names along a list.
fn names(x: Node) -> Str {
  match x.next {
    n: Node { return x.name + names(n); }
    None { return x.name; }
  }
}

class Bag {
  items: Node?[2];
}

/// Replaces the bag's first element.
fn swapIn(b: Bag) -> Str {
  b.items[0] = Node("new", 0, None);
  return "!";
}

/// A match on an element whose arm replaces it: the old one lives on in
/// the match.
fn element(b: Bag) -> Str {
  match b.items[0] {
    n: Node {
      s = swapIn(b);
      match b.items[0] {
        m: Node { return n.name + s + " " + m.name; }
        None { return "?"; }
      }
    }
    None { return "none"; }
  }
}

/// A match on a weak field: the reference the read makes holds the
/// binding.
fn weakName(w: view Watch) -> Str {
  match w.target {
    n: Node { return n.name + Str(n.v); }
    None { return "none"; }
  }
}

/// Sums the values along a list until one is 3, skipping the 2s.
fn walk(a: Node) -> Str {
  s = 0;
  terms = "";
  cur = a;
  last = 0;
  for _ in 0..10 {
    match cur.next {
      n: Node {
        last = n.v;
        if n.v == 3 { break; }
        cur = n;
        if n.v == 2 { continue; }
        terms = terms + (if s == 0 then "" else "+") + Str(n.v);
        s = s + n.v;
      }
      None { break; }
    }
  }
  return terms + "=" + Str(s) + " | stopped at " + Str(last);
}

/// The second node's value when it is positive, else 0.
fn early(a: Node) -> int {
  match a.next {
    n: Node {
      if n.v > 0 { return n.v; }
    }
    None { }
  }
  return 0;
}

fn main() -> int {
  b = Node("b", 2, None);
  wb = Watch(b);
  a = Node("a", 1, b);
  io::println("no call: " + Str(firstTwo(a)) + " | " + a.name + "'s next "
      + state(wb));

  c = Node("c", 3, None);
  wc = Watch(c);
  l = List(Node("a", 1, Node("b", 2, c)));
  io::println("cleared: " + cleared(l, wc) + " | after: " + state(wc));

  y = Node("y", 2, Node("z", 3, None));
  wy = Watch(y);
  x = Node("x", 1, y);
  io::println("unlinked: " + unlink(x, wy) + " | list: " + names(x) + " | y "
      + state(wy));

  old = Node("old", 0, None);
  wo = Watch(old);
  bag = Bag([old, None]);
  io::println("element: " + element(bag) + " | old " + state(wo));

  n = Node("w", 1, None);
  wn = Watch(n);
  io::print("weak: " + weakName(wn) + " of " + n.name);
  n = Node("other", 0, None);
  io::println(" | gone: " + weakName(wn) + ", " + n.name);

  list = Node("h", 0, Node("i", 1, Node("j", 2, Node("k", 4, Node("l", 3,
      Node("m", 5, None))))));
  io::println("walk: " + walk(list));

  e = Node("e", 0, Node("f", 2, None));
  g = Node("g", 0, Node("h", -1, None));
  we = Watch(e);
  io::println("early: " + Str(early(e)) + " | " + Str(early(g)) + " | "
      + e.name + " " + state(we));
  return 0;
}
