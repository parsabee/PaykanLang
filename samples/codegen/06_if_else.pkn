// 06 — if / else control flow
// Exercises: visitIfStmt (no-else, with-else, nested, chains),
//            early return inside if, Str vars in branches (scope cleanup)

import ::io;

fn sign(n: int) -> int {
  if n > 0 { return 1; }
  if n < 0 { return 0 - 1; }
  return 0;
}

fn fizzbuzz(n: int) -> Str {
  if n % 15 == 0 { return "FizzBuzz"; }
  if n % 3 == 0 { return "Fizz"; }
  if n % 5 == 0 { return "Buzz"; }
  return Str<int>(n);
}

fn main() -> int {
  io::println("=== if no-else ===");
  x: int = 5;
  if x > 0 {
    io::println("positive");   // printed
  }
  if x < 0 {
    io::println("negative");   // NOT printed
  }
  io::println("after");        // printed

  io::println("=== if-else ===");
  if x == 5 {
    io::println("is five");
  } else {
    io::println("not five");
  }

  io::println("=== if-else-if chain ===");
  v: int = 42;
  if v > 100 {
    io::println("large");
  } elif v > 50 {
    io::println("medium");
  } elif v > 10 {
    io::println("small");       // printed
  } else {
    io::println("tiny");
  }

  io::println("=== nested if ===");
  a: int = 3;
  b: int = 7;
  if a < b {
    if a > 0 {
      io::println("a: positive and less than b");  // printed
    } else {
      io::println("a: non-positive");
    }
  }

  io::println("=== if with complex condition ===");
  p: int = 8;
  if p > 0 && p % 2 == 0 {
    io::println("even positive");   // printed
  }
  if p < 0 || p > 100 {
    io::println("out of range");    // NOT printed
  }

  io::println("=== early return from function ===");
  io::println(Str(sign(10)));    //  1
  io::println(Str<int>(sign(0 - 3))); // -1
  io::println(Str(sign(0)));     //  0

  io::println("=== str vars inside branches (scope cleanup) ===");
  flag: bool = True;
  if flag {
    msg: Str = "branch_true";
    io::println(msg);
  } else {
    msg: Str = "branch_false";
    io::println(msg);
  }
  if !flag {
    msg: Str = "branch_true";
    io::println(msg);
  } else {
    msg: Str = "branch_false";
    io::println(msg);
  }

  io::println("=== fizzbuzz 1-15 ===");
  i: int = 1;
  while i <= 15 {
    io::println(fizzbuzz(i));
    i = i + 1;
  }

  return 0;
}
