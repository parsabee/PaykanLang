// 06 — if / else control flow
// Exercises: visitIfStmt (no-else, with-else, nested, chains),
//            early return inside if, Str vars in branches (scope cleanup)

fn sign(n: int) -> int {
  if (n > 0) { return 1; }
  if (n < 0) { return 0 - 1; }
  return 0;
}

fn fizzbuzz(n: int) -> Str {
  if (n % 15 == 0) { return "FizzBuzz"; }
  if (n % 3  == 0) { return "Fizz"; }
  if (n % 5  == 0) { return "Buzz"; }
  return StringInt(n);
}

fn main() -> int {
  out("=== if no-else ===");
  x: int = 5;
  if (x > 0) {
    out("positive");   // printed
  }
  if (x < 0) {
    out("negative");   // NOT printed
  }
  out("after");        // printed

  out("=== if-else ===");
  if (x == 5) {
    out("is five");
  } else {
    out("not five");
  }

  out("=== if-else-if chain ===");
  v: int = 42;
  if (v > 100) {
    out("large");
  } else if (v > 50) {
    out("medium");
  } else if (v > 10) {
    out("small");       // printed
  } else {
    out("tiny");
  }

  out("=== nested if ===");
  a: int = 3;
  b: int = 7;
  if (a < b) {
    if (a > 0) {
      out("a: positive and less than b");  // printed
    } else {
      out("a: non-positive");
    }
  }

  out("=== if with complex condition ===");
  p: int = 8;
  if (p > 0 && p % 2 == 0) {
    out("even positive");   // printed
  }
  if (p < 0 || p > 100) {
    out("out of range");    // NOT printed
  }

  out("=== early return from function ===");
  out(StringInt(sign(10)));    //  1
  out(StringInt(sign(0 - 3))); // -1
  out(StringInt(sign(0)));     //  0

  out("=== str vars inside branches (scope cleanup) ===");
  flag: bool = True;
  if (flag) {
    msg: Str = "branch_true";
    out(msg);
  } else {
    msg: Str = "branch_false";
    out(msg);
  }
  if (!flag) {
    msg: Str = "branch_true";
    out(msg);
  } else {
    msg: Str = "branch_false";
    out(msg);
  }

  out("=== fizzbuzz 1-15 ===");
  i: int = 1;
  while (i <= 15) {
    out(fizzbuzz(i));
    i = i + 1;
  }

  return 0;
}
