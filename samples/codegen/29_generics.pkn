// 29 — generics: generic classes and functions by monomorphisation
// Exercises: `class Box<T>` / `class Pair<K, V>` / `class Stack<T>` templates
//            instantiated per type-argument tuple (Box<int>, Box<Str>,
//            Box<Box<int>>, Pair<Str, int>, Stack<Str>), a generic free
//            function `first<T>` with explicit and inferred type arguments,
//            constructor-argument inference (`Box(5)`), an instantiation as a
//            field / parameter / return / array element type, `match` on an
//            instantiation, an instantiation cloned (`impl Cloneable for
//            Box<T>`) and one moved into a new local, and `==` via `equals`.

import ::io;

class Box<T> {
  v: T;
  view fn get() -> view T { return self.v; }
  fn set(v: T)            { self.v = move v; }
  view fn equals(other: Obj) -> bool {
    match other {
      o: Box<T> {
        return o.get() == self.v;
      }
      _ { return False; }
    }
  }
}

impl Cloneable for Box<T> {}

impl Box<T> {
  fn __init__(v: T) { self.v = move v; }
}

class Pair<K, V: Copyable> {
  k: K;
  v: V;
  view fn key() -> view K { return self.k; }
  view fn value() -> V    { return self.v; }
}

impl Pair<K, V> {
  fn __init__(k: K, v: V) { self.k = move k; self.v = move v; }
}

class Stack<T> {
  items: T[4];
  count: int;
  fn push(v: T) {
    self.items[self.count] = move v;
    self.count = self.count + 1;
  }
  fn pop() -> T {
    self.count = self.count - 1;
    return self.items[self.count].clone();
  }
  view fn empty() -> bool { return self.count == 0; }
}

impl Stack<T> {
  // Up to four items; each free slot holds its own clone of `blank`.
  fn __init__(blank: T) { self.items = [blank.clone(); 4]; self.count = 0; }
}

class Holder {
  b: Box<int>;
  view fn get() -> view Box<int> { return self.b; }
}

impl Holder {
  fn __init__(n: int) { self.b = Box<int>(n); }
}

fn first<T>(xs: view T[]) -> view T {
  return xs[0];
}

fn unbox<T: Copyable>(b: Box<T>) -> T {
  return b.get();
}

fn describe(o: view Obj) -> Str {
  match o {
    b: Box<int> {
      return "Box<int> holding " + Str<int>(b.get());
    }
    Box<Str> { return "Box<Str>"; }
    _ {
      return "something else";
    }
  }
}

fn main() -> int {
  let bi = Box<int>(3);                        // explicit type argument
  io::println(Str(bi.get()));                  // 3
  let bs: mut = Box<Str>("hello");
  bs.set("world");
  io::println(bs.get());                          // world

  let p = Pair<Str, int>("age", 42);
  io::println(p.key() + "=" + Str<int>(p.value()));  // age=42

  let bb = Box<Box<int>>(bi.clone());          // nested instantiation
  io::println(Str(bb.get().get()));            // 3

  let s: mut = Stack<Str>("");
  s.push("a");
  s.push("b");
  while !s.empty() {
    io::println(s.pop());
  }  // b, a

  io::println(Str<int>(first([10, 20])));  // 10   (T inferred as int)
  io::println(first<Str>(["x", "y"]));            // x    (explicit)
  io::println(Str(unbox(Box<int>(7))));        // 7    (T inferred through Box<T>)

  let inferred = Box(5);                      // constructor-argument inference
  io::println(Str<int>(inferred.get()));            // 5

  let h = Holder(40);                          // instantiation as a field type
  io::println(Str(h.get().get() + 2));         // 42

  let arr: Box<int>[2] = [Box<int>(1), Box<int>(2)];
  io::println(Str<int>(arr[1].get()));              // 2

  io::println(describe(bi));                      // Box<int> holding 3
  io::println(describe(bs));                      // Box<Str>
  io::println(describe(p));                       // something else

  io::println(Str(bi == Box<int>(3)));        // True  (== dispatches to equals)
  io::println(Str<bool>(bi == Box<int>(4)));  // False

  let alias: Box<int> = move bi;             // takes the box over
  io::println(Str(alias.get()));               // 3
  return 0;
}
