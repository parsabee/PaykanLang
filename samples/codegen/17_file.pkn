// 17_file.pkn — File builtin type: open, write, readln, equals, toString
// Exercises: open() returning Obj (File on success, Error on failure),
//            File.write(), File.readln() returning Obj (Str or None),
//            File.toString(), File.equals(), destroy on scope exit.

fn writelines(path: Str) -> int {
  match open(path, "w") {
    err: Error { printerrln("writelines: " + err.toString()); return 1; }
    f: File {
      f.write("line one\n");
      f.write("line two\n");
      f.write("line three\n");
    }
  }
  return 0;
}

fn readlines(path: Str) -> int {
  match open(path, "r") {
    err: Error { printerrln("readlines: " + err.toString()); return 1; }
    f: File {
      while (True) {
        match f.readln() {
          line: Str { print(line); }
          _          { break; }
        }
      }
    }
  }
  return 0;
}

fn showToString(path: Str) {
  match open(path, "r") {
    err: Error { printerrln("showToString: " + err.toString()); }
    f: File {
      s: Str = f.toString();
      println(s);   // File@0x...
    }
  }
}

fn showEquals(path: Str) {
  match open(path, "r") {
    err: Error { printerrln("showEquals: " + err.toString()); }
    f: File {
      match open(path, "r") {
        err2: Error { printerrln("showEquals inner: " + err2.toString()); }
        g: File {
          eq: bool = f.equals(g);
          println(StrBool(eq));  // False — different handles
        }
      }
    }
  }
}

fn main() -> int {
  path: Str = "/tmp/paykan_sample_17.txt";

  // --- 1. open for writing, write lines ------------------------------------
  println("=== write lines ===");
  writelines(path);

  // --- 2. open for reading, read lines back --------------------------------
  println("=== read lines ===");
  readlines(path);

  // --- 3. toString shows File@ prefix --------------------------------------
  println("=== toString ===");
  showToString(path);

  // --- 4. equals: identity -------------------------------------------------
  println("=== equals ===");
  showEquals(path);

  // --- 5. open nonexistent file — Error arm prints message -----------------
  println("=== open failure ===");
  match open("/no/such/file_sample_17.txt", "r") {
    err: Error { println("error: " + err.toString()); }
    _          { println("unexpected success"); }
  }

  return 0;
}
