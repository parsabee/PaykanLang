// 17_file.pkn — io::File: open, write, readln, equals, toString
// Exercises: io::open() returning a res::Result<io::File, err::Error> (`Ok`
//            with the file on success, `Err` with the error on failure),
//            File.write(), File.readln() returning a Result too (`Err` at
//            the end), File.toString(), File.equals(), the file closed when
//            the last reference goes.
//
// args: {tmpdir}

import ::error as err;
import ::io;

// The path of the scratch file `name`: in the first argument's directory
// (the samples harnesses pass a fresh one per run, `// args: {tmpdir}`, so
// parallel runs never share a file), else in /tmp.
fn scratchPath(args: view Str[], name: Str) -> Str {
  if args.len() > 1 {
    return args[1] + "/" + name;
  }
  return "/tmp/" + name;
}

fn writelines(path: Str) -> int {
  match io::open(path, "w") {
    w: Ok {
      let f = w.value;
      f.write("line one\n");
      f.write("line two\n");
      f.write("line three\n");
    }
    e: Err {
      io::printerrln("writelines: " + e.error.message());
      return 1;
    }
  }
  return 0;
}

fn readlines(path: Str) -> int {
  match io::open(path, "r") {
    e: Err {
      io::printerrln("readlines: " + e.error.message());
      return 1;
    }
    r: Ok {
      while True {
        match r.value.readln() {
          line: Ok { io::print(line.value); }
          _ { break; }
        }
      }
    }
  }
  return 0;
}

fn showToString(path: Str) {
  match io::open(path, "r") {
    e: Err {
      io::printerrln("showToString: " + e.error.message());
    }
    r: Ok {
      let s: Str = r.value.toString();
      io::println(s);   // File@0x...
    }
  }
}

fn showEquals(path: Str) {
  match io::open(path, "r") {
    e: Err {
      io::printerrln("showEquals: " + e.error.message());
    }
    r: Ok {
      match io::open(path, "r") {
        e2: Err {
          io::printerrln("showEquals inner: " + e2.error.message());
        }
        r2: Ok {
          let eq: bool = r.value.equals(r2.value);
          io::println(Str<bool>(eq));  // False — different handles
        }
      }
    }
  }
}

fn main(args: view Str[]) -> int {
  let path: Str = scratchPath(args, "paykan_sample_17.txt");

  // --- 1. open for writing, write lines ------------------------------------
  io::println("=== write lines ===");
  writelines(path);

  // --- 2. open for reading, read lines back --------------------------------
  io::println("=== read lines ===");
  readlines(path);

  // --- 3. toString shows File@ prefix --------------------------------------
  io::println("=== toString ===");
  showToString(path);

  // --- 4. equals: identity -------------------------------------------------
  io::println("=== equals ===");
  showEquals(path);

  // --- 5. open nonexistent file — the result's error says why --------------
  io::println("=== open failure ===");
  match io::open("/no/such/file_sample_17.txt", "r") {
    e: Err {
      io::println("error: " + err::name(e.error.code) + ": "
          + e.error.message());
    }
    _ {
      io::println("unexpected success");
    }
  }

  return 0;
}
