// 17_file.pkn — io::File: open, write, readln, equals, toString
// Exercises: io::open() returning an error::Result<io::File> (its value on
//            success, its error on failure), File.write(), File.readln()
//            returning a Str? (None at the end), File.toString(),
//            File.equals(), the file closed when the last reference goes.
//
// args: {tmpdir}

import ::result as res;
import ::io;

// The path of the scratch file `name`: in the first argument's directory
// (the samples harnesses pass a fresh one per run, `// args: {tmpdir}`, so
// parallel runs never share a file), else in /tmp.
fn scratchPath(args: view Str[], name: Str) -> Str {
  if args.len() > 1 {
    return args[1] + "/" + name;
  }
  return "/tmp/" + name;
}

fn writelines(path: Str) -> int {
  r = io::open(path, "w");
  match r.value {
    f: io::File {
      f.write("line one\n");
      f.write("line two\n");
      f.write("line three\n");
    }
    None {
      io::printerrln("writelines: " + r.error.message());
      return 1;
    }
  }
  return 0;
}

fn readlines(path: Str) -> int {
  r = io::open(path, "r");
  match r.value {
    None {
      io::printerrln("readlines: " + r.error.message());
      return 1;
    }
    f: io::File {
      while True {
        match f.readln().value {
          line: Str { io::print(line); }
          _ { break; }
        }
      }
    }
  }
  return 0;
}

fn showToString(path: Str) {
  r = io::open(path, "r");
  match r.value {
    None {
      io::printerrln("showToString: " + r.error.message());
    }
    f: io::File {
      s: Str = f.toString();
      io::println(s);   // File@0x...
    }
  }
}

fn showEquals(path: Str) {
  r = io::open(path, "r");
  match r.value {
    None {
      io::printerrln("showEquals: " + r.error.message());
    }
    f: io::File {
      r2 = io::open(path, "r");
      match r2.value {
        None {
          io::printerrln("showEquals inner: " + r2.error.message());
        }
        g: io::File {
          eq: bool = f.equals(g);
          io::println(Str<bool>(eq));  // False — different handles
        }
      }
    }
  }
}

fn main(args: view Str[]) -> int {
  path: Str = scratchPath(args, "paykan_sample_17.txt");

  // --- 1. open for writing, write lines ------------------------------------
  io::println("=== write lines ===");
  writelines(path);

  // --- 2. open for reading, read lines back --------------------------------
  io::println("=== read lines ===");
  readlines(path);

  // --- 3. toString shows File@ prefix --------------------------------------
  io::println("=== toString ===");
  showToString(path);

  // --- 4. equals: identity -------------------------------------------------
  io::println("=== equals ===");
  showEquals(path);

  // --- 5. open nonexistent file — the result's error says why --------------
  io::println("=== open failure ===");
  failed = io::open("/no/such/file_sample_17.txt", "r");
  match failed.value {
    None {
      io::println("error: " + res::name(failed.error.code) + ": "
          + failed.error.message());
    }
    _ {
      io::println("unexpected success");
    }
  }

  return 0;
}
