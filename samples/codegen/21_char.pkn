// Sample 21 — char primitive type
//
// char is an 8-bit primitive (i8 in LLVM). char literals use single quotes.
// Escape sequences supported: \n \t \r \\ \'  \0
// Str<char>(c: char) -> Str converts a char to a one-character string.
// Comparison operators ==, !=, <, >, <=, >= are supported.

import ::io;

fn main() -> int {
  // Basic literal and Str<char> conversion
  c: char = 'A';
  io::println(Str<char>(c));                 // A

  // Escape sequences
  io::println("tab:" + Str('\t') + "end");
  io::println("newline before:");
  io::println(Str<char>('\n') + "newline after");

  // Comparison
  lo: char = 'a';
  hi: char = 'z';
  if lo < hi { io::println("a < z"); }
  if lo != hi { io::println("a != z"); }
  if lo == lo { io::println("a == a"); }
  if hi > lo { io::println("z > a"); }

  // char in a variable used multiple times
  sep: char = '-';
  io::println(Str(sep) + Str<char>(sep) + Str(sep));  // ---

  return 0;
}
