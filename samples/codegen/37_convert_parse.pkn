// 37 — parsing with toInt() and toFloat() (#64)
// Exercises: `s.toInt()` -> `int?` and `s.toFloat()` -> `float?`, which
//            are None for an invalid string; unwrapping with `match` (the arm
//            binds a plain int / float), `!= None`, the int64 limits, what
//            counts as invalid (whitespace, trailing junk, overflow) and the
//            special float spellings.
//
// expect-stdout: sum of the valid numbers: 60 (2 invalid)
// expect-stdout: -9223372036854775808 is the smallest int
// expect-stdout: 9223372036854775808 is not an int
// expect-stdout: ' 7' is not an int
// expect-stdout: '7 ' is not an int
// expect-stdout: '+7' is 7
// expect-stdout: mean: 2.25
// expect-stdout: nan inf -0
// expect-stdout: '1e999' is not a float
// expect-stdout: None

import ::io;

fn describe(s: Str) -> Str {
  match s.toInt() {
    n: int {
      return "'" + s + "' is " + Str<int>(n);
    }
    None {
      return "'" + s + "' is not an int";
    }
  }
}

fn main() -> int {
  inputs: Str[5] = ["10", "x", "20", "", "30"];
  sum = 0;
  invalid = 0;
  i = 0;
  while i < inputs.len() {
    match inputs[i].toInt() {
      n: int { sum = sum + n; }
      None { invalid = invalid + 1; }
    }
    i = i + 1;
  }
  io::println("sum of the valid numbers: " + Str(sum) + " (" + Str<int>(invalid)
      + " invalid)");

  match "-9223372036854775808".toInt() {
    n: int {
      io::println(Str(n) + " is the smallest int");
    }
    None { }
  }
  if "9223372036854775808".toInt() == None {
    io::println("9223372036854775808 is not an int");
  }
  io::println(describe(" 7"));
  io::println(describe("7 "));
  io::println(describe("+7"));

  readings: Str[4] = ["1.5", "2", "bad", "3.25"];
  total = 0.0;
  count = 0;
  i = 0;
  while i < readings.len() {
    match readings[i].toFloat() {
      f: float {
        total = total + f;
        count = count + 1;
      }
      None { }
    }
    i = i + 1;
  }
  io::println("mean: " + Str<float>(total / float<int>(count)));

  out = "";
  specials: Str[3] = ["nan", "inf", "-0"];
  i = 0;
  while i < specials.len() {
    match specials[i].toFloat() {
      f: float { out = out + Str(f); }
      None { out = out + "?"; }
    }
    if i < 2 { out = out + " "; }
    i = i + 1;
  }
  io::println(out);
  if "1e999".toFloat() == None {
    io::println("'1e999' is not a float");
  }
  io::println("12abc".toInt());  // an int? prints as its value or None
  return 0;
}
