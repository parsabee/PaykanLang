// 64 — moves at last use: a reference handed on where a variable is last used
// Exercises: the compiler's transfers (docs/language/16-memory.md,
//            "Ownership transfers"; docs/pir.md §12): a variable passed,
//            assigned, stored in a field and returned at its last use; a
//            last use in one branch of an `if` and in some arms of a
//            `match` (the others release it); a use inside a loop (a copy)
//            and after it (a transfer); a variable reassigned after its
//            last use, in a loop too; `f(a, a)`; a parameter handed on;
//            `self` passed on and returned (never transferred); a lambda's
//            capture (always a copy); a hand-off followed by a field read
//            held across a call, and one in a method that uses `self`
//            after it (copies: the variable may be what keeps the read
//            object alive); a `view` parameter (never handed on).  The
//            `weak` references show when each object dies: with its last
//            holder, which after a transfer is the destination.
// expect-stdout: kept: a | alive
// expect-stdout: handed on: a | gone
// expect-stdout: then: b gone | else: c alive
// expect-stdout: arm 0: d gone | arm 1: e alive | arm 2: f gone
// expect-stdout: loop: g g g | after: g gone
// expect-stdout: reassigned: h i j | j alive
// expect-stdout: twice: k+k gone
// expect-stdout: field: alive | let go: gone
// expect-stdout: returned: m alive | dropped: m gone
// expect-stdout: self: n n | n alive
// expect-stdout: captured: o none | alive
// expect-stdout: field read: first1 first1!
// expect-stdout: method: one1 -> two2 | one1;
// expect-stdout: view: q alive | back in outer: alive | after: gone
// expect-stdout: weak local: p alive

import ::io;

class Node {
  name: Str;
}

class Holder {
  node: Node?;
}

impl Node {
  /// Hands `self` on, and returns it: both take a reference of their own.
  fn relay() -> Node { io::print(name(self) + " "); return self; }
}

/// What @p w refers to: "alive" or "gone".
fn state(w: view Watch) -> Str {
  match w.target {
    Node { return "alive"; }
    None { return "gone"; }
  }
}

class Watch {
  weak target: Node?;
}

class Slot {
  node: Node;
}

/// Gives @p s a new node, letting the old one go.
fn replace(s: Slot) -> Str {
  s.node = Node("other");
  return "!";
}

class Walker {
  at: Node;
  log: Str;
}

impl Walker {
  fn note(n: Node)      { self.log = self.log + n.name + ";"; }

  fn go(n: Node) -> Str { self.at = n; return " -> " + self.at.name; }

  /// Notes the current node, then moves on: `self` is used after `note`.
  fn step(next: Node) -> Str {
    let cur = self.at;
    self.note(cur);
    return self.at.name + self.go(next);
  }
}

fn inner(n: view Node, w: view Watch) -> Str {
  return n.name + " " + state(w);
}

/// A view: what it names lives as long as this function, also after it
/// passes the view on.
fn outer(n: view Node, w: view Watch) -> Str {
  let r = inner(n, w);
  return r + " | back in outer: " + state(w);
}

/// Takes @p n and lets it go when it returns.
fn name(n: Node) -> Str {
  return n.name;
}

fn both(a: Node, b: Node) -> Str {
  return a.name + "+" + b.name;
}

/// Hands its parameter on to `name`.
fn pass(n: Node) -> Str {
  return name(n);
}

/// `replace` lets the old node go while its name, read first, is still to
/// be used: the read takes a reference of its own, so `x`, which also holds
/// that node, need not keep it alive and is handed on to `name`.
fn fieldRead() -> Str {
  let sl = Slot(Node("first" + Str(1)));
  let x = sl.node;
  let took = name(x);
  let got = sl.node.name + replace(sl);
  return took + " " + got;
}

/// A view parameter keeps what it names until its function returns.
fn viewed() -> Str {
  let q = Node("q");
  let wq = Watch(q);
  return outer(q, wq) + " | after: " + state(wq);
}

/// A new node, returned from a local.
fn make(s: Str) -> Node {
  let n = Node(s);
  return n;
}

fn main() -> int {
  // Read afterwards: a copy.  Not read afterwards: handed on.
  let a = Node("a");
  let w = Watch(a);
  io::println("kept: " + name(a) + " | " + state(w));
  io::println("handed on: " + name(a) + " | " + state(w));

  // One branch hands the variable on; the other releases it at the end of
  // the scope, as before.
  for k in 0..2 {
    let v = Node(if k == 0 then "b" else "c");
    let wv = Watch(v);
    if k == 0 {
      io::print("then: " + name(v));
    } else {
      io::print(" | else: " + v.name);
    }
    io::print(" " + state(wv));
  }
  io::println("");

  // Some arms of a match hand it on.
  for k in 0..3 {
    let m = Node(if k == 0 then "d" else if k == 1 then "e" else "f");
    let wm = Watch(m);
    out = "";
    match k {
      0 { out = name(m); }
      1 { out = m.name; }
      _ { out = pass(m); }
    }
    io::print((if k == 0 then "" else " | ") + "arm " + Str(k) + ": " + out
        + " " + state(wm));
  }
  io::println("");

  // A use inside a loop is a copy: the next iteration reads it again.
  let g = Node("g");
  let wg = Watch(g);
  io::print("loop:");
  for _ in 0..3 {
    io::print(" " + name(g));
  }
  io::println(" | after: " + name(g) + " " + state(wg));

  // Reassigned after its last use, before the next iteration reads it:
  // each value is handed on in turn.
  r = Node("h");
  io::print("reassigned:");
  for i in 0..2 {
    io::print(" " + name(r));
    r = Node(if i == 0 then "i" else "j");
  }
  let wr = Watch(r);
  io::println(" " + r.name + " | " + r.name + " " + state(wr));

  // f(a, a): the first is a copy, the second the transfer.
  let t = Node("k");
  let wt = Watch(t);
  io::println("twice: " + both(t, t) + " " + state(wt));

  // Stored in a field at its last use: the holder holds it now, and it
  // dies when the holder lets go.
  let f = Node("l");
  let wf = Watch(f);
  h = Holder(f);
  io::print("field: " + state(wf));
  h = Holder(None);
  io::println(" | let go: " + state(wf));

  // Returned from a local, then dropped at its last use.
  let made = make("m");
  let wmade = Watch(made);
  io::print("returned: " + made.name + " " + state(wmade));
  io::println(" | dropped: " + name(made) + " " + state(wmade));

  // `self` is never handed on: the caller's reference keeps it alive.
  let s = Node("n");
  let ws = Watch(s);
  io::print("self: ");
  let back = s.relay();
  io::println(back.name + " | " + back.name + " " + state(ws));

  // A capture is a copy, even at the variable's last use: dropping the
  // closure leaves the variable's own reference.
  let c = Node("o");
  let wc = Watch(c);
  get = fn() -> Str { return c.name; };
  io::print("captured: " + get());
  get = fn() -> Str { return "none"; };
  io::println(" " + get() + " | " + state(wc));

  // In functions of their own: a field read held across a call after a
  // hand-off keeps every hand-off before it, to the variable's release, a
  // copy.
  io::println("field read: " + fieldRead());
  let wk = Walker(Node("one" + Str(1)), "");
  io::println("method: " + wk.step(Node("two" + Str(2))) + " | " + wk.log);
  io::println("view: " + viewed());

  // A weak local made from the variable itself keeps a hand-off in its
  // scope a copy, read or not: it reads the object until the variable's
  // scope ends.
  let p = Node("p");
  weak wp = p;
  io::print("weak local: " + name(p));
  match wp {
    Node { io::println(" alive"); }
    None { io::println(" gone"); }
  }
  return 0;
}
