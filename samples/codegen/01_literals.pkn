// 01 — Literals: integer, float, bool, string, None
// Exercises: visitIntegerLiteral, visitFloatLiteral, visitBoolLiteral,
//            visitStringLiteral, visitNoneLiteral, wrapStringLiteral

fn main() -> int {
  // ---- Integer literals ----------------------------------------------------
  a: int = 0;
  b: int = 1;
  c: int = 42;
  d: int = 9223372036854775807;              // INT64_MAX
  neg: int = 0 - 2147483648;                 // large negative via unary-minus at runtime
  println("int 0:    " + Str<int>(a));
  println("int 1:    " + Str(b));
  println("int 42:   " + Str<int>(c));
  println("INT64_MAX:" + Str(d));
  println("neg large:" + Str<int>(neg));

  // ---- Float literals -------------------------------------------------------
  f0: float = 0.0;
  f1: float = 1.0;
  pi: float = 3.14159;
  neg_f: float = 0.0 - 2.718;
  println("float 0:  " + Str(f0));
  println("float 1:  " + Str<float>(f1));
  println("pi:       " + Str(pi));
  println("neg float:" + Str<float>(neg_f));

  // ---- Bool literals --------------------------------------------------------
  t: bool = True;
  f: bool = False;
  println("True:     " + Str(t));
  println("False:    " + Str<bool>(f));

  // ---- String literals -------------------------------------------------------
  // Direct literal passed to println()
  println("raw literal");
  // Assigned to a Str variable (exercises VarDecl shared-box path)
  s: Str = "hello world";
  println(s);
  // Empty string
  empty: Str = "";
  println("empty='" + empty + "'");

  // ---- None literal ---------------------------------------------------------
  // None is an unowned class var; just declaring it must not crash.
  n: Obj = None;
  println("none decl ok");

  return 0;
}
