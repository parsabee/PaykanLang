// 01 — Literals: integer, float, bool, string, None
// Exercises: visitIntegerLiteral, visitFloatLiteral, visitBoolLiteral,
//            visitStringLiteral, visitNoneLiteral, wrapStringLiteral

fn main() -> int {
  // ---- Integer literals ----------------------------------------------------
  a: int = 0;
  b: int = 1;
  c: int = 42;
  d: int = 9223372036854775807;   // INT64_MAX
  neg: int = 0 - 2147483648;     // large negative via unary-minus at runtime
  println("int 0:    ", StrInt(a));
  println("int 1:    ", StrInt(b));
  println("int 42:   ", StrInt(c));
  println("INT64_MAX:", StrInt(d));
  println("neg large:", StrInt(neg));

  // ---- Float literals -------------------------------------------------------
  f0: float = 0.0;
  f1: float = 1.0;
  pi: float = 3.14159;
  neg_f: float = 0.0 - 2.718;
  println("float 0:  ", StrFloat(f0));
  println("float 1:  ", StrFloat(f1));
  println("pi:       ", StrFloat(pi));
  println("neg float:", StrFloat(neg_f));

  // ---- Bool literals --------------------------------------------------------
  t: bool = True;
  f: bool = False;
  println("True:     ", StrBool(t));
  println("False:    ", StrBool(f));

  // ---- String literals -------------------------------------------------------
  // Direct literal passed to println()
  println("raw literal");
  // Assigned to a Str variable (exercises VarDecl shared-box path)
  s: Str = "hello world";
  println(s);
  // Empty string
  empty: Str = "";
  println("empty='", empty, "'");

  // ---- None literal ---------------------------------------------------------
  // None is an unowned class var; just declaring it must not crash.
  n: Obj = None;
  println("none decl ok");

  return 0;
}
