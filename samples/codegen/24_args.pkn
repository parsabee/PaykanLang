// Sample 24 — Command-line arguments
//
// main now accepts an optional args: Str[] parameter.
// args[0] is always the script path.
// args[1..] are the arguments passed after the source file on the command line.
//
// Usage:
//   ./build/bin/paykan samples/codegen/24_args.pkn hello world 42

fn main(args: Str[]) -> int {
  println("argc: " + Str<int>(args.len()));
  i: int = 0;
  while (i < args.len()) {
    println("  args[" + Str(i) + "] = " + args[i]);
    i = i + 1;
  }
  return 0;
}
