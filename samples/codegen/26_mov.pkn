// 26 — mov: ownership-transfer move expression
// Exercises: MovExpr lowering (ExprEmitter::visitMovExpr),
//            primitive register forwarding, object box transfer with the
//            source alloca nulled (no extra retain, no scope-exit release),
//            move of a temporary, move into a call argument, move out of a
//            return, and re-assignment reviving a moved variable.
//
// `mov <expr>` transfers ownership instead of copying/sharing.  A moved local
// variable is consumed: it may not be read again until re-assigned.

// ---- Helpers ---------------------------------------------------------------

fn shout(s: Str) -> Str {
  return s + "!";
}

// Moves its parameter straight back out — the caller's argument reference is
// forwarded through without an extra retain/release round-trip.
fn relay(s: Str) -> Str {
  return mov s;
}

class Point {
  x: int;
  y: int;
  fn __init__(a: int, b: int) {
    self.x = a;
    self.y = b;
  }
  fn sum() -> int {
    return self.x + self.y;
  }
}

// ---- main ------------------------------------------------------------------

fn main() -> int {
  println("=== move a primitive (register forward) ===");
  a: int = 42;
  b = mov a;
  println(StrInt(b));            // 42
  // a is consumed here; reading it would be a compile error.

  println("=== move a string (ownership transfer) ===");
  s: Str = "Hello world";
  t = mov s;
  println(t);                   // Hello world

  println("=== move a temporary into a variable ===");
  u = mov shout("made");
  println(u);                   // made!

  println("=== move a class object ===");
  p: Point = Point(3, 4);
  q = mov p;
  println(StrInt(q.sum()));     // 7

  println("=== move into a function argument ===");
  loud: Str = "loud";
  println(shout(mov loud));     // loud!

  println("=== move out of a function return ===");
  out: Str = relay("relayed");
  println(out);                 // relayed

  println("=== re-assignment revives a moved variable ===");
  name: Str = "first";
  taken = mov name;
  name = "second";              // revives name
  println(taken);               // first
  println(name);                // second

  println("=== conditional move (branch-safe cleanup) ===");
  msg: Str = "conditional";
  if (True) {
    moved = mov msg;
    println(moved);             // conditional
  }

  return 0;
}
