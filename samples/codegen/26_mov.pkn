// 26 — ownership transfer: handing a reference on
// Exercises: primitive copies, sharing a string and a class object, a
//            temporary stored in a variable, an argument passed through a
//            function and back out of its return, re-assignment after a
//            hand-off, and a hand-off inside a branch.
//
// These are the places `mov` marked by hand before it was retired (#145).
// Each now shares the reference; the output is unchanged.

// ---- Helpers ---------------------------------------------------------------

fn shout(s: Str) -> Str {
  return s + "!";
}

// Hands its parameter straight back out.
fn relay(s: Str) -> Str {
  return s;
}

class Point {
  x: int;
  y: int;
  fn __init__(a: int, b: int) {
    self.x = a;
    self.y = b;
  }
  fn sum() -> int {
    return self.x + self.y;
  }
}

// ---- main ------------------------------------------------------------------

fn main() -> int {
  println("=== copy a primitive ===");
  a: int = 42;
  b = a;
  println(Str<int>(b));         // 42

  println("=== share a string ===");
  s: Str = "Hello world";
  t = s;
  println(t);                   // Hello world

  println("=== store a temporary in a variable ===");
  u = shout("made");
  println(u);                   // made!

  println("=== share a class object ===");
  p: Point = Point(3, 4);
  q = p;
  println(Str(q.sum()));        // 7

  println("=== pass to a function argument ===");
  loud: Str = "loud";
  println(shout(loud));         // loud!

  println("=== pass through a function return ===");
  out: Str = relay("relayed");
  println(out);                 // relayed

  println("=== re-assign after a hand-off ===");
  name: Str = "first";
  taken = name;
  name = "second";
  println(taken);               // first
  println(name);                // second

  println("=== hand-off inside a branch ===");
  msg: Str = "conditional";
  if (True) {
    kept = msg;
    println(kept);              // conditional
  }

  return 0;
}
