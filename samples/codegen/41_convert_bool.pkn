// 41 — bool<Str> and parsing settings into optionals (#88)
// Exercises: int<Str> / float<Str> / bool<Str>, which parse into an
//            optional value (`int?` & co., None for an invalid string), and
//            Str<int> / Str<float> / Str<bool>, which format the unwrapped
//            value; bool<Str> accepts exactly "True" / "False" and so
//            round-trips Str<bool>.  Both spellings appear: the inferred
//            `Str(n)` (the specialization for the argument's exact type) and
//            the explicit `Str<int>(n)`.
//
// expect-stdout: int 42 | float 2.5 | bool True
// expect-stdout: 'yes' is not a bool
// expect-stdout: settings: 3 of 5 valid
// expect-stdout: retries=3 ratio=0.75 verbose=False
// expect-stdout: 'true' is not a bool
// expect-stdout: round trip: True False
// expect-stdout: None
// expect-stdout: None

import ::io;

fn describe(s: Str) -> Str {
  match int(s) {
    n: int {
      return "int " + Str<int>(n);
    }
    None { }
  }
  match float(s) {
    f: float {
      return "float " + Str(f);
    }
    None { }
  }
  match bool(s) {
    b: bool {
      return "bool " + Str<bool>(b);
    }
    None { }
  }
  return "?";
}

fn main() -> int {
  // Each string parses as the first type that accepts it.
  io::println(describe("42") + " | " + describe("2.5") + " | "
      + describe("True"));

  // Parsing settings by key.
  keys: Str[5] = ["retries", "ratio", "verbose", "color", "depth"];
  vals: Str[5] = ["3", "0.75", "False", "yes", "deep"];
  line = "";
  valid = 0;
  k = 0;
  while k < keys.len() {
    text = "";
    if keys[k] == "ratio" {
      match float<Str>(vals[k]) {
        x: float {
          text = Str<float>(x);
        }
        None { }
      }
    } elif keys[k] == "verbose" || keys[k] == "color" {
      match bool(vals[k]) {
        // bool<Str>
        x: bool { text = Str<bool>(x); }
        None { }
      }
      if text == "" {
        io::println("'" + vals[k] + "' is not a bool");
      }
    } else {
      match int(vals[k]) {
        x: int { text = Str(x); }
        None { }
      }
    }
    if text != "" {
      valid = valid + 1;
      if line != "" {
        line = line + " ";
      }
      line = line + keys[k] + "=" + text;
    }
    k = k + 1;
  }
  io::println("settings: " + Str<int>(valid) + " of " + Str<int>(keys.len())
      + " valid");
  io::println(line);

  // bool<Str> takes exactly the spellings Str<bool> prints.
  match bool<Str>("true") {
    v: bool {
      io::println("parsed " + Str<bool>(v));
    }
    None {
      io::println("'true' is not a bool");
    }
  }
  out = "round trip:";
  flags: bool[2] = [True, False];
  j = 0;
  while j < flags.len() {
    match bool(Str(flags[j])) {
      // bool<Str>(Str<bool>(...))
      v: bool {
        out = out + " " + Str<bool>(v);
      }
      None { out = out + " ?"; }
    }
    j = j + 1;
  }
  io::println(out);

  // A failed parse is None.
  missing: int? = int<Str>("4 2");
  io::println(missing);
  io::println(bool(""));
  return 0;
}
