// 27 — shared values in every operand position
// Exercises: a local variable handed on as a call argument, method-call
//            argument, constructor argument, array-literal element, ternary
//            branch, concatenation operand, and method receiver.  These were
//            `mov` positions before the keyword was retired (#145); each is
//            now an ordinary shared read.

class Box {
  v: Str;
  fn __init__(s: Str) {
    self.v = s;
  }
  fn get() -> Str {
    return self.v;
  }
  fn combine(other: Str) -> Str {
    return self.v + other;
  }
}

fn shout(s: Str) -> Str {
  return s + "!";
}

fn main() -> int {
  println("=== in a free-function argument ===");
  a: Str = "arg";
  println(shout(a));  // arg!

  println("=== in a method-call argument ===");
  b: Box = Box("base");
  tail: Str = "-tail";
  println(b.combine(tail));  // base-tail

  println("=== in a constructor argument ===");
  payload: Str = "boxed";
  b2: Box = Box(payload);
  println(b2.get());  // boxed

  println("=== in array-literal elements ===");
  e0: Str = "x";
  e1: Str = "y";
  arr: Str[] = [e0, e1];
  println(arr[0] + arr[1]);  // xy

  println("=== in ternary branches ===");
  left: Str = "yes";
  right: Str = "no";
  flag: bool = True;
  pick: Str = if flag then left else right;
  println(pick);  // yes

  println("=== as concatenation operands ===");
  h: Str = "hello ";
  w: Str = "world";
  joined: Str = h + w;
  println(joined);  // hello world

  println("=== as a method receiver ===");
  recv: Str = "receiver";
  len: int = recv.len();
  println(Str<int>(len));  // 8

  println("=== directly into println ===");
  d: Str = "direct";
  println(d);  // direct

  return 0;
}
