// 11 — Scope and lifetime: ScopeGuard, emitScopeCleanup, emitAllScopesCleanup
// Exercises: nested ScopeGuard LIFO cleanup, early return cleanup,
//            Str vars at different nesting depths all released exactly once,
//            loop scopes, if-else branch scopes, function scopes

fn innerWork(flag: bool) -> Str {
  // Str declared before the conditional return — must be released on BOTH paths.
  prefix: Str = "result";
  if (flag) {
    suffix: Str = "-yes";
    return prefix + suffix;                  // emitAllScopesCleanup releases prefix+suffix
  }
  return prefix + "-no";                     // emitAllScopesCleanup releases only prefix
}

fn multiReturn(n: int) -> int {
  a: Str = "a";
  if (n < 0)  { return 0 - 1; }
  b: Str = "b";
  if (n == 0) { return 0; }
  c: Str = "c";
  return n * 2;
}

fn main() -> int {
  println("=== simple nested scopes ===");
  s0: Str = "outer";
  if (True) {
    s1: Str = "inner1";
    if (True) {
      s2: Str = "inner2";
      println(s2);                           // inner2  — s2 released when this block ends
    }
    println(s1);                             // inner1  — s1 released when if block ends
  }
  println(s0);                               // outer   — s0 released at function end

  println("=== loop iteration scopes ===");
  // Each iteration creates a fresh Str; scope cleanup runs per iteration.
  i: int = 0;
  total: int = 0;
  while (i < 5) {
    x: Str = Str<int>(i);
    total = total + x.len();
    i = i + 1;
  }
  // "0".."4" each have length 1  ->  total = 5
  println(Str(total));                       // 5

  println("=== early return cleanup ===");
  println(innerWork(True));                  // result-yes
  println(innerWork(False));                 // result-no

  println("=== multi-level early return ===");
  println(Str<int>(multiReturn(0 - 5)));     // -1
  println(Str(multiReturn(0)));              //  0
  println(Str<int>(multiReturn(3)));         //  6

  println("=== deeply nested scopes ===");
  // 4 levels of if-nesting each with a Str var; all must be cleaned up.
  level0: Str = "L0";
  if (True) {
    level1: Str = "L1";
    if (True) {
      level2: Str = "L2";
      if (True) {
        level3: Str = "L3";
        println(level3);                     // L3
      }
      println(level2);                       // L2
    }
    println(level1);                         // L1
  }
  println(level0);                           // L0

  println("=== Str scope across reassign ===");
  // Rebinding releases the old box and installs a new one; original string
  // must already be destroyed by the time we rebind.
  r: Str = "first";
  r = "second";
  r = "third";
  println(r);                                // third

  println("=== scope stress: many short-lived Strs ===");
  j: int = 0;
  while (j < 10) {
    tmp: Str = "t" + Str(j);
    println(tmp);
    j = j + 1;
  }

  return 0;
}
