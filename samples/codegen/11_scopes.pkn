// 11 — Scope and lifetime: ScopeGuard, emitScopeCleanup, emitAllScopesCleanup
// Exercises: nested ScopeGuard LIFO cleanup, early return cleanup,
//            Str vars at different nesting depths all released exactly once,
//            loop scopes, if-else branch scopes, function scopes

import ::io;

fn innerWork(flag: bool) -> Str {
  // Str declared before the conditional return — must be released on BOTH paths.
  let prefix: Str = "result";
  if flag {
    let suffix: Str = "-yes";
    return prefix + suffix;   // emitAllScopesCleanup releases prefix+suffix
  }
  return prefix + "-no";      // emitAllScopesCleanup releases only prefix
}

fn multiReturn(n: int) -> int {
  let a: Str = "a";
  if n < 0 { return 0 - 1; }
  let b: Str = "b";
  if n == 0 { return 0; }
  let c: Str = "c";
  return n * 2;
}

fn main() -> int {
  io::println("=== simple nested scopes ===");
  let s0: Str = "outer";
  if True {
    let s1: Str = "inner1";
    if True {
      let s2: Str = "inner2";
      io::println(s2);        // inner2  — s2 released when this block ends
    }
    io::println(s1);          // inner1  — s1 released when if block ends
  }
  io::println(s0);            // outer   — s0 released at function end

  io::println("=== loop iteration scopes ===");
  // Each iteration creates a fresh Str; scope cleanup runs per iteration.
  i: int = 0;
  total: int = 0;
  while i < 5 {
    let x: Str = Str<int>(i);
    total = total + x.len();
    i = i + 1;
  }
  // "0".."4" each have length 1  ->  total = 5
  io::println(Str(total));   // 5

  io::println("=== early return cleanup ===");
  io::println(innerWork(True));    // result-yes
  io::println(innerWork(False));   // result-no

  io::println("=== multi-level early return ===");
  io::println(Str<int>(multiReturn(0 - 5)));  // -1
  io::println(Str(multiReturn(0)));      //  0
  io::println(Str<int>(multiReturn(3)));      //  6

  io::println("=== deeply nested scopes ===");
  // 4 levels of if-nesting each with a Str var; all must be cleaned up.
  let level0: Str = "L0";
  if True {
    let level1: Str = "L1";
    if True {
      let level2: Str = "L2";
      if True {
        let level3: Str = "L3";
        io::println(level3);    // L3
      }
      io::println(level2);      // L2
    }
    io::println(level1);        // L1
  }
  io::println(level0);          // L0

  io::println("=== Str scope across reassign ===");
  // Rebinding releases the old box and installs a new one; original string
  // must already be destroyed by the time we rebind.
  r: Str = "first";
  r = "second";
  r = "third";
  io::println(r);               // third

  io::println("=== scope stress: many short-lived Strs ===");
  j: int = 0;
  while j < 10 {
    let tmp: Str = "t" + Str(j);
    io::println(tmp);
    j = j + 1;
  }

  return 0;
}
