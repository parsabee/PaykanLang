// 11 — Scope and lifetime: ScopeGuard, emitScopeCleanup, emitAllScopesCleanup
// Exercises: nested ScopeGuard LIFO cleanup, early return cleanup,
//            Str vars at different nesting depths all released exactly once,
//            loop scopes, if-else branch scopes, function scopes

fn innerWork(flag: bool) -> Str {
  // Str declared before the conditional return — must be released on BOTH paths.
  prefix: Str = "result";
  if (flag) {
    suffix: Str = "-yes";
    return prefix + suffix;   // emitAllScopesCleanup releases prefix+suffix
  }
  return prefix + "-no";      // emitAllScopesCleanup releases only prefix
}

fn multiReturn(n: int) -> int {
  a: Str = "a";
  if (n < 0)  { return 0 - 1; }
  b: Str = "b";
  if (n == 0) { return 0; }
  c: Str = "c";
  return n * 2;
}

fn main() -> int {
  out("=== simple nested scopes ===");
  s0: Str = "outer";
  if (True) {
    s1: Str = "inner1";
    if (True) {
      s2: Str = "inner2";
      out(s2);        // inner2  — s2 released when this block ends
    }
    out(s1);          // inner1  — s1 released when if block ends
  }
  out(s0);            // outer   — s0 released at function end

  out("=== loop iteration scopes ===");
  // Each iteration creates a fresh Str; scope cleanup runs per iteration.
  i: int = 0;
  total: int = 0;
  while (i < 5) {
    x: Str = StringInt(i);
    total = total + x.length();
    i = i + 1;
  }
  // "0".."4" each have length 1  →  total = 5
  out(StringInt(total));   // 5

  out("=== early return cleanup ===");
  out(innerWork(True));    // result-yes
  out(innerWork(False));   // result-no

  out("=== multi-level early return ===");
  out(StringInt(multiReturn(0 - 5)));  // -1
  out(StringInt(multiReturn(0)));      //  0
  out(StringInt(multiReturn(3)));      //  6

  out("=== deeply nested scopes ===");
  // 4 levels of if-nesting each with a Str var; all must be cleaned up.
  level0: Str = "L0";
  if (True) {
    level1: Str = "L1";
    if (True) {
      level2: Str = "L2";
      if (True) {
        level3: Str = "L3";
        out(level3);    // L3
      }
      out(level2);      // L2
    }
    out(level1);        // L1
  }
  out(level0);          // L0

  out("=== Str scope across reassign ===");
  // Rebinding releases the old box and installs a new one; original string
  // must already be destroyed by the time we rebind.
  r: Str = "first";
  r = "second";
  r = "third";
  out(r);               // third

  out("=== scope stress: many short-lived Strs ===");
  j: int = 0;
  while (j < 10) {
    tmp: Str = "t" + StringInt(j);
    out(tmp);
    j = j + 1;
  }

  return 0;
}
