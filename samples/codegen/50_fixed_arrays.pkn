// 50 — fixed-size arrays (docs/language/09-arrays.md).  `T[n]` holds n
// elements inline: it is a value, so copying it copies its elements.  An
// array of arrays puts its first length on its first index: `int[2][3]` is
// two `int[3]`s.
// Exercises: arrays of int, float, char, an enum and Str, a copy changed
// apart from its source, an assigned literal reading the old value, a 2D
// grid walked with len(), an `inout` local.  Run with --track-heap: zero
// live blocks.

import ::io;

// expect-stdout: before 1 2 3, copy 10 2 3
// expect-stdout: rotated 3 1 2
// expect-stdout: 1 2 3 = 6
// expect-stdout: 4 5 6 = 15
// expect-stdout: corner 600, mean 2.5, hi, west
// expect-stdout: cy dee 3

enum Dir { North, West }

fn main() -> int {
  xs: int[3] = [1, 2, 3];
  copy = xs;
  copy[0] = 10;
  io::println("before " + Str(xs[0]) + " " + Str(xs[1]) + " " + Str(xs[2])
      + ", copy " + Str(copy[0]) + " " + Str(copy[1]) + " " + Str(copy[2]));

  xs = [xs[2], xs[0], xs[1]];
  io::println("rotated " + Str(xs[0]) + " " + Str(xs[1]) + " " + Str(xs[2]));

  grid: int[2][3] = [[1, 2, 3], [4, 5, 6]];
  i = 0;
  while i < grid.len() {
    line = "";
    sum = 0;
    j = 0;
    while j < grid[i].len() {
      line = line + Str(grid[i][j]) + " ";
      sum = sum + grid[i][j];
      j = j + 1;
    }
    io::println(line + "= " + Str(sum));
    i = i + 1;
  }

  corner: inout = grid;
  corner[1][2] = 600;
  ws: float[2] = [1, 4];
  word: char[2] = ['h', 'i'];
  dirs: Dir[2] = [Dir::North, Dir::West];
  way = "north";
  match dirs[1] {
    West { way = "west"; }
    _ {}
  }
  io::println("corner " + Str(grid[1][2]) + ", mean " + Str((ws[0] + ws[1])
      / 2.0) + ", " + Str(word[0]) + Str(word[1]) + ", " + way);

  names: Str[3] = ["ann", "bob", "cy"];
  roll = names; // the same three strings
  roll[2] = "dee";
  io::println(names[2] + " " + roll[2] + " " + Str(roll.len()));
  return 0;
}
