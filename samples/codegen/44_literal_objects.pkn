// 44 — string literals used as objects (#116): a literal in any value
// position is a Str object built from it (like `s = "x"`), never its raw C
// string, and is released like any other string temporary.
// Exercises: subscripting a literal (`"ab"[1]`, also as a match subject and a
// conversion argument), a method call on a literal (`"abc".len()`), a
// literal in every value position (binding, typed binding, argument, return
// value, concatenation operand, field, tuple / array / optional element).  Run with --track-heap:
// zero live blocks.

// expect-stdout: "ab"[1]:     b
// expect-stdout: "xyz"[i]:    xyz
// expect-stdout: match:       newline
// expect-stdout: Str<char>:   y
// expect-stdout: len:         3
// expect-stdout: binding:     lit
// expect-stdout: println:     lit
// expect-stdout: argument:    3
// expect-stdout: typed:       typed
// expect-stdout: concat:      litx
// expect-stdout: return:      ret
// expect-stdout: field:       k2 t
// expect-stdout: tuple:       tup m1m2
// expect-stdout: array:       zyw q
// expect-stdout: optional:    opt opt2
// expect-stdout: int<Str>:    42

class Tagged {
  name: Str;
  tag: Str?;
  fn __init__()                              { self.name = "k"; self.tag = "t"; }
}

fn consume(s: Str) -> int                    { return s.len(); }
fn give() -> Str                             { return "ret"; }

fn main() -> int {
  c = "ab"[1];
  println("\"ab\"[1]:     " + Str(c));
  letters: Str = "";
  i = 0;
  while (i < 3) {
    letters = letters + Str<char>("xyz"[i]);
    i = i + 1;
  }
  println("\"xyz\"[i]:    " + letters);
  match "a\nb"[1] {
    '\n' { println("match:       newline"); }
    _ { println("match:       other"); }
  }
  println("Str<char>:   " + Str<char>("xy"[1]));
  println("len:         " + Str<int>("abc".len()));

  v = "lit";
  println("binding:     " + v);
  print("println:     ");
  println("lit");
  println("argument:    " + Str<int>(consume("lit")));
  s: Str = "typed";
  println("typed:       " + s);
  println("concat:      " + ("lit" + "x"));
  println("return:      " + give());
  k = Tagged();
  k.name = "k2";
  match k.tag {
    t: Str { println("field:       " + k.name + " " + t); }
    None { println("field:       " + k.name + " none"); }
  }

  t = ("tup", 1);
  m: (Str, Str) = ("m1", "m2");
  println("tuple:       " + t.0 + " " + m.0 + m.1);
  a: Str[] = ["x", "y"];
  a[0] = "z";
  a.push("w");
  println("array:       " + a[0] + a[1] + a[2] + " " + ["p", "q"][1]);
  o: Str? = "opt";
  o2: Str? = "opt2";
  match o {
    p: Str {
      match o2 {
        q: Str { println("optional:    " + p + " " + q); }
        None { println("optional:    " + p); }
      }
    }
    None { println("optional:    none"); }
  }
  print("int<Str>:    ");
  println(int<Str>("42"));
  return 0;
}
