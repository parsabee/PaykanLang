// 09 — Variables: explicit type declarations, implicit (inferred) declarations,
//       rebinding, int->float promotion on rebind, scope shadowing
// Exercises: visitVarDecl (explicit typed), visitAssignStmt (implicit first-assign),
//            visitAssignStmt (rebind), emitImplicitVarDecl, emitClassVarRebind,
//            Scope::declare/declareUnowned, Scope::findOwner

import ::io;

fn main() -> int {
  io::println("=== explicit typed declarations ===");
  let a: int = 42;
  let b: float = 3.14;
  let c: bool = True;
  let d: Str = "hello";
  io::println(Str<int>(a));    // 42
  io::println(Str(b));  // 3.14
  io::println(Str<bool>(c));   // True
  io::println(d);               // hello

  io::println("=== implicit (inferred) declarations ===");
  // No type annotation — CodeGen infers from RHS value
  let x = 100;
  let y = 2.718;
  let z = False;
  let w = "world";
  io::println(Str(x));    // 100
  io::println(Str<float>(y));  // 2.718
  io::println(Str(z));   // False
  io::println(w);               // world

  io::println("=== rebind int ===");
  v: int = 1;
  v = 2;
  v = v + 10;
  v = v * 3;
  io::println(Str<int>(v));    // 36

  io::println("=== rebind float ===");
  f: float = 0.0;
  f = 1.5;
  f = f + 0.5;
  io::println(Str(f));  // 2

  io::println("=== rebind bool ===");
  flag: bool = False;
  flag = True;
  flag = !flag;
  io::println(Str<bool>(flag)); // False

  io::println("=== int->float promotion on rebind ===");
  pf: float = 0.0;
  pf = 7;              // int literal assigned to float var -> SIToFP
  io::println(Str(pf));  // 7
  pf = pf + 1;         // int 1 promoted
  io::println(Str<float>(pf));  // 8

  io::println("=== Str rebind (emitClassVarRebind) ===");
  s: Str = "first";
  io::println(s);               // first
  s = "second";
  io::println(s);               // second
  s = s + "!";          // concat then rebind
  io::println(s);               // second!

  io::println("=== Str implicit decl then rebind ===");
  msg = "initial";
  io::println(msg);             // initial
  msg = "updated";
  io::println(msg);             // updated

  io::println("=== multiple vars same scope ===");
  p: int = 1;
  let q: int = 2;
  let r: int = 3;
  p = p + q + r;
  io::println(Str(p));    // 6

  io::println("=== nested scope variable access ===");
  outer: int = 10;
  if True {
    let inner: int = 20;
    outer = outer + inner;   // outer accessible from inner scope
    io::println(Str<int>(outer));   // 30
  }
  io::println(Str(outer));     // 30 (modified by inner scope)

  io::println("=== None initialised var ===");
  let n: Obj = None;   // None has type Obj, not Str
  io::println("none ok");  // just checking it doesn't crash

  return 0;
}
