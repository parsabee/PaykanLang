// 03 — Relational and equality operators: < > <= >= == !=
// Exercises: visitBinaryExpr for Lt/Gt/Le/Ge/Eq/Ne,
//            int comparisons, float comparisons, float-int mixed

import ::io;

fn main() -> int {
  io::println("=== int relational ===");
  io::println("1<2:  " + Str<bool>(1 < 2));  // True
  io::println("2<1:  " + Str(2 < 1));     // False
  io::println("3>3:  " + Str<bool>(3 > 3));  // False
  io::println("4>3:  " + Str(4 > 3));     // True
  io::println("5<=5: " + Str<bool>(5 <= 5));  // True
  io::println("5<=4: " + Str(5 <= 4));    // False
  io::println("6>=6: " + Str<bool>(6 >= 6));  // True
  io::println("6>=7: " + Str(6 >= 7));    // False
  io::println("7==7: " + Str<bool>(7 == 7));  // True
  io::println("7==8: " + Str(7 == 8));    // False
  io::println("9!=9: " + Str<bool>(9 != 9));  // False
  io::println("9!=10:" + Str(9 != 10));   // True

  io::println("=== float relational ===");
  io::println("1.0<2.0:" + Str<bool>(1.0 < 2.0));  // True
  io::println("3.5>3.5:" + Str(3.5 > 3.5));  // False
  io::println("3.5>=3.5:" + Str<bool>(3.5 >= 3.5));  // True
  io::println("1.5==1.5:" + Str(1.5 == 1.5));  // True
  io::println("1.5!=2.5:" + Str<bool>(1.5 != 2.5));  // True

  io::println("=== float-int mixed (promotion) ===");
  io::println("1<1.5:" + Str(1 < 1.5));    // True
  io::println("2.0==2:" + Str<bool>(2.0 == 2.0));  // True
  io::println("3>2.9:" + Str(3 > 2.9));    // True

  io::println("=== equality in variables ===");
  a: int = 10;
  b: int = 10;
  c: int = 20;
  io::println("a==b:" + Str<bool>(a == b));  // True
  io::println("a==c:" + Str(a == c));        // False
  io::println("a!=c:" + Str<bool>(a != c));  // True

  // Comparisons used in assignments
  big: bool = a > 5;
  small: bool = c < 5;
  io::println("big:  " + Str(big));          // True
  io::println("small:" + Str<bool>(small));  // False

  return 0;
}
