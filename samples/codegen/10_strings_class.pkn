// 10 — Str class type: VarDecl, rebind, pass as arg, return from fn,
//       methods (length, concat, toString, equals), string concatenation op,
//       Str<int>/Str<float>/Str<bool> conversion builtins
// Exercises: emitSharedNew (VarDecl + ImplicitVarDecl + RebindFromCall),
//            emitClassVarRebind with exprAlreadyShared guard,
//            visitMethodCallExpr (primitive + class-typed returns),
//            emitAsShared in call args, emitRetain/emitRelease,
//            scope cleanup releasing the strings

import ::io;

// ---- Helpers that pass/return Str ----------------------------------------

fn shprintln(s: Str) -> Str {
  return s + "!!!";
}
fn repeat(s: Str, n: int) -> Str {
  acc: Str = "";
  i: int = 0;
  while i < n {
    acc = acc + s;
    i = i + 1;
  }
  return acc;
}
fn longerOf(a: Str, b: Str) -> Str {
  return if a.len() >= b.len() then a else b;
}

// ---- main -----------------------------------------------------------------

fn main() -> int {
  io::println("=== basic Str VarDecl ===");
  s: Str = "hello";
  io::println(s);               // hello

  io::println("=== Str rebind from literal ===");
  s = "world";
  io::println(s);               // world

  io::println("=== Str rebind from concat expr ===");
  s = "foo" + "bar";
  io::println(s);               // foobar

  io::println("=== Str rebind from function call (no double-box) ===");
  s = shprintln("hi");
  io::println(s);               // hi!!!

  io::println("=== implicit Str decl from function call ===");
  implicit_s = shprintln("bye");
  io::println(implicit_s);      // bye!!!

  io::println("=== Str rebind from ternary (no double-box) ===");
  flag: bool = True;
  s = if flag then "yes" else "no";
  io::println(s);               // yes
  s = if !flag then "yes" else "no";
  io::println(s);               // no

  io::println("=== method: length() ===");
  t: Str = "hello";
  n: int = t.len();
  io::println(Str<int>(n));    // 5
  empty: Str = "";
  io::println(Str(empty.len()));  // 0

  io::println("=== method: concat() (in-place mutation) ===");
  a: Str = "hello";
  b: Str = " world";
  a.concat(b);
  io::println(a);               // hello world
  // concat more
  a2: Str = "hello";
  a2.concat(" !!");
  io::println(a2);              // hello !!

  io::println("=== method: toString() (class-typed return) ===");
  e: Str = "paykan";
  f: Str = e.toString();
  io::println(f);               // paykan

  io::println("=== string + operator ===");
  g: Str = "abc" + "def";
  io::println(g);               // abcdef
  g = g + g;
  io::println(g);               // abcdefabcdef

  io::println("=== Str<int> / Str<float> / Str<bool> builtins ===");
  si: Str = Str<int>(255);
  sf: Str = Str(3.14);
  sb: Str = Str<bool>(True);
  io::println(si);              // 255
  io::println(sf);              // 3.14
  io::println(sb);              // True

  io::println("=== Str passed to function ===");
  base: Str = "hi";
  io::println(shprintln(base));     // hi!!!
  io::println(repeat("ab", 4)); // abababab

  io::println("=== Str returned and used immediately ===");
  io::println(longerOf("short", "much longer string"));  // much longer string
  io::println(longerOf("equal!", "equal!"));  // equal!

  io::println("=== many Str vars same scope (stress refcount) ===");
  v0: Str = "s0";
  v1: Str = "s1";
  v2: Str = "s2";
  v3: Str = "s3";
  v4: Str = "s4";
  io::println(v0 + v1 + v2 + v3 + v4);   // s0s1s2s3s4

  io::println("=== Str vars in loop (scope cleanup per iteration) ===");
  i: int = 0;
  while i < 4 {
    label: Str = "item-" + Str(i);
    io::println(label);
    i = i + 1;
  }

  io::println("=== Str var in if/else branches ===");
  if True {
    branch: Str = "true-branch";
    io::println(branch);
  } else {
    branch: Str = "false-branch";
    io::println(branch);
  }

  return 0;
}
