// 74 — a generic enum's variant takes its type arguments from either side
// Exercises: a variant written without type arguments, `Maybe::Nothing`, on
//            either side of `==` and `!=` and in either arm of a conditional
//            expression, takes them from the other side or arm
//            (docs/language/07-enums.md, "Generic enums"): in both orders,
//            in a nested conditional, against a conditional, and a variant
//            made with fields that leaves a type argument open
//            (`Res::Ok(1)`), or whose field takes the other side's sized
//            type (`Maybe::Just(200)` against a `Maybe<u8>`); a generic
//            function's call that takes them from the other side
//            (`none()`, `ok(1)`) against a variant made with fields in
//            either order, and a variant whose fields leave one open
//            (`Two::Left(1)`) or whose field needs it
//            (`Maybe::Just(Maybe::Nothing)`) against one that does not.
// expect-stdout: False False True True
// expect-stdout: Nothing Just(value: 2)
// expect-stdout: False True
// expect-stdout: Nothing Nothing Just(value: 2)
// expect-stdout: False True
// expect-stdout: True False True
// expect-stdout: False True True False
// expect-stdout: Just(value: 2) Nothing Ok(v: 1) Nothing
// expect-stdout: False Left(a: 1) False Just(value: Nothing)

import ::io;

enum Maybe<T> {
  Just(value: T),
  Nothing
}

enum Res<T, E> { Ok(v: T), Err(e: E) }

enum Two<A, B> {
  Both(a: A, b: B),
  Left(a: A)
}

fn none<T>() -> Maybe<T> => Maybe::Nothing;

fn ok<T, E>(v: T) -> Res<T, E> => Res::Ok(v);

fn main() -> int {
  x = Maybe::Just(5);
  n = 2;
  io::println(Str(Maybe::Nothing == x) + " " + Str(x == Maybe::Nothing) + " "
      + Str(Maybe::Nothing != x) + " " + Str(x != Maybe::Nothing));
  b = if n > 0 then Maybe::Nothing else Maybe::Just(n);
  c = if n > 5 then Maybe::Nothing else Maybe::Just(n);
  io::println(b.toString() + " " + c.toString());
  io::println(Str(b == x) + " " + Str(c == Maybe::Just(2)));
  d = if n > 5 then Maybe::Nothing else if n > 1 then Maybe::Nothing
      else Maybe::Just(n);
  e = if n > 5 then Maybe::Nothing else if n > 3 then Maybe::Just(n)
      else Maybe::Nothing;
  f = if n > 5 then Maybe::Nothing else if n > 1 then Maybe::Just(n)
      else Maybe::Nothing;
  io::println(d.toString() + " " + e.toString() + " " + f.toString());
  io::println(Str(Maybe::Nothing == (if n > 1 then x else Maybe::Nothing)) + " "
      + Str(x != (if n > 1 then Maybe::Nothing else Maybe::Nothing)));
  r = Res<int, Str>::Ok(1);
  small: Maybe<u8> = Maybe::Just(200);
  io::println(Str(Res::Ok(1) == r) + " " + Str(Res::Err("no") == r) + " "
      + Str(Maybe::Just(200) == small));
  io::println(Str(Maybe::Just(1) == none()) + " " + Str(none() != x) + " "
      + Str(ok(1) == r) + " " + Str(r != ok(1)));
  g = if n > 0 then Maybe::Just(n) else none();
  h = if n > 0 then none() else Maybe::Just(n);
  i = if n > 0 then ok(1) else r;
  j = if n > 5 then Maybe::Just(n) else (if n > 1 then none() else none());
  io::println(g.toString() + " " + h.toString() + " " + i.toString() + " "
      + j.toString());
  k = if n > 0 then Two::Left(1) else Two::Both(1, "s");
  l = if n > 0 then Maybe::Just(Maybe::Nothing)
      else Maybe::Just(Maybe::Just(n));
  io::println(Str(Two::Left(1) == Two::Both(1, "s")) + " " + k.toString() + " "
      + Str(Maybe::Just(Maybe::Nothing) == Maybe::Just(Maybe::Just(n))) + " "
      + l.toString());
  return 0;
}
