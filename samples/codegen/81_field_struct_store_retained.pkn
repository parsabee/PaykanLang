// 81 — a field written through an object a variable or a capture holds
// Exercises: a struct or fixed-size array field assigned through an object
//            read from a field into a variable, captured by a lambda, or
//            read in a loop, copied from an `inout` parameter (a lambda's
//            too), from another variable or from an `inout` result, and an
//            optional one, on every path.  The retain
//            of a value whose type is a class that is not optional makes no
//            test for null (docs/pir.md §6, `retain nonnull`): with one,
//            GCC's -Warray-bounds at -O1 and above followed the null path
//            into the field's write, and the strict C build failed.  A
//            native function's `Obj?` result matched to its `None` arm: the
//            type arm's retain of the subject's box keeps its test, since
//            the same box, null, is released on the way to `None`.  The
//            same through an object a value held in memory holds (a struct
//            parameter, a copy of a struct, a tuple or an array, a union's
//            variant bound by a `match`, `inout` too, an optional struct's,
//            a lambda's captured struct): its copy's retain of a class
//            reference makes no test either, but in an optional's or a
//            union's, whose other variants are zeros.
// expect-stdout: field: 8
// expect-stdout: capture: 8 8
// expect-stdout: loop: 2
// expect-stdout: optional: 5 None
// expect-stdout: inout: 2 4 3 5 6
// expect-stdout: native: True
// expect-stdout: held: 8 5 6 6 3 4 1 0 4 18

import ::io;

struct P {
  a: int;
  b: int;
  c: int;
}

class C {
  p: P;
  xs: int[3];
}

class H {
  c: C;
  o: C?;
}

fn set(h: H) {
  let d = h.c;
  d.p = P(7, 8, 9);
}

fn setEach(hs: H[3]) -> int {
  n = 0;
  for i in 0..3 {
    let d = hs[i].c;
    d.xs = [i, i, i];
    n = n + d.xs[1];
  }
  return n - 1;
}

fn setOptional(h: H) -> Str {
  match h.o {
    e: C {
      e.p = P(4, 5, 6);
      return Str(e.p.b);
    }
    None { return "None"; }
  }
}

fn viaInout(c: inout C) {
  let d = c;
  d.p = P(7, 2, 9);
}

fn viaBinding(c: inout C) {
  let e = c;
  e.xs = [4, 4, 4];
}

fn viaRebind(c: inout C, d: C) {
  e = d;
  e = c;
  e.p = P(7, 3, 9);
}

fn held(h: inout H) -> inout C {
  return h.c;
}

struct S {
  c: C;
  n: int;
}

enum U { A(c: C, k: int), B(n: int), }

fn viaStructCopy(s: S) -> int {
  let s2 = s;
  s2.c.p = P(7, 8, 9);
  s2.c.xs = [4, 4, 4];
  return s2.c.p.b;
}

fn viaParam(s: S) -> int {
  s.c.p = P(5, 5, 5);
  return s.c.p.a;
}

fn viaUnion(u: U) -> int {
  match u {
    a: A {
      a.c.p = P(6, 6, 6);
      a.c.xs = [6, 6, 6];
      return a.c.p.a;
    }
    B { return 0; }
  }
}

fn viaUnionInout(u: inout U) -> int {
  match u {
    a: inout A {
      a.c.p = P(6, 6, 6);
      return a.c.p.a;
    }
    B { return 0; }
  }
}

fn viaTuple(t: (C, int)) -> int {
  let t2 = t;
  t2.0.p = P(3, 3, 3);
  return t2.0.p.a;
}

fn viaArray(arr: C[2]) -> int {
  let b = arr;
  b[0].p = P(2, 2, 2);
  b[1].xs = [2, 2, 2];
  return b[0].p.a + b[1].xs[0];
}

fn viaOptStruct(os: S?) -> int {
  match os {
    s: S {
      s.c.p = P(1, 1, 1);
      return s.c.p.a;
    }
    None { return 0; }
  }
}

fn viaClosure(s: S) -> int {
  let k = fn() -> int {
    s.c.p = P(4, 4, 4);
    return s.c.p.a;
  };
  return k();
}

fn viaLocalStruct() -> int {
  let s = S(C(P(1, 1, 1), [1, 1, 1]), 1);
  let t = s;
  t.c.p = P(9, 9, 9);
  return t.c.p.a + s.c.p.a;
}

fn fresh() -> C => C(P(1, 2, 3), [1, 2, 3]);

native fn _open(path: view Str, mode: view Str, errno: inout int)
                -> Obj? = "Paykan_io_open";

class F {
  handle: Obj;
}

fn opened(path: Str) -> F? {
  errno = 0;
  match _open(path, "r", errno) {
    handle: Obj { return F(handle); }
    None { return None; }
  }
}

fn main() -> int {
  h = H(C(P(1, 2, 3), [1, 2, 3]), C(P(1, 2, 3), [1, 2, 3]));
  set(h);
  io::println("field: " + Str(h.c.p.b));
  c = h.c;
  let k = fn() { c.p = P(7, 8, 9); c.xs = [7, 8, 9]; };
  k();
  io::println("capture: " + Str(c.p.b) + " " + Str(c.xs[1]));
  let hs = [h, H(C(P(0, 0, 0), [0, 0, 0]), None), h];
  io::println("loop: " + Str(setEach(hs)));
  let none = H(C(P(0, 0, 0), [0, 0, 0]), None);
  io::println("optional: " + setOptional(h) + " " + setOptional(none));
  c = C(P(1, 1, 1), [1, 1, 1]);
  viaInout(c);
  let b = c.p.b;
  viaBinding(c);
  let x = c.xs[0];
  viaRebind(c, C(P(0, 0, 0), [0, 0, 0]));
  let r = c.p.b;
  let f = fn(y: inout C) { let d = y; d.p = P(7, 5, 9); };
  f(c);
  let l = c.p.b;
  h = H(c, None);
  at: inout = held(h);
  let q = at;
  q.p = P(7, 6, 9);
  io::println("inout: " + Str(b) + " " + Str(x) + " " + Str(r) + " " + Str(l)
      + " " + Str(c.p.b));
  io::println("native: " + Str(opened("") == None));
  let s = S(fresh(), 1);
  u = U::A(fresh(), 1);
  io::println("held: " + Str(viaStructCopy(s)) + " " + Str(viaParam(s)) + " "
      + Str(viaUnion(u)) + " " + Str(viaUnionInout(u)) + " "
      + Str(viaTuple((fresh(), 1))) + " " + Str(viaArray([fresh(), fresh()]))
      + " " + Str(viaOptStruct(s)) + " " + Str(viaOptStruct(None)) + " "
      + Str(viaClosure(s)) + " " + Str(viaLocalStruct()));
  return 0;
}
