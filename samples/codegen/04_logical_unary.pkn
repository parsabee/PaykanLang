// 04 — Logical operators && || ! and unary negation
// Exercises: visitBinaryExpr (And/Or short-circuit), visitUnaryExpr (Not/Neg),
//            bool short-circuit semantics, combined logical expressions

import ::io;

fn main() -> int {
  io::println("=== AND truth table ===");
  io::println("T&&T=" + Str<bool>(True && True));  // True
  io::println("T&&F=" + Str(True && False));  // False
  io::println("F&&T=" + Str<bool>(False && True));  // False
  io::println("F&&F=" + Str(False && False));  // False

  io::println("=== OR truth table ===");
  io::println("T||T=" + Str<bool>(True || True));  // True
  io::println("T||F=" + Str(True || False));  // True
  io::println("F||T=" + Str<bool>(False || True));  // True
  io::println("F||F=" + Str(False || False));  // False

  io::println("=== NOT ===");
  io::println("!T=" + Str<bool>(!True));            // False
  io::println("!F=" + Str(!False));           // True
  io::println("!!T=" + Str<bool>(!!True));  // True

  io::println("=== short-circuit && ===");
  // The side effect counter verifies RHS is skipped when LHS is False.
  counter: int = 0;
  flag: bool = False && (counter == 0);  // RHS never executed
  io::println("F&&(c==0)=" + Str(flag));   // False
  // counter stays 0 whether or not RHS ran (no side-effect possible in
  // this language without a call), but the path still exercises the
  // correct codegen branch structure.

  io::println("=== short-circuit || ===");
  flag2: bool = True || False;           // RHS skipped
  io::println("T||F=" + Str<bool>(flag2));  // True

  io::println("=== precedence && before || ===");
  // && binds tighter than ||
  a: bool = True || False && False;     // True || (False && False) = True || F = True
  b: bool = False && True || True;      // (False && True) || True = False || True = True
  c: bool = False && True || False;     // (False && True) || False = False
  io::println("T||F&&F=" + Str(a));      // True
  io::println("F&&T||T=" + Str<bool>(b));  // True
  io::println("F&&T||F=" + Str(c));      // False

  io::println("=== unary negation (int) ===");
  x: int = 5;
  neg_x: int = 0 - x;
  io::println("-5=" + Str<int>(neg_x));   // -5
  io::println("-(3+2)=" + Str(0 - (3 + 2)));  // -5

  io::println("=== unary negation (float) ===");
  io::println("-3.14=" + Str<float>(0.0 - 3.14));  // -3.14

  io::println("=== combined ===");
  v: int = 7;
  result: bool = v > 0 && v < 10 && v != 5;
  io::println("7 in (0,10) and !=5:" + Str(result));  // True
  result2: bool = v < 0 || v > 5 && v < 10;
  io::println("7<0 or in (5,10):" + Str<bool>(result2));  // True

  return 0;
}
