// 75 — parsing a string with Str's methods
// Exercises: `s.toInt()`, `toI8()`, `toI16()`, `toI32()`, `toUnsigned()`,
//            `toU8()`, `toU16()`, `toU32()`, `toFloat()`, `toF16()`,
//            `toF32()` and `toBool()`, each the optional of its type
//            (docs/language/04-strings-and-conversions.md, "Parsing a
//            string"): unwrapping with `match`, the range of each type, a
//            sign refused by every unsigned type, an f32 or f16 text that
//            rounds to infinity being None while one below the range rounds
//            to 0, a literal and the parse of its text agreeing, an
//            integer text rounded once into an f32 at any size, and a
//            receiver that is a literal, a local, a struct's field, a
//            class's field, `self`'s field, a `view` parameter, a list's
//            element, a concatenation and a call's result.
// expect-stdout: sum 60, 2 invalid
// expect-stdout: 127 None -128 None 32767 -2147483648 None
// expect-stdout: 255 None None None 65535 4294967295 18446744073709551615 None
// expect-stdout: 2.5 0.5 16 inf nan None None
// expect-stdout: 0.1 3.40282e+38 None None 0 -0
// expect-stdout: 65504 None None 0 0.0999756
// expect-stdout: True False None None
// expect-stdout: agree agree agree agree agree
// expect-stdout: agree agree agree agree
// expect-stdout: 200 65535 65535 255 None True 128 42 7

import ::io;
import ::collections;

struct Reading {
  text: Str;
}

class Sensor {
  label: Str;
  view fn level() -> u16? { return self.label.toU16(); }
}

impl Sensor {
  fn __init__(label: Str) { self.label = label; }
}

fn byte(s: view Str) -> u8? {
  return s.toU8();
}

fn answer() -> Str {
  return "4" + "2";
}

fn same(x: f32, o: f32?) -> Str {
  match o {
    v: f32 { if v == x { return "agree"; } return "differ"; }
    None { return "None"; }
  }
}

fn main() -> int {
  let inputs: Str[5] = ["10", "x", "20", "", "30"];
  sum = 0;
  invalid = 0;
  for i in 0..inputs.len() {
    match inputs[i].toInt() {
      n: int { sum = sum + n; }
      None { invalid = invalid + 1; }
    }
  }
  io::println("sum " + Str(sum) + ", " + Str(invalid) + " invalid");

  // The range of each signed type, and a sign it may carry.
  io::println("127".toI8().toString() + " " + "128".toI8().toString() + " "
      + "-128".toI8().toString() + " " + "-129".toI8().toString() + " "
      + "+32767".toI16().toString() + " " + "-2147483648".toI32().toString()
      + " " + " 1".toInt().toString());

  // An unsigned type refuses any sign.
  io::println("255".toU8().toString() + " " + "256".toU8().toString() + " "
      + "+1".toU8().toString() + " " + "-0".toU32().toString() + " "
      + "65535".toU16().toString() + " " + "4294967295".toU32().toString() + " "
      + "18446744073709551615".toUnsigned().toString() + " "
      + "+1".toUnsigned().toString());

  // The float types: C's strtod spellings, and their range.
  io::println("2.5".toFloat().toString() + " " + ".5".toFloat().toString() + " "
      + "0x10".toFloat().toString() + " " + "inf".toFloat().toString() + " "
      + "nan".toFloat().toString() + " " + "1e999".toFloat().toString() + " "
      + "1e-400".toFloat().toString());
  io::println("0.1".toF32().toString() + " " + "3.4028235e38".toF32().toString()
      + " " + "3.4028235677973366e38".toF32().toString() + " "
      + "1e39".toF32().toString() + " " + "1e-46".toF32().toString() + " "
      + "-1e-50".toF32().toString());
  io::println("65519".toF16().toString() + " " + "65520".toF16().toString()
      + " " + "70000".toF16().toString() + " " + "1e-9".toF16().toString() + " "
      + "0.1".toF16().toString());
  io::println("True".toBool().toString() + " " + "False".toBool().toString()
      + " " + "true".toBool().toString() + " " + "1".toBool().toString());

  // A literal in an f32 slot and the parse of its text are one value.
  io::println(same(1.0000000596046448, "1.0000000596046448".toF32()) + " "
      + same(3.4028235e38, "3.4028235e38".toF32()) + " "
      + same(1e-46, "1e-46".toF32()) + " " + same(16777217, "16777217".toF32())
      + " " + same(0.1, "0.1".toF32()));

  // An integer text is rounded once into an f32, at any size, as `f32(u)`
  // is: 2^63 + 2^39 + 1 and 2^64 + 2^40 + 1, whose f64s are midpoints, and
  // 2^128 - 2^103 - 1, just below the one above the largest f32.
  io::println(same(9223373136366403584.0, "9223372586610589697".toF32()) + " "
      + same(-9223373136366403584.0, "-9223372586610589697".toF32()) + " "
      + same(18446746272732807168.0, "18446745173221179393".toF32()) + " "
      + same(3.4028235e38, "340282356779733661637539395458142568447".toF32()));

  // Any receiver: it is borrowed for the parse, a temporary one released.
  let r = Reading("200");
  let s = Sensor("65535");
  names = collections::List<Str>();
  names.push("True");
  io::println(r.text.toU8().toString() + " " + s.label.toU16().toString() + " "
      + s.level().toString() + " " + byte("255").toString() + " "
      + byte("256").toString() + " " + names.at(unsigned(0)).toBool().toString()
      + " " + ("1" + "2" + "8").toI16().toString() + " "
      + answer().toI32().toString() + " " + Str(7).toUnsigned().toString());
  return 0;
}
