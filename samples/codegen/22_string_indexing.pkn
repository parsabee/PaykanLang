// Sample 22 — String indexing: str[i] -> char
//
// Indexing a Str with an integer subscript now yields a char (primitive i8).
// Out-of-bounds access aborts with a runtime error message.

import ::io;

fn countChar(s: view Str, target: char) -> int {
  count = 0;
  i = 0;
  while i < s.len() {
    if s[i] == target {
      count = count + 1;
    }
    i = i + 1;
  }
  return count;
}

fn reverseStr(s: Str) -> Str {
  result = "";
  i = s.len() - 1;
  while i >= 0 {
    result = result + Str(s[i]);
    i = i - 1;
  }
  return result;
}

fn isPalindrome(s: Str) -> bool {
  lo = 0;
  hi = s.len() - 1;
  while lo < hi {
    if s[lo] != s[hi] {
      return False;
    }
    lo = lo + 1;
    hi = hi - 1;
  }
  return True;
}

fn main() -> int {
  // Basic indexing
  let word = "hello";
  io::println(Str(word[0]));   // h
  io::println(Str(word[4]));   // o

  // Round-trip: index, then convert the char back to Str
  i = 0;
  while i < word.len() {
    io::print(Str(word[i]));
    i = i + 1;
  }
  io::println("");   // newline

  // Count occurrences of a char
  let sentence = "the quick brown fox jumps over the lazy dog";
  io::println("'e' count: " + Str(countChar(sentence, 'e')));  // 3
  io::println("'o' count: " + Str(countChar(sentence, 'o')));  // 4

  // Reverse a string
  io::println(reverseStr("abcde"));   // edcba
  io::println(reverseStr("racecar")); // racecar

  // Palindrome check
  io::println(Str(isPalindrome("racecar")));  // True
  io::println(Str(isPalindrome("hello")));  // False
  io::println(Str(isPalindrome("a")));        // True
  io::println(Str(isPalindrome("")));         // True

  // Comparison between indexed chars
  let s = "az";
  if s[0] < s[1] {
    io::println("a < z: true");
  }

  return 0;
}
