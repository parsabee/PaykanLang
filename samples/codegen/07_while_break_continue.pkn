// 07 — while loops, break, continue
// Exercises: visitWhileStmt, visitBreakStmt, visitContinueStmt,
//            nested loops, loop with Str vars (scope cleanup per iteration),
//            break/continue leaving unreachable blocks correct

fn main() -> int {
  println("=== basic while ===");
  i: int = 0;
  while (i < 5) {
    println(StrInt(i));
    i = i + 1;
  }

  println("=== while sum ===");
  sum: int = 0;
  n: int = 1;
  while (n <= 100) {
    sum = sum + n;
    n = n + 1;
  }
  println("sum 1..100=", StrInt(sum));   // 5050

  println("=== while never executes ===");
  while (False) {
    println("unreachable");
  }
  println("after never");

  println("=== while True + break ===");
  count: int = 0;
  while (True) {
    if (count == 5) { break; }
    count = count + 1;
  }
  println("count=", StrInt(count));      // 5

  println("=== continue skips odd ===");
  evens: int = 0;
  j: int = 0;
  while (j < 10) {
    j = j + 1;
    if (j % 2 != 0) { continue; }
    evens = evens + j;
  }
  println("sum evens 2..10=", StrInt(evens));  // 30

  println("=== nested loops ===");
  total: int = 0;
  r: int = 0;
  while (r < 4) {
    c: int = 0;
    while (c < 4) {
      total = total + 1;
      c = c + 1;
    }
    r = r + 1;
  }
  println("4x4 iterations=", StrInt(total));  // 16

  println("=== break inner loop only ===");
  outer: int = 0;
  inner_total: int = 0;
  while (outer < 3) {
    inner: int = 0;
    while (True) {
      if (inner == 3) { break; }
      inner_total = inner_total + 1;
      inner = inner + 1;
    }
    outer = outer + 1;
  }
  println("3 * 3 inner=", StrInt(inner_total));  // 9

  println("=== Str var per iteration (scope cleanup) ===");
  k: int = 0;
  while (k < 3) {
    label: Str = "iter-" + StrInt(k);
    println(label);
    k = k + 1;
  }

  println("=== loop with complex condition ===");
  a: int = 0;
  b: int = 100;
  while (a < 10 && b > 90) {
    a = a + 1;
    b = b - 1;
  }
  println("a=", StrInt(a), " b=", StrInt(b));  // a=10 b=90

  println("=== countdown with multiple continues ===");
  x: int = 10;
  out_count: int = 0;
  while (x > 0) {
    x = x - 1;
    if (x % 3 == 0) { continue; }
    if (x % 4 == 0) { continue; }
    out_count = out_count + 1;
  }
  // x=0..9: skip multiples of 3 (0,3,6,9) and multiples of 4 (0,4,8)
  // skipped: 0,3,4,6,8,9 => 4 remaining: 1,2,5,7
  println("non-3/4 count=", StrInt(out_count));   // 4

  return 0;
}
