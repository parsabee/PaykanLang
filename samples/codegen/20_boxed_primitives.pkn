// Sample 20 — Parsing with int<Str> / float<Str>, and the boxed primitives
//
// int<Str>(s: Str) -> int?    parses a decimal integer string.
// float<Str>(s: Str) -> float?  parses a floating-point string.
// Both return None for a string that is not a valid number.  Use match to
// unwrap the result (the arm binds a plain int / float).
//
// A present int? / float? is a boxed Int / Float object; handed to an Obj it
// can be matched as one, and the boxes print and compare by value.

fn tryParseInt(s: Str) -> Str {
  match int<Str>(s) {
    n: int { return "ok: " + Str<int>(n); }
    None   { return "invalid: '" + s + "'"; }
  }
}

fn tryParseFloat(s: Str) -> Str {
  match float<Str>(s) {
    f: float { return "ok: " + Str<float>(f); }
    None     { return "invalid: '" + s + "'"; }
  }
}

fn main() -> int {
  // === int<Str> ===
  println("=== int<Str> ===");

  // valid integers
  println(tryParseInt("0"));
  println(tryParseInt("42"));
  println(tryParseInt("-99"));
  println(tryParseInt("9223372036854775807"));   // INT64_MAX

  // invalid inputs
  println(tryParseInt("abc"));
  println(tryParseInt("12abc"));
  println(tryParseInt(""));
  println(tryParseInt("3.14"));
  println(tryParseInt("9223372036854775808"));   // INT64_MAX + 1

  // === float<Str> ===
  println("=== float<Str> ===");

  // valid floats
  println(tryParseFloat("0"));
  println(tryParseFloat("3.14"));
  println(tryParseFloat("-2.718"));
  println(tryParseFloat("1e10"));
  println(tryParseFloat("2.5e-3"));

  // invalid inputs
  println(tryParseFloat("abc"));
  println(tryParseFloat("1.2.3"));
  println(tryParseFloat(""));

  // === counting valid inputs ===
  println("=== counting valid inputs ===");

  i: int = 0;
  total = 0;
  inputs: Str[] = ["10", "20", "bad", "30", "nope", "40"];
  while (i < inputs.len()) {
    if (int<Str>(inputs[i]) != None) { total = total + 1; }
    i = i + 1;
  }
  println("valid ints in list: " + Str<int>(total));

  // === the boxes: toString / equals ===
  println("=== toString / equals ===");

  a: Obj = int<Str>("7");
  b: Obj = int<Str>("7");
  c: Obj = int<Str>("8");
  match a {
    x: Int {
      println(x.toString());
      println(Str<bool>(x.equals(b)));
      println(Str<bool>(x.equals(c)));
    }
    _ {}
  }
  println(Str<bool>(int<Str>("7") == int<Str>("7")));

  f: Obj = float<Str>("1.5");
  match f {
    y: Float { println(y.toString()); }
    _ {}
  }
  println(int<Str>("nope"));

  return 0;
}
