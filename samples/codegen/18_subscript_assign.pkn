// 18_subscript_assign.pkn — array index assignment and string subscript read
// Covers: arr[idx] = val for int / float / bool / Str arrays,
//         str[idx] returning a single-char Str,
//         iterating over string characters via subscript,
//         mixed subscript read + write in a loop.
// Exercises: visitSubscriptAssignStmt (CodeGen), PaykanArray_set,
//            PaykanString_at, visitSubscriptExpr on Str receiver.

// ---- helpers ---------------------------------------------------------------

fn printBool(b: bool) -> int                 { println(Str<bool>(b)); return 0; }

// ---- 1. int array index assignment -----------------------------------------

fn intArrayAssign() -> int {
  println("=== int array assign ===");
  arr: int[] = [10, 20, 30];
  arr[0] = 99;
  arr[2] = 42;
  println(Str(arr[0]));                      // 99
  println(Str<int>(arr[1]));                 // 20
  println(Str(arr[2]));                      // 42
  return 0;
}

// ---- 2. float array index assignment ---------------------------------------

fn floatArrayAssign() -> int {
  println("=== float array assign ===");
  arr: float[] = [1.0, 2.0, 3.0];
  arr[1] = 9.5;
  println(Str<float>(arr[0]));               // 1.0
  println(Str(arr[1]));                      // 9.5
  println(Str<float>(arr[2]));               // 3.0
  return 0;
}

// ---- 3. bool array index assignment ----------------------------------------

fn boolArrayAssign() -> int {
  println("=== bool array assign ===");
  arr: bool[] = [True, False, True];
  arr[0] = False;
  arr[2] = False;
  printBool(arr[0]);                         // False
  printBool(arr[1]);                         // False
  printBool(arr[2]);                         // False
  return 0;
}

// ---- 4. Str array index assignment -----------------------------------------

fn strArrayAssign() -> int {
  println("=== str array assign ===");
  arr: Str[] = ["a", "b", "c"];
  arr[1] = "hello";
  println(arr[0]);                           // a
  println(arr[1]);                           // hello
  println(arr[2]);                           // c
  return 0;
}

// ---- 5. In-place loop overwrite --------------------------------------------

fn loopOverwrite() -> int {
  println("=== loop overwrite ===");
  arr: int[] = [0, 0, 0, 0, 0];
  i: int = 0;
  while (i < 5) {
    arr[i] = i * i;
    i = i + 1;
  }
  i = 0;
  while (i < 5) {
    println(Str(arr[i]));                    // 0 1 4 9 16
    i = i + 1;
  }
  return 0;
}

// ---- 6. String subscript read (char) ----------------------------------------

fn strSubscript() -> int {
  println("=== str subscript ===");
  s: Str = "paykan";
  println(Str<char>(s[0]));                  // p (convert char to Str)
  println(Str(s[5]));                        // n
  c: Str = Str<char>(s[3]);                  // k (convert char to Str)
  println(c);
  return 0;
}

// ---- 7. Iterate over string characters -------------------------------------

fn iterString() -> int {
  println("=== iter string ===");
  s: Str = "hello";
  n: int = s.len();
  i: int = 0;
  while (i < n) {
    println(Str(s[i]));                      // convert char to Str
    i = i + 1;
  }
  return 0;
}

// ---- 8. Build a new string by reading chars --------------------------------

fn reverseFirstThree() -> int {
  println("=== reverse first three ===");
  s: Str = "abcdef";
  result: Str = Str<char>(s[2]) + Str(s[1]) + Str<char>(s[0]);
  println(result);                           // cba
  return 0;
}

// ---- main ------------------------------------------------------------------

fn main() -> int {
  intArrayAssign();
  floatArrayAssign();
  boolArrayAssign();
  strArrayAssign();
  loopOverwrite();
  strSubscript();
  iterString();
  reverseFirstThree();
  return 0;
}
