// 65 — moves at last use of values held in place
// Exercises: a tuple, a struct, a tagged union, a function value, an
//            optional tuple and a fixed-size array copied whole at a
//            variable's last use (docs/language/16-memory.md, "Ownership
//            transfers"): into another variable, out of a function and
//            into a field.  The copy then holds the references the variable
//            held, so the objects die when the copy lets them go, which the
//            `weak` references show.  A copy the variable is read after,
//            and an element copied out of it, keep their own.
// expect-stdout: tuple: alive | replaced: gone
// expect-stdout: struct: alive | replaced: gone
// expect-stdout: enum: alive | replaced: gone
// expect-stdout: function: f | replaced: gone
// expect-stdout: optional: alive | replaced: gone
// expect-stdout: array: alive alive | replaced: gone gone
// expect-stdout: returned: r alive | replaced: gone | field: alive | let go: gone
// expect-stdout: read after: c | alive | element: e | alive

import ::io;

class Node {
  name: Str;
}

class Watch {
  weak target: Node?;
}

/// What @p w refers to: "alive" or "gone".
fn state(w: view Watch) -> Str {
  match w.target {
    Node { return "alive"; }
    None { return "gone"; }
  }
}

struct Pair {
  node: Node;
  n: int;
}

enum Slot { Empty, Full(node: Node) }

class Holder {
  pair: (Node, int);
}

/// A function value whose closure holds the only reference to @p n.
fn closureOver(n: Node) -> () -> Str {
  return fn() -> Str { return n.name; };
}

/// A struct built in a local and returned from it.
fn makePair(name: Str) -> Pair {
  let p = Pair(Node(name), 1);
  return p;
}

fn main() -> int {
  // A tuple: `q = t` is t's last use, so q holds the node now.
  let tn = Node("t");
  let wt = Watch(tn);
  let t = (tn, 1);
  q = t;
  io::print("tuple: " + state(wt));
  q = (Node("u"), 2);
  io::println(" | replaced: " + state(wt));

  // A struct.
  let sn = Node("s");
  let ws = Watch(sn);
  let p = Pair(sn, 1);
  r = p;
  io::print("struct: " + state(ws));
  r = Pair(Node("x"), 2);
  io::println(" | replaced: " + state(ws));

  // A tagged union holding a node.
  let en = Node("e");
  let we = Watch(en);
  let e = Slot::Full(en);
  e2 = e;
  io::print("enum: " + state(we));
  e2 = Slot::Empty;
  io::println(" | replaced: " + state(we));

  // A function value: its closure holds the node.
  let fnode = Node("f");
  let wf = Watch(fnode);
  let g = closureOver(fnode);
  h = g;
  io::print("function: " + h());
  h = fn() -> Str { return ""; };
  io::println(" | replaced: " + state(wf));

  // An optional tuple.
  let on = Node("o");
  let wo = Watch(on);
  let o: (Node, int)? = (on, 1);
  o2 = o;
  io::print("optional: " + state(wo));
  o2 = None;
  io::println(" | replaced: " + state(wo));

  // A fixed-size array of references.
  let a0 = Node("a");
  let a1 = Node("b");
  let wa0 = Watch(a0);
  let wa1 = Watch(a1);
  let arr: Node[2] = [a0, a1];
  arr2 = arr;
  io::print("array: " + state(wa0) + " " + state(wa1));
  arr2 = [Node("c"), Node("d")];
  io::println(" | replaced: " + state(wa0) + " " + state(wa1));

  // Returned from a local: the caller's variable holds what it held.
  made = makePair("r");
  let wm = Watch(made.node);
  io::print("returned: " + made.node.name + " " + state(wm));
  made = Pair(Node("q"), 0);
  io::print(" | replaced: " + state(wm));

  // Assigned to a field at its last use: the field holds the node now.
  let hn = Node("h");
  let wh = Watch(hn);
  holder = Holder((Node("z"), 0));
  let pair = (hn, 1);
  holder.pair = pair;
  io::print(" | field: " + state(wh));
  holder = Holder((Node("y"), 0));
  io::println(" | let go: " + state(wh));

  // Read after the copy: the copy is one of its own.  An element copied
  // out of a value stays a copy too.
  let cn = Node("c");
  let wc = Watch(cn);
  let kept = (cn, 1);
  copy = kept;
  copy = (Node("w"), 0);
  io::print("read after: " + kept.0.name + " | " + state(wc));
  let ek = Node("e");
  let wek = Watch(ek);
  let outer = ((ek, 1), 2);
  inner = outer.0;
  inner = (Node("v"), 0);
  io::println(" | element: " + outer.0.0.name + " | " + state(wek));
  return 0;
}
