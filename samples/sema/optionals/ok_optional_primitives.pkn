import ::io;

// Optional primitives: `int?`, `float?`, `bool?`, `char?` widen from their
// primitive, take None, and unwrap with a primitive match arm.
fn half(n: int) -> int? {
  if n % 2 != 0 { return None; }
  return n / 2;
}

fn main() -> int {
  let a: int? = half(4);
  let f: float? = 3;      // int -> float, then boxed
  let b: bool? = None;
  let c: char? = 'c';
  let xs: int?[3] = [1, 2, None];
  match a {
    n: int {
      io::println(Str<int>(n + 1));
    }
    None { io::println("odd"); }
  }
  if b == None && a != None {
    io::println("ok");
  }
  return 0;
}
