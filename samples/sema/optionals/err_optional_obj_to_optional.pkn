// An `Obj` does not flow into a `Node?`: it might be anything but a Node.  (It
// converts to an `Obj?`, always a present one.)
class Node {
  v: int;
}

impl Node {
  fn __init__(x: int) { self.v = x; }
}

fn main() -> int {
  let o: Obj = Node(1);
  let n: Node? = o;   // error: initializer of type 'Obj' does not match declared type 'Node?'
  return 0;
}
