import ::io;

// Optional types: declarations, None, widening, reassignment,
// optional parameters and returns.
class Node {
  v: int;
  next: Node?;
}

impl Node {
  fn __init__(x: int) { self.v = x; }
}

fn wrap(n: Node) -> Node? {
  return n;
}
fn pass(n: Node?) -> Node? {
  return n;
}

fn main() -> int {
  a: Node? = None;
  let b: Node? = Node(1);
  let n: Node = Node(2);
  let c: Node? = n;            // Node widens to Node?
  a = b;
  a = None;
  s: Str? = "text";
  s = None;
  let d: Node? = wrap(n);
  let e: Node? = pass(None);
  let f = pass(Node(3));       // inferred Node?
  match f {
    // an optional is not an Obj: unwrap it
    x: Node { let o: Obj = x; }
    None { }
  }
  io::println(f);                  // print takes an optional: None or the value
  return 0;
}
