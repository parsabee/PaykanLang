import ::io;

// Optional types: the only operators on an optional are == and !=
// — against None (a null check) or against another optional of a compatible
// type (both None -> equal, one None -> not equal, otherwise `equals`).
class Node {
  v: int;
}

impl Node {
  fn __init__(x: int) { self.v = x; }
}
class Leaf : Node {}

impl Leaf {
  fn __init__(x: int) { __super__(x); }
}

fn main() -> int {
  let a: Node? = None;
  let b: Node? = Node(1);
  let l: Leaf? = Leaf(2);
  if a == None {
    io::println("a is none");
  }
  if b != None {
    io::println("b is some");
  }
  if None == a {
    io::println("none == a");
  }
  io::println(Str<bool>(a == b));
  io::println(Str<bool>(b == l));    // subtype-compatible optionals
  let s: Str? = "x";
  let t: Str? = "x";
  io::println(Str<bool>(s == t));
  return 0;
}
