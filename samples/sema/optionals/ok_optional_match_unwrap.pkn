// Optional types: `match` is the unwrap.  A `Node` arm binds
// every present value, `None` (or `_`) covers the absent case, and a strict
// subclass arm matches on exact runtime type.
class Node {
  v: int;
  next: Node?;
  fn __init__(x: int)                        { self.v = x; }
}
class Leaf : Node {
  fn __init__(x: int)                        { __super__(x); }
}

fn value(n: Node?) -> int {
  match n {                                  // exhaustive: Node arm + None arm
    x: Node { return x.v; }
    None    { return -1; }
  }
}

fn kind(n: Node?) -> Str {
  match n {
    l: Leaf { return "leaf"; }
    x: Node { return "node"; }
    _       { return "none"; }
  }
}

fn main() -> int {
  a: Node? = Leaf(1);
  println(Str<int>(value(a)));
  println(kind(a));
  match a {                                  // unwrap first, then reach into the value
    n: Node {
      match n.next {
        m: Node { println(Str<int>(m.v)); }
        None    { println("tail"); }
      }
    }
    None { }
  }
  return 0;
}
