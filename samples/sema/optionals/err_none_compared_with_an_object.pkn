// Only an optional is ever `None` (#394): a value of a class type, `Obj`
// included, is not compared with it.
class Node {
  v: int;
}

impl Node {
  fn __init__(x: int) { self.v = x; }
}

fn main() -> int {
  let o: Obj = Node(1);
  if o == None {
    // error: cannot compare 'Obj' with None: only an optional is ever None
    return 1;
  }
  return 0;
}
