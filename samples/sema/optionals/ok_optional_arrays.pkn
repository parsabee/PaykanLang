import ::io;

// Optional types: arrays of optionals (`Node?[n]`, None slots).
class Node {
  v: int;
}

impl Node {
  fn __init__(x: int) { self.v = x; }
}

fn main() -> int {
  xs: Node?[2] = [None, Node(1)];
  xs[0] = Node(2);
  xs[1] = None;
  let e: Node? = xs[0];
  let p: Node? = xs[1];
  let ys: Node?[_] = [None, None];  // the None elements take the declared type
  match xs[0] {
    n: Node {
      io::println(Str<int>(n.v));
    }
    None { io::println("none"); }
  }
  return 0;
}
