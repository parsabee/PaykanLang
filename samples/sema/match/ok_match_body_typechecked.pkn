import ::io;

// OK: arm body is fully type-checked — local variables, method calls, assignments
class Dog {
  name: Str;
  view fn bark() -> Str { return "woof"; }
}

impl Dog {
  fn __init__(n: Str) { self.name = n; }
}

fn main() -> int {
  x: Obj = Dog("Rex");
  match x {
    d: Dog {
      sound: Str = d.bark();
      io::println(sound);
    }
    _ { }
  }
  return 0;
}
