// ERROR: a type arm tests for the object's exact class, and an object is of
// an abstract class (one with a pure virtual method it does not implement)
// only while it is being constructed, so an arm cannot name one:
//   a 'match' arm cannot name abstract class 'Shape': an object is of it only
//   while it is being constructed
class Shape {
  view fn area() -> float;
}

class Square : Shape {
  side: float;
  view fn area() -> float { return self.side * self.side; }
}

fn describe(o: Obj) -> int {
  match o {
    Shape { return 1; }
    Square { return 2; }
    _ { return 0; }
  }
}

fn main() -> int {
  return describe(Square(2.0));
}
