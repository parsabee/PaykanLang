// A primitive does not parse a string: that is a method of the string, which
// the error names, with the optional it returns.  Each old parse is one
// error, and what is built on it reports nothing more.
fn main() -> int {
  let s: Str = "12";
  let a = int(s);          // error: no specialization of 'int' for 'Str': parse a 'Str' with its method 'toInt()', which returns 'int?'
  let b = u8<Str>(s);      // error: no specialization of 'u8' for 'Str': parse a 'Str' with its method 'toU8()', which returns 'u8?'
  let c: bool = bool(s);   // error: no specialization of 'bool' for 'Str': parse a 'Str' with its method 'toBool()', which returns 'bool?'
  let d = char(s);         // error: no specialization of 'char' for 'Str'; its specializations are int, i8, i16, i32, u8, u16, u32, unsigned, char
  return 0;
}
