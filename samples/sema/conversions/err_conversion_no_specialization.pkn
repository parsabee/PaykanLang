// The inferred form picks the specialization for the argument's exact type;
// a user class has none.
class A {}
impl A {
  fn __init__() { }
}
fn main() -> int {
  a = A();
  s = Str(a);   // error: no specialization of 'Str' for 'A'; its specializations are int, float, bool, char, i8, i16, i32, u8, u16, u32, unsigned, f16, f32
  return 0;
}
