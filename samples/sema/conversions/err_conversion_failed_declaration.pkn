import ::io;

// ERROR: argument of 'Str<int>' has type 'float', expected 'int'
// The failed declaration of `a` is the only error reported: `a` is still
// declared (with an internal error type), so its later uses are not reported
// as "use of undeclared variable 'a'", and neither is anything built on it.
fn main() -> int {
  let n = 2.5;
  let a = Str<int>(n);
  io::println(a);
  let b = a + "!";
  io::println(b.len());
  return 0;
}
