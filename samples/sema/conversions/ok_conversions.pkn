// Every conversion constructor `Target<Source>(value)` with its result type.
fn main() -> int {
  i: int = 1;  f: float = 1.5;  b: bool = True;  c: char = 'c';  s: Str = "12";
  s1: Str = Str<int>(i);
  s2: Str = Str<float>(f);
  s3: Str = Str<bool>(b);
  s4: Str = Str<char>(c);
  p1: int? = int<Str>(s);                    // None for an invalid string
  p2: float? = float<Str>(s);
  n1: int = int<float>(f);
  n2: float = float<int>(i);
  n3: int = int<bool>(b);
  n4: bool = bool<int>(i);
  n5: int = int<char>(c);
  n6: char = char<int>(i);
  q1: bool? = bool<Str>(s);                  // exactly "True" / "False"
  // The boxed forms: a boxed source formats like its primitive, a boxed
  // target parses into the optional box.
  b1: Int? = Int<Str>(s);
  b2: Float? = Float<Str>(s);
  b3: Bool? = Bool<Str>(s);
  match b1 { x: Int { t: Str = Str<Int>(x); } None { } }
  match b2 { x: Float { t: Str = Str<Float>(x); } None { } }
  match b3 { x: Bool { t: Str = Str<Bool>(x); } None { } }
  cq: char? = c;
  o: Obj = cq;
  match o { x: Char { t: Str = Str<Char>(x); } _ { } }
  return 0;
}
