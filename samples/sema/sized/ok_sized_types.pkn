// The sized numeric types: literals take the type their context expects,
// every operation has one operand type, and the conversions cover every
// numeric pair.
struct Pixel { r: u8; g: u8; b: u8; a: f32; }
fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
  if v < lo { return lo; }
  if v > hi { return hi; }
  return v;
}
fn main() -> int {
  a: u8 = 255;                     // the literal is a u8
  b: u8 = a + 1;                   // u8 + u8 (the literal adapts)
  c: i8 = -128;
  d: unsigned = 7;
  e: u64 = d;                      // u64 is unsigned
  f: i64 = int(e);                 // i64 is int
  g: f32 = 1.5;
  h: f16 = g16(1);
  i = clamp(300, 0, 255);          // the literals are i32 arguments
  j: i32? = 5;
  k: u8 = u8(300);                 // 44: the low bits
  l: int = int(c) + 1;
  m: f64 = float(g);               // f64 is float
  n: unsigned? = unsigned("18446744073709551615");
  o = Str(a) + a.toString() + Str(g) + Str(e);
  p = a.hash() + e.hash();
  px = Pixel(1, 2, 3, 0.5);
  q: bool = px.r < 200 && px.a > 0.25;
  match a { 255 { } _ { } }
  return 0;
}
fn g16(v: f16) -> f16 { return v * 2; }
