// ERROR: an override must have the same parameter and return types as the
// base method (strict equality — no covariance).
class Animal {
  fn describe() -> int { return 1; }
}

impl Animal {
  fn __init__() { }
}

class Dog : Animal {
  fn describe() -> Str { return "dog"; }  // return type mismatch
}

impl Dog {
  fn __init__() { __super__(); }
}

fn main() -> int {
  return 0;
}
