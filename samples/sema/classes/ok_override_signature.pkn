// OK: overrides keep the base signature; toString/equals overrides of the Obj
// root with their correct signatures are valid.
class Animal {
  view fn describe() -> int { return 1; }
  view fn toString() -> Str { return "animal"; }
  view fn equals(other: Obj) -> bool { return True; }
}

impl Animal {
  fn __init__() {}
}

class Dog : Animal {
  view fn describe() -> int { return 2; }       // matching signature
  view fn toString() -> Str { return "dog"; }   // valid Obj override
}

impl Dog {
  fn __init__() { __super__(); }
}

fn main() -> int {
  return 0;
}
