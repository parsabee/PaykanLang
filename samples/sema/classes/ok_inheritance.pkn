// OK: inheritance with __super__ call
class Animal {
  name: Str;

  view fn getName() -> view Str { return self.name; }
}

impl Animal {
  fn __init__(n: Str) { self.name = move n; }
}

class Dog : Animal {
  breed: Str;

  view fn getBreed() -> view Str { return self.breed; }

  view fn describe() -> view Str { return self.name; }
}

impl Dog {
  fn __init__(n: Str, b: Str) { __super__(move n); self.breed = move b; }
}

fn main() -> int {
  return 0;
}
