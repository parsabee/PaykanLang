// OK: inheritance with __super__ call
class Animal {
  name: Str;

  fn __init__(n: Str) {
    self.name = n;
  }

  view fn getName() -> view Str {
    return self.name;
  }
}

class Dog : Animal {
  breed: Str;

  fn __init__(n: Str, b: Str) {
    __super__(n);
    self.breed = b;
  }

  view fn getBreed() -> view Str {
    return self.breed;
  }

  view fn describe() -> view Str {
    return self.name;
  }
}

fn main() -> int {
  return 0;
}
