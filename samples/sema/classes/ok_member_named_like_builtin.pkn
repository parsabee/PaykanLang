import ::io;

// OK: fields and methods live in their own per-class namespace, so they may
// reuse a standard library function's name (io::print, io::open), which
// stays callable.
class Logger {
  count: int;

  fn print(msg: Str) { self.count = self.count + 1; io::println(msg); }
}

impl Logger {
  fn __init__() { self.count = 0; }
}

class Stats {
  open: int;
}

impl Stats {
  fn __init__() { self.open = 1; }
}

fn main() -> int {
  let l: Logger = Logger();
  l.print("first");
  io::print("second\n");
  let s: Stats = Stats();
  return s.open - 1;
}
