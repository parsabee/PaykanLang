// ERROR: __super__() is required as the first statement even when the base
// __init__ takes no parameters.
class Base {}

impl Base {
  fn __init__() { }
}

class Derived : Base {
  x: int;
}

impl Derived {
  fn __init__(v: int) {
    self.x = v;   // missing: __super__();
  }
}

fn main() -> int {
  return 0;
}
