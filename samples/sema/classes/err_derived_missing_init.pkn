// ERROR: a derived class must declare an __init__ (that calls __super__) when
// its base declares one — otherwise the base initializer never runs.
class Base {
  val: int;
  fn __init__(v: int) { self.val = v; }
}

class Derived : Base {
  y: int;
  // no __init__ declared at all
}

fn main() -> int {
  return 0;
}
