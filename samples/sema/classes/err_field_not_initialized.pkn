// ERROR: __init__ must assign every field on every path; 'y' is left unset.
class Bad {
  x: int;
  y: int;
  view fn toString() -> Str {
    return Str<int>(self.x) + "," + Str<int>(self.y);
  }
}

impl Bad {
  fn __init__(a: int) {
    self.x = a;
    // missing: self.y = ...
  }
}

fn main() -> int {
  return 0;
}
