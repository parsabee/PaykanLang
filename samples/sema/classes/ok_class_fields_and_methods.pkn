// OK: class with fields, __init__, and a getter method
class Point {
  x: int;
  y: int;

  fn __init__(x: int, y: int)                { self.x = x; self.y = y; }

  fn getX() -> int                           { return self.x; }

  fn getY() -> int                           { return self.y; }
}

fn main() -> int                             { return 0; }
