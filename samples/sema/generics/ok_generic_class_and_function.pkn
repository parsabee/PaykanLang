// OK: generic class and function templates, instantiated in every type
// position: variable annotation, field, parameter, return, array element,
// nested argument, match arm, explicit constructor / call type arguments,
// and inferred function type arguments.
class Box<T> {
  v: T;
  fn __init__(v: T) { self.v = v; }
  view fn get() -> view T { return self.v; }
}

class Pair<K, V> {
  k: K;
  v: V;
  fn __init__(k: K, v: V) { self.k = k; self.v = v; }
  view fn key() -> view K { return self.k; }
}

class Holder {
  b: Box<int>;
  ps: Pair<Str, int>[];
  fn __init__() { self.b = Box<int>(1); self.ps = []; }
  view fn get() -> view Box<int> { return self.b; }
}

fn first<T>(xs: T[]) -> T { return xs[0]; }
fn unbox<T>(b: view Box<T>) -> T { return b.get(); }

fn describe(o: Obj) -> Str {
  match o {
    b: Box<int> { return Str<int>(b.get()); }
    Box<Str>    { return "str"; }
    _           { return "other"; }
  }
}

fn main() -> int {
  h: Holder = Holder();
  n: int = unbox(h.get());
  m: int = unbox<int>(Box<Box<int>>(Box<int>(1)).get());
  arr: Box<int>[] = [Box<int>(1), Box<int>(2)];
  k: view Str = Pair<Str, int>("a", 1).key();
  s: Str = first(["x"]);
  i: int = first<int>([3]);
  inferred = Box(5);
  println(describe(inferred));
  return n + m + i;
}
