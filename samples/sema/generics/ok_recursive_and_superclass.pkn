// OK: a generic class may refer to its own instantiation (`Node<T>`) in a
// method signature, and may extend a concrete class.
class Base {
  n: int;
  view fn num() -> int { return self.n; }
}

impl Base {
  fn __init__(n: int) { self.n = n; }
}

class Wrap<T> : Base {
  v: T;
  view fn get() -> view T { return self.v; }
}

impl Wrap<T> {
  fn __init__(v: T, n: int) { __super__(n); self.v = move v; }
}

class Node<T> {
  v: T;
  next: Obj;
  fn link(n: Node<T>) { self.next = move n; }
}

impl Node<T> {
  fn __init__(v: T) { self.v = move v; self.next = None; }
}

fn main() -> int {
  let w = Wrap("a", 5);
  b: view Base = w;
  let a: mut = Node(1);
  a.link(Node(2));
  return b.num() + w.num();
}
