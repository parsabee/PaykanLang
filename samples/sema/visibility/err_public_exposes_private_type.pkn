// A public function, field or method cannot name a `__` type: an importer
// could receive a value it cannot name.
class __Hidden { v: int; }
fn make() -> __Hidden { return __Hidden(1); }   // error: 'make' is public but its result names the private type '__Hidden'
class Pub { h: __Hidden; }                       // error: field 'h' of 'Pub' is public but it names the private type '__Hidden'
fn main() -> int { return make().v; }
