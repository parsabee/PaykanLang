import ::io;

// OK: a function type `(T1, T2) -> R` names what a function value takes and
// returns; a value is a lambda or a named function, stored, passed, returned
// and called like a function; a lambda captures the variables around it by
// copy.
fn square(x: int) -> int {
  return x * x;
}
fn apply(f: (int) -> int, x: int) -> int {
  return f(x);
}
fn twice(f: (int) -> int) -> (int) -> int {
  return fn(x: int) -> int {
    return f(f(x));
  };
}

class Button {
  label: Str;
  onClick: (Str) -> void;
}
struct Op {
  name: Str;
  run: (int, int) -> int;
}

fn main() -> int {
  let n = 10;
  let add = fn(x: int) -> int {
    return x + n;
  };  // captures n
  let g: (int) -> int = square;
  let fs: ((int) -> int)[2] = [square, twice(add)];
  let b = Button("ok", fn(l: Str) { io::println(l); });
  b.onClick("clicked");
  let o = Op("add", fn(a: int, b: int) -> int { return a + b; });
  let v = fn(s: view Str, c: inout int) -> bool {
    c = c + s.len();
    return c > 3;
  };
  m = 0;
  let ok = v("abc", m);
  let opt: (() -> int)? = fn() -> int {
    return 1;
  };
  match opt {
    f: () -> int { m = m + f(); }
    None { }
  }
  return apply(g, 3) + fs[1](2) + o.run(1, 2) + add(1) + (if ok then m else 0);
}
