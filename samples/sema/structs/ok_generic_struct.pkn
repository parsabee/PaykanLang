// OK: a generic struct is a template, instantiated by its type arguments
// (`Pair<int, Str>`) or inferred from a constructor call (`Pair(1, "a")`);
// its `impl` blocks name the type parameters and apply to every
// instantiation, and so do `impl Trait for` blocks.
struct Pair<A, B> {
  a: A;
  b: B;
}

impl Pair<A, B> {
  view fn first() -> view A { return self.a; }
  fn swapWith(other: inout Pair<A, B>)
                            { let t = self.a; self.a = other.a; other.a = t; }
}

impl Hashable for Pair<A, B> {
  view fn hash() -> int { return 1; }
}

struct Box<T> {
  v: T;
}

impl Box<T> {
  fn __init__(v: T)       { self.v = v; }
  view fn get() -> view T { return self.v; }
}

fn sum(p: view Pair<int, int>) -> int {
  return p.a + p.b;
}
fn firstOf<A, B>(p: view Pair<A, B>) -> view A {
  return p.a;
}
fn hashOf<T: Hashable>(x: view T) -> int {
  return x.hash();
}

fn main() -> int {
  p = Pair(1, "one");
  q: Pair<int, Str> = Pair<int, Str>(2, "two");
  p.swapWith(q);
  let b = Box(Pair(3, 4));
  let bs: Box<int>[2] = [Box(1), Box(2)];
  let n: int = firstOf(p) + 1;
  return sum(b.get()) + p.first() + bs[1].v + hashOf(q) + n;
}
