// Demonstrates logical operators && and ||

fn main() -> int {
  // Basic truth tables
  out("=== AND ===");
  out("T && T = ", StringBool(True && True));
  out("T && F = ", StringBool(True && False));
  out("F && T = ", StringBool(False && True));
  out("F && F = ", StringBool(False && False));

  out("=== OR ===");
  out("T || T = ", StringBool(True || True));
  out("T || F = ", StringBool(True || False));
  out("F || T = ", StringBool(False || True));
  out("F || F = ", StringBool(False || False));

  // With relational operators
  x: int = 5;
  inRange: bool = x > 0 && x < 10;
  out("5 in (0,10)? ", StringBool(inRange));

  outOfRange: bool = x < 0 || x > 100;
  out("5 out of [0,100]? ", StringBool(outOfRange));

  // Chained logical with short-circuit
  a: bool = True || False && False;   // True (|| short-circuits)
  b: bool = False && True || True;    // True (first && is false, then || True)
  out("T || F && F = ", StringBool(a));
  out("F && T || T = ", StringBool(b));

  // Combined with if
  y: int = 15;
  if (y > 10 && y < 20) {
    out("y is a teen");
  }

  // Combined with while
  i: int = 0;
  j: int = 100;
  while (i < 10 && j > 90) {
    i = i + 1;
    j = j - 1;
  }
  out("i=", StringInt(i), " j=", StringInt(j));

  return 0;
}
