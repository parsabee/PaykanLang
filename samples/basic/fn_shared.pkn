// Functions with shared ownership — refcounting across calls

fn hello() {
  out("hello from shared caller");
}

fn main() -> int {
  a: shared String = "shared value";
  out(&a);

  // Shared reassignment inside a scope
  {
    b: shared String = "temporary";
    a = b;
    out(&a);
    out(&b);
    // b released here; refcount drops to 1 (a still holds it)
  }

  // a still alive — holds "temporary"
  out(&a);

  hello();
  return 0;
}
