// Passing constructor results and expressions directly to functions

fn twice(x: int) -> int {
  return x + x;
}

fn main() -> int {
  // Pass constructor results directly via out (builtin, no mov needed)
  out(StringInt(100));
  out(StringFloat(3.14));
  out(StringBool(True));
  out(String("literal passthrough"));

  // Pass nested call results
  out(StringInt(twice(21)));
  out(StringInt(twice(twice(5))));

  // Chain: construct from expression
  a: int = 7;
  out(StringInt(a * a + 1));

  return 0;
}
