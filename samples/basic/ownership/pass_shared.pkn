// Passing to shared parameters: shared var or mov from unique/shared.

fn hold(s: shared String) -> int {
  return 11;
}

fn main() -> int {
  // shared → shared (refcount bump)
  a: shared String = "shared arg";
  acc: int = hold(a);       // 11
  acc = acc + hold(a);      // a still alive, 11

  // mov unique → shared
  b: String = "unique to shared";
  acc = acc + hold(mov b);  // 11

  return acc;   // exit 33
}
