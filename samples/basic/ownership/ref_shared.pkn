// Borrowing a shared variable via const &.
// Shared vars can only be borrowed as const references.

fn display(s: const String&) -> int {
  return 4;
}

fn peek(s: shared String) -> int {
  return 6;
}

fn main() -> int {
  a: shared String = "shared val";
  acc: int = display(&a);    // const & borrow of shared → 4
  acc = acc + peek(a);       // a still alive after const borrow → 6
  return acc;   // exit 10
}
