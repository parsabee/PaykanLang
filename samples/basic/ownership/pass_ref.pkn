// Passing to reference parameters: & on owned vars, direct for ref vars.

fn modify(s: String&) -> int {
  return 9;
}

fn main() -> int {
  a: String = "owned";
  acc: int = modify(&a);     // borrow unique via & → 9

  r: String& = &a;
  acc = acc + modify(r);     // ref var passes directly to ref param → 9

  return acc;   // exit 18
}
