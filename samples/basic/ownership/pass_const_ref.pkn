// Passing rvalues and literals to const T& parameters.

fn show(s: const String&) -> int {
  return 5;
}

fn main() -> int {
  // String literal → const ref (rvalue OK)
  acc: int = show("hello literal");     // 5

  // Constructor result → const ref
  acc = acc + show(StringInt(99));       // 5
  acc = acc + show(StringBool(True));    // 5

  // & on owned var → const ref
  a: String = "owned";
  acc = acc + show(&a);                 // 5

  // ref var → const ref
  r: String& = &a;
  acc = acc + show(r);                  // 5

  return acc;   // exit 25
}
