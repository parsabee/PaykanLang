// Reference: borrowing a unique variable via &.

fn inspect(s: const String&) -> int {
  return 5;
}

fn peek(s: String&) -> int {
  return 3;
}

fn main() -> int {
  a: String = "original";

  // r borrows a — no ownership transfer
  r: String& = &a;
  acc: int = peek(r);          // ref var to ref param → 3

  // Can also pass references to const ref params
  acc = acc + inspect(&a);     // & on unique to const ref → 5

  return acc;   // exit 8
}
