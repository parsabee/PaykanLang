// Passing to unique parameters requires mov.

fn consume(s: String) -> int {
  return 15;
}

fn main() -> int {
  a: String = "to be consumed";
  acc: int = consume(mov a);
  // a is now dead

  // Can also mov a shared into a unique param
  b: shared String = "shared to unique";
  acc = acc + consume(mov b);

  return acc;   // exit 30
}
