// Move semantics: transferring unique ownership between variables and into calls.

fn consume(s: String) -> int {
  return 10;
}

fn main() -> int {
  a: String = "alpha";
  acc: int = 0;

  // Move ownership from a to b — a is now dead.
  b: String = mov a;

  // Move into a function call — b is now dead.
  acc = acc + consume(mov b);

  // Chain: create, move to var, move to call.
  c: String = "gamma";
  d: String = mov c;
  acc = acc + consume(mov d);

  return acc;   // exit 20
}
