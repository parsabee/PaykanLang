// Functions with reference and move semantics

fn printIt(s: String&) {
  out(s);
}

fn consume(s: String) {
  out(&s);
}

fn main() -> int {
  original: String = "hello world";

  // Reference aliases the original — no copy, no ownership transfer
  alias: String& = &original;
  out(alias);
  out(&original);

  // Pass reference to function — ref doesn't require mov
  printIt(alias);

  // Move original into the call — transfers ownership
  consume(mov original);

  return 0;
}
