// String constructors — convert builtin types to String

fn main() -> int {
  // From integer
  a: String = StringInt(42);
  out(&a);

  // From float
  b: String = StringFloat(3.14);
  out(&b);

  // From bool
  c: String = StringBool(True);
  out(&c);

  d: String = StringBool(False);
  out(&d);

  // From string literal (identity)
  e: String = String("hello world");
  out(&e);

  // From expression
  x: int = 100;
  f: String = StringInt(x + 23);
  out(&f);

  return 0;
}
