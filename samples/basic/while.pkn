// Demonstrates while loops

fn main() -> int {
  // Count from 0 to 4
  i: int = 0;
  while (i < 5) {
    out(StringInt(i));
    i = i + 1;
  }

  // Sum 1..10
  sum: int = 0;
  n: int = 1;
  while (n <= 10) {
    sum = sum + n;
    n = n + 1;
  }
  out("sum 1..10 = ", StringInt(sum));

  // Nested loops: multiplication table (3x3)
  row: int = 1;
  while (row <= 3) {
    col: int = 1;
    while (col <= 3) {
      out(StringInt(row), " * ", StringInt(col), " = ", StringInt(row * col));
      col = col + 1;
    }
    row = row + 1;
  }

  // While with if inside: print even numbers < 10
  j: int = 0;
  while (j < 10) {
    if (j % 2 == 0) {
      out("even: ", StringInt(j));
    }
    j = j + 1;
  }

  return 0;
}
