// Passing builtin types (int, float, bool) to functions — no mov needed

fn addInts(a: int, b: int) -> int {
  return a + b;
}

fn addFloats(a: float, b: float) -> float {
  return a + b;
}

fn intToStr(x: int) {
  out(StringInt(x));
}

fn floatToStr(x: float) {
  out(StringFloat(x));
}

fn boolToStr(b: bool) {
  out(StringBool(b));
}

fn main() -> int {
  // Pass int literals and variables
  x: int = addInts(10, 20);
  y: int = addInts(x, 5);
  intToStr(y);

  // Pass float literals and variables
  f: float = addFloats(1.5, 2.5);
  floatToStr(f);

  // Pass bool literals and variables
  t: bool = True;
  boolToStr(t);
  boolToStr(False);

  // Pass expressions as args
  intToStr(addInts(1, 2) + 100);
  floatToStr(addFloats(0.1, 0.2));

  return 0;
}
