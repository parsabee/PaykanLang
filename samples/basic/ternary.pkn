// Ternary expression: if <cond> then <expr> else <expr>

fn abs(x: int) -> int {
  return if x < 0 then 0 - x else x;
}

fn max(a: int, b: int) -> int {
  return if a > b then a else b;
}

fn main() -> int {
  // Basic ternary
  x: int = if True then 10 else 20;
  out(StringInt(x));

  // Ternary with relational condition
  y: int = if 5 > 3 then 100 else 200;
  out(StringInt(y));

  // Nested ternary (else-if chain)
  grade: int = 85;
  label: int = if grade > 90 then 1
               else if grade > 80 then 2
               else if grade > 70 then 3
               else 4;
  out(StringInt(label));

  // Ternary in function
  out(StringInt(abs(0 - 42)));
  out(StringInt(max(10, 20)));

  return 0;
}
