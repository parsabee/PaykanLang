// Functions with unique ownership and mov semantics

fn consume(s: String) {
  out(&s);
}

fn main() -> int {
  // Move into a function call — transfers ownership
  a: String = "owned by a";
  d: String = mov a;
  consume(mov d);

  // Move between variables, then into a call
  b: String = "will be moved";
  c: String = mov b;
  consume(mov c);

  return 0;
}
