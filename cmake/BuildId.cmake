# BuildId.cmake -- writes BuildId.h, the compiler's build ID (#188).
#
# Script mode, run by the paykan_build_id target on every build:
#
#   cmake -DSOURCE_DIR=<src> -DOUTPUT=<BuildId.h> -DRELEASE=<ON|OFF>
#         -P BuildId.cmake
#
# The build ID tells apart two builds of the same version: a module cache
# entry (.paykan_cache/*.pkm) records the ID of the paykan that wrote it and
# is rebuilt by any other (pkm::checkCompatibility, docs/design/pkm.md
# §2.2).  It is a hash of the contents of the compiler's sources, src/ and
# include/, so it changes with any edit, committed or not, and stays the same
# for a rebuild of the same sources.  A release build (-DPAYKAN_RELEASE=ON)
# has none: its version alone identifies it.  The header is rewritten only
# when the ID changes, so an unchanged build recompiles nothing.

foreach(var SOURCE_DIR OUTPUT)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "BuildId.cmake: ${var} is not set")
    endif()
endforeach()

set(build_id "")
if(NOT RELEASE)
    file(GLOB_RECURSE sources LIST_DIRECTORIES false
        "${SOURCE_DIR}/src/*" "${SOURCE_DIR}/include/*")
    list(SORT sources)
    set(listing "")
    foreach(f IN LISTS sources)
        file(SHA256 "${f}" digest)
        file(RELATIVE_PATH rel "${SOURCE_DIR}" "${f}")
        string(APPEND listing "${rel} ${digest}\n")
    endforeach()
    string(SHA256 digest "${listing}")
    string(SUBSTRING "${digest}" 0 16 build_id)
endif()

set(content "// Generated by cmake/BuildId.cmake; do not edit.
// The build ID of this paykan: a hash of its sources, or empty for a release
// build (PAYKAN_RELEASE).
#pragma once

namespace paykan {
inline constexpr const char *kBuildId = \"${build_id}\";
} // namespace paykan
")

set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
