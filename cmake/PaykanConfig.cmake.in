# PaykanConfig.cmake -- find_package(Paykan)
# ----------------------------------------------------------------------------
# Imported targets (all static, namespace Paykan::):
#   Paykan::plugin                    the plugin compatibility check
#   Paykan::ast Paykan::diag Paykan::frontend Paykan::ast_printer Paykan::sema
#   Paykan::pir Paykan::backend       the compiler core (standard C++ only)
#   Paykan::runtime                   the C runtime every backend's output links
#   Paykan::driver                    the `paykan` driver as a library (has main)
#   Paykan::frontend_<name>, Paykan::backend_<name>
#                                     the plugins this installation was built with
#
# Variables:
#   PAYKAN_PLUGINS      the installed plugin targets (exported names)
#   PAYKAN_FRONTENDS    the frontends this installation was built with
#   PAYKAN_BACKENDS     the backends this installation was built with
#   PAYKAN_RUNTIME_LIBRARY      the installed libpaykan_runtime.a
#   PAYKAN_RUNTIME_INCLUDE_DIR  the directory of the installed Runtime.h
#   PAYKAN_TOOLCHAIN_VERSION    this installation's version, pre-release label
#                               included ("0.1.0-alpha"): the version a plugin
#                               compiled against it records as its build version
#   PAYKAN_PLUGIN_COMPATIBLE_VERSIONS
#                               the plugin build versions this installation
#                               accepts (cmake/PluginCompat.cmake; exact match)
#
# Functions:
#   paykan_add_frontend_plugin(<target> [BUILT_WITH <version>] <source>...)
#   paykan_add_backend_plugin(<target> [BUILT_WITH <version>] <source>...)
#       Add a static frontend / backend plugin library <target> linked with
#       Paykan::frontend / Paykan::backend.  BUILT_WITH is the PaykanLang
#       version the plugin is built with (default: PAYKAN_TOOLCHAIN_VERSION,
#       the installation it compiles against); a plugin may pin it to the
#       version it is written for.  Configure fails with a FATAL_ERROR unless
#       that version is in PAYKAN_PLUGIN_COMPATIBLE_VERSIONS.
#   paykan_add_driver(<target> [PLUGINS <lib>...])
#       Add an executable <target>: the paykan driver linked with every
#       installed plugin plus the given ones (static registration needs them
#       linked whole, which this does).  The driver looks for the runtime
#       at PAYKAN_RUNTIME_LIBRARY / PAYKAN_RUNTIME_INCLUDE_DIR (after
#       $PAYKAN_RUNTIME_DIR), wherever its own executable is.
#       See docs/writing-a-backend.md.
# ----------------------------------------------------------------------------
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(PAYKAN_FRONTENDS "@PAYKAN_FRONTENDS@")
set(PAYKAN_BACKENDS "@PAYKAN_BACKENDS@")
set(PAYKAN_PLUGINS "@PAYKAN_CONFIG_PLUGINS@")
set(PAYKAN_NEEDS_LLVM @PAYKAN_NEEDS_LLVM@)
set_and_check(PAYKAN_RUNTIME_LIBRARY "@PACKAGE_PAYKAN_CONFIG_RUNTIME_LIBRARY@")
set_and_check(PAYKAN_RUNTIME_INCLUDE_DIR "@PACKAGE_PAYKAN_CONFIG_RUNTIME_INCLUDE_DIR@")
set(PAYKAN_TOOLCHAIN_VERSION "@PAYKAN_VERSION@")
set(PAYKAN_PLUGIN_COMPATIBLE_VERSIONS "@PAYKAN_PLUGIN_COMPATIBLE_VERSIONS@")

if(PAYKAN_NEEDS_LLVM)
    # The llvm backend's libraries reference LLVM's imported targets.
    find_dependency(LLVM CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PaykanTargets.cmake")

function(paykan_add_driver target)
    cmake_parse_arguments(ARG "" "" "PLUGINS" ${ARGN})
    # An executable needs a source; the driver's main() comes from
    # Paykan::driver (crt references main, so the archive member is pulled).
    # The source also records this package's runtime for the toolchain, so
    # `run` / `build` find it however far the driver is from the prefix.
    set(stub "${CMAKE_CURRENT_BINARY_DIR}/${target}_paykan_driver_stub.cpp")
    file(CONFIGURE OUTPUT "${stub}" @ONLY CONTENT [=[
// Generated by paykan_add_driver: the driver's main() is in Paykan::driver.
#include "paykan/backends/Toolchain.h"

namespace {
// The installed runtime of the Paykan package this driver was built against.
const struct PackageRuntime {
  PackageRuntime() {
    paykan::toolchain::setPackageRuntime(PAYKAN_PACKAGE_RUNTIME_LIBRARY,
                                         PAYKAN_PACKAGE_RUNTIME_INCLUDE_DIR);
  }
} packageRuntime;
} // namespace
]=])
    add_executable(${target} "${stub}")
    target_compile_definitions(${target} PRIVATE
        PAYKAN_PACKAGE_RUNTIME_LIBRARY="${PAYKAN_RUNTIME_LIBRARY}"
        PAYKAN_PACKAGE_RUNTIME_INCLUDE_DIR="${PAYKAN_RUNTIME_INCLUDE_DIR}")
    target_link_libraries(${target} PRIVATE Paykan::driver
                                            Paykan::backend_toolchain)
    foreach(plugin IN LISTS PAYKAN_PLUGINS ARG_PLUGINS)
        target_link_libraries(${target} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${plugin}>")
    endforeach()
endfunction()

# The plugin compatibility check at configure time (#103): the same list a
# running paykan checks a plugin's build version against.
# BUILT_WITH is parsed with PARSE_ARGV, so `BUILT_WITH ""` (an unset cache
# variable, say) keeps its empty value and means the default.
function(_paykan_add_plugin_library kind target built_with)
    if(built_with STREQUAL "")
        set(built_with "${PAYKAN_TOOLCHAIN_VERSION}")
    endif()
    if(NOT built_with IN_LIST PAYKAN_PLUGIN_COMPATIBLE_VERSIONS)
        list(JOIN PAYKAN_PLUGIN_COMPATIBLE_VERSIONS ", " accepted)
        message(FATAL_ERROR
            "Paykan ${kind} plugin '${target}' is incompatible: built with "
            "PaykanLang ${built_with}; the installed PaykanLang "
            "${PAYKAN_TOOLCHAIN_VERSION} (${Paykan_DIR}) accepts ${accepted}")
    endif()
    if(NOT ARGN)
        message(FATAL_ERROR "paykan_add_${kind}_plugin(${target}): no sources")
    endif()
    add_library(${target} STATIC ${ARGN})
    target_link_libraries(${target} PUBLIC Paykan::${kind})
endfunction()

function(paykan_add_frontend_plugin target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "BUILT_WITH" "")
    _paykan_add_plugin_library(frontend ${target} "${ARG_BUILT_WITH}"
                               ${ARG_UNPARSED_ARGUMENTS})
endfunction()

function(paykan_add_backend_plugin target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "BUILT_WITH" "")
    _paykan_add_plugin_library(backend ${target} "${ARG_BUILT_WITH}"
                               ${ARG_UNPARSED_ARGUMENTS})
endfunction()

check_required_components(Paykan)
