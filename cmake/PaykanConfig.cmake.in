# PaykanConfig.cmake -- find_package(Paykan)
# Imported targets (namespace Paykan::):
#   Paykan::plugin_api                the C plugin interface
#                                     (paykan/plugin_api.h, header only): all
#                                     a loadable plugin compiles against
#   Paykan::plugin                    the plugin compatibility check
#   Paykan::ast Paykan::diag Paykan::frontend Paykan::ast_printer Paykan::sema
#   Paykan::pir Paykan::backend       the compiler core (standard C++ only)
#   Paykan::runtime                   the C runtime every backend's output links
#   Paykan::driver                    the `paykan` driver as a library (has main)
#   Paykan::frontend_<name>, Paykan::backend_<name>
#                                     the plugins this installation was built with
#
# Variables:
#   PAYKAN_PLUGINS      the installed plugin targets (exported names)
#   PAYKAN_FRONTENDS    the frontends this installation was built with
#   PAYKAN_BACKENDS     the backends this installation was built with
#   PAYKAN_RUNTIME_LIBRARY      the installed libpaykan_runtime.a
#   PAYKAN_RUNTIME_INCLUDE_DIR  the directory of the installed Runtime.h
#   PAYKAN_TOOLCHAIN_VERSION    this installation's version, pre-release label
#                               included (e.g. "1.2.3", or "1.2.3-rc1" for
#                               a pre-release): the version a plugin
#                               compiled against it records as its build version
#   PAYKAN_PLUGIN_COMPATIBLE_VERSIONS
#                               the plugin build versions this installation
#                               accepts (cmake/PluginCompat.cmake; exact match)
#   PAYKAN_PLUGIN_API_VERSION   the plugin API version of paykan/plugin_api.h
#   PAYKAN_PLUGIN_INSTALL_DIR   the installation's system plugin directory,
#                               <prefix>/lib/paykan/plugins/<version>: the
#                               installed `paykan` loads every plugin in it
#   PAYKAN_EXECUTABLE           the installed `paykan`
#
# Functions:
#   paykan_add_frontend_plugin(<target> [BUILT_WITH <version>] <source>...)
#   paykan_add_backend_plugin(<target> [BUILT_WITH <version>] <source>...)
#       Add a loadable frontend / backend plugin <target>: a shared module
#       (lib<target>.so, .dylib on macOS) with the C interface of
#       paykan/plugin_api.h, linked with nothing of PaykanLang
#       (Paykan::plugin_api only provides the header).  Its sources may be C
#       or C++ (or the module may wrap a library built in another language).
#       BUILT_WITH is the PaykanLang version the plugin is built with
#       (default: PAYKAN_TOOLCHAIN_VERSION, the installation it compiles
#       against); a plugin may pin it to the version it is written for.  It
#       is defined as PAYKAN_PLUGIN_BUILD_VERSION, which the descriptor
#       carries for paykan's check at load time.  Configure fails with a
#       FATAL_ERROR unless that version is in
#       PAYKAN_PLUGIN_COMPATIBLE_VERSIONS.  The module's symbols are hidden
#       but for the entry point (PAYKAN_PLUGIN_EXPORT).
#   paykan_check_plugin_built_with(<kind> <name> <version> <out-var>)
#       The configure-time version check alone, for a plugin that is not a
#       CMake library target (built by another toolchain): FATAL_ERROR unless
#       <version> (empty: PAYKAN_TOOLCHAIN_VERSION) is accepted; sets
#       <out-var> to the version.
#   paykan_install_plugin(<target>...)
#       Install the plugin modules into PAYKAN_PLUGIN_INSTALL_DIR, where the
#       installed `paykan` finds them (docs/plugins/overview.md).
#   paykan_add_driver(<target> [PLUGINS <lib>...])
#       Add an executable <target>: the paykan driver linked with every
#       installed plugin plus the given ones (static registration needs them
#       linked whole, which this does).  The driver looks for the runtime
#       at PAYKAN_RUNTIME_LIBRARY / PAYKAN_RUNTIME_INCLUDE_DIR (after
#       $PAYKAN_RUNTIME_DIR), wherever its own executable is.
#       See docs/writing-a-backend.md.
#   paykan_add_frontend_tests(<frontend> PLUGIN <target-or-file>)
#       The parser, Sema and frontend suites against a frontend plugin
#       (PaykanFrontendTests.cmake; docs/writing-a-frontend-plugin.md).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(PAYKAN_FRONTENDS "@PAYKAN_FRONTENDS@")
set(PAYKAN_BACKENDS "@PAYKAN_BACKENDS@")
set(PAYKAN_PLUGINS "@PAYKAN_CONFIG_PLUGINS@")
set(PAYKAN_NEEDS_LLVM @PAYKAN_NEEDS_LLVM@)
set_and_check(PAYKAN_RUNTIME_LIBRARY "@PACKAGE_PAYKAN_CONFIG_RUNTIME_LIBRARY@")
set_and_check(PAYKAN_RUNTIME_INCLUDE_DIR "@PACKAGE_PAYKAN_CONFIG_RUNTIME_INCLUDE_DIR@")
set(PAYKAN_TOOLCHAIN_VERSION "@PAYKAN_VERSION@")
set(PAYKAN_PLUGIN_COMPATIBLE_VERSIONS "@PAYKAN_PLUGIN_COMPATIBLE_VERSIONS@")
set(PAYKAN_PLUGIN_API_VERSION "@PAYKAN_PLUGIN_API_VERSION@")
set(PAYKAN_PLUGIN_INSTALL_DIR "@PACKAGE_PAYKAN_CONFIG_PLUGIN_INSTALL_DIR@")
set(PAYKAN_EXECUTABLE "@PACKAGE_PAYKAN_CONFIG_EXECUTABLE@")

if(PAYKAN_NEEDS_LLVM)
    # The llvm backend's libraries reference LLVM's libraries.  Only a
    # consumer that links them (paykan_add_driver with the llvm backend)
    # needs LLVM, so it is looked for, not required: a backend or frontend
    # plugin built against this package (Paykan::plugin_api) builds without
    # LLVM installed.  Pass -DLLVM_DIR=<llvm>/lib/cmake/llvm to link the
    # llvm backend into a driver.
    find_package(LLVM CONFIG QUIET)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PaykanTargets.cmake")

function(paykan_add_driver target)
    cmake_parse_arguments(ARG "" "" "PLUGINS" ${ARGN})
    # An executable needs a source; the driver's main() comes from
    # Paykan::driver (crt references main, so the archive member is pulled).
    # The source also records this package's runtime for the toolchain, so
    # `run` / `build` find it however far the driver is from the prefix.
    set(stub "${CMAKE_CURRENT_BINARY_DIR}/${target}_paykan_driver_stub.cpp")
    file(CONFIGURE OUTPUT "${stub}" @ONLY CONTENT [=[
// Generated by paykan_add_driver: the driver's main() is in Paykan::driver.
#include "paykan/backends/Toolchain.h"

namespace {
// The installed runtime of the Paykan package this driver was built against.
const struct PackageRuntime {
  PackageRuntime() {
    paykan::toolchain::setPackageRuntime(PAYKAN_PACKAGE_RUNTIME_LIBRARY,
                                         PAYKAN_PACKAGE_RUNTIME_INCLUDE_DIR);
  }
} packageRuntime;
} // namespace
]=])
    add_executable(${target} "${stub}")
    target_compile_definitions(${target} PRIVATE
        PAYKAN_PACKAGE_RUNTIME_LIBRARY="${PAYKAN_RUNTIME_LIBRARY}"
        PAYKAN_PACKAGE_RUNTIME_INCLUDE_DIR="${PAYKAN_RUNTIME_INCLUDE_DIR}")
    target_link_libraries(${target} PRIVATE Paykan::driver
                                            Paykan::backend_toolchain)
    foreach(plugin IN LISTS PAYKAN_PLUGINS ARG_PLUGINS)
        target_link_libraries(${target} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${plugin}>")
    endforeach()
endfunction()

# The plugin compatibility check at configure time (#103): the same list a
# running paykan checks a plugin's build version against.  Sets
# <out_var> to the version the plugin is built with.
function(paykan_check_plugin_built_with kind target built_with out_var)
    if(built_with STREQUAL "")
        set(built_with "${PAYKAN_TOOLCHAIN_VERSION}")
    endif()
    if(NOT built_with IN_LIST PAYKAN_PLUGIN_COMPATIBLE_VERSIONS)
        list(JOIN PAYKAN_PLUGIN_COMPATIBLE_VERSIONS ", " accepted)
        message(FATAL_ERROR
            "Paykan ${kind} plugin '${target}' is incompatible: built with "
            "PaykanLang ${built_with}; the installed PaykanLang "
            "${PAYKAN_TOOLCHAIN_VERSION} (${Paykan_DIR}) accepts ${accepted}")
    endif()
    set(${out_var} "${built_with}" PARENT_SCOPE)
endfunction()

# A loadable plugin module of <kind> (frontend, backend): what
# paykan_add_frontend_plugin / paykan_add_backend_plugin add.
function(_paykan_add_plugin_module kind target built_with)
    paykan_check_plugin_built_with(${kind} ${target} "${built_with}" built_with)
    if(NOT ARGN)
        message(FATAL_ERROR "paykan_add_${kind}_plugin(${target}): no sources")
    endif()
    # A MODULE: loaded at run time, never linked against.
    add_library(${target} MODULE ${ARGN})
    target_link_libraries(${target} PRIVATE Paykan::plugin_api)
    target_compile_definitions(${target} PRIVATE
        "PAYKAN_PLUGIN_BUILD_VERSION=\"${built_with}\"")
    # lib<target>.so on Linux, lib<target>.dylib on macOS (where a CMake
    # MODULE would otherwise be named .so): the suffix paykan looks for in
    # the plugin directories.
    # Only the entry point (PAYKAN_PLUGIN_EXPORT) is exported: the rest of
    # the module stays private to it.
    set_target_properties(${target} PROPERTIES PREFIX "lib"
        C_VISIBILITY_PRESET hidden CXX_VISIBILITY_PRESET hidden
        VISIBILITY_INLINES_HIDDEN ON)
    if(APPLE)
        set_target_properties(${target} PROPERTIES SUFFIX ".dylib")
    endif()
endfunction()

# BUILT_WITH is parsed with PARSE_ARGV, so `BUILT_WITH ""` (an unset cache
# variable, say) keeps its empty value and means the default.
function(paykan_add_backend_plugin target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "BUILT_WITH" "")
    _paykan_add_plugin_module(backend ${target} "${ARG_BUILT_WITH}"
                              ${ARG_UNPARSED_ARGUMENTS})
endfunction()

function(paykan_add_frontend_plugin target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "BUILT_WITH" "")
    _paykan_add_plugin_module(frontend ${target} "${ARG_BUILT_WITH}"
                              ${ARG_UNPARSED_ARGUMENTS})
endfunction()

function(paykan_install_plugin)
    install(TARGETS ${ARGN} LIBRARY DESTINATION "${PAYKAN_PLUGIN_INSTALL_DIR}")
endfunction()

# paykan_add_frontend_tests(), when the installation carries the test support
# (PaykanFrontendTests.cmake, docs/writing-a-frontend-plugin.md).
include("${CMAKE_CURRENT_LIST_DIR}/PaykanFrontendTests.cmake" OPTIONAL)

check_required_components(Paykan)
