{
  "_comment": [
    "The test suites: the one list of them. cmake/PaykanTests.cmake reads it",
    "for -DPAYKAN_BUILD_TESTS / -DPAYKAN_BUILD_ALL_TESTS, tests/CMakeLists.txt",
    "registers each suite's tests (configure fails if a suite here registers",
    "nothing there, or one there is not here), and scripts/affected_tests.py",
    "maps changed files to suites with the rules below.",
    "",
    "suites: name -> {gtest: built on GoogleTest, description}.",
    "groups: name -> suites; a rule may name a group as '@<group>'.",
    "rules: [pattern, suites] in order, the first pattern a changed path",
    "matches decides; '*' matches across directories (fnmatch).  suites is",
    "'all', or a list of suite and '@group' names ([] for none).  A path no",
    "rule matches affects every suite."
  ],
  "suites": {
    "parser":          {"gtest": true,  "description": "tests/Parser: ParserTests.<frontend>"},
    "sema":            {"gtest": true,  "description": "tests/Sema: SemaTests.<frontend>"},
    "codegen":         {"gtest": true,  "description": "tests/CodeGen: CodeGenTests.<backend>"},
    "pir-llvm":        {"gtest": true,  "description": "tests/Backends: PIRLLVMTests (llvm backend only)"},
    "pir":             {"gtest": true,  "description": "tests/PIR: PIRTests"},
    "lowering":        {"gtest": true,  "description": "tests/Lowering: LoweringTests"},
    "ast-interchange": {"gtest": true,  "description": "tests/AST: ASTInterchangeTests"},
    "plugin":          {"gtest": true,  "description": "tests/Plugin: PluginTests, PluginLoaderTests"},
    "runtime":         {"gtest": true,  "description": "tests/Runtime: RuntimeTests"},
    "driver":          {"gtest": true,  "description": "tests/Driver: DriverTests.<backend>"},
    "frontend":        {"gtest": true,  "description": "tests/Frontend: FrontendTests"},
    "samples":         {"gtest": false, "description": "scripts/samples_parity.py, cache_race.py, runtime_lookup.py: SamplesParity*, CacheRace, RuntimeLookup"},
    "c-strict":        {"gtest": false, "description": "scripts/c_strict.py: CStrictC11 (c backend only)"},
    "docs":            {"gtest": false, "description": "scripts/check_links.py, doc_examples.py: MarkdownLinks, DocExamples"},
    "configure":       {"gtest": false, "description": "tests/DefaultConfigure.cmake: DefaultConfigure"},
    "out-of-tree":     {"gtest": true,  "description": "tests/OutOfTree: PrintPIROutOfTree, PluginCompatOutOfTree, FrontendTestsOutOfTree"}
  },
  "groups": {
    "e2e": ["codegen", "driver", "plugin", "samples", "c-strict", "docs", "out-of-tree"]
  },
  "rules": [
    ["scripts/affected_tests.py", "all"],
    ["tests/suites.json", "all"],
    [".github/workflows/ci.yml", "all"],
    ["tests/CMakeLists.txt", "all"],
    ["cmake/PaykanTests.cmake", "all"],
    ["cmake/GTestSetup.cmake", "all"],

    ["tests/Parser/*", ["parser"]],
    ["tests/Sema/*", ["sema"]],
    ["tests/CodeGen/*", ["codegen"]],
    ["tests/CodeGenTestUtils.h", ["codegen"]],
    ["tests/Backends/*", ["pir-llvm"]],
    ["tests/PIR/*", ["pir"]],
    ["tests/Lowering/*", ["lowering"]],
    ["tests/AST/*", ["ast-interchange"]],
    ["tests/Plugin/*", ["plugin"]],
    ["tests/Runtime/*", ["runtime"]],
    ["tests/Driver/*", ["driver"]],
    ["tests/Frontend/*", ["frontend", "out-of-tree"]],
    ["tests/OutOfTree/*", ["out-of-tree"]],
    ["tests/DefaultConfigure.cmake", ["configure"]],
    ["tests/*", "all"],

    ["src/Sema/*", ["sema", "lowering", "@e2e"]],
    ["src/Lowering/*", ["lowering", "pir-llvm", "@e2e"]],
    ["src/PIR/*", ["pir", "lowering", "pir-llvm", "@e2e"]],
    ["src/ASTInterchange/*", ["ast-interchange", "driver", "plugin", "out-of-tree"]],
    ["src/Runtime/*", ["runtime", "pir-llvm", "@e2e"]],
    ["src/Backends/LLVM/*", ["pir-llvm", "@e2e"]],
    ["src/Backends/C/*", ["@e2e"]],
    ["src/Backends/Toolchain/*", ["@e2e"]],
    ["src/Backend/*", ["pir-llvm", "@e2e"]],
    ["src/Driver/*", ["@e2e"]],
    ["src/Backends/PrintPIR/*", ["out-of-tree"]],
    ["src/Frontends/ASTText/*", ["out-of-tree"]],
    ["src/*", "all"],
    ["include/*", "all"],

    ["samples/*", ["samples", "c-strict", "docs", "lowering", "ast-interchange", "frontend", "plugin", "out-of-tree"]],
    ["scripts/samples_parity.py", ["samples"]],
    ["scripts/cache_race.py", ["samples"]],
    ["scripts/runtime_lookup.py", ["samples"]],
    ["scripts/c_strict.py", ["c-strict"]],
    ["scripts/check_links.py", ["docs"]],
    ["scripts/doc_examples.py", ["docs"]],
    ["docs/*", ["docs"]],
    ["*.md", ["docs"]],
    ["cmake/PaykanTestSupport.cmake", ["frontend", "out-of-tree"]],

    ["scripts/clang_format.py", []],
    ["scripts/run_clang_tidy.py", []],
    ["scripts/coverage.py", []],
    ["scripts/build_apt_repo.sh", []],
    [".github/*", []],
    ["Formula/*", []],
    [".clang-format", []],
    [".clang-tidy", "all"],
    [".pre-commit-config.yaml", []],
    [".gitignore", []],
    ["LICENSE", []],

    ["cmake/*", "all"],
    ["CMakeLists.txt", "all"]
  ]
}
