// ::memory Box<T: ValueType>: one value shared through an object, written
// through get() by an `inout` local, an `inout` argument or a field of it.
import ::io;
import ::memory;

enum Light { Red, Yellow, Green }

class Counter {
  hits: shared mut memory::Box<int>;
}

fn bump(n: inout int) {
  n = n + 1;
}

fn next(l: Light) -> Light {
  match l {
    Red { return Light::Green; }
    Green { return Light::Yellow; }
    Yellow { return Light::Red; }
  }
}

fn main() -> int {
  // Two names, one box: a change through either shows through both.
  total: shared mut = memory::Box(0);
  alias: shared mut = total;
  bump(total.get());
  bump(alias.get());
  n: inout int = alias.get();
  n = n * 10;
  io::println(Str(total.get()) + " " + Str(alias.get()));

  // Objects that share one box share its value.
  a: mut = Counter(total);
  b = Counter(total);
  bump(a.hits.get());
  io::println(Str(b.hits.value()) + " " + Str(total.get()));

  f: mut = memory::Box(1.5);
  x: inout float = f.get();
  x = x * 3.0;
  c: mut = memory::Box('a');
  ch: inout char = c.get();
  ch = 'z';
  flag: mut = memory::Box(False);
  on: inout bool = flag.get();
  on = !on;
  io::println(Str(f.get()) + " " + Str(c.get()) + " " + Str(flag.get()));

  light: mut = memory::Box(Light::Red);
  i: int = 0;
  while i < 4 {
    l: inout Light = light.get();
    l = next(l);
    i = i + 1;
  }
  io::println(Str(light.get() == Light::Green));

  // A tuple: read in place, replaced whole.
  pair: shared mut = memory::Box((1, "one"));
  pairAlias: shared mut = pair;
  io::println(Str(pair.get().0) + pair.get().1);
  p: inout (int, Str) = pairAlias.get();
  p = (2, "two");
  io::println(Str(pair.get().0) + pair.get().1);
  kept = pair.get();
  q: inout (int, Str) = pair.get();
  q = (3, "three");
  io::println(Str(kept.0) + kept.1 + " " + Str(pair.get().0) + pair.get().1);
  return 0;
}
