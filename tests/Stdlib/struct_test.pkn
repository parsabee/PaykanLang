// Structs (docs/language/11-structs.md) in the collections: a struct is an
// element of a List<T>, and one with `impl Hashable for` is a key of a
// HashMap<K, V> and a HashSet<K>.  Equality of elements and keys is a
// struct's field-wise `==`.
import ::io;
import ::collections;

struct P {
  x: int;
  y: int;
}
impl P {
  view fn sum() -> int { return self.x + self.y; }
}
impl Hashable for P {
  view fn hash() -> int { return (self.x * 31 + self.y).hash(); }
}

struct Named {
  p: P;
  name: Str;
}

// The text of an index `indexOf` returns: the number, or "None".
fn idx(i: unsigned?) -> Str {
  match i {
    n: unsigned { return Str(n); }
    None { return "None"; }
  }
}

fn main() -> int {
  l = collections::List<P>();
  l.push(P(5, 6));
  l.push(P(7, 8));
  io::println(Str(l.get(1).sum()) + " " + Str(l.contains(P(5, 6))) + " "
      + idx(l.indexOf(P(9, 9))) + " " + Str(l.len()));
  io::println(l.get(0));

  m = collections::HashMap<P, Str>();
  m.put(P(1, 1), "one");
  m.put(P(2, 2), "two");
  m.put(P(1, 1), "uno");                  // the same key: replaced
  io::println(m.get(P(2, 2)) + " " + m.get(P(1, 1)) + " "
      + Str(m.containsKey(P(3, 3))) + " " + Str(m.len()));

  s = collections::HashSet<P>();
  s.add(P(1, 1));
  s.add(P(1, 1));
  s.add(P(2, 1));
  io::println(Str(s.len()) + " " + Str(s.contains(P(2, 1))) + " "
      + Str(s.contains(P(1, 2))));

  // A struct holding a reference and another struct, as an element.
  ns = collections::List<Named>();
  ns.push(Named(P(1, 2), "a"));
  ns.push(Named(P(3, 4), "b"));
  io::println(ns.get(1));
  io::println(Str(ns.contains(Named(P(1, 2), "a"))) + " "
      + Str(ns.get(0).p.sum()));
  return 0;
}
