// Function values (docs/language/14-function-types.md) in the collections:
// a function value is held in place and equal to another holding the same
// code and closure, so it is an element of a List<T>, found by `contains`
// and `indexOf` (a named function, or a copy of a lambda's value), and a
// value of a HashMap.
import ::io;
import ::collections;

fn square(x: int) -> int {
  return x * x;
}

// The text of an index `indexOf` returns: the number, or "None".
fn idx(i: unsigned?) -> Str {
  match i {
    n: unsigned { return Str(n); }
    None { return "None"; }
  }
}

fn main() -> int {
  fs = collections::List<(int) -> int>();
  fs.push(square);
  fs.push(fn(x: int) -> int { return x + 1; });
  double = fn(x: int) -> int {
    return x * 2;
  };
  fs.push(double);
  i: unsigned = 0;
  total = 0;
  while i < fs.len() {
    f = fs.get(i);
    total = total + f(3);
    i = i + 1;
  }
  io::println(Str(total) + " " + Str(fs.contains(double)) + " "
      + idx(fs.indexOf(double)) + " " + Str(fs.contains(fn(x: int) -> int {
    return x * 2;
  })) + " " + Str(fs.contains(square)) + " " + idx(fs.indexOf(square)));

  greetings = collections::HashMap<Str, (Str) -> Str>();
  greetings.put("en", fn(n: Str) -> Str { return "hello " + n; });
  greetings.put("fr", fn(n: Str) -> Str { return "bonjour " + n; });
  g = greetings.get("fr");
  io::println(g("pat") + " " + Str(greetings.containsKey("de")) + " "
      + Str(greetings.len()));

  stack = collections::Stack<() -> int>();
  n = 1;
  stack.push(fn() -> int { return n; });
  n = 2;
  stack.push(fn() -> int { return n; });
  top = stack.pop();
  io::println(Str(top()) + " " + Str(stack.len()));
  return 0;
}
