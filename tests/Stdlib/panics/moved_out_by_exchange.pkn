// expect-panic: a value moved out of 'h.n' is still borrowed
import ::memory as mem;

class Node {
  v: int;
}
class H {
  n: mut Node;
}

fn exchange(a: inout Node, b: inout Node) {
  mem::swap(a, b);
}

fn g(h: shared mut H, n: view Node) -> int {
  x: mut Node = Node(2);
  exchange(h.n, x);
  return x.v + n.v;
}

fn main() -> int {
  h: shared mut H = H(Node(1));
  return g(h, h.n);
}
