// expect-panic: lock taken twice: code that a 'lock' block ran (a '__deinit__' of what the block let go of) locks the cell the block holds, and would wait for ever
// A `lock` block's calls are checked by the compiler.  What it lets go of
// is not: the Session moved into the block is destroyed at the block's end,
// and its `__deinit__` takes the lock the block holds.  The thread would
// wait for itself for ever; the runtime stops the program instead.
import ::io;

class Registry {
  open: int;
}

class Session {
  registry: locked mut Registry;
  id: int;
}

impl Session {
  fn __init__(registry: locked mut Registry, id: int) {
    self.registry = registry;
    self.id = id;
    lock self.registry as r: inout { r.open += 1; }
  }
  fn __deinit__() { lock self.registry as r: inout { r.open -= 1; } }
}

fn main() -> int {
  registry: locked mut Registry = Registry(0);
  s = Session(registry, 1);
  lock registry as r: inout {
    let mine = move s;
    io::println(Str(r.open) + " open, closing " + Str(mine.id));
  }
  io::println("not reached");
  return 0;
}
