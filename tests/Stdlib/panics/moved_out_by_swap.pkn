// expect-panic: a value moved out of 'h.n' is still borrowed
import ::memory as mem;

class Node {
  v: int;
}
class H {
  n: mutable Node;
}

fn g(h: shared mutable H, n: view Node) -> int {
  x: mutable Node = Node(2);
  mem::swap(h.n, x);
  return x.v + n.v;
}

fn main() -> int {
  h: shared mutable H = H(Node(1));
  return g(h, h.n);
}
