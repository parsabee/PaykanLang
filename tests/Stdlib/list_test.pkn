// ::collections List<T>: growth, indexing, insert/remove, search, copies.
import ::io;
import ::collections;
import ::memory;

class Point {
  x: int;
  y: int;
  view fn toString() -> Str {
    return "(" + Str(self.x) + "," + Str(self.y) + ")";
  }
  view fn equals(other: Obj) -> bool {
    match other {
      p: Point {
        return p.x == self.x && p.y == self.y;
      }
      _ { return False; }
    }
  }
}

// An element equal to another of its `id`, whose `equals` first calls its
// hook, if it has one.
class Hooked {
  id: int;
  hook: (() -> int)?;
  view fn toString() -> Str { return Str(self.id); }
  view fn equals(other: Obj) -> bool {
    match self.hook {
      h: () -> int { h(); }
      None { }
    }
    match other {
      o: Hooked { return o.id == self.id; }
      _ { return False; }
    }
  }
}

// A list of two elements, 1 and 2, the first of which empties the list when
// its `equals` is called.
fn emptiedByEquals() -> collections::List<Hooked> {
  xs = collections::List<Hooked>();
  let shared = memory::Box(xs);
  xs.push(Hooked(1, fn() -> int { shared.get().clear(); return 0; }));
  xs.push(Hooked(2, None));
  return xs;
}

// A list of 1, 2 and 3, whose 2 removes the first element when its `equals`
// is called.  Its hook holds the list: clear it when done, or the list holds
// itself.
fn shrunkByEquals() -> collections::List<Hooked> {
  xs = collections::List<Hooked>();
  let shared = memory::Box(xs);
  xs.push(Hooked(1, None));
  xs.push(Hooked(2, fn() -> int { shared.get().removeAt(0); return 0; }));
  xs.push(Hooked(3, None));
  return xs;
}

// The text of an index `indexOf` returns: the number, or "None".
fn idx(i: unsigned?) -> Str {
  match i {
    n: unsigned { return Str(n); }
    None { return "None"; }
  }
}

fn main() -> int {
  xs = collections::List<int>();
  io::println(Str(xs.len()) + " " + Str(xs.isEmpty()));
  i: int = 0;
  while i < 10 {
    xs.push(i * i);
    i = i + 1;
  }
  io::println(collections::listToString(xs));
  io::println(Str(xs.len()) + " " + Str(xs.get(3)) + " " + Str(xs.last()));
  xs.set(0, -1);
  xs.insert(0, 100);
  xs.insert(xs.len(), 200);
  xs.insert(5, 55);
  io::println(collections::listToString(xs));
  io::println(Str(xs.removeAt(0)) + " " + Str(xs.removeAt(xs.len() - 1)) + " "
      + Str(xs.pop()));
  io::println(idx(xs.indexOf(55)) + " " + idx(xs.indexOf(7)) + " "
      + Str(xs.contains(16)) + " " + Str(xs.remove(55)) + " "
      + Str(xs.remove(55)));
  xs.reverse();
  io::println(collections::listToString(xs));

  words = collections::listOf(["pear", "fig", "apple"]);
  copy = words.copy();
  copy.push("kiwi");
  words.set(1, "plum");
  io::println(collections::listToString(words) + " "
      + collections::listToString(copy));
  words.clear();
  io::println(Str(words.len()) + " " + Str(words.isEmpty()));

  pts = collections::List<Point>();
  pts.push(Point(1, 2));
  pts.push(Point(3, 4));
  io::println(collections::listToString(pts) + " "
      + Str(pts.contains(Point(3, 4))) + " " + idx(pts.indexOf(Point(9, 9))));

  // A list of optionals and a list of lists.
  maybe = collections::List<Str?>();
  maybe.push("a");
  maybe.push(None);
  io::println(Str(maybe.len()) + " " + Str(maybe.get(1) == None));
  grid = collections::List<collections::List<int>>();
  grid.push(collections::listOf([1, 2]));
  grid.push(collections::listOf([3]));
  io::println(Str(grid.get(0).len() + grid.get(1).len()));

  // listToString appends each element's text to a string of its own: two
  // calls give two strings, the second "[]" too, unchanged by an append to
  // the first.  100,000 elements take time linear in the text, where putting
  // it together with `+` copied it per element.
  let none = collections::List<int>();
  let first = collections::listToString(none);
  let second = collections::listToString(none);
  first.concat("!");
  io::println(first + " " + second);
  big = collections::List<int>();
  for k in 0..100000 {
    big.push(k);
  }
  let text = collections::listToString(big);
  io::println(Str(text.len()) + " "
      + Str(collections::startsWith(text, "[0, 1, 2, ")) + " "
      + Str(collections::endsWith(text, ", 99998, 99999]")));

  // indexOf, contains and remove read the length again for each element,
  // which the first element's `equals` sets to 0.
  let a = emptiedByEquals();
  let b = emptiedByEquals();
  c = emptiedByEquals();
  io::println(idx(a.indexOf(Hooked(0, None))) + " "
      + Str(b.contains(Hooked(0, None))) + " " + Str(c.remove(Hooked(0, None)))
      + " " + Str(a.len() + b.len() + c.len()));

  // remove removes nothing when the `equals` that found the element changed
  // the list's length: the index it was found at names 3 once 1 is gone,
  // and no element once the list is empty.
  d = shrunkByEquals();
  e = emptiedByEquals();
  io::println(Str(d.remove(Hooked(2, None))) + " "
      + collections::listToString(d) + " " + Str(e.remove(Hooked(1, None)))
      + " " + collections::listToString(e));
  d.clear();
  return 0;
}
