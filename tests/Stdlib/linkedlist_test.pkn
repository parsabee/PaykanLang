// ::collections LinkedList<T>, Stack<T> and Queue<T>.
import ::io;
import ::collections;

enum Suit { Hearts, Spades }

fn show(l: view collections::LinkedList<Str>) -> Str {
  return collections::listToString(l.toList()) + " len=" + Str(l.len());
}

fn main() -> int {
  l = collections::LinkedList<Str>();
  io::println(show(l) + " " + Str(l.isEmpty()));
  l.pushBack("b");
  l.pushBack("c");
  l.pushFront("a");
  l.pushBack("d");
  io::println(show(l) + " front=" + l.front() + " back=" + l.back());
  io::println(l.popFront() + l.popBack() + " " + show(l));
  // Removing from the middle relinks the neighbours.
  l.pushFront("z");
  l.pushBack("y");
  io::println(show(l));
  io::println(Str(l.remove("b")) + " " + Str(l.remove("q")) + " " + show(l));
  io::println(Str(l.contains("y")) + " " + Str(l.contains("b")));
  io::println(l.popBack() + l.popBack() + l.popFront() + " " + show(l));
  l.pushBack("again");
  io::println(show(l));
  l.pushBack("more");
  l.clear();
  io::println(show(l));
  l.pushFront("after clear");
  io::println(show(l));

  // Elements of any type: an enum, an optional, a tuple.
  suits = collections::LinkedList<Suit>();
  suits.pushBack(Suit::Spades);
  suits.pushFront(Suit::Hearts);
  io::println(Str(suits.popBack() == Suit::Spades) + " " + Str(suits.len()));
  pairs = collections::LinkedList<(int, Str)>();
  pairs.pushBack((1, "one"));
  pairs.pushBack((2, "two"));
  p = pairs.popFront();
  io::println(Str(p.0) + p.1 + " " + Str(pairs.contains((2, "two"))));
  opts = collections::LinkedList<int?>();
  opts.pushBack(None);
  opts.pushBack(3);
  io::println(Str(opts.contains(None)) + " " + Str(opts.len()));

  s = collections::Stack<int>();
  i: int = 1;
  while i <= 5 {
    s.push(i);
    i = i + 1;
  }
  io::println("stack " + collections::listToString(s.toList()) + " peek="
      + Str(s.peek()));
  out: Str = "";
  while !s.isEmpty() {
    out = out + Str(s.pop());
  }
  io::println("popped " + out + " len=" + Str(s.len()));

  q = collections::Queue<Str>();
  q.enqueue("first");
  q.enqueue("second");
  q.enqueue("third");
  io::println("queue " + collections::listToString(q.toList()) + " peek="
      + q.peek());
  io::println(q.dequeue() + " " + q.dequeue() + " len=" + Str(q.len()));
  q.enqueue("fourth");
  io::println(q.dequeue() + " " + q.dequeue() + " " + Str(q.isEmpty()));
  q.enqueue("x");
  q.clear();
  s.push(9);
  s.clear();
  io::println(Str(q.len() + s.len()));
  return 0;
}
