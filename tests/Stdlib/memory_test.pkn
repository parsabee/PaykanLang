// ::memory Buffer<T>: a struct whose copies share the slots; new slots are
// zero (or unset); set/at/get/copy, growth, shrinking and swap, for values and
// references; and the errors the operations report instead of panicking.
import ::io;
import ::error as err;
import ::memory as mem;
import ::result as res;

/// The name of @p e's code.
fn code(e: err::Error) -> Str {
  return err::name(e.code);
}

/// The name of the code of @p r's error, `Ok` when it made a value.
fn codeOf<T>(r: res::Result<T, err::Error>) -> Str {
  match r {
    v: Ok { return "Ok"; }
    e: Err { return code(e.error); }
  }
}

/// The text of @p r's value, or the name of its error's code.
fn shown<T: Show>(r: res::Result<T, err::Error>) -> Str {
  match r {
    v: Ok { return v.value.toString(); }
    e: Err { return code(e.error); }
  }
}

fn main() -> int {
  n = mem::Buffer<int>();
  io::println(Str(n.len()) + " " + code(n.grow(3)) + " " + Str(n.len()));
  io::println(n.at(0) + n.get(2));
  e = n.set(1, 7);
  e = n.grow(2);
  e = n.push(9);
  io::println(Str(n.len()) + " " + Str(n.at(1)) + " " + Str(n.at(4)) + " "
      + Str(n.get(5)));
  io::println(shown(n.copy(5)));
  e = n.swap(1, 5);
  io::println(Str(n.get(1)) + Str(n.get(5)));
  e = n.shrink(4);
  e = n.reserve(3);
  io::println(Str(n.len()) + " " + Str(n.get(1)) + " " + Str(n.get(2)));

  // A copy shares the slots.
  alias = n;
  e = alias.set(0, 42);
  io::println(n.get(0));

  // What goes wrong is an error, and the buffer is unchanged.
  io::println(code(n.set(10, 1)) + " " + code(n.swap(0, 10)) + " "
      + code(n.shrink(10)) + " " + codeOf(n.copy(10)) + " " + Str(n.len()));
  io::println(code(n.grow(9223372036854775807)) + " " + Str(n.len()));

  s = mem::Buffer<Str>();
  i: int = 0;
  while i < 100 {
    e = s.push("s" + Str(i));
    i = i + 1;
  }
  kept = s.copy(42);
  e = s.shrink(99);
  io::println(Str(s.len()) + " " + s.at(0) + " " + shown(kept));
  e = s.grow(1);
  io::println(codeOf(s.copy(1)) + " " + code(s.swap(0, 1)));

  opt = mem::Buffer<Str?>();
  e = opt.grow(2);
  e = opt.set(1, "here");
  io::println(Str(opt.at(0) == None) + " " + Str(opt.get(1) == None) + " "
      + shown(opt.copy(1)));
  f = mem::Buffer<float>();
  b = mem::Buffer<bool>();
  c = mem::Buffer<char>();
  e = f.grow(1);
  e = b.grow(1);
  e = c.grow(1);
  io::println(Str(f.get(0)) + " " + Str(b.get(0)) + " "
      + Str(int<char>(c.get(0))));
  return 0;
}
