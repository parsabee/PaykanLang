// calc/parser — recursive-descent parser for arithmetic with variables.
//
// Grammar (lowest to highest precedence):
//   stmt   ::= IDENT '=' expr | expr
//   expr   ::= term   (('+' | '-') term)*
//   term   ::= factor (('*' | '/' | '%') factor)*
//   factor ::= '(' expr ')' | '-' factor | number | IDENT
//   number ::= [0-9]+ ('.' [0-9]+)?
//   IDENT  ::= [A-Za-z_] [A-Za-z0-9_]*
//
// A `factor` may be a variable name, looked up in the shared environment
// (a calc::hashmap::HashMap). A leading `IDENT '='` is an assignment; anything
// else is an expression — so the parser saves its position and backtracks if
// the `=` does not materialise.
//
// Errors are recorded in `error: Str?` (None while parsing succeeds) rather
// than aborting, so the REPL can report them and continue. parseStatement()
// returns a tuple `(Str?, float)`: the assigned name, or None for a bare
// expression, together with the value.

import calc::hashmap;

// The four binary operators plus modulo, modelled as a distinct enum type.
enum Op { Add, Sub, Mul, Div, Mod }

fn applyOp(op: Op, a: float, b: float) -> float {
  match op {
    Add { return a + b; }
    Sub { return a - b; }
    Mul { return a * b; }
    Div { return a / b; }
    Mod { return a % b; }
  }
}

class Parser {
  input: Str;
  pos: int;
  env: hashmap::HashMap;
  error: Str?;   // the first error, or None

  fn __init__(s: Str, env: hashmap::HashMap) {
    self.input = s;
    self.pos = 0;
    self.env = env;
  }

  // Record the first error only; later errors are usually cascades.
  fn fail(msg: Str) {
    if (self.error == None) { self.error = msg; }
  }

  fn done() -> bool {
    return self.pos >= self.input.len();
  }

  fn atIs(ch: char) -> bool {
    return !self.done() && self.input[self.pos] == ch;
  }

  fn atIsOr(a: char, b: char) -> bool {
    if (self.done()) { return False; }
    c: char = self.input[self.pos];
    return c == a || c == b;
  }

  fn atIsDigit() -> bool {
    if (self.done()) { return False; }
    c: char = self.input[self.pos];
    return c >= '0' && c <= '9';
  }

  fn atIsIdentStart() -> bool {
    if (self.done()) { return False; }
    c: char = self.input[self.pos];
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
  }

  fn atIsIdentChar() -> bool {
    if (self.done()) { return False; }
    c: char = self.input[self.pos];
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        || (c >= '0' && c <= '9') || c == '_';
  }

  // Current char is '=' and it is NOT the start of '=='.
  fn atAssign() -> bool {
    if (!self.atIs('=')) { return False; }
    if (self.pos + 1 >= self.input.len()) { return True; }
    return self.input[self.pos + 1] != '=';
  }

  fn atDigitVal() -> int {
    if (self.done()) { return 0; }
    c: char = self.input[self.pos];
    match c {
      '0' { return 0; }
      '1' { return 1; }
      '2' { return 2; }
      '3' { return 3; }
      '4' { return 4; }
      '5' { return 5; }
      '6' { return 6; }
      '7' { return 7; }
      '8' { return 8; }
      '9' { return 9; }
      _   { return 0; }
    }
  }

  fn advance() {
    self.pos = self.pos + 1;
  }

  fn skipWs() {
    while (!self.done() && self.atIs(' ')) {
      self.advance();
    }
  }

  fn parseIdent() -> Str {
    name: Str = "";
    while (self.atIsIdentChar()) {
      name = name + Str<char>(self.input[self.pos]);
      self.advance();
    }
    return name;
  }

  // The unconsumed remainder of the input (for "unexpected '…'" diagnostics).
  fn rest() -> Str {
    out: Str = "";
    i: int = self.pos;
    while (i < self.input.len()) {
      out = out + Str(self.input[i]);
      i = i + 1;
    }
    return out;
  }

  fn parseNumber() -> float {
    result: float = 0.0;
    while (self.atIsDigit()) {
      result = result * 10.0 + self.atDigitVal();
      self.advance();
    }
    if (self.atIs('.')) {
      self.advance();
      frac: float = 0.1;
      while (self.atIsDigit()) {
        result = result + self.atDigitVal() * frac;
        frac = frac * 0.1;
        self.advance();
      }
    }
    return result;
  }

  fn parseFactor() -> float {
    self.skipWs();
    if (self.atIs('(')) {
      self.advance();
      val: float = self.parseExpr();
      self.skipWs();
      if (self.atIs(')')) { self.advance(); }
      else { self.fail("missing ')'"); }
      return val;
    }
    if (self.atIs('-')) {
      self.advance();
      return 0.0 - self.parseFactor();
    }
    if (self.atIsIdentStart()) {
      name: Str = self.parseIdent();
      match self.env.lookup(name) {
        e: hashmap::Entry { return e.value; }
        None {
          self.fail("undefined variable '" + name + "'");
          return 0.0;
        }
      }
    }
    if (!self.atIsDigit()) {
      self.fail("expected a number, variable, or '('");
      return 0.0;
    }
    return self.parseNumber();
  }

  fn parseTerm() -> float {
    result: float = self.parseFactor();
    self.skipWs();
    while (!self.done() && (self.atIs('*') || self.atIs('/') || self.atIs('%'))) {
      op: Op = if self.atIs('*') then Op::Mul
               else if self.atIs('/') then Op::Div else Op::Mod;
      self.advance();
      rhs: float = self.parseFactor();
      result = applyOp(op, result, rhs);
      self.skipWs();
    }
    return result;
  }

  fn parseExpr() -> float {
    result: float = self.parseTerm();
    self.skipWs();
    while (self.atIsOr('+', '-')) {
      op: Op = if self.atIs('+') then Op::Add else Op::Sub;
      self.advance();
      rhs: float = self.parseTerm();
      result = applyOp(op, result, rhs);
      self.skipWs();
    }
    return result;
  }

  // Parse a whole line: an assignment if it begins `IDENT =` (not `==`),
  // otherwise a bare expression. The position is saved so a non-assignment
  // that merely starts with a variable name backtracks cleanly.
  fn parseStatement() -> (Str?, float) {
    self.skipWs();
    start: int = self.pos;
    if (self.atIsIdentStart()) {
      name: Str = self.parseIdent();
      self.skipWs();
      if (self.atAssign()) {
        self.advance(); // consume '='
        v: float = self.parseExpr();
        self.skipWs();
        target: Str? = name;
        return (target, v);
      }
      self.pos = start; // not an assignment — rewind and parse as an expression
    }
    v: float = self.parseExpr();
    self.skipWs();
    noName: Str? = None;
    return (noName, v);
  }
}
