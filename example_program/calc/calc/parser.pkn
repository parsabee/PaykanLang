// calc/parser — recursive descent arithmetic expression parser
//
// Grammar (lowest to highest precedence):
//   expr   ::= term   (('+' | '-') term)*
//   term   ::= factor (('*' | '/') factor)*
//   factor ::= '(' expr ')' | '-' factor | number
//   number ::= [0-9]+ ('.' [0-9]+)?
//
// Language features on display: an `enum` for the operator kind, `match` for
// dispatch (on the enum and on digit characters), and the `if … then … else`
// ternary expression.

// The four binary operators, modelled as a distinct enum type rather than
// raw characters.
enum Op { Add, Sub, Mul, Div }

// Apply a binary operator. The match is exhaustive over Op, so no wildcard or
// trailing return is needed.
fn applyOp(op: Op, a: float, b: float) -> float {
  match op {
    Add { return a + b; }
    Sub { return a - b; }
    Mul { return a * b; }
    Div { return a / b; }
  }
}

class Parser {
  input: Str;
  pos: int;

  fn __init__(s: Str) {
    self.input = s;
    self.pos = 0;
  }

  fn done() -> bool {
    return self.pos >= self.input.len();
  }

  fn atIs(ch: char) -> bool {
    // Short-circuit guards the subscript: when done, the input is not indexed.
    return !self.done() && self.input[self.pos] == ch;
  }

  fn atIsOr(a: char, b: char) -> bool {
    if (self.done()) { return False; }
    c: char = self.input[self.pos];
    return c == a || c == b;
  }

  fn atIsDigit() -> bool {
    if (self.done()) { return False; }
    c: char = self.input[self.pos];
    return c >= '0' && c <= '9';
  }

  fn atDigitVal() -> int {
    if (self.done()) { return 0; }
    c: char = self.input[self.pos];
    match c {
      '0' { return 0; }
      '1' { return 1; }
      '2' { return 2; }
      '3' { return 3; }
      '4' { return 4; }
      '5' { return 5; }
      '6' { return 6; }
      '7' { return 7; }
      '8' { return 8; }
      '9' { return 9; }
      _   { return 0; }
    }
  }

  fn advance() {
    self.pos = self.pos + 1;
  }

  fn skipWs() {
    while (!self.done() && self.atIs(' ')) {
      self.advance();
    }
  }

  fn parseNumber() -> float {
    result: float = 0.0;
    while (self.atIsDigit()) {
      result = result * 10.0 + self.atDigitVal();
      self.advance();
    }
    if (self.atIs('.')) {
      self.advance();
      frac: float = 0.1;
      while (self.atIsDigit()) {
        result = result + self.atDigitVal() * frac;
        frac = frac * 0.1;
        self.advance();
      }
    }
    return result;
  }

  fn parseFactor() -> float {
    self.skipWs();
    if (self.atIs('(')) {
      self.advance();
      val: float = self.parseExpr();
      self.skipWs();
      if (self.atIs(')')) { self.advance(); }
      return val;
    }
    if (self.atIs('-')) {
      self.advance();
      return 0.0 - self.parseFactor();
    }
    return self.parseNumber();
  }

  fn parseTerm() -> float {
    result: float = self.parseFactor();
    self.skipWs();
    while (self.atIsOr('*', '/')) {
      op: Op = if self.atIs('*') then Op::Mul else Op::Div;
      self.advance();
      rhs: float = self.parseFactor();
      result = applyOp(op, result, rhs);
      self.skipWs();
    }
    return result;
  }

  fn parseExpr() -> float {
    result: float = self.parseTerm();
    self.skipWs();
    while (self.atIsOr('+', '-')) {
      op: Op = if self.atIs('+') then Op::Add else Op::Sub;
      self.advance();
      rhs: float = self.parseTerm();
      result = applyOp(op, result, rhs);
      self.skipWs();
    }
    return result;
  }
}
