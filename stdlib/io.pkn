// ::io: printing, files and the standard input.
//
// The print functions take any value that shows itself (`T: Showable`: an
// object, a Str, a number, a bool, a char, and a tuple, struct, enum or
// optional whose parts all do, None printing as "None") and write its
// `toString()` to stdout or stderr, `println` and `printerrln` with a
// newline after it.
//
// A File is an open file: `open(path, mode)` opens one with C's `fopen` (the
// mode "r", "w", "a", ...) and returns a Result (::result) holding it, or the
// Error (::error) saying why it could not; `stdin()` is the process's
// standard input.  A File is a value with one owner: it moves, and the file
// is closed where the File is destroyed (its `__deinit__`).  Each of its
// methods reports what went wrong the same way: a write returns its Error
// (`Ok` when it wrote), a read a Result holding the text read, or its
// Error, `EndOfFile` when nothing was left to read.  Reading and writing
// change the file (its position, what C has buffered), so they are plain
// `fn`s: a function that reads a file takes it `inout`.
//
// Names starting with `_` are the module's own (docs/language/15-modules.md,
// "Private to the module"): the native functions, bound to the runtime's
// (Runtime.h, "The standard library's ::io").

import ::error as err;
import ::result as res;

// -- Printing -----------------------------------------------------------------

native fn _print(s: view Str) = "Paykan_print";
native fn _println(s: view Str) = "Paykan_println";
native fn _printerr(s: view Str) = "Paykan_printerr";
native fn _printerrln(s: view Str) = "Paykan_printerrln";

/// Writes `value.toString()` to stdout.
fn print<T: Showable>(value: view T) {
  _print(value.toString());
}
/// Writes `value.toString()` and a newline to stdout.
fn println<T: Showable>(value: view T) {
  _println(value.toString());
}
/// Writes `value.toString()` to stderr.
fn printerr<T: Showable>(value: view T) {
  _printerr(value.toString());
}
/// Writes `value.toString()` and a newline to stderr.
fn printerrln<T: Showable>(value: view T) {
  _printerrln(value.toString());
}

// -- Files --------------------------------------------------------------------

// A file is named by its handle, an `int`: the address of the runtime's
// file (Runtime.h, "File"), which nothing counts.  0 is no file.
native fn _open(path: view Str, mode: view Str, errno: inout int)
                -> int = "Paykan_io_open";
native fn _close(file: int) = "Paykan_io_close";
native fn _write(file: int, s: view Str) -> int = "Paykan_io_write";
native fn _readln(file: int, errno: inout int) -> Str? = "Paykan_io_readln";
native fn _readbytes(file: int, n: int, errno: inout int)
                     -> Str? = "Paykan_io_readbytes";
native fn _read(file: int, errno: inout int) -> Str? = "Paykan_io_read";
native fn _stdin() -> int = "Paykan_io_stdin";

/// The Result of a read: the @p text read, or the error its @p errno says
/// (`EndOfFile` for 0, nothing left to read).
fn _readResult(text: Str?, errno: int) -> res::Result<Str, err::Error> {
  match move text {
    t: Str { return res::ok(move t); }
    None {
      if errno == 0 {
        return res::fail(err::Error(err::ErrorCode::EndOfFile, None));
      }
      return res::fail(err::fromErrno(errno));
    }
  }
}

/// An open file.  Made by `open` and `stdin`; the handle names the
/// runtime's file, which this File alone holds and closes when it is
/// destroyed.
struct File {
  __handle: int;
}

impl File {
  /// Made by `open` and `stdin` only: the initializer is the module's.
  fn ___init__(handle: int) { self.__handle = handle; }
  /// Closes the file (the process's standard input stays open).
  fn __deinit__()           { _close(self.__handle); }
  /// Writes @p s to the file: no error, or why it could not.
  fn write(s: view Str) -> err::Error
                            { return err::fromErrno(_write(self.__handle, s)); }
  /// The next line, with its newline when it has one.
  fn readln() -> res::Result<Str, err::Error> {
    errno = 0;
    return _readResult(_readln(self.__handle, errno), errno);
  }
  /// Up to @p n bytes (`InvalidArgument` when @p n is not positive).
  fn readbytes(n: int) -> res::Result<Str, err::Error> {
    errno = 0;
    return _readResult(_readbytes(self.__handle, n, errno), errno);
  }
  /// The rest of the file.
  fn read() -> res::Result<Str, err::Error> {
    errno = 0;
    return _readResult(_read(self.__handle, errno), errno);
  }
}

/// The file at @p path opened with the `fopen` mode @p mode, or the Error
/// saying why it could not be (`NotFound`, `PermissionDenied`, ..., with C's
/// text as its message).
fn open(path: view Str, mode: view Str) -> res::Result<File, err::Error> {
  errno = 0;
  let handle = _open(path, mode, errno);
  if handle == 0 {
    return res::fail(err::fromErrno(errno));
  }
  return res::ok(File(handle));
}

/// The process's standard input.  Every call gives a File of its own over
/// the one input, which none of them closes.
fn stdin() -> File {
  return File(_stdin());
}
