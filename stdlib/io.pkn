// ::io: printing, files and the standard input.
//
// The print functions take any value that shows itself (`T: Show`: an
// object, a Str, a number, a bool, a char, a tuple, a struct, or an optional
// of one, None printing as "None") and write its `toString()` to stdout or
// stderr, `println` and `printerrln` with a newline after it.
//
// A File is an open file: `open(path, mode)` opens one with C's `fopen` (the
// mode "r", "w", "a", ...) and returns a Result (::result) holding it, or the
// Error saying why it could not; `stdin()` is the process's standard input.
// A File is closed when the last reference to it goes.  Each of its methods
// reports what went wrong the same way: a write returns its Error (`Ok` when
// it wrote), a read a Result holding the text read, whose error is
// `EndOfFile` when nothing was left to read.
//
// Names starting with `_` are the module's own (docs/language/06-modules.md,
// "Private to the module"): the native functions, bound to the runtime's
// (Runtime.h, "The standard library's ::io").

import ::result as res;

// -- Printing -----------------------------------------------------------------

native fn _print(s: view Str) = "Paykan_print";
native fn _println(s: view Str) = "Paykan_println";
native fn _printerr(s: view Str) = "Paykan_printerr";
native fn _printerrln(s: view Str) = "Paykan_printerrln";

/// Writes `value.toString()` to stdout.
fn print<T: Show>(value: view T) {
  _print(value.toString());
}
/// Writes `value.toString()` and a newline to stdout.
fn println<T: Show>(value: view T) {
  _println(value.toString());
}
/// Writes `value.toString()` to stderr.
fn printerr<T: Show>(value: view T) {
  _printerr(value.toString());
}
/// Writes `value.toString()` and a newline to stderr.
fn printerrln<T: Show>(value: view T) {
  _printerrln(value.toString());
}

// -- Files --------------------------------------------------------------------

native fn _open(path: view Str, mode: view Str, errno: inout int)
                -> Obj? = "Paykan_io_open";
native fn _write(file: view Obj, s: view Str) -> int = "Paykan_io_write";
native fn _readln(file: view Obj, errno: inout int)
                  -> Str? = "Paykan_io_readln";
native fn _readbytes(file: view Obj, n: int, errno: inout int)
                     -> Str? = "Paykan_io_readbytes";
native fn _read(file: view Obj, errno: inout int) -> Str? = "Paykan_io_read";
native fn _stdin() -> Obj = "Paykan_io_stdin";

/// The Error of C's @p errno: none for 0.
fn _error(errno: int) -> res::Error {
  return if errno == 0 then res::none() else res::fromErrno(errno);
}

/// The Result of a read: the @p text read, or the error its @p errno says
/// (`EndOfFile` for 0, nothing left to read).
fn _readResult(text: Str?, errno: int) -> res::Result<Str> {
  match text {
    t: Str { return res::ok(t); }
    None {
      e = if errno == 0 then res::Error(res::ErrorCode::EndOfFile, None)
          else res::fromErrno(errno);
      return res::Result<Str>(e, None);
    }
  }
}

/// An open file.  Made by `open` and `stdin`; the handle is the runtime's
/// file, closed when the last File holding it goes.
class File {
  __handle: Obj;
  /// "File@" and the address of the runtime's file.
  view fn toString() -> Str { return self.__handle.toString(); }
}

impl File {
  /// Writes @p s to the file: no error, or why it could not.
  view fn write(s: view Str) -> res::Error {
    return _error(_write(self.__handle, s));
  }
  /// The next line, with its newline when it has one.
  view fn readln() -> res::Result<Str> {
    errno = 0;
    return _readResult(_readln(self.__handle, errno), errno);
  }
  /// Up to @p n bytes (`InvalidArgument` when @p n is not positive).
  view fn readbytes(n: int) -> res::Result<Str> {
    errno = 0;
    return _readResult(_readbytes(self.__handle, n, errno), errno);
  }
  /// The rest of the file.
  view fn read() -> res::Result<Str> {
    errno = 0;
    return _readResult(_read(self.__handle, errno), errno);
  }
}

/// The file at @p path opened with the `fopen` mode @p mode, or the Error
/// saying why it could not be (`NotFound`, `PermissionDenied`, ..., with C's
/// text as its message).
fn open(path: view Str, mode: view Str) -> res::Result<File> {
  errno = 0;
  match _open(path, mode, errno) {
    handle: Obj {
      return res::ok(File(handle));
    }
    None {
      return res::Result<File>(res::fromErrno(errno), None);
    }
  }
}

/// The process's standard input.
fn stdin() -> File {
  return File(_stdin());
}
