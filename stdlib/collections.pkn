// ::collections: the standard containers.
//
//   List<T>                  a growable array
//   LinkedList<T>            a doubly linked list
//   Stack<T>, Queue<T>       last-in-first-out and first-in-first-out,
//                            on a LinkedList
//   HashMap<K, V>, HashSet<K>
//                            hash tables of Hashable keys
//   MinPriorityQueue<T>, MaxPriorityQueue<T>
//                            binary heaps ordered by an int priority
//
// List, Stack, Queue, HashMap, HashSet and the priority queues are structs,
// each holding one object that keeps all of its state (LinkedList is that
// object itself), so assigning or passing a container names the same
// container: a change through either name is seen through both.  Every index and
// size is an `unsigned`: `len()` returns one, `get(i)` takes one, and
// `indexOf` returns an `unsigned?`.  A container holds
// its own reference to each element it stores.  Elements are compared with
// `==`, so a class compares by its `equals`.  A method that hands an element
// out returns a copy (an object is then shared with the container).  A
// broken precondition, such as `pop` on an empty container or an index out
// of range, panics.
//
// Names starting with `_` are private (docs/language/15-modules.md,
// "Private to the module"): `_Entry`, `_Table`, `_Heap`, `_panic`, `_fail`,
// `_bucket` and the buffer helpers are the module's own, and a `__` field or method is reachable
// only from its type's methods.

import ::memory as mem;
import ::result as res;

native fn _panic(message: view Str) = "Paykan_panic_message";
// _panic for where a value is due: it never returns one.
native fn _fail<T>(message: view Str) -> T = "Paykan_panic_value";
// What a `view fn` returns after _panic, as a `view` of part of `owner`: it
// is never reached.
native fn _unreachableView<T>(owner: view Obj)
                              -> view T = "Paykan_unreachable_view";

// -- Buffers ------------------------------------------------------------------
//
// The containers keep their elements in mem::Buffers, whose operations
// say when they fail (::result).  A container checks its own preconditions
// first, so what is left is a buffer that cannot grow: out of memory, a
// panic here.

/// @p e, which is no error unless memory ran out.
fn _check(e: res::Error) {
  if !e.isOk() {
    _panic("out of memory: " + e.message());
  }
}

/// A buffer of @p n new slots.
fn _buffer<T>(n: unsigned) -> mem::Buffer<T> {
  b = mem::Buffer<T>();
  _check(b.grow(n));
  return b;
}

// -- List ---------------------------------------------------------------------

// A growable array.  `push` and `pop` at the end are amortised O(1); `insert`
// and `removeAt` move the elements after the index.
struct List<T> {
  __items: mem::Buffer<T>;
}

impl List<T> {
  // An empty list.
  fn __init__()                       { self.__items = mem::Buffer<T>(); }

  // The number of elements.
  view fn len() -> unsigned           { return self.__items.len(); }

  // True when the list has no elements.
  view fn isEmpty() -> bool           { return self.__items.len() == 0; }

  // Element `i`, for i < len(), as a `view`.
  view fn get(i: unsigned) -> view T {
    self.__check(i, self.__items.len());
    return self.__items.get(i);
  }

  // Replace element `i`, for i < len().
  fn set(i: unsigned, v: view T) {
    self.__check(i, self.__items.len());
    _check(self.__items.set(i, v));
  }

  // Append `v`.
  fn push(v: view T)                  { _check(self.__items.push(v)); }

  // Remove and return the last element.
  fn pop() -> T {
    n: unsigned = self.__items.len();
    if n == 0 {
      _panic("pop from an empty List");
    }
    v: T = self.__items.copyUnchecked(n - 1);
    _check(self.__items.shrink(1));
    return v;
  }

  // The last element, as a `view`.
  view fn last() -> view T {
    n: unsigned = self.__items.len();
    if n == 0 {
      _panic("last of an empty List");
    }
    return self.__items.get(n - 1);
  }

  // Exchange elements `i` and `j`.
  fn swap(i: unsigned, j: unsigned) {
    self.__check(i, self.__items.len());
    self.__check(j, self.__items.len());
    _check(self.__items.swap(i, j));
  }

  // Insert `v` before element `i`, for i <= len().
  fn insert(i: unsigned, v: view T) {
    n: unsigned = self.__items.len();
    self.__check(i, n + 1);
    _check(self.__items.push(v));
    j: unsigned = n;
    while j > i {
      _check(self.__items.swap(j, j - 1));
      j = j - 1;
    }
  }

  // Remove and return element `i`, for i < len().
  fn removeAt(i: unsigned) -> T {
    n: unsigned = self.__items.len();
    self.__check(i, n);
    v: T = self.__items.copyUnchecked(i);
    j: unsigned = i;
    while j < n - 1 {
      _check(self.__items.swap(j, j + 1));
      j = j + 1;
    }
    _check(self.__items.shrink(1));
    return v;
  }

  // The index of the first element == v, or None.
  view fn indexOf(v: view T) -> unsigned? {
    i: unsigned = 0;
    n: unsigned = self.__items.len();
    while i < n {
      if self.__items.get(i) == v {
        return i;
      }
      i = i + 1;
    }
    return None;
  }

  // True when some element == v.
  view fn contains(v: view T) -> bool { return self.indexOf(v) != None; }

  // Remove the first element == v; True if there was one.
  fn remove(v: view T) -> bool {
    match self.indexOf(v) {
      i: unsigned {
        self.removeAt(i);
        return True;
      }
      None { return False; }
    }
  }

  // Reverse the order of the elements.
  fn reverse() {
    n: unsigned = self.__items.len();
    if n < 2 { return; }
    i: unsigned = 0;
    j: unsigned = n - 1;
    while i < j {
      _check(self.__items.swap(i, j));
      i = i + 1;
      j = j - 1;
    }
  }

  // Remove every element.
  fn clear() {
    _check(self.__items.shrink(self.__items.len()));
  }

  // A new list of the same elements (which it shares, if they are objects).
  view fn copy() -> List<T> {
    out: List<T> = List<T>();
    i: unsigned = 0;
    n: unsigned = self.__items.len();
    while i < n {
      out.push(self.__items.get(i));
      i = i + 1;
    }
    return out;
  }

  view fn __check(i: unsigned, n: unsigned) {
    if i >= n {
      _panic("List index " + Str(i) + " out of range (len="
          + Str(self.__items.len()) + ")");
    }
  }
}

// A list of the elements of `xs`.
fn listOf<T>(xs: view T[]) -> List<T> {
  out: List<T> = List<T>();
  i: int = 0;
  while i < xs.len() {
    out.push(xs[i]);
    i = i + 1;
  }
  return out;
}

// "[a, b, c]": the elements' toString, in order.
fn listToString<T: Show>(xs: view List<T>) -> Str {
  out: Str = "[";
  i: unsigned = 0;
  while i < xs.len() {
    if i > 0 { out = out + ", "; }
    out = out + xs.get(i).toString();
    i = i + 1;
  }
  return out + "]";
}

// -- LinkedList ---------------------------------------------------------------

// A node of a LinkedList: its value, the next node, which the node owns (the
// list owns the chain through its head), and the previous node as a `weak`
// back link, so two neighbours form no reference cycle and dropping the
// list frees every node.
class _Node<T> {
  value: T;
  next: _Node<T>?;
  weak prev: _Node<T>?;
}

// A doubly linked list: both ends are O(1) to reach, add to and remove from.
// The head owns the chain of nodes through their `next` links; the tail is a
// weak reference, kept alive by the chain.
class LinkedList<T> {
  __head: _Node<T>?;
  weak __tail: _Node<T>?;
  __len: unsigned;
}

impl LinkedList<T> {
  // An empty list.
  fn __init__() {
    self.__head = None;
    self.__tail = None;
    self.__len = 0;
  }

  // The number of elements.
  view fn len() -> unsigned { return self.__len; }

  // True when the list has no elements.
  view fn isEmpty() -> bool { return self.__len == 0; }

  // Add `v` before the first element.
  fn pushFront(v: T) {
    n = _Node<T>(v, self.__head, None);
    match self.__head {
      h: _Node<T> { h.prev = n; }
      None { self.__tail = n; }
    }
    self.__head = n;
    self.__len = self.__len + 1;
  }

  // Add `v` after the last element.
  fn pushBack(v: T) {
    match self.__tail {
      t: _Node<T> {
        n = _Node<T>(v, None, t);
        t.next = n;
        self.__tail = n;
        self.__len = self.__len + 1;
      }
      None { self.pushFront(v); }
    }
  }

  // Remove and return the first element.
  fn popFront() -> T {
    match self.__head {
      h: _Node<T> {
        self.__unlink(h);
        return h.value;
      }
      None {
        return _fail<T>("popFront on an empty LinkedList");
      }
    }
  }

  // Remove and return the last element.
  fn popBack() -> T {
    match self.__tail {
      t: _Node<T> {
        self.__unlink(t);
        return t.value;
      }
      None {
        return _fail<T>("popBack on an empty LinkedList");
      }
    }
  }

  // The first element.
  view fn front() -> view T {
    match self.__head {
      n: _Node<T> { return n.value; }
      None {
        _panic("front on an empty LinkedList");
        return _unreachableView<T>(self);
      }
    }
  }

  // The last element.
  view fn back() -> view T {
    match self.__tail {
      n: _Node<T> { return n.value; }
      None {
        _panic("back on an empty LinkedList");
        return _unreachableView<T>(self);
      }
    }
  }

  // True when some element == v.
  view fn contains(v: view T) -> bool {
    weak cur = self.__head; // the cursor: no reference copied out of self
    while True {
      match cur {
        n: _Node<T> {
          if n.value == v { return True; }
          cur = n.next;
        }
        None { return False; }
      }
    }
    return False;
  }

  // Remove the first element == v; True if there was one.
  fn remove(v: view T) -> bool {
    weak cur = self.__head;
    while True {
      match cur {
        n: _Node<T> {
          if n.value == v {
            self.__unlink(n);
            return True;
          }
          cur = n.next;
        }
        None { return False; }
      }
    }
    return False;
  }

  // Remove every element.
  fn clear() {
    self.__head = None;
    self.__tail = None;
    self.__len = 0;
  }

  // The elements from first to last, in a new list.
  view fn toList() -> List<T> {
    out: List<T> = List<T>();
    weak cur = self.__head; // the cursor: no reference copied out of self
    while True {
      match cur {
        n: _Node<T> {
          out.push(n.value);
          cur = n.next;
        }
        None { return out; }
      }
    }
    return out;
  }

  // Take node `n` out of the chain.
  fn __unlink(n: _Node<T>) {
    match n.prev {
      p: _Node<T> { p.next = n.next; }
      None { self.__head = n.next; }
    }
    match n.next {
      x: _Node<T> { x.prev = n.prev; }
      None { self.__tail = n.prev; }
    }
    n.next = None;
    n.prev = None;
    self.__len = self.__len - 1;
  }
}

// -- Stack and Queue ------------------------------------------------------------

// Last in, first out: push and pop at the top, O(1).
struct Stack<T> {
  __list: LinkedList<T>;
}

impl Stack<T> {
  // An empty stack.
  fn __init__()               { self.__list = LinkedList<T>(); }

  view fn len() -> unsigned   { return self.__list.len(); }
  view fn isEmpty() -> bool   { return self.__list.isEmpty(); }

  // Put `v` on top.
  fn push(v: T)               { self.__list.pushFront(v); }

  // Remove and return the top element.
  fn pop() -> T {
    if self.__list.isEmpty() {
      _panic("pop from an empty Stack");
    }
    return self.__list.popFront();
  }

  // The top element.
  view fn peek() -> view T {
    if self.__list.isEmpty() {
      _panic("peek at an empty Stack");
    }
    return self.__list.front();
  }

  // Remove every element.
  fn clear()                  { self.__list.clear(); }

  // The elements from top to bottom, in a new list.
  view fn toList() -> List<T> { return self.__list.toList(); }
}

// First in, first out: enqueue at the back and dequeue at the front, O(1).
struct Queue<T> {
  __list: LinkedList<T>;
}

impl Queue<T> {
  // An empty queue.
  fn __init__()               { self.__list = LinkedList<T>(); }

  view fn len() -> unsigned   { return self.__list.len(); }
  view fn isEmpty() -> bool   { return self.__list.isEmpty(); }

  // Add `v` at the back.
  fn enqueue(v: T)            { self.__list.pushBack(v); }

  // Remove and return the front element.
  fn dequeue() -> T {
    if self.__list.isEmpty() {
      _panic("dequeue from an empty Queue");
    }
    return self.__list.popFront();
  }

  // The front element.
  view fn peek() -> view T {
    if self.__list.isEmpty() {
      _panic("peek at an empty Queue");
    }
    return self.__list.front();
  }

  // Remove every element.
  fn clear()                  { self.__list.clear(); }

  // The elements from front to back, in a new list.
  view fn toList() -> List<T> { return self.__list.toList(); }
}

// -- HashMap and HashSet --------------------------------------------------------

// One key and its value, in its bucket's chain.
class _Entry<K, V> {
  key: K;
  value: V;
  hash: int;
  next: _Entry<K, V>?;
}

// The table of a HashMap or a HashSet: its buckets and its number of keys,
// which every copy of the map or set shares.
class _Table<K: Hashable, V> {
  __buckets: mem::Buffer<_Entry<K, V>?>;
  __size: unsigned;
}

impl _Table<K, V> {
  fn __init__() {
    self.__buckets = _buffer<_Entry<K, V>?>(8);
    self.__size = 0;
  }

  // The number of keys.
  view fn len() -> unsigned { return self.__size; }

  // True when the map has no keys.
  view fn isEmpty() -> bool { return self.__size == 0; }

  // Map `k` to `v`, replacing its value if `k` is already a key.  True if
  // `k` is a new key.
  fn put(k: K, v: V) -> bool {
    h: int = k.hash();
    match self.__find(k, h) {
      e: _Entry<K, V> {
        e.value = v;
        return False;
      }
      None { }
    }
    if (self.__size + 1) * 4 > self.__buckets.len() * 3 {
      self.__rehash(self.__buckets.len() * 2);
    }
    b: unsigned = _bucket(h, self.__buckets.len());
    _check(self.__buckets.set(b, _Entry<K,
        V>(k, v, h, self.__buckets.copyUnchecked(b))));
    self.__size = self.__size + 1;
    return True;
  }

  // The value of `k`, which must be a key, as a `view`.
  view fn get(k: view K) -> view V {
    h: int = k.hash();
    match self.__buckets.get(_bucket(h, self.__buckets.len())) {
      e: _Entry<K, V> { return self.__valueIn(e, k, h); }
      None {
        _panic("HashMap.get of a key it does not have");
        return _unreachableView<V>(self);
      }
    }
  }

  // The value of `k`, or `otherwise` if it is not a key, as a `view`.
  view fn getOr(k: view K, otherwise: view V) -> view V {
    h: int = k.hash();
    match self.__buckets.get(_bucket(h, self.__buckets.len())) {
      e: _Entry<K, V> { return self.__valueOr(e, k, h, otherwise); }
      None { return otherwise; }
    }
  }

  // True when `k` is a key.
  view fn containsKey(k: view K) -> bool {
    h: int = k.hash();
    weak cur = self.__buckets.get(_bucket(h, self.__buckets.len()));
    while True {
      match cur {
        e: _Entry<K, V> {
          if e.hash == h && e.key == k { return True; }
          cur = e.next;
        }
        None { return False; }
      }
    }
    return False;
  }

  // Remove `k` and its value; True if it was a key.
  fn remove(k: view K) -> bool {
    h: int = k.hash();
    b: unsigned = _bucket(h, self.__buckets.len());
    prev: _Entry<K, V>? = None;
    cur: _Entry<K, V>? = self.__buckets.copyUnchecked(b);
    while True {
      match cur {
        e: _Entry<K, V> {
          if e.hash == h && e.key == k {
            match prev {
              p: _Entry<K, V> {
                p.next = e.next;
              }
              None {
                _check(self.__buckets.set(b, e.next));
              }
            }
            self.__size = self.__size - 1;
            return True;
          }
          prev = e;
          cur = e.next;
        }
        None { return False; }
      }
    }
    return False;
  }

  // Remove every key.
  fn clear() {
    self.__buckets = _buffer<_Entry<K, V>?>(8);
    self.__size = 0;
  }

  // The keys, in a new list.
  view fn keys() -> List<K> {
    out: List<K> = List<K>();
    i: unsigned = 0;
    while i < self.__buckets.len() {
      weak cur = self.__buckets.get(i); // no reference copied out of self
      while cur != None {
        match cur {
          e: _Entry<K, V> {
            out.push(e.key);
            cur = e.next;
          }
          None { }
        }
      }
      i = i + 1;
    }
    return out;
  }

  // The values, in a new list, in the order of keys().
  view fn values() -> List<V> {
    out: List<V> = List<V>();
    i: unsigned = 0;
    while i < self.__buckets.len() {
      weak cur = self.__buckets.get(i); // no reference copied out of self
      while cur != None {
        match cur {
          e: _Entry<K, V> {
            out.push(e.value);
            cur = e.next;
          }
          None { }
        }
      }
      i = i + 1;
    }
    return out;
  }

  // The value of key `k`, whose hash is `h`, in the chain from `e`, which
  // holds it.
  view fn __valueIn(e: view _Entry<K, V>, k: view K, h: int) -> view V {
    if e.hash == h && e.key == k {
      return e.value;
    }
    match e.next {
      n: _Entry<K, V> { return self.__valueIn(n, k, h); }
      None {
        _panic("HashMap.get of a key it does not have");
        return _unreachableView<V>(self);
      }
    }
  }

  // The value of key `k`, whose hash is `h`, in the chain from `e`, or
  // `otherwise`.
  view fn __valueOr(e: view _Entry<K, V>, k: view K, h: int, otherwise: view V)
                    -> view V {
    if e.hash == h && e.key == k {
      return e.value;
    }
    match e.next {
      n: _Entry<K, V> { return self.__valueOr(n, k, h, otherwise); }
      None { return otherwise; }
    }
  }

  // The entry of key `k`, whose hash is `h`, or None: for put(), which
  // changes it.
  fn __find(k: view K, h: int) -> _Entry<K, V>? {
    cur: _Entry<K, V>? =
        self.__buckets.copyUnchecked(_bucket(h, self.__buckets.len()));
    while True {
      match cur {
        e: _Entry<K, V> {
          if e.hash == h && e.key == k {
            return e;
          }
          cur = e.next;
        }
        None { return None; }
      }
    }
    return None;
  }

  // Move every entry into `n` new buckets.
  fn __rehash(n: unsigned) {
    old: mem::Buffer<_Entry<K, V>?> = self.__buckets;
    self.__buckets = _buffer<_Entry<K, V>?>(n);
    i: unsigned = 0;
    while i < old.len() {
      cur: _Entry<K, V>? = old.copyUnchecked(i);
      while cur != None {
        match cur {
          e: _Entry<K, V> {
            cur = e.next;
            b: unsigned = _bucket(e.hash, n);
            e.next = self.__buckets.copyUnchecked(b);
            _check(self.__buckets.set(b, e));
          }
          None { }
        }
      }
      i = i + 1;
    }
  }
}

// The bucket of hash `h` among `n`: the hash's bits read as an unsigned
// number, modulo `n`, so a negative hash lands in a bucket too.
fn _bucket(h: int, n: unsigned) -> unsigned {
  return unsigned(h) % n;
}

// A hash table: each key is Hashable and maps to one value.  Two keys are
// the same key when they are ==, and keys that are == must have equal
// hash(): a class key implements both (`impl Hashable for` and `equals`).
// `put`, `get`, `containsKey` and `remove` are O(1) on average.  The table
// keeps at most 3 entries for every 4 buckets, doubling when it would hold
// more.  The order of keys() is the table's, not the insertion order.
struct HashMap<K: Hashable, V> {
  __table: _Table<K, V>;
}

impl HashMap<K, V> {
  // An empty map.
  fn __init__()                          { self.__table = _Table<K, V>(); }

  // The number of keys.
  view fn len() -> unsigned              { return self.__table.len(); }

  // True when the map has no keys.
  view fn isEmpty() -> bool              { return self.__table.isEmpty(); }

  // Map `k` to `v`, replacing its value if `k` is already a key.  True if
  // `k` is a new key.
  fn put(k: K, v: V) -> bool             { return self.__table.put(k, v); }

  // The value of `k`, which must be a key, as a `view`.
  view fn get(k: view K) -> view V       { return self.__table.get(k); }

  // The value of `k`, or `otherwise` if it is not a key, as a `view`.
  view fn getOr(k: view K, otherwise: view V) -> view V {
    return self.__table.getOr(k, otherwise);
  }

  // True when `k` is a key.
  view fn containsKey(k: view K) -> bool { return self.__table.containsKey(k); }

  // Remove `k` and its value; True if it was a key.
  fn remove(k: view K) -> bool           { return self.__table.remove(k); }

  // Remove every key.
  fn clear()                             { self.__table.clear(); }

  // The keys, in a new list.
  view fn keys() -> List<K>              { return self.__table.keys(); }

  // The values, in a new list, in the order of keys().
  view fn values() -> List<V>            { return self.__table.values(); }
}

// A set of Hashable keys, compared with == (see HashMap): the keys of a
// _Table, which every copy of the set shares.
struct HashSet<K: Hashable> {
  __table: _Table<K, bool>;
}

impl HashSet<K> {
  // An empty set.
  fn __init__()                       { self.__table = _Table<K, bool>(); }

  // The number of keys.
  view fn len() -> unsigned           { return self.__table.len(); }

  // True when the set has no keys.
  view fn isEmpty() -> bool           { return self.__table.isEmpty(); }

  // Add `k`; True if it was not in the set.
  fn add(k: K) -> bool                { return self.__table.put(k, True); }

  // True when `k` is in the set.
  view fn contains(k: view K) -> bool { return self.__table.containsKey(k); }

  // Remove `k`; True if it was in the set.
  fn remove(k: view K) -> bool        { return self.__table.remove(k); }

  // Remove every key.
  fn clear()                          { self.__table.clear(); }

  // The keys, in a new list.
  view fn toList() -> List<K>         { return self.__table.keys(); }
}

// -- Priority queues ------------------------------------------------------------

// A binary heap of elements, each with an int priority.  It pops the lowest
// priority first when `__max` is False, the highest when True; elements of
// equal priority pop in the order they were pushed.  Every element carries a
// sequence number for that, and the heap orders by (priority, sequence).
class _Heap<T> {
  __values: mem::Buffer<T>;
  __priorities: mem::Buffer<int>;
  __order: mem::Buffer<unsigned>;
  __pushed: unsigned;
  __max: bool;
}

impl _Heap<T> {
  fn __init__(max: bool) {
    self.__values = mem::Buffer<T>();
    self.__priorities = mem::Buffer<int>();
    self.__order = mem::Buffer<unsigned>();
    self.__pushed = 0;
    self.__max = max;
  }

  view fn len() -> unsigned { return self.__values.len(); }

  fn push(v: view T, priority: int) {
    _check(self.__values.push(v));
    _check(self.__priorities.push(priority));
    _check(self.__order.push(self.__pushed));
    self.__pushed = self.__pushed + 1;
    self.__siftUp(self.__values.len() - 1);
  }

  fn pop(what: view Str) -> T {
    self.__nonEmpty(what);
    v: T = self.__values.copyUnchecked(0);
    last: unsigned = self.__values.len() - 1;
    self.__swap(0, last);
    _check(self.__values.shrink(1));
    _check(self.__priorities.shrink(1));
    _check(self.__order.shrink(1));
    self.__siftDown(0);
    return v;
  }

  view fn peek() -> view T {
    self.__nonEmpty("peek");
    return self.__values.get(0);
  }

  view fn peekPriority(what: view Str) -> int {
    self.__nonEmpty(what);
    return self.__priorities.get(0);
  }

  fn clear() {
    n: unsigned = self.__values.len();
    _check(self.__values.shrink(n));
    _check(self.__priorities.shrink(n));
    _check(self.__order.shrink(n));
  }

  // True when node `i` pops before node `j`.
  view fn __before(i: unsigned, j: unsigned) -> bool {
    pi: int = self.__priorities.get(i);
    pj: int = self.__priorities.get(j);
    if pi != pj {
      if self.__max { return pi > pj; }
      return pi < pj;
    }
    return self.__order.get(i) < self.__order.get(j);
  }

  fn __swap(i: unsigned, j: unsigned) {
    if i == j { return; }
    _check(self.__values.swap(i, j));
    _check(self.__priorities.swap(i, j));
    _check(self.__order.swap(i, j));
  }

  fn __siftUp(i: unsigned) {
    k: unsigned = i;
    while k > 0 {
      parent: unsigned = (k - 1) / 2;
      if !self.__before(k, parent) {
        return;
      }
      self.__swap(k, parent);
      k = parent;
    }
  }

  fn __siftDown(i: unsigned) {
    n: unsigned = self.__values.len();
    k: unsigned = i;
    while True {
      best: unsigned = k;
      l: unsigned = 2 * k + 1;
      r: unsigned = l + 1;
      if l < n && self.__before(l, best) {
        best = l;
      }
      if r < n && self.__before(r, best) {
        best = r;
      }
      if best == k { return; }
      self.__swap(k, best);
      k = best;
    }
  }

  view fn __nonEmpty(what: view Str) {
    if self.__values.len() == 0 {
      _panic(what + " on an empty priority queue");
    }
  }
}

// A priority queue that pops the element of lowest priority first, and of
// equal priorities the one pushed first.  push and pop are O(log n).
struct MinPriorityQueue<T> {
  __heap: _Heap<T>;
}

impl MinPriorityQueue<T> {
  // An empty queue.
  fn __init__()                     { self.__heap = _Heap<T>(False); }

  view fn len() -> unsigned         { return self.__heap.len(); }
  view fn isEmpty() -> bool         { return self.__heap.len() == 0; }

  // Add `v` with `priority`.
  fn push(v: view T, priority: int) { self.__heap.push(v, priority); }

  // Remove and return the element of lowest priority.
  fn pop() -> T                     { return self.__heap.pop("pop"); }

  // The element of lowest priority, as a `view`.
  view fn peek() -> view T          { return self.__heap.peek(); }

  // Its priority.
  view fn peekPriority() -> int {
    return self.__heap.peekPriority("peekPriority");
  }

  // Remove every element.
  fn clear()                        { self.__heap.clear(); }
}

// A priority queue that pops the element of highest priority first, and of
// equal priorities the one pushed first.  push and pop are O(log n).
struct MaxPriorityQueue<T> {
  __heap: _Heap<T>;
}

impl MaxPriorityQueue<T> {
  // An empty queue.
  fn __init__()                     { self.__heap = _Heap<T>(True); }

  view fn len() -> unsigned         { return self.__heap.len(); }
  view fn isEmpty() -> bool         { return self.__heap.len() == 0; }

  // Add `v` with `priority`.
  fn push(v: view T, priority: int) { self.__heap.push(v, priority); }

  // Remove and return the element of highest priority.
  fn pop() -> T                     { return self.__heap.pop("pop"); }

  // The element of highest priority, as a `view`.
  view fn peek() -> view T          { return self.__heap.peek(); }

  // Its priority.
  view fn peekPriority() -> int {
    return self.__heap.peekPriority("peekPriority");
  }

  // Remove every element.
  fn clear()                        { self.__heap.clear(); }
}
