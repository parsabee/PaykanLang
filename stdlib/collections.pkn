// ::collections: the standard containers, and functions on strings.
//
//   List<T>                  a growable array
//   LinkedList<T>            a doubly linked list
//   Stack<T>, Queue<T>       last-in-first-out and first-in-first-out,
//                            on a LinkedList
//   HashMap<K, V>, HashSet<K>
//                            hash tables of Hashable keys
//   MinPriorityQueue<T>, MaxPriorityQueue<T>
//                            binary heaps ordered by an int priority
//   split, join, lines, words, indexOf, contains, startsWith, endsWith,
//   substring, trim, replace, repeat
//                            functions on Str ("Strings", at the end)
//
// List, Stack, Queue, HashMap, HashSet and the priority queues are structs,
// each holding one object that keeps all of its state (LinkedList is that
// object itself), so assigning or passing a container names the same
// container: a change through either name is seen through both.  Every index and
// size is an `unsigned`: `len()` returns one, `at(i)` and `get(i)` take one,
// and `indexOf` returns an `unsigned?`.  A container holds
// its own reference to each element it stores.  Elements are compared with
// `==`, so a class compares by its `equals`.  An element is handed out two
// ways: lent, as a `view` that stays the container's (`at`, `last`,
// `front`, `back`, `peek`, `atOr`: `view fn`s, so a `view` of the container
// reads with them), or as a copy the caller keeps (`get`, `getFront`,
// `getBack`, `getOr`: not `view fn`s, since an object element is then
// shared with the container).  A broken precondition, such as `pop` on an
// empty container or an index out of range, panics.
//
// Names starting with `_` are private (docs/language/15-modules.md,
// "Private to the module"): `_Entry`, `_Table`, `_Heap`, `_panic`, `_fail`,
// `_bucket`, the buffer helpers and the strings' (`_slice`, `_find`,
// `_isSpace`, `_isAt`, `_Pieces`) are the module's own, and a `__` field or
// method is reachable only from its type's methods.

import ::error as err;
import ::memory as mem;

native fn _panic(message: view Str) = "Paykan_panic_message";
// _panic for where a value is due: it never returns one.
native fn _fail<T>(message: view Str) -> T = "Paykan_panic_value";
// What a `view fn` returns after _panic, as a `view` of part of `owner`: it
// is never reached.
native fn _unreachableView<T>(owner: view Obj)
                              -> view T = "Paykan_unreachable_view";

// -- Buffers ------------------------------------------------------------------
//
// The containers keep their elements in mem::Buffers, whose operations
// say when they fail (::error).  A container checks its own preconditions
// first, so what is left is a buffer that cannot grow: out of memory, a
// panic here.

/// @p e, which is no error unless memory ran out.
fn _check(e: err::Error) {
  if !e.isOk() {
    _panic("out of memory: " + e.message());
  }
}

/// A buffer of @p n new slots.
fn _buffer<T>(n: unsigned) -> mem::Buffer<T> {
  b = mem::Buffer<T>();
  _check(b.grow(n));
  return b;
}

// -- List ---------------------------------------------------------------------

// A growable array.  `push` and `pop` at the end are amortised O(1); `insert`
// and `removeAt` move the elements after the index.
struct List<T> {
  __items: mem::Buffer<T>;
}

impl List<T> {
  // An empty list.
  fn __init__()                       { self.__items = mem::Buffer<T>(); }

  // The number of elements.
  view fn len() -> unsigned           { return self.__items.len(); }

  // True when the list has no elements.
  view fn isEmpty() -> bool           { return self.__items.len() == 0; }

  // Element `i`, for i < len(), as a `view`.
  view fn at(i: unsigned) -> view T {
    self.__check(i, self.__items.len());
    return self.__items.at(i);
  }

  // A copy of element `i`, for i < len(), to keep (an object is shared with
  // the list).
  fn get(i: unsigned) -> T {
    self.__check(i, self.__items.len());
    return self.__items.get(i);
  }

  // Replace element `i`, for i < len().
  fn set(i: unsigned, v: view T) {
    self.__check(i, self.__items.len());
    _check(self.__items.set(i, v));
  }

  // Append `v`.
  fn push(v: view T)                  { _check(self.__items.push(v)); }

  // Remove and return the last element.
  fn pop() -> T {
    n: unsigned = self.__items.len();
    if n == 0 {
      _panic("pop from an empty List");
    }
    v: T = self.__items.get(n - 1);
    _check(self.__items.shrink(1));
    return v;
  }

  // The last element, as a `view`.
  view fn last() -> view T {
    n: unsigned = self.__items.len();
    if n == 0 {
      _panic("last of an empty List");
    }
    return self.__items.at(n - 1);
  }

  // Exchange elements `i` and `j`.
  fn swap(i: unsigned, j: unsigned) {
    self.__check(i, self.__items.len());
    self.__check(j, self.__items.len());
    _check(self.__items.swap(i, j));
  }

  // Insert `v` before element `i`, for i <= len().
  fn insert(i: unsigned, v: view T) {
    n: unsigned = self.__items.len();
    self.__check(i, n + 1);
    _check(self.__items.push(v));
    j: unsigned = n;
    while j > i {
      _check(self.__items.swap(j, j - 1));
      j = j - 1;
    }
  }

  // Remove and return element `i`, for i < len().
  fn removeAt(i: unsigned) -> T {
    n: unsigned = self.__items.len();
    self.__check(i, n);
    v: T = self.__items.get(i);
    j: unsigned = i;
    while j < n - 1 {
      _check(self.__items.swap(j, j + 1));
      j = j + 1;
    }
    _check(self.__items.shrink(1));
    return v;
  }

  // The index of the first element == v, or None.  The length is read for
  // each element: an element's `equals` may change the list.
  view fn indexOf(v: view T) -> unsigned? {
    i: unsigned = 0;
    while i < self.__items.len() {
      if self.__items.at(i) == v {
        return i;
      }
      i = i + 1;
    }
    return None;
  }

  // True when some element == v.
  view fn contains(v: view T) -> bool { return self.indexOf(v) != None; }

  // Remove the first element == v; True if there was one.
  fn remove(v: view T) -> bool {
    match self.indexOf(v) {
      i: unsigned {
        self.removeAt(i);
        return True;
      }
      None { return False; }
    }
  }

  // Reverse the order of the elements.
  fn reverse() {
    n: unsigned = self.__items.len();
    if n < 2 { return; }
    i: unsigned = 0;
    j: unsigned = n - 1;
    while i < j {
      _check(self.__items.swap(i, j));
      i = i + 1;
      j = j - 1;
    }
  }

  // Remove every element.
  fn clear() {
    _check(self.__items.shrink(self.__items.len()));
  }

  // A new list of the same elements (which it shares, if they are objects).
  view fn copy() -> List<T> {
    out: List<T> = List<T>();
    i: unsigned = 0;
    n: unsigned = self.__items.len();
    while i < n {
      out.push(self.__items.at(i));
      i = i + 1;
    }
    return out;
  }

  view fn __check(i: unsigned, n: unsigned) {
    if i >= n {
      _panic("List index " + Str(i) + " out of range (len="
          + Str(self.__items.len()) + ")");
    }
  }
}

// A list of the elements of `xs`.
fn listOf<T>(xs: view T[]) -> List<T> {
  out: List<T> = List<T>();
  i: int = 0;
  while i < xs.len() {
    out.push(xs[i]);
    i = i + 1;
  }
  return out;
}

// "[a, b, c]": the elements' toString, in order.  Each is appended to `out`
// with `concat`, which grows it in place; `out = out + ...` would copy the
// string so far for each element.  `out` is a string of its own (each use
// of a literal is a new one), so the appends change no other.
fn listToString<T: Show>(xs: view List<T>) -> Str {
  let out: Str = "[";
  i: unsigned = 0;
  while i < xs.len() {
    if i > 0 { out.concat(", "); }
    out.concat(xs.at(i).toString());
    i = i + 1;
  }
  out.concat("]");
  return out;
}

// -- LinkedList ---------------------------------------------------------------

// A node of a LinkedList: its value, the next node, which the node owns (the
// list owns the chain through its head), and the previous node as a `weak`
// back link, so two neighbours form no reference cycle and dropping the
// list frees every node.
class _Node<T> {
  value: T;
  next: _Node<T>?;
  weak prev: _Node<T>?;
}

// A doubly linked list: both ends are O(1) to reach, add to and remove from.
// The head owns the chain of nodes through their `next` links; the tail is a
// weak reference, kept alive by the chain.
class LinkedList<T> {
  __head: _Node<T>?;
  weak __tail: _Node<T>?;
  __len: unsigned;
}

impl LinkedList<T> {
  // An empty list.
  fn __init__() {
    self.__head = None;
    self.__tail = None;
    self.__len = 0;
  }

  // The number of elements.
  view fn len() -> unsigned { return self.__len; }

  // True when the list has no elements.
  view fn isEmpty() -> bool { return self.__len == 0; }

  // Add `v` before the first element.
  fn pushFront(v: T) {
    n = _Node<T>(v, self.__head, None);
    match self.__head {
      h: _Node<T> { h.prev = n; }
      None { self.__tail = n; }
    }
    self.__head = n;
    self.__len = self.__len + 1;
  }

  // Add `v` after the last element.
  fn pushBack(v: T) {
    match self.__tail {
      t: _Node<T> {
        n = _Node<T>(v, None, t);
        t.next = n;
        self.__tail = n;
        self.__len = self.__len + 1;
      }
      None { self.pushFront(v); }
    }
  }

  // Remove and return the first element.
  fn popFront() -> T {
    match self.__head {
      h: _Node<T> {
        self.__unlink(h);
        return h.value;
      }
      None {
        return _fail<T>("popFront on an empty LinkedList");
      }
    }
  }

  // Remove and return the last element.
  fn popBack() -> T {
    match self.__tail {
      t: _Node<T> {
        self.__unlink(t);
        return t.value;
      }
      None {
        return _fail<T>("popBack on an empty LinkedList");
      }
    }
  }

  // The first element.
  view fn front() -> view T {
    match self.__head {
      n: _Node<T> { return n.value; }
      None {
        _panic("front on an empty LinkedList");
        return _unreachableView<T>(self);
      }
    }
  }

  // The last element.
  view fn back() -> view T {
    match self.__tail {
      n: _Node<T> { return n.value; }
      None {
        _panic("back on an empty LinkedList");
        return _unreachableView<T>(self);
      }
    }
  }

  // A copy of the first element, to keep.
  fn getFront() -> T {
    match self.__head {
      n: _Node<T> { return n.value; }
      None { return _fail<T>("getFront on an empty LinkedList"); }
    }
  }

  // A copy of the last element, to keep.
  fn getBack() -> T {
    match self.__tail {
      n: _Node<T> { return n.value; }
      None { return _fail<T>("getBack on an empty LinkedList"); }
    }
  }

  // True when some element == v.
  view fn contains(v: view T) -> bool {
    weak cur = self.__head; // the cursor: no reference copied out of self
    while True {
      match cur {
        n: _Node<T> {
          if n.value == v { return True; }
          cur = n.next;
        }
        None { return False; }
      }
    }
    return False;
  }

  // Remove the first element == v; True if there was one.
  fn remove(v: view T) -> bool {
    weak cur = self.__head;
    while True {
      match cur {
        n: _Node<T> {
          if n.value == v {
            self.__unlink(n);
            return True;
          }
          cur = n.next;
        }
        None { return False; }
      }
    }
    return False;
  }

  // Remove every element.
  fn clear() {
    self.__head = None;
    self.__tail = None;
    self.__len = 0;
  }

  // The elements from first to last, in a new list.
  view fn toList() -> List<T> {
    out: List<T> = List<T>();
    weak cur = self.__head; // the cursor: no reference copied out of self
    while True {
      match cur {
        n: _Node<T> {
          out.push(n.value);
          cur = n.next;
        }
        None { return out; }
      }
    }
    return out;
  }

  // Take node `n` out of the chain.
  fn __unlink(n: _Node<T>) {
    match n.prev {
      p: _Node<T> { p.next = n.next; }
      None { self.__head = n.next; }
    }
    match n.next {
      x: _Node<T> { x.prev = n.prev; }
      None { self.__tail = n.prev; }
    }
    n.next = None;
    n.prev = None;
    self.__len = self.__len - 1;
  }
}

// -- Stack and Queue ------------------------------------------------------------

// Last in, first out: push and pop at the top, O(1).
struct Stack<T> {
  __list: LinkedList<T>;
}

impl Stack<T> {
  // An empty stack.
  fn __init__()               { self.__list = LinkedList<T>(); }

  view fn len() -> unsigned   { return self.__list.len(); }
  view fn isEmpty() -> bool   { return self.__list.isEmpty(); }

  // Put `v` on top.
  fn push(v: T)               { self.__list.pushFront(v); }

  // Remove and return the top element.
  fn pop() -> T {
    if self.__list.isEmpty() {
      _panic("pop from an empty Stack");
    }
    return self.__list.popFront();
  }

  // The top element.
  view fn peek() -> view T {
    if self.__list.isEmpty() {
      _panic("peek at an empty Stack");
    }
    return self.__list.front();
  }

  // A copy of the top element, to keep.
  fn get() -> T {
    if self.__list.isEmpty() {
      _panic("get from an empty Stack");
    }
    return self.__list.getFront();
  }

  // Remove every element.
  fn clear()                  { self.__list.clear(); }

  // The elements from top to bottom, in a new list.
  view fn toList() -> List<T> { return self.__list.toList(); }
}

// First in, first out: enqueue at the back and dequeue at the front, O(1).
struct Queue<T> {
  __list: LinkedList<T>;
}

impl Queue<T> {
  // An empty queue.
  fn __init__()               { self.__list = LinkedList<T>(); }

  view fn len() -> unsigned   { return self.__list.len(); }
  view fn isEmpty() -> bool   { return self.__list.isEmpty(); }

  // Add `v` at the back.
  fn enqueue(v: T)            { self.__list.pushBack(v); }

  // Remove and return the front element.
  fn dequeue() -> T {
    if self.__list.isEmpty() {
      _panic("dequeue from an empty Queue");
    }
    return self.__list.popFront();
  }

  // The front element.
  view fn peek() -> view T {
    if self.__list.isEmpty() {
      _panic("peek at an empty Queue");
    }
    return self.__list.front();
  }

  // A copy of the front element, to keep.
  fn get() -> T {
    if self.__list.isEmpty() {
      _panic("get from an empty Queue");
    }
    return self.__list.getFront();
  }

  // Remove every element.
  fn clear()                  { self.__list.clear(); }

  // The elements from front to back, in a new list.
  view fn toList() -> List<T> { return self.__list.toList(); }
}

// -- HashMap and HashSet --------------------------------------------------------

// One key and its value, in its bucket's chain.
class _Entry<K, V> {
  key: K;
  value: V;
  hash: int;
  next: _Entry<K, V>?;
}

// The table of a HashMap or a HashSet: its buckets and its number of keys,
// which every copy of the map or set shares.
class _Table<K: Hashable, V> {
  __buckets: mem::Buffer<_Entry<K, V>?>;
  __size: unsigned;
}

impl _Table<K, V> {
  fn __init__() {
    self.__buckets = _buffer<_Entry<K, V>?>(8);
    self.__size = 0;
  }

  // The number of keys.
  view fn len() -> unsigned { return self.__size; }

  // True when the map has no keys.
  view fn isEmpty() -> bool { return self.__size == 0; }

  // Map `k` to `v`, replacing its value if `k` is already a key.  True if
  // `k` is a new key.
  fn put(k: K, v: V) -> bool {
    h: int = k.hash();
    match self.__find(k, h) {
      e: _Entry<K, V> {
        e.value = v;
        return False;
      }
      None { }
    }
    if (self.__size + 1) * 4 > self.__buckets.len() * 3 {
      self.__rehash(self.__buckets.len() * 2);
    }
    b: unsigned = _bucket(h, self.__buckets.len());
    _check(self.__buckets.set(b, _Entry<K, V>(k, v, h, self.__buckets.get(b))));
    self.__size = self.__size + 1;
    return True;
  }

  // The value of `k`, which must be a key, as a `view`.
  view fn at(k: view K) -> view V {
    h: int = k.hash();
    match self.__buckets.at(_bucket(h, self.__buckets.len())) {
      e: _Entry<K, V> { return self.__valueIn(e, k, h); }
      None {
        _panic("HashMap.at of a key it does not have");
        return _unreachableView<V>(self);
      }
    }
  }

  // The value of `k`, or `otherwise` if it is not a key, as a `view`.
  view fn atOr(k: view K, otherwise: view V) -> view V {
    h: int = k.hash();
    match self.__buckets.at(_bucket(h, self.__buckets.len())) {
      e: _Entry<K, V> { return self.__valueOr(e, k, h, otherwise); }
      None { return otherwise; }
    }
  }

  // A copy of the value of `k`, which must be a key, to keep.
  fn get(k: view K) -> V {
    match self.__find(k, k.hash()) {
      e: _Entry<K, V> { return e.value; }
      None { return _fail<V>("HashMap.get of a key it does not have"); }
    }
  }

  // A copy of the value of `k`, or `otherwise` if it is not a key.
  fn getOr(k: view K, otherwise: V) -> V {
    match self.__find(k, k.hash()) {
      e: _Entry<K, V> { return e.value; }
      None { return otherwise; }
    }
  }

  // True when `k` is a key.
  view fn containsKey(k: view K) -> bool {
    h: int = k.hash();
    weak cur = self.__buckets.at(_bucket(h, self.__buckets.len()));
    while True {
      match cur {
        e: _Entry<K, V> {
          if e.hash == h && e.key == k { return True; }
          cur = e.next;
        }
        None { return False; }
      }
    }
    return False;
  }

  // Remove `k` and its value; True if it was a key.
  fn remove(k: view K) -> bool {
    h: int = k.hash();
    b: unsigned = _bucket(h, self.__buckets.len());
    prev: _Entry<K, V>? = None;
    cur: _Entry<K, V>? = self.__buckets.get(b);
    while True {
      match cur {
        e: _Entry<K, V> {
          if e.hash == h && e.key == k {
            match prev {
              p: _Entry<K, V> {
                p.next = e.next;
              }
              None {
                _check(self.__buckets.set(b, e.next));
              }
            }
            self.__size = self.__size - 1;
            return True;
          }
          prev = e;
          cur = e.next;
        }
        None { return False; }
      }
    }
    return False;
  }

  // Remove every key.
  fn clear() {
    self.__buckets = _buffer<_Entry<K, V>?>(8);
    self.__size = 0;
  }

  // The keys, in a new list.
  view fn keys() -> List<K> {
    out: List<K> = List<K>();
    i: unsigned = 0;
    while i < self.__buckets.len() {
      weak cur = self.__buckets.at(i); // no reference copied out of self
      while cur != None {
        match cur {
          e: _Entry<K, V> {
            out.push(e.key);
            cur = e.next;
          }
          None { }
        }
      }
      i = i + 1;
    }
    return out;
  }

  // The values, in a new list, in the order of keys().
  view fn values() -> List<V> {
    out: List<V> = List<V>();
    i: unsigned = 0;
    while i < self.__buckets.len() {
      weak cur = self.__buckets.at(i); // no reference copied out of self
      while cur != None {
        match cur {
          e: _Entry<K, V> {
            out.push(e.value);
            cur = e.next;
          }
          None { }
        }
      }
      i = i + 1;
    }
    return out;
  }

  // The value of key `k`, whose hash is `h`, in the chain from `e`, which
  // holds it.
  view fn __valueIn(e: view _Entry<K, V>, k: view K, h: int) -> view V {
    if e.hash == h && e.key == k {
      return e.value;
    }
    match e.next {
      n: _Entry<K, V> { return self.__valueIn(n, k, h); }
      None {
        _panic("HashMap.at of a key it does not have");
        return _unreachableView<V>(self);
      }
    }
  }

  // The value of key `k`, whose hash is `h`, in the chain from `e`, or
  // `otherwise`.
  view fn __valueOr(e: view _Entry<K, V>, k: view K, h: int, otherwise: view V)
                    -> view V {
    if e.hash == h && e.key == k {
      return e.value;
    }
    match e.next {
      n: _Entry<K, V> { return self.__valueOr(n, k, h, otherwise); }
      None { return otherwise; }
    }
  }

  // The entry of key `k`, whose hash is `h`, or None: for put(), which
  // changes it, and for get().
  fn __find(k: view K, h: int) -> _Entry<K, V>? {
    cur: _Entry<K, V>? = self.__buckets.get(_bucket(h, self.__buckets.len()));
    while True {
      match cur {
        e: _Entry<K, V> {
          if e.hash == h && e.key == k {
            return e;
          }
          cur = e.next;
        }
        None { return None; }
      }
    }
    return None;
  }

  // Move every entry into `n` new buckets.
  fn __rehash(n: unsigned) {
    old: mem::Buffer<_Entry<K, V>?> = self.__buckets;
    self.__buckets = _buffer<_Entry<K, V>?>(n);
    i: unsigned = 0;
    while i < old.len() {
      cur: _Entry<K, V>? = old.get(i);
      while cur != None {
        match cur {
          e: _Entry<K, V> {
            cur = e.next;
            b: unsigned = _bucket(e.hash, n);
            e.next = self.__buckets.get(b);
            _check(self.__buckets.set(b, e));
          }
          None { }
        }
      }
      i = i + 1;
    }
  }
}

// The bucket of hash `h` among `n`: the hash's bits read as an unsigned
// number, modulo `n`, so a negative hash lands in a bucket too.
fn _bucket(h: int, n: unsigned) -> unsigned {
  return unsigned(h) % n;
}

// A hash table: each key is Hashable and maps to one value.  Two keys are
// the same key when they are ==, and keys that are == must have equal
// hash(): a class key implements both (`impl Hashable for` and `equals`).
// `put`, `at`, `get`, `containsKey` and `remove` are O(1) on average.  The table
// keeps at most 3 entries for every 4 buckets, doubling when it would hold
// more.  The order of keys() is the table's, not the insertion order.
struct HashMap<K: Hashable, V> {
  __table: _Table<K, V>;
}

impl HashMap<K, V> {
  // An empty map.
  fn __init__()                          { self.__table = _Table<K, V>(); }

  // The number of keys.
  view fn len() -> unsigned              { return self.__table.len(); }

  // True when the map has no keys.
  view fn isEmpty() -> bool              { return self.__table.isEmpty(); }

  // Map `k` to `v`, replacing its value if `k` is already a key.  True if
  // `k` is a new key.
  fn put(k: K, v: V) -> bool             { return self.__table.put(k, v); }

  // The value of `k`, which must be a key, as a `view`.
  view fn at(k: view K) -> view V        { return self.__table.at(k); }

  // The value of `k`, or `otherwise` if it is not a key, as a `view`.
  view fn atOr(k: view K, otherwise: view V) -> view V {
    return self.__table.atOr(k, otherwise);
  }

  // A copy of the value of `k`, which must be a key, to keep.
  fn get(k: view K) -> V                 { return self.__table.get(k); }

  // A copy of the value of `k`, or `otherwise` if it is not a key.
  fn getOr(k: view K, otherwise: V) -> V {
    return self.__table.getOr(k, otherwise);
  }

  // True when `k` is a key.
  view fn containsKey(k: view K) -> bool { return self.__table.containsKey(k); }

  // Remove `k` and its value; True if it was a key.
  fn remove(k: view K) -> bool           { return self.__table.remove(k); }

  // Remove every key.
  fn clear()                             { self.__table.clear(); }

  // The keys, in a new list.
  view fn keys() -> List<K>              { return self.__table.keys(); }

  // The values, in a new list, in the order of keys().
  view fn values() -> List<V>            { return self.__table.values(); }
}

// A set of Hashable keys, compared with == (see HashMap): the keys of a
// _Table, which every copy of the set shares.
struct HashSet<K: Hashable> {
  __table: _Table<K, bool>;
}

impl HashSet<K> {
  // An empty set.
  fn __init__()                       { self.__table = _Table<K, bool>(); }

  // The number of keys.
  view fn len() -> unsigned           { return self.__table.len(); }

  // True when the set has no keys.
  view fn isEmpty() -> bool           { return self.__table.isEmpty(); }

  // Add `k`; True if it was not in the set.
  fn add(k: K) -> bool                { return self.__table.put(k, True); }

  // True when `k` is in the set.
  view fn contains(k: view K) -> bool { return self.__table.containsKey(k); }

  // Remove `k`; True if it was in the set.
  fn remove(k: view K) -> bool        { return self.__table.remove(k); }

  // Remove every key.
  fn clear()                          { self.__table.clear(); }

  // The keys, in a new list.
  view fn toList() -> List<K>         { return self.__table.keys(); }
}

// -- Priority queues ------------------------------------------------------------

// A binary heap of elements, each with an int priority.  It pops the lowest
// priority first when `__max` is False, the highest when True; elements of
// equal priority pop in the order they were pushed.  Every element carries a
// sequence number for that, and the heap orders by (priority, sequence).
class _Heap<T> {
  __values: mem::Buffer<T>;
  __priorities: mem::Buffer<int>;
  __order: mem::Buffer<unsigned>;
  __pushed: unsigned;
  __max: bool;
}

impl _Heap<T> {
  fn __init__(max: bool) {
    self.__values = mem::Buffer<T>();
    self.__priorities = mem::Buffer<int>();
    self.__order = mem::Buffer<unsigned>();
    self.__pushed = 0;
    self.__max = max;
  }

  view fn len() -> unsigned { return self.__values.len(); }

  fn push(v: view T, priority: int) {
    _check(self.__values.push(v));
    _check(self.__priorities.push(priority));
    _check(self.__order.push(self.__pushed));
    self.__pushed = self.__pushed + 1;
    self.__siftUp(self.__values.len() - 1);
  }

  fn pop(what: view Str) -> T {
    self.__nonEmpty(what);
    v: T = self.__values.get(0);
    last: unsigned = self.__values.len() - 1;
    self.__swap(0, last);
    _check(self.__values.shrink(1));
    _check(self.__priorities.shrink(1));
    _check(self.__order.shrink(1));
    self.__siftDown(0);
    return v;
  }

  view fn peek() -> view T {
    self.__nonEmpty("peek");
    return self.__values.at(0);
  }

  fn get() -> T {
    self.__nonEmpty("get");
    return self.__values.get(0);
  }

  view fn peekPriority(what: view Str) -> int {
    self.__nonEmpty(what);
    return self.__priorities.at(0);
  }

  fn clear() {
    n: unsigned = self.__values.len();
    _check(self.__values.shrink(n));
    _check(self.__priorities.shrink(n));
    _check(self.__order.shrink(n));
  }

  // True when node `i` pops before node `j`.
  view fn __before(i: unsigned, j: unsigned) -> bool {
    pi: int = self.__priorities.at(i);
    pj: int = self.__priorities.at(j);
    if pi != pj {
      if self.__max { return pi > pj; }
      return pi < pj;
    }
    return self.__order.at(i) < self.__order.at(j);
  }

  fn __swap(i: unsigned, j: unsigned) {
    if i == j { return; }
    _check(self.__values.swap(i, j));
    _check(self.__priorities.swap(i, j));
    _check(self.__order.swap(i, j));
  }

  fn __siftUp(i: unsigned) {
    k: unsigned = i;
    while k > 0 {
      parent: unsigned = (k - 1) / 2;
      if !self.__before(k, parent) {
        return;
      }
      self.__swap(k, parent);
      k = parent;
    }
  }

  fn __siftDown(i: unsigned) {
    n: unsigned = self.__values.len();
    k: unsigned = i;
    while True {
      best: unsigned = k;
      l: unsigned = 2 * k + 1;
      r: unsigned = l + 1;
      if l < n && self.__before(l, best) {
        best = l;
      }
      if r < n && self.__before(r, best) {
        best = r;
      }
      if best == k { return; }
      self.__swap(k, best);
      k = best;
    }
  }

  view fn __nonEmpty(what: view Str) {
    if self.__values.len() == 0 {
      _panic(what + " on an empty priority queue");
    }
  }
}

// A priority queue that pops the element of lowest priority first, and of
// equal priorities the one pushed first.  push and pop are O(log n).
struct MinPriorityQueue<T> {
  __heap: _Heap<T>;
}

impl MinPriorityQueue<T> {
  // An empty queue.
  fn __init__()                     { self.__heap = _Heap<T>(False); }

  view fn len() -> unsigned         { return self.__heap.len(); }
  view fn isEmpty() -> bool         { return self.__heap.len() == 0; }

  // Add `v` with `priority`.
  fn push(v: view T, priority: int) { self.__heap.push(v, priority); }

  // Remove and return the element of lowest priority.
  fn pop() -> T                     { return self.__heap.pop("pop"); }

  // The element of lowest priority, as a `view`.
  view fn peek() -> view T          { return self.__heap.peek(); }

  // A copy of it, to keep.
  fn get() -> T                     { return self.__heap.get(); }

  // Its priority.
  view fn peekPriority() -> int {
    return self.__heap.peekPriority("peekPriority");
  }

  // Remove every element.
  fn clear()                        { self.__heap.clear(); }
}

// A priority queue that pops the element of highest priority first, and of
// equal priorities the one pushed first.  push and pop are O(log n).
struct MaxPriorityQueue<T> {
  __heap: _Heap<T>;
}

impl MaxPriorityQueue<T> {
  // An empty queue.
  fn __init__()                     { self.__heap = _Heap<T>(True); }

  view fn len() -> unsigned         { return self.__heap.len(); }
  view fn isEmpty() -> bool         { return self.__heap.len() == 0; }

  // Add `v` with `priority`.
  fn push(v: view T, priority: int) { self.__heap.push(v, priority); }

  // Remove and return the element of highest priority.
  fn pop() -> T                     { return self.__heap.pop("pop"); }

  // The element of highest priority, as a `view`.
  view fn peek() -> view T          { return self.__heap.peek(); }

  // A copy of it, to keep.
  fn get() -> T                     { return self.__heap.get(); }

  // Its priority.
  view fn peekPriority() -> int {
    return self.__heap.peekPriority("peekPriority");
  }

  // Remove every element.
  fn clear()                        { self.__heap.clear(); }
}

// -- Strings ------------------------------------------------------------------
//
// Functions on Str.  They count bytes, as `s.len()` and `s[i]` do, and take
// and return an index or a size as an `unsigned`.  A search is the runtime's
// (_find: C's memchr for the needle's first byte, memcmp for the rest of it
// where that byte is), and a part of a string is copied out whole (_slice),
// never built a byte at a time: split, lines, words, indexOf and contains
// take time linear in their input for a delimiter or a needle of a few
// bytes, and at worst proportional to its length times the needle's.  join
// and replace put their pieces together with a _Pieces, and repeat doubles
// its string, never appending each piece to the result so far with `+`
// (which copies it each time).  `concat` grows its string with C's realloc,
// which copies the string only when it moves the block; a _Pieces bounds
// the copies whatever realloc does.

native fn _slice(s: view Str, from: unsigned, to: unsigned)
                 -> Str = "PaykanString_slice";
native fn _find(s: view Str, needle: view Str, from: unsigned)
                -> int = "PaykanString_find";

// Whether `c` is ASCII whitespace: a space, or a tab, a line feed, a vertical
// tab, a form feed or a carriage return (the codes 9 to 13).
fn _isSpace(c: char) -> bool {
  return c == ' ' || (c >= '\t' && c <= '\r');
}

// Whether `part` is in `s` at index `at`, which leaves room for it.
fn _isAt(s: view Str, part: view Str, at: int) -> bool {
  for i in 0..part.len() {
    if s[at + i] != part[i] {
      return False;
    }
  }
  return True;
}

// A string put together from pieces added in order, for join and replace.
// Appending each piece to the string so far would copy that string each
// time, k times for k pieces.  Instead two strings of 2^b pieces each are
// merged into one of 2^(b+1), as a binary counter carries: the stack holds
// a string for each bit set in the count of pieces, the one of the most
// pieces at the bottom, and take() puts them together from the top.  A
// byte of a string of 2^b pieces has been copied by b merges, and take()
// copies it once for each string from there to the top, b + 1 at most:
// fewer than 2 log2(k) + 2 times in all (about log2(k) + 1 times for pieces
// of one length), so a result of n bytes takes time proportional to
// n log2(k).
struct _Pieces {
  __stack: List<Str>;
  __count: unsigned;
}

impl _Pieces {
  // No pieces.
  fn __init__() { self.__stack = List<Str>(); self.__count = 0; }

  // Add `piece` after the others ("" adds nothing).
  fn add(piece: view Str) {
    if piece.len() == 0 {
      return;
    }
    self.__stack.push(piece);
    self.__count = self.__count + 1;
    carry = self.__count;
    while carry % 2 == 0 {
      let top = self.__stack.pop();
      let below = self.__stack.pop();
      self.__stack.push(below + top);
      carry = carry / 2;
    }
  }

  // The pieces, in order, as a new string ("" for none); the stack is left
  // empty.
  fn take() -> Str {
    out = "";
    while !self.__stack.isEmpty() {
      out = self.__stack.pop() + out;
    }
    return out;
  }
}

// The fields of `s` between the occurrences of `delim`, in order, empty ones
// included: split("a,,b", ",") is ["a", "", "b"], and a string without
// `delim` is one field, itself ("" too).  join(split(s, d), d) == s.  An
// empty `delim` panics.
fn split(s: view Str, delim: view Str) -> List<Str> {
  if delim.len() == 0 {
    _panic("split: the delimiter is empty");
  }
  out = List<Str>();
  let step = unsigned(delim.len());
  from: unsigned = 0;
  at = _find(s, delim, 0);
  while at >= 0 {
    let end = unsigned(at);
    out.push(_slice(s, from, end));
    from = end + step;
    at = _find(s, delim, from);
  }
  out.push(_slice(s, from, unsigned(s.len())));
  return out;
}

// The elements of `parts` with `sep` between each two: "" for no elements.
fn join(parts: view List<Str>, sep: view Str) -> Str {
  out = _Pieces();
  for i in 0..parts.len() {
    if i > 0 {
      out.add(sep);
    }
    out.add(parts.at(i));
  }
  return out.take();
}

// The lines of `s`: the text before each "\n", and after the last one when
// that is not the end of `s`, each without one "\r" it ends with.  "" has
// no lines.
fn lines(s: view Str) -> List<Str> {
  out = List<Str>();
  let n = s.len();
  let newline = "\n";
  from = 0;
  while from < n {
    let at = _find(s, newline, unsigned(from));
    let stop = if at < 0 then n else at;
    let end = if stop > from && s[stop - 1] == '\r' then stop - 1 else stop;
    out.push(_slice(s, unsigned(from), unsigned(end)));
    from = stop + 1;
  }
  return out;
}

// The words of `s`: its runs of bytes other than ASCII whitespace, in order.
fn words(s: view Str) -> List<Str> {
  out = List<Str>();
  let n = s.len();
  i = 0;
  while i < n {
    if _isSpace(s[i]) {
      i = i + 1;
    } else {
      let start = i;
      while i < n && !_isSpace(s[i]) {
        i = i + 1;
      }
      out.push(_slice(s, unsigned(start), unsigned(i)));
    }
  }
  return out;
}

// The index of the first occurrence of `needle` in `s`, or None; an empty
// needle is at 0.
fn indexOf(s: view Str, needle: view Str) -> unsigned? {
  let at = _find(s, needle, 0);
  if at < 0 {
    return None;
  }
  return unsigned(at);
}

// Whether `needle` occurs in `s`; an empty one does in every string.
fn contains(s: view Str, needle: view Str) -> bool {
  return _find(s, needle, 0) >= 0;
}

// Whether `s` starts with `prefix`.
fn startsWith(s: view Str, prefix: view Str) -> bool {
  return prefix.len() <= s.len() && _isAt(s, prefix, 0);
}

// Whether `s` ends with `suffix`.
fn endsWith(s: view Str, suffix: view Str) -> bool {
  return suffix.len() <= s.len() && _isAt(s, suffix, s.len() - suffix.len());
}

// The bytes of `s` from index `from` up to, not including, `to`, as a new
// string; unless from <= to <= s.len(), it panics.
fn substring(s: view Str, from: unsigned, to: unsigned) -> Str {
  return _slice(s, from, to);
}

// `s` without the ASCII whitespace at its start and at its end, as a new
// string.
fn trim(s: view Str) -> Str {
  start = 0;
  end = s.len();
  while start < end && _isSpace(s[start]) {
    start = start + 1;
  }
  while end > start && _isSpace(s[end - 1]) {
    end = end - 1;
  }
  return _slice(s, unsigned(start), unsigned(end));
}

// `s` with every occurrence of `from` replaced by `to`, as a new string.  The
// occurrences are found from the start, each after the one before it ends:
// replace("aaa", "aa", "b") is "ba".  An empty `from` panics.
fn replace(s: view Str, from: view Str, to: view Str) -> Str {
  if from.len() == 0 {
    _panic("replace: the text to replace is empty");
  }
  out = _Pieces();
  let step = unsigned(from.len());
  start: unsigned = 0;
  at = _find(s, from, 0);
  while at >= 0 {
    let end = unsigned(at);
    out.add(_slice(s, start, end));
    out.add(to);
    start = end + step;
    at = _find(s, from, start);
  }
  out.add(_slice(s, start, unsigned(s.len())));
  return out.take();
}

// `s` `n` times over, as a new string: "" for n == 0.  `block` is `s` 2^b
// times over at bit b of `n`, doubled from the one before, and `out` takes
// it in where that bit is set: each byte of the result is copied a few
// times at most, and the loop runs once for each bit of `n` up to its
// highest one set.
fn repeat(s: view Str, n: unsigned) -> Str {
  out = "";
  block = s.toString();
  rest = n;
  while rest > 0 {
    if rest % 2 == 1 {
      out = out + block;
    }
    rest = rest / 2;
    if rest > 0 {
      block = block + block;
    }
  }
  return out;
}
