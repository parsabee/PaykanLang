// ::result: the results of what can fail.
//
// A Result<T, E> is the value an operation made, `Ok(value)`, or the error
// saying why it could not, `Err(error)`: a tagged union
// (docs/language/07-enums.md), taken apart with `match`.  A function of the
// standard library that can fail returns a `Result<T, Error>`, its error an
// ::error Error.
//
//   import ::io;
//   ...
//   match io::open("notes.txt", "r") {
//     f: Ok { ... f.value ... }
//     e: Err { io::printerrln("cannot open notes.txt: " + e.error.message()); }
//   }
//
// `ok` makes the Result of an operation that made a value, as `Result::Ok`
// does; ::error's `fail` makes one that failed with an Error.

/// The value an operation made, or the error saying why it could not.
enum Result<T, E> {
  Ok(value: T),
  Err(error: E)
}

/// The Result of an operation that made @p value.  `E` is taken from the
/// type the Result flows into (`return res::ok(n);` in a function returning a
/// `Result<int, Error>`).
fn ok<T, E>(value: T) -> Result<T, E> {
  return Result::Ok(value);
}
