// ::memory: Buffer<T>, a run of slots whose storage is the runtime's
// (Runtime.h, "Buffer"), reached through generic native functions, and
// Box<T>, one value held in a shared object.
//
// A Buffer is a struct: a handle to its storage, which the runtime holds.
// Copying a Buffer copies the handle, so every copy sees the same slots (as a
// slice header does); the storage goes with the last copy.
//
// A buffer has len() slots.  Every index and count is an `unsigned`.  It
// grows and shrinks only when asked to, and growing a slot at a time is
// amortised O(1).  A new slot holds zero bytes, which is the value 0, 0.0,
// False, char 0 or None.  A reference slot that may not be None (a class,
// Str, a tuple) is unset until stored.
//
// What can go wrong is reported as ::error's errors, not a panic: memory
// that is not there for new slots is `OutOfMemory` (the buffer unchanged),
// an index past the end is `OutOfRange`, reading an unset slot is
// `NotFound`, and shrinking by more than len() is `InvalidArgument`.  So a
// buffer starts empty, `Buffer<T>()`, which allocates no slots, and grows by
// grow(), reserve() or push(), each saying whether it could.  The one exception is
// at() and get(), the reads for code that has checked its index already
// (at() returns the slot itself, a `view`, nothing copied; get() a copy to
// keep): they panic on a bad index, as reading a fixed-size array out of
// bounds does.  copy() is the checked read.
//
// The buffer holds its own reference to each value it stores and drops it
// when the slot is overwritten or shrunk away, or the buffer dies.
//
// Names starting with `_` are private (docs/language/15-modules.md,
// "Private to the module"): the `_` native functions are the module's own,
// and `Buffer`'s `__data` is reachable only from its methods.

import ::error as err;
import ::result as res;

native fn _new<T>(n: unsigned) -> Obj = "PaykanBuffer_new";
native fn _len<T>(b: view Obj) -> unsigned = "PaykanBuffer_len";
native fn _isSet<T>(b: view Obj, i: unsigned) -> int = "PaykanBuffer_isSet";
native fn _get<T>(b: view Obj, i: unsigned) -> view T = "PaykanBuffer_get";
native fn _copy<T>(b: view Obj, i: unsigned) -> T = "PaykanBuffer_copy";
native fn _set<T>(b: inout Obj, i: unsigned, v: view T) = "PaykanBuffer_set";
native fn _reserve<T>(b: inout Obj, n: unsigned)
                      -> int = "PaykanBuffer_tryReserve";
native fn _grow<T>(b: inout Obj, by: unsigned) -> int = "PaykanBuffer_tryGrow";
native fn _shrink<T>(b: inout Obj, by: unsigned) = "PaykanBuffer_shrink";

/// The error of a buffer operation that failed with @p code.
fn _errorOf(code: err::ErrorCode) -> err::Error {
  return err::Error(code, None);
}

struct Buffer<T> {
  __data: Obj;
}

impl Buffer<T> {
  // An empty buffer: no slots, nothing allocated for them.
  fn __init__()                     { self.__data = _new<T>(0); }

  // The number of slots.
  view fn len() -> unsigned         { return _len<T>(self.__data); }

  // Slot `i`, for i < len(), itself: read in place, panicking on a bad
  // index or an unset slot (copy() reports them instead).
  view fn at(i: unsigned) -> view T { return _get<T>(self.__data, i); }

  // A copy of slot `i`, to keep, for i < len(): panicking on a bad index or
  // an unset slot, as at() does (copy() reports them instead).  A copy of
  // an object shares it with the buffer, so it is not taken through a
  // `view` of the buffer: a `view` reads with at().
  fn get(i: unsigned) -> T          { return _copy<T>(self.__data, i); }

  // A copy of slot `i`, to keep: `OutOfRange` past the end, `NotFound` for
  // a slot never set.  As get(), not through a `view`.
  fn copy(i: unsigned) -> res::Result<T, err::Error> {
    if i >= _len<T>(self.__data) {
      return res::fail(_errorOf(err::ErrorCode::OutOfRange));
    }
    if _isSet<T>(self.__data, i) == 0 {
      return res::fail(_errorOf(err::ErrorCode::NotFound));
    }
    return res::ok(_copy<T>(self.__data, i));
  }

  // Store `v` in slot `i`: `OutOfRange` past the end.
  fn set(i: unsigned, v: view T) -> err::Error {
    if i >= _len<T>(self.__data) {
      return _errorOf(err::ErrorCode::OutOfRange);
    }
    _set<T>(self.__data, i, v);
    return err::none();
  }

  // Make the buffer at least `n` slots long: `OutOfMemory` when the slots
  // cannot be allocated.
  fn reserve(n: unsigned) -> err::Error {
    return err::fromErrno(_reserve<T>(self.__data, n));
  }

  // Add `by` new slots at the end: `OutOfMemory` when they cannot be
  // allocated.
  fn grow(by: unsigned) -> err::Error {
    return err::fromErrno(_grow<T>(self.__data, by));
  }

  // Drop the last `by` slots: `InvalidArgument` for more than len().
  fn shrink(by: unsigned) -> err::Error {
    if by > _len<T>(self.__data) {
      return _errorOf(err::ErrorCode::InvalidArgument);
    }
    _shrink<T>(self.__data, by);
    return err::none();
  }

  // Append `v` in a new slot: `OutOfMemory` when it cannot be allocated.
  fn push(v: view T) -> err::Error {
    errno = _grow<T>(self.__data, 1);
    if errno != 0 {
      return err::fromErrno(errno);
    }
    _set<T>(self.__data, _len<T>(self.__data) - 1, v);
    return err::none();
  }

  // Exchange slots `i` and `j`: `OutOfRange` when either is past the end,
  // `NotFound` when either was never set.
  fn swap(i: unsigned, j: unsigned) -> err::Error {
    n = _len<T>(self.__data);
    if i >= n || j >= n {
      return _errorOf(err::ErrorCode::OutOfRange);
    }
    if _isSet<T>(self.__data, i) == 0 || _isSet<T>(self.__data, j) == 0 {
      return _errorOf(err::ErrorCode::NotFound);
    }
    a: T = _copy<T>(self.__data, i);
    b: T = _copy<T>(self.__data, j);
    _set<T>(self.__data, i, b);
    _set<T>(self.__data, j, a);
    return err::none();
  }
}

// One value of a ValueType (int, float, bool, char, an enum or a tuple) in an
// object, so that the value can be shared: assigning a box shares it, and a
// change through one name shows through every other.  get() is the value's
// storage, which the caller reads, assigns through an `inout` local or
// passes to an `inout` parameter.
class Box<T: ValueType> {
  __data: T;
}

impl Box<T> {
  fn __init__(v: T)   { self.__data = v; }
  fn get() -> inout T { return self.__data; }
}
